#!/bin/bash

# omarchy-profile-auth — the no-prompt half of the privileged pair.
#
# It answers exactly one kind of question: "here is a profile's own password,
# is it right, and if so do this one thing with it". Everything it can do needs
# that password first, so it is safe to run through polkit with allow_active
# and no dialog of its own — which is the whole point. On a machine with one
# Unix user, polkit's auth_self means THE OWNER'S password, and the person
# using a profile must be able to rotate their own password without borrowing
# the owner. That is why the privileged code is split in two, and why this half
# is physically incapable of the owner operations: it can never create a hash
# where none exists, never reset one, never bind a face, and never print a hash.
#
#   verify <p>            is this the profile's password
#   change <p>            old\nnew on stdin, replaces the hash
#   clear  <p>            deletes the hash
#   rename <old> <new>    moves hash, identity and counter together
#   remove <p>            deletes hash, identity and counter
#
# Secrets arrive on stdin and nowhere else: a password in argv is readable
# through /proc/<pid>/cmdline by the same Unix user this gate exists to stop,
# and a root process's cmdline is world-readable too.
#
# One JSON object on stdout. Exit 0 ok, 1 error, 2 refused by authentication,
# 3 busy. The engine passes those through unchanged.

set -euo pipefail
# Explicitly, in case the caller exported it: a trace of this script would put
# the password in whatever collects stderr.
set +x
umask 077
# Fixed, because the caller chose the environment this runs in.
PATH=/usr/sbin:/usr/bin
export PATH
unset IFS BASH_ENV ENV

ROOT=/var/lib/omarchy-profiles
PASSWORDS=$ROOT/passwords
IDENTITY=$ROOT/identity
ATTEMPTS=$ROOT/attempts
LOG=$ROOT/log
SELF=omarchy-profile-auth

VERB=${1:-}
PROFILE=${2:-}
ARG=${3:-}

SECRET=""
OLD_SECRET=""
NEW_SECRET=""
# Belt and braces: whatever path is taken out of here, the secrets go with it.
trap 'SECRET=""; OLD_SECRET=""; NEW_SECRET=""' EXIT

# The root log is the record to trust. The engine's own audit() goes through
# logger as the user and any same-user process can write to it; this file can
# only be written by root. Outcomes only — never a secret, not even its length.
log() {
  local ts
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null) || ts="?"
  printf '%s %s verb=%s profile=%s uid=%s result=%s\n' \
    "$ts" "$SELF" "${VERB:-?}" "${PROFILE:-?}" "${PKEXEC_UID:-?}" "$1" >>"$LOG" 2>/dev/null || true
}

ok() {
  printf '%s\n' "${1:-\{\"ok\":true\}}"
  log "${2:-ok}"
  exit 0
}

# fail <exit code> <error> [<extra JSON, leading comma>]
fail() {
  printf '{"error":"%s"%s}\n' "$2" "${3:-}"
  log "$2"
  exit "$1"
}

# Not called through pkexec, and not root either: refuse rather than half-run.
if [[ -z ${PKEXEC_UID:-} ]] && [[ $(id -ru) != 0 ]]; then
  fail 1 not_privileged
fi

# argv is caller-chosen, so every name is validated before it is used to build
# a path. The engine's own rule plus a length bound.
valid_profile() { [[ $1 =~ ^[a-zA-Z0-9_-]{1,64}$ ]]; }
valid_identity() { [[ $1 =~ ^[a-z0-9_-]{1,32}$ ]]; }

valid_profile "$PROFILE" || fail 1 bad_profile_name

# ------------------------------------------------------------------- stdin

# Bounded: more than 1024 bytes is not a password anyone typed, and reading an
# unbounded stream into a variable is how a caller turns this into a memory
# bomb. One trailing newline is stripped — the engine's `printf '%s\n'` adds
# exactly one — and nothing else is touched, because a password may legitimately
# end in a space.
read_secret() {
  local LC_ALL=C blob
  blob=$(head -c 1025; printf .) || blob="."
  blob=${blob%.}
  if ((${#blob} > 1024)); then fail 1 too_long; fi
  SECRET=${blob%$'\n'}
}

# `change` reads exactly two lines: the current password, then the new one.
read_secret_pair() {
  local LC_ALL=C blob rest
  blob=$(head -c 2051; printf .) || blob="."
  blob=${blob%.}
  if ((${#blob} > 2050)); then fail 1 too_long; fi
  OLD_SECRET=${blob%%$'\n'*}
  rest=${blob#*$'\n'}
  # No newline at all means one line was sent: a current password and no new one.
  if [[ $rest == "$blob" ]]; then rest=""; fi
  NEW_SECRET=${rest%%$'\n'*}
}

# ------------------------------------------------------- the per-profile lock

# Every verb here runs inside it, so a hundred parallel callers get one
# comparison at a time and a locked-out profile is refused before any
# comparison at all. Throughput is bounded by the lockout schedule rather than
# by how many processes the attacker can start.
lock_for() {
  local p=$1 fd=$2
  mkdir -p "$ATTEMPTS" 2>/dev/null || true
  chmod 0700 "$ATTEMPTS" 2>/dev/null || true
  : >>"$ATTEMPTS/$p.lock" 2>/dev/null || fail 1 store_unwritable
  chmod 0600 "$ATTEMPTS/$p.lock" 2>/dev/null || true
  case $fd in 8 | 9) ;; *) fail 1 internal ;; esac
  eval "exec $fd>\"\$ATTEMPTS/\$p.lock\"" || fail 1 store_unwritable
  flock -w 5 "$fd" || fail 3 busy
}

# ------------------------------------------------------------- the comparison

# Assumes the profile's lock is already held.
#
# The order is the point: no hash at all is not an authentication failure and
# does not touch the counter; a lockout is answered before anything is
# compared; empty stdin means "no password supplied" and is not a wrong guess.
check_password() {
  local p=$1 fails=0 until=0 now stored salt cand backoff

  if [[ ! -e $PASSWORDS/$p ]]; then fail 1 no_password; fi

  if [[ -s $ATTEMPTS/$p ]]; then read -r fails until <"$ATTEMPTS/$p" || true; fi
  [[ ${fails:-} =~ ^[0-9]+$ ]] || fails=0
  [[ ${until:-} =~ ^[0-9]+$ ]] || until=0
  now=$(date +%s)

  if ((now < until)); then fail 2 rate_limited ",\"retry_after\":$((until - now))"; fi
  if [[ -z $SECRET ]]; then fail 2 needs_password; fi

  stored=$(<"$PASSWORDS/$p")
  # Field 3 of $6$salt$hash. Never the positional form of `openssl passwd`,
  # which takes the password as an argument.
  salt=${stored#*\$}
  salt=${salt#*\$}
  salt=${salt%%\$*}
  cand=$(printf '%s\n' "$SECRET" | openssl passwd -6 -salt "$salt" -stdin 2>/dev/null) || cand=""

  if [[ -n $cand && $cand == "$stored" ]]; then
    printf '0 0\n' >"$ATTEMPTS/$p" 2>/dev/null || true
    chmod 0600 "$ATTEMPTS/$p" 2>/dev/null || true
    return 0
  fi

  fails=$((fails + 1))
  until=0
  if ((fails >= 5)); then
    if ((fails - 5 > 5)); then
      backoff=900
    else
      backoff=$((30 * (2 ** (fails - 5))))
      if ((backoff > 900)); then backoff=900; fi
    fi
    until=$((now + backoff))
  fi
  printf '%s %s\n' "$fails" "$until" >"$ATTEMPTS/$p" 2>/dev/null || true
  chmod 0600 "$ATTEMPTS/$p" 2>/dev/null || true

  if ((until > now)); then fail 2 rate_limited ",\"retry_after\":$((until - now))"; fi
  fail 2 bad_password
}

# Sets NEW_HASH, and refuses from the MAIN shell rather than from a command
# substitution.
#
# The first version was `write_hash "$p" "$(hash_new)"`, with the refusals
# inside it. A `fail` in a command substitution exits only the subshell, and
# its JSON goes to that subshell's stdout — so an empty new password was
# answered with {"ok":true} and the refusal itself was written into the file as
# the password hash. The profile then had a hash that nothing could ever match.
NEW_HASH=""
make_hash() {
  if [[ -z $NEW_SECRET ]]; then fail 1 empty_password; fi
  NEW_HASH=$(printf '%s\n' "$NEW_SECRET" | openssl passwd -6 -stdin 2>/dev/null) || NEW_HASH=""
  # It has to look like what it claims to be before it is stored: anything else
  # means openssl produced no hash, whatever its exit status said.
  case $NEW_HASH in
  '$6$'*) ;;
  *) fail 1 hash_failed ;;
  esac
}

write_hash() {
  local p=$1 hash=$2 tmp
  mkdir -p "$PASSWORDS" 2>/dev/null || true
  chmod 0711 "$PASSWORDS" 2>/dev/null || true
  tmp=$(mktemp "$PASSWORDS/.$p.XXXXXX") || fail 1 store_unwritable
  printf '%s\n' "$hash" >"$tmp" || { rm -f "$tmp"; fail 1 store_unwritable; }
  chmod 0600 "$tmp"
  chown root:root "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$PASSWORDS/$p" || { rm -f "$tmp"; fail 1 store_unwritable; }
}

# ------------------------------------------------------------------- verbs

case $VERB in
verify)
  read_secret
  lock_for "$PROFILE" 9
  check_password "$PROFILE"
  ok '{"ok":true}' verified
  ;;

change)
  read_secret_pair
  SECRET=$OLD_SECRET
  lock_for "$PROFILE" 9
  check_password "$PROFILE"
  SECRET=""
  make_hash
  write_hash "$PROFILE" "$NEW_HASH"
  NEW_SECRET=""
  ok '{"ok":true}' changed
  ;;

clear)
  read_secret
  lock_for "$PROFILE" 9
  check_password "$PROFILE"
  rm -f "$PASSWORDS/$PROFILE" "$ATTEMPTS/$PROFILE"
  ok '{"ok":true}' cleared
  ;;

rename)
  valid_profile "$ARG" || fail 1 bad_profile_name
  if [[ $ARG == "$PROFILE" ]]; then fail 1 same_name; fi
  if [[ -e $PASSWORDS/$ARG || -e $IDENTITY/$ARG ]]; then fail 1 stale_password; fi
  read_secret
  # Both counters, in name order, so two renames crossing each other cannot
  # deadlock waiting for one another's lock.
  if [[ $PROFILE < $ARG ]]; then
    lock_for "$PROFILE" 9
    lock_for "$ARG" 8
  else
    lock_for "$ARG" 8
    lock_for "$PROFILE" 9
  fi
  check_password "$PROFILE"
  moved=""
  for d in "$PASSWORDS" "$IDENTITY" "$ATTEMPTS"; do
    [[ -e $d/$PROFILE ]] || continue
    if mv -n "$d/$PROFILE" "$d/$ARG"; then
      moved="$moved $d"
    else
      # Partial failure puts everything back rather than leaving a profile
      # whose hash lives under one name and whose binding lives under another.
      for b in $moved; do mv -n "$b/$ARG" "$b/$PROFILE" 2>/dev/null || true; done
      fail 1 rename_failed
    fi
  done
  # The lock file follows too, or the next caller would serialise on a name
  # that no longer exists. If the new name already had one (we just created it
  # taking both locks), the old one is simply dropped — it is an empty file
  # whose only purpose was to be flocked.
  mv -n "$ATTEMPTS/$PROFILE.lock" "$ATTEMPTS/$ARG.lock" 2>/dev/null || true
  rm -f "$ATTEMPTS/$PROFILE.lock"
  ok '{"ok":true}' "renamed to $ARG"
  ;;

remove)
  read_secret
  lock_for "$PROFILE" 9
  check_password "$PROFILE"
  rm -f "$PASSWORDS/$PROFILE" "$IDENTITY/$PROFILE" "$ATTEMPTS/$PROFILE"
  ok '{"ok":true}' removed
  ;;

*)
  fail 1 unknown_verb
  ;;
esac
