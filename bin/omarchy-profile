#!/bin/bash

# omarchy-profile — switch the machine between profiles.
#
# A profile is a saved desktop: theme, wallpaper, bar layout, which plugins run,
# which applications are visible, do-not-disturb, idle timers, a browser data
# directory and a block of workspaces. Switching is not "apply a template" — the
# outgoing profile's live state is captured back into it first, so anything
# changed while inside a profile is still there next time. Profiles are saved
# desks, not presets.
#
# One profile is the master. It sees every application, new profiles are copied
# from it, and an application installed anywhere is registered to it.
#
#   ~/.config/omarchy/profiles/config.json    global settings
#   ~/.config/omarchy/profiles/<name>.json    one profile
#   ~/.local/state/omarchy-profiles/current.json   which profile is active
#
# This script is the engine. The Quickshell plugin is a face for it; everything
# here works from a terminal or a keybind with no shell running, which is what
# makes recovery possible when the shell is the thing that broke.

set -uo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

PROFILE_DIR="$CONFIG_HOME/omarchy/profiles"
CONFIG_FILE="$PROFILE_DIR/config.json"
SHELL_JSON="$CONFIG_HOME/omarchy/shell.json"
# Where this copy of the plugin lives, so messages can point at the file the
# user actually has rather than at a path we hope they installed to.
PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

STATE_DIR="$STATE_HOME/omarchy-profiles"
STATE_FILE="$STATE_DIR/current.json"
THEME_NAME_FILE="$STATE_HOME/omarchy/current/theme.name"

# A switch outlives the process that started it — it restarts the shell that
# asked for it — so what it is doing has to be written down somewhere that
# survives both. These three are that record, and they are read before any
# switch starts as well as after one dies.
LOCK_FILE="$STATE_DIR/.lock"
JOURNAL="$STATE_DIR/switch.json"
SWITCH_LOG="$STATE_DIR/switch.log"

# Application visibility writes XDG hidden entries here. Deliberately the
# literal path and not "$DATA_HOME/applications": Omarchy's hidden-entries.sh
# scans ~/.local/share/applications whatever XDG_DATA_HOME says, so writing
# anywhere else would hide nothing.
APPS_DIR="$HOME/.local/share/applications"
APP_BACKUP_DIR="$STATE_DIR/desktop-backups"
# Written into the [Desktop Entry] group of every file we touch. Which tag a
# file carries is what decides how it is put back (see the section below).
APP_TAG_HIDDEN="X-OmarchyProfiles-Hidden"
APP_TAG_MODIFIED="X-OmarchyProfiles-Modified"

die() { echo "omarchy-profile: $*" >&2; exit 1; }
warn() { echo "omarchy-profile: $*" >&2; }

# A --json verb prints ONE JSON document on stdout and nothing else, and every
# word meant for a person goes to stderr. Set by the verbs that take the flag,
# read by refuse() and answer(), so a refusal does not have to be written twice.
JSON=""

# refuse <exit-code> <error> <message> [<extra JSON object>]
#
# The error string is the contract's; the message is the same thing said to a
# person. Exit codes: 1 error, 2 refused by authentication, 3 busy.
refuse() {
  local code=$1 err=$2 msg=$3 extra=${4:-}
  if [[ -n $JSON ]]; then
    if [[ -n $extra ]]; then jq -nc --arg e "$err" --argjson x "$extra" '{error: $e} + $x'
    else jq -nc --arg e "$err" '{error: $e}'; fi
  fi
  [[ -n $msg ]] && echo "omarchy-profile: $msg" >&2
  exit "$code"
}

# answer <json> <prose> — one verdict, in whichever language was asked for.
answer() { if [[ -n $JSON ]]; then printf '%s\n' "$1"; else printf '%s\n' "$2"; fi; }

# Verbs the contract names but that a later phase builds. They are dispatchable
# from the day the contract freezes, so a panel that calls one gets a JSON
# answer it can render rather than "unknown command" on stderr and exit 1 with
# nothing on stdout.
not_implemented() {
  echo '{"error":"not_implemented"}'
  echo "omarchy-profile: '$*' is not built yet" >&2
  exit 1
}

command -v jq >/dev/null || die "jq is required"

# ------------------------------------------------------------------ config

ensure_config() {
  mkdir -p "$PROFILE_DIR" "$STATE_DIR"
  [[ -s $CONFIG_FILE ]] && return 0
  # No `last` and no `unlock.method`: `.last` always equalled current.json, so
  # nothing could use it, and how a profile is authenticated is no longer a
  # setting — it is whether the profile has a password.
  jq -n '{
    version: 1, master: "master", master_switchable: true,
    pinned_plugins: ["kalinewb.profiles"], workspace_span: 10,
    isolate: []
  }' >"$CONFIG_FILE"
}

# cfg <filter>            raw string value
# cfg -c <filter>         compact JSON (for arrays handed to --argjson)
cfg() {
  if [[ ${1:-} == -c ]]; then jq -c "$2" "$CONFIG_FILE" 2>/dev/null
  else jq -r "$1" "$CONFIG_FILE" 2>/dev/null; fi
}

cfg_set() {
  local tmp
  # In the config file's own directory. A bare mktemp is /tmp, on tmpfs, so the
  # mv below would be a cross-filesystem copy rather than an atomic rename —
  # and a half-written config.json is a machine with no master profile.
  tmp=$(mktemp "$CONFIG_FILE.XXXXXX") || return 1
  jq "$@" "$CONFIG_FILE" >"$tmp" && mv "$tmp" "$CONFIG_FILE" || { rm -f "$tmp"; return 1; }
}

file_for() { printf '%s/%s.json\n' "$PROFILE_DIR" "$1"; }

profile_names() {
  find "$PROFILE_DIR" -maxdepth 1 -name '*.json' -not -name 'config.json' -printf '%f\n' 2>/dev/null |
    sed 's/\.json$//' | sort
}

exists() { [[ -f $(file_for "$1") ]]; }

current_profile() {
  [[ -s $STATE_FILE ]] || { echo ""; return; }
  jq -r '.profile // ""' "$STATE_FILE" 2>/dev/null
}

is_master() { [[ $1 == "$(cfg .master)" ]]; }

# Workspace blocks are allocated in order and never reused while a profile
# holds one, so window ids stay stable across a rename or a reordering.
next_offset() {
  local span used max=-1
  span=$(cfg .workspace_span); [[ $span =~ ^[0-9]+$ ]] || span=10
  while read -r n; do
    [[ -n $n ]] || continue
    used=$(jq -r '.workspaces.offset // 0' "$(file_for "$n")" 2>/dev/null)
    [[ $used =~ ^[0-9]+$ ]] && ((used > max)) && max=$used
  done < <(profile_names)
  ((max < 0)) && { echo 0; return; }
  echo $((max + span))
}

# ------------------------------------------------- passwords and the gate
#
# A profile is protected by a password of its own, not by the machine owner's.
#
# The owner's password was the wrong question: a partner could not open THEIR
# own desk without the owner standing there. So each profile carries its own
# hash, and the owner is only asked for the things that are genuinely the
# owner's — creating a password, resetting one somebody has forgotten, and
# deciding whose face opens a profile.
#
# The hash is root-owned and this script is not privileged, so the gate reads
# root-owned state and asks a root helper to do anything with it:
#
#   /var/lib/omarchy-profiles/passwords/<p>   root:root 0600   the hash
#   /var/lib/omarchy-profiles/identity/<p>    root:root 0644   whose face opens it
#   /var/lib/omarchy-profiles/attempts/<p>    root:root 0600   the rate-limit counter
#
# passwords/ is 0711: execute without read. This script can ask whether a hash
# exists for a name it already knows — which is all `hasPassword` needs — and
# cannot list the directory or open a hash. Profile names are not secret; they
# are file names in ~/.config/omarchy/profiles.
#
# What this does and does not hold. Root ownership closes exactly one hole:
# switching a lock off by editing a setting. It also makes the password itself
# unreadable and unforgeable. It does NOT make the gate a security boundary —
# the gate is decided by this script, which lives in a directory the user can
# write, and every profile is the same Unix user, so anyone willing to edit
# files can enter any profile and read any profile's data without entering it
# at all. It stops a person at the keyboard using the desktop as intended.

ROOT_STORE=/var/lib/omarchy-profiles
HELPER_AUTH=/usr/local/bin/omarchy-profile-auth
HELPER_PASSWD=/usr/local/bin/omarchy-profile-passwd
POLICY_SRC="$PLUGIN_DIR/polkit/no.kalinewb.profiles.policy"
POLICY_DEST=/usr/share/polkit-1/actions/no.kalinewb.profiles.policy
# The single-action file this replaces. An install that leaves it registered
# leaves a stale action behind, so it is removed by name as well as overwritten.
POLICY_LEGACY=/usr/share/polkit-1/actions/no.kalinewb.profiles.unlock.policy

profile_locked() { jq -e '.locked // false' "$(file_for "$1")" >/dev/null 2>&1; }

# The three questions the gate asks, and the only three. `hasPassword` is never
# stored as truth anywhere the user can write: write_index puts a derived copy
# in profiles.json for the panel to render, and this is where it comes from.
has_password() { [[ -e $ROOT_STORE/passwords/$1 ]]; }

# `locked` without a hash is the migration state — a profile locked under the
# old owner-identity model. It falls back to the owner prompt and the `locks`
# Setup row names it. In that state only, and nowhere else, editing the profile
# JSON can remove the gate.
asks_auth() { has_password "$1" || profile_locked "$1"; }

# Whose face opens a profile. Root-side, written only by the owner helper: a
# partner with an enrolled face can no longer bind it to somebody else's
# profile by editing a JSON file.
bound_identity() {
  [[ -r $ROOT_STORE/identity/$1 ]] || return 1
  local v
  v=$(head -c 64 "$ROOT_STORE/identity/$1" 2>/dev/null | head -1)
  [[ -n $v ]] || return 1
  printf '%s\n' "$v"
}

password_status() {
  has_password "$1" && { echo set; return 0; }
  profile_locked "$1" && { echo locked_no_password; return 0; }
  echo none
}

# Absolute path first: PATH belongs to whoever called us, and the install
# location does not. Replaces every hardcoded reference to the face helper.
face_identity() {
  local p=/usr/local/bin/omarchy-face-identity
  [[ -x $p ]] && { printf '%s\n' "$p"; return 0; }
  command -v omarchy-face-identity
}

face_installed() { face_identity >/dev/null 2>&1; }

# Every attempt is logged, pass or fail.
#
# Not for its own sake: with a face bound, a successful unlock is silent and
# instant, which is indistinguishable from no check having run at all. "It did
# not ask me for anything" is the expected experience and also exactly what a
# broken gate looks like, so the only way to tell them apart is a record.
# `journalctl --user -t omarchy-profile` shows it.
#
# Advisory only, and labelled as such: this goes through logger as the user, so
# any process running as the user can write to it. The helpers' root-owned log
# at /var/lib/omarchy-profiles/log is the record to trust.
audit() { logger -t omarchy-profile -p user.notice -- "$*" 2>/dev/null || true; }

# ----------------------------------------------------------------- secrets
#
# A password in argv is readable through /proc/<pid>/cmdline by the same Unix
# user this gate exists to stop — and a root process's cmdline is world
# readable too. So: stdin only, never an argument, never an environment
# variable, never a temp file, and never echoed back into an error, a log line
# or a trace.

SECRET=""
OLD_SECRET=""
NEW_SECRET=""
HELPER_STDIN=""

clear_secrets() { SECRET=""; OLD_SECRET=""; NEW_SECRET=""; HELPER_STDIN=""; }

# Whatever path is taken out of this process, the secrets go with it.
trap 'clear_secrets' EXIT

# Bounded, because reading an unbounded stream into a variable is how a caller
# turns a password field into a memory bomb. Exactly one trailing newline is
# stripped — the sender adds exactly one — and nothing else, because a password
# may legitimately end in a space.
#
# Empty stdin means "no password supplied", never "an empty password".
read_secret() {
  local LC_ALL=C blob
  blob=$(head -c 1025; printf .) || blob="."
  blob=${blob%.}
  ((${#blob} > 1024)) && refuse 1 too_long "that is not a password anyone typed"
  SECRET=${blob%$'\n'}
  return 0
}

# `password change` sends the current password and the new one, one per line.
read_secret_pair() {
  local LC_ALL=C blob rest
  blob=$(head -c 2051; printf .) || blob="."
  blob=${blob%.}
  ((${#blob} > 2050)) && refuse 1 too_long "that is not a password anyone typed"
  OLD_SECRET=${blob%%$'\n'*}
  rest=${blob#*$'\n'}
  [[ $rest == "$blob" ]] && rest=""
  NEW_SECRET=${rest%%$'\n'*}
  return 0
}

# At a terminal there is no GUI to collect anything, so ask here — with `read
# -rs`, which echoes nothing. The panel never takes this path: its stdin is a
# pipe.
prompt_secret() {
  local label=$1
  printf '%s: ' "$label" >&2
  IFS= read -rs SECRET
  printf '\n' >&2
  return 0
}

# The one way a secret is collected for a profile, whichever side called.
collect_secret() {
  local name=$1
  SECRET=""
  if [[ -t 0 ]]; then
    has_password "$name" || return 0
    prompt_secret "Password for $name (empty to authorise as the owner)"
    return 0
  fi
  read_secret
}

# ------------------------------------------------------------- the helpers
#
# Two of them, because the two halves answer to different people:
#
#   omarchy-profile-auth    allow_active, no dialog. Everything it does is
#                           gated by the profile's own password, which is why
#                           it needs no prompt of its own.
#   omarchy-profile-passwd  auth_self. The owner's operations: create a
#                           password, reset one, bind a face, purge.
#
# The secret is piped in with bash's builtin printf — never /usr/bin/printf,
# never echo from a subshell, never a here-string, all of which would put it
# somewhere another process can read.

HELPER_OUT=""

helper_call() {
  local which=$1
  shift
  local bin rc
  if [[ $which == owner ]]; then bin=$HELPER_PASSWD; else bin=$HELPER_AUTH; fi

  if [[ ! -x $bin ]]; then
    HELPER_OUT='{"error":"helper_unavailable"}'
    return 1
  fi
  if ! command -v pkexec >/dev/null; then
    HELPER_OUT='{"error":"helper_unavailable"}'
    return 1
  fi

  HELPER_OUT=$(printf '%s\n' "$HELPER_STDIN" | pkexec "$bin" "$@" 2>/dev/null)
  rc=$?

  # pkexec's own codes, which are not the helper's. 126 is a dismissed dialog
  # and 127 is not authorised.
  if ((rc == 126 || rc == 127)); then
    if [[ $which == owner ]]; then
      HELPER_OUT='{"error":"owner_declined"}'
      return 2
    fi
    # From the no-prompt helper these mean the action is missing or
    # unannotated, so pkexec fell back to its generic admin action and there
    # was nobody to answer it. That is never "wrong password".
    HELPER_OUT='{"error":"helper_unavailable"}'
    return 1
  fi
  [[ -n $HELPER_OUT ]] || HELPER_OUT=$(jq -nc --argjson c "$rc" '{error: "failed", code: $c}')
  return $rc
}

# The same refusal said to a person. The panel renders the error code itself;
# this is for a terminal.
auth_message() {
  case $1 in
  needs_password) echo "that profile asks for its password" ;;
  bad_password) echo "wrong password" ;;
  rate_limited) echo "too many attempts — wait ${2:-a while} seconds and try again" ;;
  owner_declined) echo "not authorised" ;;
  no_password) echo "that profile has no password" ;;
  empty_password) echo "a password is required" ;;
  helper_unavailable) echo "the password helpers are not installed yet — open Setup" ;;
  busy) echo "the profile is busy — try again in a moment" ;;
  stale_password) echo "a password is still stored under that name" ;;
  *) echo "the password check failed ($1)" ;;
  esac
}

# Call a helper and, on refusal, hand its verdict straight on: the helper's
# JSON is the contract's JSON, so nothing is reworded on the way out.
helper_or_refuse() {
  helper_call "$@"
  local rc=$?
  ((rc == 0)) && return 0
  local out=$HELPER_OUT err retry
  err=$(jq -r '.error // "failed"' <<<"$out" 2>/dev/null) || err=failed
  retry=$(jq -r '.retry_after // ""' <<<"$out" 2>/dev/null)
  [[ -n $JSON ]] && printf '%s\n' "$out"
  warn "$(auth_message "$err" "$retry")"
  clear_secrets
  exit "$rc"
}

# ------------------------------------------------------- entering a profile

# The pid, its start time and the uid — not the bare pid, which is racy: a pid
# can be recycled between the check and the decision. Field 22 of
# /proc/<pid>/stat, read after the LAST ')', so a process whose comm contains a
# space or a bracket cannot shift the field index.
proc_start_time() {
  local stat rest
  stat=$(</proc/$$/stat) || return 1
  rest=${stat##*") "}
  # Deliberate word splitting: everything after the comm is numeric fields.
  # shellcheck disable=SC2206
  local -a f=($rest)
  printf '%s\n' "${f[19]}"
}

# Who may enter this profile, decided before anything is locked or written.
#
# Called by `set` stage 1 with the secret already collected. Returns 0 to let
# the switch proceed, or exits 2 with the contract's verdict.
#
# `face` is deliberately a global: stage 1's TERM trap kills it, which is what
# makes the panel's "stop looking for a face, I am typing" instant.
face=""

auth_entry() {
  local name=$1

  if has_password "$name"; then
    if [[ -n $SECRET ]]; then
      HELPER_STDIN=$SECRET
      helper_or_refuse auth verify "$name"
      clear_secrets
      audit "entered $name by password"
      return 0
    fi

    # Empty stdin with a bound face is the shortcut: try the face, and say
    # `needs_password` if it does not answer. Nothing was guessed, so the
    # counter is untouched either way.
    local id fbin
    id=$(bound_identity "$name") || id=""
    fbin=$(face_identity 2>/dev/null) || fbin=""
    if [[ -n $id && -n $fbin && -x $fbin ]]; then
      # Background and `wait`, never foreground: bash defers a TERM trap until
      # a FOREGROUND child exits, which measured 3011 ms against 307 ms. The
      # trap kills $face, so a typed password cancels the camera immediately.
      timeout 12 "$fbin" verify "$id" >/dev/null 2>&1 &
      face=$!
      if wait "$face"; then
        face=""
        audit "entered $name by bound face '$id'"
        return 0
      fi
      face=""
    fi
    refuse 2 needs_password "'$name' asks for its password"
  fi

  if profile_locked "$name"; then
    # Locked from before passwords existed: there is no profile password to
    # type, so the owner answers. pkcheck asks polkit for a decision without
    # running anything as root — an authorisation question, not a privileged
    # action, and it should not have to become one.
    command -v pkcheck >/dev/null ||
      refuse 1 helper_unavailable "pkcheck is not available, so the owner cannot be asked"
    local start
    start=$(proc_start_time)
    if pkcheck --action-id no.kalinewb.profiles.owner \
         --process "$$,${start:-0},$UID" --allow-user-interaction >/dev/null 2>&1; then
      audit "entered $name by owner authorisation (locked without a password)"
      return 0
    fi
    refuse 2 owner_declined "not authorised — '$name' is locked without a password of its own"
  fi

  return 0
}

# ------------------------------------------------------ managing a password

# `locked` in the profile JSON is belt and braces, not the gate: a hash lost or
# orphaned by a failed rename fails closed to the owner rather than open. It is
# written after the helper has succeeded, never before.
set_locked() {
  local name=$1 want=$2 file tmp
  file=$(file_for "$name")
  [[ -f $file ]] || return 0
  tmp=$(mktemp "$file.XXXXXX") || return 1
  jq --argjson l "$want" '.locked = $l' "$file" >"$tmp" && mv "$tmp" "$file" || {
    rm -f "$tmp"
    warn "could not record the lock state of '$name' — it stays as it was"
    return 1
  }
}

# What an older version of this plugin left in a profile's JSON.
#
# The `identity` key is deleted rather than copied into the root store: copying
# a user-writable value into root storage would launder exactly the edit the
# root store exists to prevent — anyone who could type a face name into a JSON
# file would get it blessed as a root-side binding. So the binding is dropped
# and the `locks` row asks for it to be made again, by the owner. Its dead
# companion `owner_override` goes with it: the setting it modified is gone.
migrate_profiles() {
  local n file tmp changed=0
  while read -r n; do
    [[ -n $n ]] || continue
    file=$(file_for "$n")
    jq -e 'has("identity") or has("owner_override")' "$file" >/dev/null 2>&1 || continue
    tmp=$(mktemp "$file.XXXXXX") || continue
    if jq 'del(.identity) | del(.owner_override)' "$file" >"$tmp" && mv "$tmp" "$file"; then
      changed=$((changed + 1))
      audit "migration: dropped the editable face binding on $n"
    else
      rm -f "$tmp"
      warn "could not migrate '$n'"
    fi
  done < <(profile_names)
  ((changed > 0)) && echo "migrated $changed profile(s) off the old face binding"
  return 0
}

# Names this machine has given a password to.
#
# passwords/ is 0711 on purpose, so nothing unprivileged can list it: the modes
# are what make `hasPassword` answerable without being able to read a hash. The
# cost is that a hash under a name nothing else remembers is invisible, so the
# names are also written down here as a hint — not as truth. Nothing is gated
# on this file; it only gives the `stale-hashes` row somewhere to look, and
# every name it offers is checked against the root store and against the
# profile directory before it is shown, let alone acted on.
PASSWORD_NAMES="$STATE_DIR/password-names"

note_password_name() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  grep -qxF -- "$1" "$PASSWORD_NAMES" 2>/dev/null && return 0
  printf '%s\n' "$1" >>"$PASSWORD_NAMES" 2>/dev/null || true
}

cmd_password() {
  local verb="" name="" a
  for a in "$@"; do
    case $a in
    --json) JSON=1 ;;
    -*) die "unknown option '$a'" ;;
    *) if [[ -z $verb ]]; then verb=$a; elif [[ -z $name ]]; then name=$a; fi ;;
    esac
  done
  [[ -n $verb ]] || die "usage: omarchy-profile password <set|change|clear|reset|status> <name>"
  [[ -n $name ]] || die "usage: omarchy-profile password $verb <name>"
  exists "$name" || refuse 1 no_such_profile "no such profile '$name'"

  case $verb in
  status)
    answer "$(jq -nc --arg s "$(password_status "$name")" '{status: $s}')" "$(password_status "$name")" ;;

  set | reset)
    # The owner authorises; the new password itself is typed by whoever will be
    # using the profile, and travels on stdin like every other secret.
    if [[ -t 0 ]]; then prompt_secret "New password for $name"; else read_secret; fi
    [[ -n $SECRET ]] || refuse 1 empty_password "a password is required"
    HELPER_STDIN=$SECRET
    helper_or_refuse owner "$verb" "$name"
    clear_secrets
    note_password_name "$name"
    set_locked "$name" true
    write_index
    audit "password $verb on $name"
    answer '{"ok":true}' "'$name' now asks for its password" ;;

  change)
    if [[ -t 0 ]]; then
      prompt_secret "Current password for $name"; OLD_SECRET=$SECRET
      prompt_secret "New password for $name"; NEW_SECRET=$SECRET
      SECRET=""
    else
      read_secret_pair
    fi
    [[ -n $NEW_SECRET ]] || refuse 1 empty_password "a new password is required"
    HELPER_STDIN="$OLD_SECRET"$'\n'"$NEW_SECRET"
    helper_or_refuse auth change "$name"
    clear_secrets
    note_password_name "$name"
    set_locked "$name" true
    write_index
    audit "password changed on $name"
    answer '{"ok":true}' "the password for '$name' was changed" ;;

  clear)
    collect_secret "$name"
    if [[ -n $SECRET ]]; then
      HELPER_STDIN=$SECRET
      helper_or_refuse auth clear "$name"
    else
      HELPER_STDIN=""
      helper_or_refuse owner clear "$name"
    fi
    clear_secrets
    # Only once the helper has succeeded, and on EVERY clear path: otherwise
    # "remove password" would leave the profile locked_no_password, asking for
    # the owner on every entry — which is not what the button says.
    set_locked "$name" false
    write_index
    audit "password cleared on $name"
    answer '{"ok":true}' "'$name' no longer asks for a password" ;;

  *) die "unknown password verb '$verb' (set, change, clear, reset, status)" ;;
  esac
}

# Which face opens which profile. The binding itself is root-side; this only
# asks the owner helper to write it.
cmd_identity() {
  local verb="" name="" identity="" a
  for a in "$@"; do
    case $a in
    --json) JSON=1 ;;
    -*) die "unknown option '$a'" ;;
    *)
      if [[ -z $verb ]]; then verb=$a
      elif [[ -z $name ]]; then name=$a
      elif [[ -z $identity ]]; then identity=$a; fi ;;
    esac
  done

  case ${verb:-list} in
  list)
    local fbin names='[]' installed=false
    fbin=$(face_identity 2>/dev/null) || fbin=""
    if [[ -n $fbin && -x $fbin ]]; then
      installed=true
      names=$("$fbin" list 2>/dev/null | jq -Rsc 'split("\n") | map(select(length > 0))') || names='[]'
    fi
    answer "$(jq -nc --argjson i "$installed" --argjson n "${names:-[]}" '{installed: $i, names: $n}')" \
           "$(printf '%s\n' "${names}" | jq -r '.[]' 2>/dev/null)" ;;

  bind)
    [[ -n $name && -n $identity ]] || die "usage: omarchy-profile identity bind <profile> <identity>"
    exists "$name" || refuse 1 no_such_profile "no such profile '$name'"
    [[ $identity =~ ^[a-z0-9_-]{1,32}$ ]] || refuse 1 bad_identity "'$identity' is not a face name"
    # Refuse to point a profile at a face that was never enrolled: it would
    # look configured and silently never open for anybody.
    local fbin
    fbin=$(face_identity 2>/dev/null) || fbin=""
    [[ -n $fbin && -x $fbin ]] || refuse 1 face_absent "omarchy-face is not installed, so a face cannot be bound"
    "$fbin" list 2>/dev/null | grep -qx -- "$identity" ||
      refuse 1 no_such_identity "no face enrolled as '$identity' — enrol it in Face Unlock first"
    HELPER_STDIN=""
    helper_or_refuse owner bind "$name" "$identity"
    write_index
    audit "identity '$identity' bound to $name"
    answer '{"ok":true}' "$name also opens for the face enrolled as '$identity'" ;;

  clear)
    [[ -n $name ]] || die "usage: omarchy-profile identity clear <profile>"
    exists "$name" || refuse 1 no_such_profile "no such profile '$name'"
    HELPER_STDIN=""
    helper_or_refuse owner unbind "$name"
    write_index
    audit "identity cleared on $name"
    answer '{"ok":true}' "$name no longer opens for a face of its own" ;;

  *) die "usage: omarchy-profile identity <list|bind|clear> ..." ;;
  esac
}

# --------------------------------------------------------------- isolation
#
# Per-profile plugin state.
#
# A plugin's settings are per-profile already when it keeps them inline in
# shell.json, because a profile captures that whole object. Plugins with their
# own files outside it are global: the Spotify plugin's session lives at
# ~/.local/state/omarchy-spotify/session.json, so every profile is signed in as
# the same person, and the dock's settings live in one arc-dock.json, so every
# profile gets the same dock.
#
# The fix is the trick browsers use for their own profiles: keep one copy per
# profile and point the path the plugin knows at the active profile's copy. The
# plugin is unchanged and unaware.
#
# Swapping is lossless and self-healing:
#   leaving F, entering T, for each isolated path P
#     P is a symlink we own -> remove it (the target is already F's store)
#     P is real, F exists   -> move it into F's store, since the live data is F's
#     P is real, no F       -> move it into .orphaned/, never unlink it
#     T has a store         -> symlink P at it, with -n and no -f
#     T has none            -> tier 2: leave P absent, and the plugin makes a
#                              fresh one; tier 3: seed T's store first, because
#                              a `require`d Hyprland file may never be absent
# Nothing is ever deleted and no symlink is ever left dangling.
#
# Three tiers, and only the third needs anything more than the swap:
#
#   1  theme, wallpaper, bar, plugins, apps, workspaces — captured wholesale
#   2  plugin data outside shell.json — the swap plus the shell restart
#   3  ~/.config/hypr/{looknfeel,bindings,input}.lua — the swap plus
#      `hyprctl reload`, which is confirmed to re-read a swapped Lua file here
#      and probed rather than assumed anywhere else
#
# Tier 3 is the one that can take the desktop with it, so it carries three
# safeguards the others do not need: a blocklist, a seeding rule, and a reload
# that rolls a file back when the compositor reports a new error for it.

ISOLATE_DIR="$STATE_DIR/isolated"
# Where Omarchy's own Hyprland config lives, and the three files this engine
# writes beside the isolate stores.
HYPR_DIR="$CONFIG_HOME/hypr"
# Tier-3 rollbacks, one key per profile with one outstanding. A watched file.
HYPR_ERRORS="$STATE_DIR/hypr-errors.json"
# Every packaged version of a hypr file this engine has ever read, so a store
# that is a stock copy can be recognised as one and quietly updated.
HYPR_PKG_HASHES="$STATE_DIR/hypr-packaged.sha256"
# What this machine was measured to be able to do, keyed by Hyprland version.
PROBES_FILE="$STATE_DIR/probes.json"
# A path a swap could not file under its owner is left exactly where it is and
# recorded here, `path<TAB>owner`. While a line exists no switch may start, so
# no later swap ever has to wonder whose data is at that path. Written by the
# isolate phase; read from here on, which is what makes the refusal real before
# the thing that writes it exists.
PENDING_OWNER="$ISOLATE_DIR/.pending-owner"

# ~/.local/state/omarchy-spotify -> local%state%omarchy-spotify
store_key() { printf '%s' "${1#"$HOME"/}" | tr '/' '%'; }
store_for() { printf '%s/%s/%s\n' "$ISOLATE_DIR" "$1" "$(store_key "$2")"; }

# An isolate entry is either a bare path or {path, plugin}. The tagged form
# exists so one control can answer "is this plugin the same in every profile",
# which is the question a person actually has — they do not think in terms of
# ~/.local/state/omarchy-spotify. Bare strings keep working.
isolated_paths() {
  cfg -c '.isolate // []' |
    jq -r '.[] | if type == "object" then .path else . end' 2>/dev/null |
    while read -r p; do
      [[ -n $p ]] || continue
      printf '%s\n' "${p/#\~/$HOME}"
    done
}

# The same list with each path's reload mode beside it, `path<TAB>reload`.
#
# `reload` is `none` — the swap is enough, because the shell restarts anyway —
# or `hypr`, which means the compositor has to be told. A bare string entry and
# an entry with no `reload` key are both `none`, so nothing written by an older
# version changes meaning.
isolated_rows() {
  cfg -c '.isolate // []' |
    jq -r '.[] | if type == "object" then [.path, (.reload // "none")] else [., "none"] end | @tsv' 2>/dev/null |
    while IFS=$'\t' read -r p r; do
      [[ -n $p ]] || continue
      printf '%s\t%s\n' "${p/#\~/$HOME}" "${r:-none}"
    done
}

# Is anything isolated that the compositor has to be told about? Asked before a
# swap takes a `configerrors` baseline, so a machine with no tier-3 entry never
# pays for one.
has_tier3() { isolated_rows | grep -q $'\thypr$'; }

# --------------------------------------------------------------- blocklist
#
# Four files are refused outright, and the reason is different in each case:
# two are hardware, one is the loader that would take the rest with it, and one
# is managed by Setup and must be identical in every profile — a per-profile
# copy of it means exactly one profile has working workspace keys.
#
# Checked at `isolate add`, and again inside swap_isolated: config.json is the
# user's file and can be edited by hand, and the swap is the step that would
# act on it.
blocklist_reason() {
  local p=${1/#\~/$HOME}
  case $p in
  "$HYPR_DIR"/monitors.lua)
    echo "monitors.lua is hardware, not preference — a switch that relayouts your displays is a bug" ;;
  "$HYPR_DIR"/hyprmoncfg-monitors.lua)
    echo "hyprmoncfg-monitors.lua is generated from your displays, not from your taste" ;;
  "$HYPR_DIR"/hyprland.lua)
    echo "hyprland.lua is the loader every other Hyprland file is required from, and it carries this plugin's managed line" ;;
  "$HYPR_DIR"/profiles-keys.lua)
    echo "profiles-keys.lua is managed by Setup and has to be identical in every profile, or only one profile has working workspace keys" ;;
  "$ISOLATE_DIR" | "$ISOLATE_DIR"/* | "$STATE_DIR" | "$STATE_DIR"/* | "$PROFILE_DIR" | "$PROFILE_DIR"/*)
    echo "that is this plugin's own data" ;;
  esac
  [[ $p == "$HOME"/* ]] || echo "it is outside your home directory"
}

is_blocklisted() { [[ -n $(blocklist_reason "$1") ]]; }

# Omarchy's own copy of a hypr file, resolved the way Omarchy's migrations
# resolve it (1781485962.sh:11-19). This is what a clean profile starts from and
# what a broken store falls back to.
packaged_hypr_file() {
  local name=$1 p
  for p in "${OMARCHY_PATH:-/usr/share/omarchy}/config/hypr/$name" "/etc/skel/.config/hypr/$name"; do
    [[ -f $p ]] && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}

# The packaged file for an isolated path, or nothing if the path is not one of
# Omarchy's hypr files.
packaged_for_path() {
  local path=${1/#\~/$HOME}
  [[ $path == "$HYPR_DIR"/* ]] || return 1
  packaged_hypr_file "${path##*/}"
}

# Paths this plugin owns, whether isolated right now or parked in `shared`.
plugin_paths() {
  local id=$1
  cfg -c '.isolate // []' |
    jq -r --arg id "$id" '.[] | select(type == "object" and .plugin == $id) | .path' 2>/dev/null |
    while read -r p; do [[ -n $p ]] && printf '%s\n' "${p/#\~/$HOME}"; done
  cfg -c '.shared_paths // []' |
    jq -r --arg id "$id" '.[] | select(.plugin == $id) | .path' 2>/dev/null |
    while read -r p; do [[ -n $p ]] && printf '%s\n' "${p/#\~/$HOME}"; done
}

# Drop every isolate entry naming this path, in whichever form it was written.
#
# Entries exist as a bare string or as {path, plugin}, and as "~/..." or as a
# full path, because both forms have been written at different times. Comparing
# the literals missed the older ones, which then quietly re-isolated a plugin
# that had just been made shared. Normalise both sides against $HOME instead.
drop_isolate_path() {
  local target=${1/#\~/$HOME}
  cfg_set --arg t "$target" --arg home "$HOME" '
    def norm: if startswith("~/") then ($home + .[1:]) else . end;
    .isolate = ((.isolate // [])
      | map(select(((if type == "object" then .path else . end) | norm) != $t)))
  '
}

plugin_is_shared() {
  cfg -c '.pinned_plugins // []' | jq -e --arg id "$1" 'index($id) != null' >/dev/null 2>&1
}

# Pinned plugins that render in the bar.
#
# Pinning used to mean only "a profile may not add this to disabledPlugins",
# which is not enough: applying a profile writes .bar wholesale from what that
# profile captured, so a pinned widget missing from that snapshot still
# vanished. A plugin that is the same in every profile has to be put back.
pinned_bar_widgets() {
  local catalog="$STATE_DIR/plugins.json"
  [[ -s $catalog ]] || return 0
  # `. as $p` before the pipe: inside `$pinned | index(...)` the input is the
  # array, so a bare `.id` there indexes an array with a string and jq aborts.
  # Same mistake as write_catalog had; it fails loudly there and silently here,
  # which is why it survived — an empty list just looks like "nothing pinned".
  jq -r --argjson pinned "$(cfg -c '.pinned_plugins // []')" '
    .[] | . as $p
        | select(($pinned | index($p.id)) != null)
        | select($p.kinds | index("bar-widget"))
        | $p.id
  ' "$catalog" 2>/dev/null
}

# Drop stores belonging to profiles that no longer exist. Removal cleans up
# after itself, but a profile deleted by hand — or by a version of this script
# from before that existed — leaves one behind, and those files can include a
# live Spotify session.
prune_isolated() {
  [[ -d $ISOLATE_DIR ]] || return 0
  local dir name
  for dir in "$ISOLATE_DIR"/*; do
    [[ -d $dir ]] || continue
    name=$(basename "$dir")
    exists "$name" || { rm -rf "${dir:?}"; warn "dropped leftover plugin data for the removed profile '$name'"; }
  done
}

# ------------------------------------------------------- tier-3 seeding
#
# hyprland.lua requires hypr.input, hypr.bindings and hypr.looknfeel without
# pcall, so a missing one aborts the chunk at the next reload: autostart, the
# toggles and the managed workspace keys never load, and SUPER+1..0 are gone.
# One rule — every profile has a store for every tier-3 path — applied wherever
# a profile could otherwise end up without one: `isolate add`, `create --clean`,
# a switch into a profile that has no store, and (phase 8) `purge`.

# A same-directory temp file and a rename, so a store is never half-written:
# the file it stands in for is required by a config that may be reloaded at any
# moment by something other than us.
copy_into_store() {
  local src=$1 store=$2 tmp
  mkdir -p "$(dirname "$store")" || return 1
  tmp=$(mktemp "$store.XXXXXX") || return 1
  cp -- "$src" "$tmp" && mv -T "$tmp" "$store" || { rm -f "$tmp"; return 1; }
}

# seed_tier3 <profile> <path> [<fallback-source>]
#
# The packaged file first — that is what a profile with no opinion should
# start from — and otherwise whatever was live at the path before this switch,
# which is the only other content that is certainly loadable. Stage 1 has
# already refused the switch if neither exists.
seed_tier3() {
  local p=$1 path=$2 fallback=${3:-} store pkg
  store=$(store_for "$p" "$path")
  [[ -e $store || -L $store ]] && return 0
  if pkg=$(packaged_for_path "$path"); then
    note_packaged_hash "$pkg"
    copy_into_store "$pkg" "$store" && return 0
    warn "could not seed $p's copy of ${path/#$HOME/\~} from $pkg"
    return 1
  fi
  if [[ -n $fallback && -f $fallback ]]; then
    copy_into_store "$fallback" "$store" && return 0
  fi
  warn "nothing to seed $p's copy of ${path/#$HOME/\~} from"
  return 1
}

# Every packaged version of a hypr file this engine has read. Without it
# "byte-identical to a packaged version" has no force: against the current
# packaged file alone a stock copy is either already current or unrecognisable.
note_packaged_hash() {
  local pkg=$1 h
  h=$(sha256sum <"$pkg" 2>/dev/null | cut -d' ' -f1) || return 0
  [[ -n $h ]] || return 0
  mkdir -p "$STATE_DIR"
  grep -qxF "$h" "$HYPR_PKG_HASHES" 2>/dev/null || printf '%s\n' "$h" >>"$HYPR_PKG_HASHES"
}

# An Omarchy update rewrites the packaged file, and a migration only reaches the
# active profile's store. A store that is a stock copy of some packaged version
# is brought up to date silently; anything else is the user's own override,
# which Omarchy itself leaves alone (hyprland.lua:15-18).
refresh_if_packaged() {
  local p=$1 path=$2 pkg store s pkg_hash
  pkg=$(packaged_for_path "$path") || return 0
  note_packaged_hash "$pkg"
  store=$(store_for "$p" "$path")
  [[ -f $store && ! -L $store ]] || return 0
  s=$(sha256sum <"$store" 2>/dev/null | cut -d' ' -f1)
  pkg_hash=$(sha256sum <"$pkg" 2>/dev/null | cut -d' ' -f1)
  [[ -n $s && -n $pkg_hash ]] || return 0
  [[ $s == "$pkg_hash" ]] && return 0
  # Not a version of the packaged file we have ever seen: the user's own.
  grep -qxF "$s" "$HYPR_PKG_HASHES" 2>/dev/null || return 0
  copy_into_store "$pkg" "$store" &&
    echo "updated $p's copy of ${path/#$HOME/\~} to the packaged version"
}

# ------------------------------------------------- tier-3 reload and rollback

hypr_live() { command -v hyprctl >/dev/null && [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; }

# `configerrors -j` answers `[""]` on a clean config, so the empty string is
# dropped rather than compared.
hypr_config_errors() {
  local out
  out=$(hyprctl configerrors -j 2>/dev/null) || { echo '[]'; return 0; }
  jq -c 'if type == "array" then map(select(. != "")) else [] end' <<<"$out" 2>/dev/null || echo '[]'
}

# What is at a path right now, as one comparable string.
path_desc() {
  local p=$1
  if [[ -L $p ]]; then printf 'link:%s\n' "$(readlink "$p")"
  elif [[ -e $p ]]; then echo real
  else echo absent; fi
}

hypr_errors_read() { [[ -s $HYPR_ERRORS ]] && cat "$HYPR_ERRORS" || echo '{}'; }

hypr_errors_put() {
  local doc=$1 tmp
  mkdir -p "$STATE_DIR"
  tmp=$(mktemp "$HYPR_ERRORS.XXXXXX") || return 1
  printf '%s\n' "$doc" >"$tmp" && mv -T "$tmp" "$HYPR_ERRORS" || { rm -f "$tmp"; return 1; }
}

# A profile's entry goes when a later switch into it reloads cleanly, and when
# the file it names stops being isolated.
hypr_errors_drop() {
  local p=$1 doc
  [[ -s $HYPR_ERRORS ]] || return 0
  doc=$(jq -c --arg p "$p" 'del(.[$p])' "$HYPR_ERRORS" 2>/dev/null) || return 0
  hypr_errors_put "$doc"
}

hypr_errors_drop_path() {
  local path=${1/#\~/$HOME} doc rel
  [[ -s $HYPR_ERRORS ]] || return 0
  rel=${path/#$HOME/\~}
  doc=$(jq -c --arg p "$path" --arg r "$rel" '
    with_entries(.value.files = ((.value.files // []) | map(select(. != $p and . != $r))))
    | with_entries(select((.value.files // []) | length > 0))' "$HYPR_ERRORS" 2>/dev/null) || return 0
  hypr_errors_put "$doc"
}

# tier3_reload <to> <baseline-json> <path> <prev-source> [<path> <prev-source> ...]
#
# One reload for the whole switch, compared against a baseline taken before
# anything moved — a config that was already reporting errors must not roll a
# file back on every switch. Only the files the compositor names are rolled
# back, so a good override beside a broken one stays linked; when it names none
# of them, every changed file is rolled back, because something in the set is
# the cause and nothing is overwritten either way.
tier3_reload() {
  local to=$1 baseline=${2:-[]}
  shift 2
  hypr_live || return 0
  hyprctl reload >/dev/null 2>&1

  local now new
  now=$(hypr_config_errors)
  new=$(jq -nc --argjson a "$now" --argjson b "${baseline:-[]}" '$a - $b' 2>/dev/null) || new='[]'
  if [[ -z $new || $new == "[]" ]]; then
    [[ -n $to ]] && hypr_errors_drop "$to"
    return 0
  fi

  local paths=() prevs=() path prev
  while (($# >= 2)); do
    paths+=("$1"); prevs+=("$2"); shift 2
  done

  # Blamed by a `path:line:` prefix in the error text, in whichever form the
  # compositor writes the path.
  local blamed=() i
  for i in "${!paths[@]}"; do
    path=${paths[$i]}
    if jq -e --arg p "$path" --arg r "${path/#$HOME/\~}" \
         'any(.[]; contains($p + ":") or contains($r + ":"))' <<<"$new" >/dev/null 2>&1; then
      blamed+=("$i")
    fi
  done
  # The error names none of them. Something in the set is still the cause.
  ((${#blamed[@]})) || blamed=("${!paths[@]}")

  local rolled=() kept=() store keptcopy src pkg
  for i in "${blamed[@]}"; do
    path=${paths[$i]}; prev=${prevs[$i]}
    [[ -n $to ]] || continue
    store=$(store_for "$to" "$path")
    [[ -e $store || -L $store ]] || continue

    # What to put back: the file that was live before the switch, else the
    # packaged one. Without either there is nothing better than what is there.
    src=""
    [[ -n $prev && $prev != - && -f $prev ]] && src=$prev
    [[ -z $src ]] && { pkg=$(packaged_for_path "$path") && src=$pkg; }
    [[ -n $src ]] || { warn "${path/#$HOME/\~} broke the config and there is nothing to put back"; continue; }

    # Timestamped, so a second rollback can never erase the first kept copy —
    # and the profile's own copy is often a hand-edited file that exists
    # nowhere else.
    keptcopy="$store.broken.$(date +%s)"
    if ! mv -T "$store" "$keptcopy"; then
      warn "could not keep $to's broken copy of ${path/#$HOME/\~}"
      continue
    fi
    if ! copy_into_store "$src" "$store"; then
      mv -T "$keptcopy" "$store"
      warn "could not roll ${path/#$HOME/\~} back"
      continue
    fi
    [[ -e $path || -L $path ]] || ln -sn "$store" "$path" 2>/dev/null
    rolled+=("${path/#$HOME/\~}")
    kept+=("${keptcopy/#$HOME/\~}")
    warn "${path/#$HOME/\~} had config errors — $to's copy is kept at ${keptcopy/#$HOME/\~} and the previous file is in use"
  done

  hyprctl reload >/dev/null 2>&1

  ((${#rolled[@]})) || return 0
  local doc
  doc=$(jq -c --arg p "$to" \
           --argjson files "$(printf '%s\n' "${rolled[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
           --argjson kept "$(printf '%s\n' "${kept[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
           --argjson errors "$new" --argjson at "$(date +%s)" \
           '.[$p] = {files: $files, kept: $kept, errors: $errors, at: $at}' <<<"$(hypr_errors_read)")
  [[ -n $doc ]] && hypr_errors_put "$doc"
  return 0
}

# --------------------------------------------------------- the reload probe
#
# Swapping a Lua file and reloading was confirmed on this machine (§0.1). That
# proves one machine, not another Hyprland build or another way of layering a
# config — so whether tier 3 works here is measured, cached against the
# Hyprland version, and reported as a state string rather than assumed.
#
# The block is APPENDED, never substituted: keys set in looknfeel.lua are
# overridden after it here — hyprmoncfg-monitors.lua is dofile'd last from
# hyprland.lua:34 — so a probe that edited the file in place could be overruled
# by a later file and report `broken` on a machine where tier 3 works.
HYPR_PROBE_KEYS=(decoration:rounding decoration:dim_strength general:border_size)

hypr_version_tag() { hyprctl version -j 2>/dev/null | jq -r '.tag // ""'; }

# The cached answer, or `unknown` — never a guess. A different Hyprland version
# resets it: the thing measured is the compositor's behaviour.
hypr_reload_state() {
  hypr_live || { echo unknown; return 0; }
  [[ -s $PROBES_FILE ]] || { echo unknown; return 0; }
  local tag; tag=$(hypr_version_tag)
  [[ -n $tag ]] || { echo unknown; return 0; }
  jq -r --arg v "$tag" '
    if ((.hyprland_reload.version // "") == $v)
    then (.hyprland_reload.state // "unknown") else "unknown" end' "$PROBES_FILE" 2>/dev/null ||
    echo unknown
}

hypr_probe_store() {
  local state=$1 doc tmp
  mkdir -p "$STATE_DIR"
  doc=$(jq -nc --slurpfile old <(([[ -s $PROBES_FILE ]] && cat "$PROBES_FILE") || echo '{}') \
           --arg s "$state" --arg v "$(hypr_version_tag)" --argjson at "$(date +%s)" \
           '($old[0] // {}) + {hyprland_reload: {state: $s, version: $v, at: $at}}') || return 1
  tmp=$(mktemp "$PROBES_FILE.XXXXXX") || return 1
  printf '%s\n' "$doc" >"$tmp" && mv -T "$tmp" "$PROBES_FILE" || { rm -f "$tmp"; return 1; }
}

# The §0.1 test, automated and self-restoring. Probes THROUGH a symlink, which
# is what tier 3 does, and puts back exactly what was there — a real file as a
# real file, a symlink as a symlink — from a trap that runs whatever happens.
hypr_reload_probe() {
  hypr_live ||
    { warn "there is no Hyprland session to probe — this is only answerable from inside one"; return 1; }

  local target="$HYPR_DIR/looknfeel.lua" work="$STATE_DIR/probe" result
  mkdir -p "$work" || return 1
  rm -f "$work/looknfeel.lua" "$work/original"

  result=$(
    orig=$(path_desc "$target")
    restore() {
      case $orig in
      absent) rm -f "$target" ;;
      link:*) rm -f "$target"; ln -sn "${orig#link:}" "$target" ;;
      real)
        # A copy, not a move: restore runs once per key as well as from the
        # trap, and a move would leave the second key's iteration with nothing
        # to put back. `cp -a` restores the mode and the timestamp too, so the
        # file is exactly what it was. The copy goes with $work at the end.
        if [[ -f $work/original ]]; then
          rm -f "$target"
          cp -a "$work/original" "$target"
        fi ;;
      esac
      hyprctl reload >/dev/null 2>&1
    }
    # Unconditional, and up before the first thing that could move the file.
    trap restore EXIT

    content=""
    [[ -e $target ]] && content=$(cat "$target" 2>/dev/null)
    if [[ $orig == real ]]; then
      cp -a "$target" "$work/original" || { echo unknown; exit 0; }
    fi

    for key in "${HYPR_PROBE_KEYS[@]}"; do
      raw=$(hyprctl getoption -j "$key" 2>/dev/null)
      [[ -n $raw ]] || continue
      kind=$(jq -r 'if has("int") then "int" elif has("float") then "float" else "" end' <<<"$raw" 2>/dev/null)
      [[ $kind == int || $kind == float ]] || continue
      v=$(jq -r 'if has("int") then (.int | tostring) else (.float | tostring) end' <<<"$raw")
      # Far enough from the current value that no rounding can confuse the two.
      if [[ $kind == int ]]; then want=$((${v%.*} + 3))
      else want=$(awk -v x="$v" 'BEGIN { printf "%.3f", x + 0.17 }'); fi

      printf '%s\n\n-- kalinewb.profiles reload probe; removed again immediately\nhl.config({ %s = { %s = %s } })\n' \
        "$content" "${key%%:*}" "${key##*:}" "$want" >"$work/looknfeel.lua" || continue
      rm -f "$target"
      ln -sn "$work/looknfeel.lua" "$target" || continue
      hyprctl reload >/dev/null 2>&1
      got=$(hyprctl getoption -j "$key" 2>/dev/null |
            jq -r 'if has("int") then (.int | tostring) else (.float | tostring) end' 2>/dev/null)
      restore
      # The swapped value came back: the compositor re-read the file through
      # the symlink, which is the whole question.
      if [[ -n $got ]] &&
         awk -v a="$got" -v b="$want" 'BEGIN { d = a - b; if (d < 0) d = -d; exit !(d < 0.005) }'; then
        echo ok
        exit 0
      fi
      # V unchanged, or something else entirely: ambiguous, try the next key.
    done
    echo broken
  )

  # The copy the probe linked at is inert once the path is back, and leaving a
  # stray looknfeel.lua in the state directory invites someone to wonder whose
  # it is.
  rm -rf "$work"

  case ${result:-unknown} in
  ok | broken) hypr_probe_store "$result" ;;
  *) result=unknown ;;
  esac
  printf '%s\n' "$result"
}

# A path that cannot be filed is held, never handed on: the real file stays
# where it is, `to` is not linked over it, and the line written here blocks
# every later switch until `setup fix switch` files it.
hold_path() {
  local path=$1 owner=$2
  mkdir -p "$ISOLATE_DIR"
  printf '%s\t%s\n' "$path" "$owner" >>"$PENDING_OWNER"
  warn "could not move ${path/#$HOME/\~} into $owner's store — it is left in place, and switching is blocked until Setup files it"
}

# Runs inside the state lock. Never overwrites a real file, never unlinks one it
# could not save, and never deletes a store before the live file is safely
# somewhere else.
swap_isolated() {
  local from=${1:-} to=${2:-} path reload from_store to_store
  local prev prev_src dest owner baseline='[]' changed=()

  # Before anything moves: a config that was already broken must not look like
  # something this switch did.
  if has_tier3 && hypr_live; then baseline=$(hypr_config_errors); fi

  while IFS=$'\t' read -r path reload; do
    [[ -n $path ]] || continue
    [[ $path == "$HOME"/* ]] || { warn "refusing to isolate '$path' (outside your home)"; continue; }
    if is_blocklisted "$path"; then
      warn "not isolating ${path/#$HOME/\~}: $(blocklist_reason "$path")"
      continue
    fi

    # What is here now, and where its content can still be read from after this
    # iteration has moved it. Both are needed: the first says whether anything
    # changed, the second is what a rollback puts back.
    prev=$(path_desc "$path")
    prev_src=""
    [[ $prev == link:* ]] && prev_src=${prev#link:}

    # No switch runs while a path is held (§4.9), so whatever is here belongs to
    # the outgoing profile and to nobody else.
    owner=$from

    if [[ -L $path && $(readlink "$path") == "$ISOLATE_DIR"/* ]]; then
      # Ours. The target is already a store, so there is nothing to save.
      rm -f "$path"
    elif [[ -e $path || -L $path ]]; then
      if [[ -n $owner ]]; then
        from_store=$(store_for "$owner" "$path")
        mkdir -p "$(dirname "$from_store")" || { hold_path "$path" "$owner"; continue; }
        # .prev may be a tier-2 directory, and `mv -T` onto a non-empty
        # directory fails — so it is cleared first, and only the previous
        # store is ever at risk, never the live file.
        rm -rf "$from_store.prev"
        if [[ -e $from_store || -L $from_store ]]; then
          mv -T "$from_store" "$from_store.prev" || { hold_path "$path" "$owner"; continue; }
        fi
        if mv -T "$path" "$from_store"; then
          prev_src=$from_store
        else
          [[ -e $from_store.prev || -L $from_store.prev ]] && mv -T "$from_store.prev" "$from_store"
          hold_path "$path" "$owner"
          continue
        fi
      else
        # Nobody to file it under. Moved aside rather than unlinked: this is
        # the user's Hyprland config or a dock they have been editing, and an
        # absent current.json is not a reason to lose it.
        dest="$ISOLATE_DIR/.orphaned/$(date +%s)/$(store_key "$path")"
        mkdir -p "${dest%/*}"
        mv -T "$path" "$dest" || { warn "could not move ${path/#$HOME/\~} aside"; continue; }
        prev_src=$dest
        warn "moved ${path/#$HOME/\~} aside to ${dest/#$HOME/\~}: no current profile owned it"
      fi
    fi

    if [[ -n $to ]]; then
      to_store=$(store_for "$to" "$path")
      if [[ $reload == hypr ]]; then
        # A required file may never be absent, so tier 3 seeds rather than
        # leaving the path empty the way tier 2 does.
        [[ -e $to_store || -L $to_store ]] || seed_tier3 "$to" "$path" "$prev_src"
        refresh_if_packaged "$to" "$path"
      fi
      if [[ ! -e $to_store && ! -L $to_store ]]; then
        : # Tier 2 with no store: absent, and the plugin makes a fresh one.
      elif [[ -e $path || -L $path ]]; then
        warn "something recreated ${path/#$HOME/\~} during the switch; not linking over it"
      else
        mkdir -p "$(dirname "$path")"
        # -n so a link to a directory is replaced rather than written inside
        # it, and deliberately no -f: this never replaces anything.
        ln -sn "$to_store" "$path" || warn "could not point ${path/#$HOME/\~} at $to's copy"
      fi
    fi

    [[ $reload == hypr ]] || continue
    [[ $(path_desc "$path") == "$prev" ]] && continue
    changed+=("$path" "${prev_src:--}")
  done < <(isolated_rows)

  ((${#changed[@]})) && tier3_reload "$to" "$baseline" "${changed[@]}"
  return 0
}

# ------------------------------------------------- the manifest convention
#
# A plugin says where its own state lives and the config page offers it, with
# no table here to maintain as the suite grows:
#
#   "omarchy": { "profileData": ["~/.local/state/omarchy-spotify"] }
#
# Read from the installed manifests directly rather than through
# `omarchy-plugin-catalog`, which does not carry the `omarchy` object — it
# emits id, name, description, kinds, entry points and the bar-widget block,
# and nothing else. The catalog is still the source for everything else; this
# is the one field it does not have.
PLUGIN_ROOT="$CONFIG_HOME/omarchy/plugins"

# Known third-party plugins that keep state outside shell.json and declare
# nothing. `id<TAB>path<TAB>label`; only offered when the plugin is installed.
PROFILE_DATA_FALLBACK=(
  $'quickshell.spotify\t~/.local/state/omarchy-spotify\tSpotify account'
  $'io.github.claudsondouglas.arcdock\t~/.config/omarchy/arc-dock.json\tDock layout'
)

# `plugin<TAB>path<TAB>label<TAB>source`, declarations first so a plugin that
# has started declaring wins over its entry in the table above.
declared_profile_data() {
  local mf id p name row
  {
    for mf in "$PLUGIN_ROOT"/*/manifest.json; do
      [[ -f $mf ]] || continue
      jq -r '(.omarchy.profileData // [])[] as $p
             | [(.id // ""), $p, (.name // .id // ""), "declared"] | @tsv' "$mf" 2>/dev/null
    done
    for row in "${PROFILE_DATA_FALLBACK[@]}"; do
      IFS=$'\t' read -r id p name <<<"$row"
      [[ -d $PLUGIN_ROOT/$id ]] || continue
      printf '%s\t%s\t%s\ttable\n' "$id" "$p" "$name"
    done
  } | while IFS=$'\t' read -r id p name src; do
    [[ -n $id && -n $p ]] || continue
    printf '%s\t%s\t%s\t%s\n' "$id" "${p/#\~/$HOME}" "$name" "$src"
  done | awk -F'\t' '!seen[$2]++'
}

# Where an isolated path came from, for the config page's grouping.
isolate_source() {
  local path=${1/#\~/$HOME} src
  src=$(declared_profile_data | awk -F'\t' -v p="$path" '$2 == p { print $4; exit }')
  [[ -n $src ]] && { printf '%s\n' "$src"; return 0; }
  [[ $path == "$HYPR_DIR"/* ]] && { echo hypr; return 0; }
  echo custom
}

isolate_list_json() {
  local cur; cur=$(current_profile)
  local path reload active store
  while IFS=$'\t' read -r path reload; do
    [[ -n $path ]] || continue
    active=false
    if [[ -L $path && -n $cur ]]; then
      store=$(store_for "$cur" "$path")
      [[ $(readlink "$path") == "$store" ]] && active=true
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$path" \
      "$(cfg -c '.isolate // []' | jq -r --arg p "$path" --arg h "$HOME" '
          def norm: if startswith("~/") then ($h + .[1:]) else . end;
          .[] | select(type == "object") | select((.path | norm) == $p) | .plugin // ""' | head -1)" \
      "$reload" "$active" "$(isolate_source "$path")"
  done < <(isolated_rows) |
    jq -R -s --arg home "$HOME" '
      [ split("\n")[] | select(length > 0) | split("\t")
        | {path: (.[0] | sub("^" + $home; "~")), plugin: .[1], reload: .[2],
           active: (.[3] == "true"), source: .[4]} ]'
}

# Declared and table entries not yet isolated, minus the blocklist: what the
# config page offers with one click.
isolate_candidates_json() {
  local isolated id path name src
  isolated=$(isolated_paths)
  while IFS=$'\t' read -r id path name src; do
    [[ -n $path ]] || continue
    grep -qxF "$path" <<<"$isolated" && continue
    is_blocklisted "$path" && continue
    local kind=absent
    [[ -L $path ]] && kind=symlink
    [[ -d $path ]] && kind=directory
    [[ -f $path && ! -L $path ]] && kind=file
    printf '%s\t%s\t%s\t%s\t%s\n' "$id" "$path" "$name" "$src" "$kind"
  done < <(declared_profile_data) |
    jq -R -s --arg home "$HOME" '
      [ split("\n")[] | select(length > 0) | split("\t")
        | {plugin: .[0], path: (.[1] | sub("^" + $home; "~")), name: .[2],
           source: .[3], kind: .[4], exists: (.[4] != "absent")} ]'
}

# `stat` and the blocklist, and nothing else: this is what the custom-path field
# calls while someone is still typing, so it never follows a path into anything
# and never writes.
isolate_resolve_json() {
  local path=${1/#\~/$HOME} kind=absent size=0 reason
  if [[ -L $path ]]; then kind=symlink
  elif [[ -d $path ]]; then kind=directory
  elif [[ -e $path ]]; then kind=file; fi
  [[ $kind == file ]] && size=$(stat -c %s "$path" 2>/dev/null || echo 0)
  reason=$(blocklist_reason "$path")
  jq -nc --arg p "${path/#$HOME/\~}" --arg k "$kind" --argjson s "${size:-0}" \
         --argjson b "$([[ -n $reason ]] && echo true || echo false)" --arg r "$reason" \
    '{path: $p, exists: ($k != "absent"), kind: $k, size: $s, blocklisted: $b, reason: $r}'
}

# Rule 1 of the seeding rule (§5.3a): the live file goes into every other
# profile that has no copy, before the swap files it under the current one.
# Without this, a switch into a profile that existed before the add would find
# no store and — for a required Hyprland file — no file at all.
seed_other_profiles() {
  local path=$1 cur=$2 src="" name store pkg
  if [[ -e $path && ! -d $path ]]; then src=$path
  elif pkg=$(packaged_for_path "$path"); then src=$pkg; note_packaged_hash "$pkg"; fi
  [[ -n $src ]] || return 0
  while read -r name; do
    [[ -n $name && $name != "$cur" ]] || continue
    store=$(store_for "$name" "$path")
    [[ -e $store || -L $store ]] && continue
    copy_into_store "$src" "$store" ||
      warn "could not give $name its own copy of ${path/#$HOME/\~}"
  done < <(profile_names)
}

cmd_isolate() {
  local verb=${1:-list} plugin="" reload="" path="" a
  shift || true
  # Flags in any order, and the first bare word is the path: the panel sends
  # `--reload hypr` and a person sends neither.
  while (($#)); do
    a=$1
    case $a in
    --json) JSON=1 ;;
    --plugin) plugin=${2:-}; shift ;;
    --reload) reload=${2:-}; shift ;;
    -*) die "unknown option '$a'" ;;
    *) [[ -n $path ]] || path=$a ;;
    esac
    shift
  done

  # Adding or removing a path moves real files between stores, which is exactly
  # what a switch is doing; the two may not interleave. The read verbs never
  # wait — the config page calls `resolve` on every keystroke.
  case $verb in
  add | remove) require_no_journal; lock_or_busy ;;
  esac

  case $verb in
  list)
    if [[ -n $JSON ]]; then isolate_list_json; return 0; fi
    local any=0 p
    while read -r p; do
      [[ -n $p ]] || continue
      any=1
      local mark="  "
      [[ -L $p ]] && mark="* "
      printf '%s%s\n' "$mark" "${p/#$HOME/\~}"
    done < <(isolated_paths)
    ((any)) || echo "nothing isolated — try: omarchy-profile isolate add ~/.local/state/omarchy-spotify"
    echo
    echo "* = currently pointed at the active profile's copy" ;;
  candidates) isolate_candidates_json ;;
  resolve)
    [[ -n $path ]] || die "usage: omarchy-profile isolate resolve <path> --json"
    isolate_resolve_json "$path" ;;
  add)
    # isolate add [--plugin <id>] [--reload hypr|none] <path>
    #
    # The plugin tag is what lets one "same in every profile" control move a
    # plugin's paths together. It cannot be guessed: quickshell.spotify keeps
    # its session in omarchy-spotify, and nothing in either name implies the
    # other.
    [[ -n $path ]] || die "usage: omarchy-profile isolate add [--plugin <id>] [--reload hypr] <path>"
    local expanded=${path/#\~/$HOME}
    local reason; reason=$(blocklist_reason "$expanded")
    [[ -n $reason ]] &&
      refuse 1 blocklisted "cannot isolate ${expanded/#$HOME/\~}: $reason" \
        "$(jq -nc --arg p "${expanded/#$HOME/\~}" --arg r "$reason" '{path: $p, reason: $r}')"

    # A file under ~/.config/hypr is tier 3 unless the caller says otherwise:
    # the compositor has to be told, and nobody adding looknfeel.lua by hand
    # should have to know that.
    if [[ -z $reload ]]; then
      if [[ $expanded == "$HYPR_DIR"/* ]]; then reload=hypr; else reload=none; fi
    fi
    [[ $reload == hypr || $reload == none ]] || die "--reload takes hypr or none"

    local rel=${expanded/#$HOME/\~}
    drop_isolate_path "$expanded"
    cfg_set --arg p "$rel" --arg id "$plugin" --arg r "$reload" \
      '.isolate = ((.isolate // []) + [{path: $p, reload: $r} + (if $id == "" then {} else {plugin: $id} end)])' ||
      die "could not record '$rel'"

    local cur; cur=$(current_profile)
    # Every other profile gets a copy of the live file first, while it is still
    # at the path: a required file may never be absent in any profile.
    [[ $reload == hypr ]] && seed_other_profiles "$expanded" "$cur"
    # Adopt what is live into the profile the user is in, then point at it.
    # Passing the same profile as both sides does exactly that: the real file
    # is filed under it, and the symlink comes back to the copy just made.
    [[ -n $cur ]] && swap_isolated "$cur" "$cur"
    echo "isolating $rel" ;;
  remove)
    [[ -n $path ]] || die "usage: omarchy-profile isolate remove <path>"
    local expanded=${path/#\~/$HOME} cur store
    cur=$(current_profile)
    # Put the active profile's copy back as a real file, so dropping isolation
    # leaves a working setup rather than a dangling link.
    if [[ -L $expanded && -n $cur ]]; then
      store=$(store_for "$cur" "$expanded")
      rm -f "$expanded"
      [[ -e $store ]] && mv "$store" "$expanded"
    fi
    drop_isolate_path "$expanded" || die "could not update the isolate list"
    # A rollback recorded against this file has nothing left to describe.
    hypr_errors_drop_path "$expanded"
    echo "no longer isolating ${expanded/#$HOME/\~}" ;;
  *) die "unknown isolate verb '$verb' (list, add, remove, candidates, resolve)" ;;
  esac
}

# "Is this plugin the same in every profile?" — one question, one control.
#
# Two mechanisms sit underneath it and a person should not have to know either:
# pinning keeps the plugin out of disabledPlugins and forces its widget back
# into every profile's bar, and un-isolating its state files gives it one
# account rather than one per profile. Answering them separately is how you end
# up with music playing and no player: the daemon kept going while the widget
# came back signed in to a different profile's empty session.
cmd_shared() {
  local verb=${1:-list} id=${2:-}
  case $verb in
  list)
    local any=0 p
    while read -r p; do
      [[ -n $p ]] || continue
      any=1
      printf '  %s\n' "$p"
    done < <(cfg -c '.pinned_plugins // []' | jq -r '.[]')
    ((any)) || echo "nothing shared"
    echo
    echo "These are in every profile's bar, cannot be switched off by a profile,"
    echo "and use one set of files rather than one per profile." ;;
  add)
    [[ -n $id ]] || die "usage: omarchy-profile shared add <plugin-id>"
    cfg_set --arg id "$id" '.pinned_plugins = (((.pinned_plugins // []) + [$id]) | unique)' ||
      die "could not pin '$id'"

    # Stop isolating its paths, and keep the record so unsharing can restore it.
    # The active profile's copy becomes the real file, since that is the one the
    # user has been using and the only one that is certainly current.
    local path expanded cur store rel
    cur=$(current_profile)
    while read -r path; do
      [[ -n $path ]] || continue
      expanded=${path/#\~/$HOME}
      rel=$(printf '%s' "$expanded" | sed "s|^$HOME/|~/|")
      if [[ -L $expanded && -n $cur ]]; then
        store=$(store_for "$cur" "$expanded")
        rm -f "$expanded"
        [[ -e $store ]] && mv "$store" "$expanded"
      fi
      drop_isolate_path "$expanded"
      cfg_set --arg p "$rel" --arg id "$id" \
        '.shared_paths = (((.shared_paths // []) + [{path: $p, plugin: $id}]) | unique)' ||
        warn "could not stop isolating $rel"
    done < <(plugin_paths "$id")
    write_catalog
    echo "$id is now the same in every profile" ;;
  remove)
    [[ -n $id ]] || die "usage: omarchy-profile shared remove <plugin-id>"
    [[ $id == kalinewb.profiles ]] &&
      die "the profile picker stays shared — a profile that could hide it would leave no way back"
    cfg_set --arg id "$id" '.pinned_plugins = ((.pinned_plugins // []) | map(select(. != $id)))' ||
      die "could not unpin '$id'"
    # Anything parked in shared_paths goes back to being isolated, with the same
    # reload mode `isolate add` would have given it — a Hyprland file that came
    # back as tier 2 would swap without telling the compositor.
    local path rel reload
    while read -r path; do
      [[ -n $path ]] || continue
      rel=$(printf '%s' "${path/#\~/$HOME}" | sed "s|^$HOME/|~/|")
      if [[ ${path/#\~/$HOME} == "$HYPR_DIR"/* ]]; then reload=hypr; else reload=none; fi
      cfg_set --arg p "$rel" --arg id "$id" --arg r "$reload" \
        '.shared_paths = ((.shared_paths // []) | map(select(.path != $p)))
         | .isolate = (((.isolate // []) + [{path: $p, plugin: $id, reload: $r}]))' ||
        warn "could not isolate $rel again"
    done < <(cfg -c '.shared_paths // []' | jq -r --arg id "$id" '.[] | select(.plugin == $id) | .path')
    local cur; cur=$(current_profile)
    [[ -n $cur ]] && swap_isolated "$cur" "$cur"
    write_catalog
    echo "$id is now per profile" ;;
  *) die "unknown shared verb '$verb' (list, add, remove)" ;;
  esac
}

# ------------------------------------------------------------------ capture

# Read the machine's live state into a profile. This is what makes a profile a
# saved desk: it runs for the OUTGOING profile on every switch, so changes made
# while inside it are kept rather than discarded on the way out.
capture_into() {
  local name=$1 file
  file=$(file_for "$name")
  exists "$name" || { warn "cannot capture into unknown profile '$name'"; return 1; }

  local theme dnd screensaver lock bar
  # `cat`, not `$([[ -s f ]] && <f)`: a redirect with no command runs no command
  # and so produces no output, which silently captured an empty theme.
  theme=$(cat "$THEME_NAME_FILE" 2>/dev/null)
  dnd=$(omarchy-shell notifications isDnd 2>/dev/null)
  [[ $dnd == on ]] && dnd=true || dnd=false
  screensaver=$(jq -r '.idle.screensaver // 150' "$SHELL_JSON" 2>/dev/null)
  lock=$(jq -r '.idle.lock // 300' "$SHELL_JSON" 2>/dev/null)
  # The whole bar object, not a preset name. A profile owning its own layout is
  # what removes any chance of a stale shared preset silently dropping widgets.
  bar=$(jq -c '.bar // {}' "$SHELL_JSON" 2>/dev/null)
  local disabled
  disabled=$(jq -c '.disabledPlugins // []' "$SHELL_JSON" 2>/dev/null)

  local tmp
  tmp=$(mktemp "$file.XXXXXX") || return 1
  jq \
    --arg theme "$theme" \
    --argjson dnd "$dnd" \
    --argjson screensaver "${screensaver:-150}" \
    --argjson lock "${lock:-300}" \
    --argjson bar "${bar:-\{\}}" \
    --argjson disabled "${disabled:-[]}" '
      . as $p
      | .theme = (if $theme == "" then $p.theme else $theme end)
      | .dnd = $dnd
      | .idle = ((.idle // {}) | .screensaver = $screensaver | .lock = $lock)
      | .bar = $bar
      | .plugins = ((.plugins // {}) | .disabled = $disabled)
    ' "$file" >"$tmp" && mv "$tmp" "$file" || { rm -f "$tmp"; warn "capture into '$name' failed"; return 1; }
}

# An index of every profile, for the panel to read.
#
# The panel could shell out and parse `list`, but a QML process per repaint is
# both slow and racy. One JSON file it can FileView, rewritten by whichever
# command changed the set, keeps the UI declarative and means the panel has no
# opinion about where profiles live or what a profile is.
index_json() {
  local master cur
  master=$(cfg .master)
  cur=$(current_profile)
  printf '['
  local first=1 n
  while read -r n; do
    [[ -n $n ]] || continue
    ((first)) || printf ','
    first=0
    # hasPassword and identity come from the root store, never from the profile
    # JSON: both are the facts a user must not be able to edit, and a derived
    # copy here is for rendering only. `locked` is still the JSON's, because
    # without a hash it is the migration state the `locks` row reports.
    jq -c --arg name "$n" \
       --argjson is_master "$([[ $n == "$master" ]] && echo true || echo false)" \
       --argjson active "$([[ $n == "$cur" ]] && echo true || echo false)" \
       --argjson has_password "$(has_password "$n" && echo true || echo false)" \
       --arg identity "$(bound_identity "$n" || true)" '{
      name: $name,
      label: $name,
      description: (._description // ""),
      master: $is_master,
      active: $active,
      hidden: (.hidden // false),
      locked: (.locked // false),
      hasPassword: $has_password,
      identity: $identity,
      theme: (.theme // ""),
      icon: (.icon // ""),
      offset: (.workspaces.offset // 0)
    }' "$(file_for "$n")"
  done < <(profile_names)
  printf ']'
}

write_index() {
  mkdir -p "$STATE_DIR"
  local tmp
  tmp=$(mktemp "$STATE_DIR/profiles.json.XXXXXX") || return 1
  index_json >"$tmp" && mv "$tmp" "$STATE_DIR/profiles.json" || { rm -f "$tmp"; warn "could not write the profile index"; return 1; }
}

# The installable set, for the settings view's toggle lists.
#
# Plugins come from `omarchy plugin list --json` because QML has no plugin
# registry to read; applications are NOT listed here — the panel reads
# DesktopEntries directly, which is always current and needs no refresh.
#
# `pinned` is folded in here rather than left to the UI so every consumer agrees
# on what may not be switched off.
write_catalog() {
  mkdir -p "$STATE_DIR"
  command -v omarchy >/dev/null || return 0
  local tmp pinned state meta
  pinned=$(cfg -c '.pinned_plugins // []')

  # Two sources, because neither alone is enough:
  #   plugin list --json  what is enabled, what may be disabled
  #   plugin-catalog      the description and the author's own category
  # A list of bare ids tells the user nothing about what they are switching
  # off, so the description is the point of joining them.
  state=$(omarchy plugin list --json 2>/dev/null) || state='[]'
  meta=$(omarchy-plugin-catalog 2>/dev/null) || meta='[]'

  # Where each plugin says its own state lives (§5.6). Not in the catalog's
  # output — it carries no `omarchy` object — so it comes from the manifests,
  # which is the same walk one level down.
  local declared
  declared=$(declared_profile_data |
    jq -R -s '[ split("\n")[] | select(length > 0) | split("\t")
                | {id: .[0], path: .[1], source: .[3]} ]') || declared='[]'

  tmp=$(mktemp "$STATE_DIR/plugins.json.XXXXXX") || return 1
  jq -nc --argjson state "${state:-[]}" --argjson meta "${meta:-[]}" \
         --argjson declared "${declared:-[]}" \
         --argjson pinned "${pinned:-[]}" '
    ($meta | map({key: .id, value: .}) | from_entries) as $by_id
    | [ $state[] | . as $p | ($by_id[$p.id] // {}) as $m | {
        id: $p.id,
        name: ($p.name // $p.id),
        kinds: ($p.kinds // []),
        enabled: ($p.enabled // false),
        canDisable: ($p.canDisable // true),
        firstParty: ($p.firstParty // false),
        # $p.id, not .id: after `$pinned |` the input is the array, so `.id`
        # would try to index it with a string.
        pinned: (($pinned | index($p.id)) != null),
        # State of its own outside shell.json, which is what the config page
        # offers to give every profile a copy of.
        profileData: [ $declared[] | select(.id == $p.id) | .path ],
        # The widget blurb first: it is written about the thing in the bar and
        # is shorter than the plugin-level description, which often reads like
        # a README paragraph.
        description: (($m.barWidget.description // $m.description // "") | gsub("\\s+"; " ")),
        # The author'"'"'s own category where they set one — Audio, Compositor,
        # Wellbeing — since it says more than the kind does. Falls back to the
        # kind for the plugins that declare none.
        category: (
          $m.barWidget.category //
          (if ($p.kinds | index("bar-widget")) then "Bar widgets"
           elif ($p.kinds | index("panel")) then "Panels"
           elif ($p.kinds | index("service")) then "Services"
           elif ($p.kinds | index("overlay")) then "Overlays"
           elif ($p.kinds | index("menu")) then "Menus"
           elif ($p.kinds | index("bar")) then "Bars"
           else "Other" end))
      } ]
    | sort_by(.category, (.name | ascii_downcase))
  ' >"$tmp" && mv "$tmp" "$STATE_DIR/plugins.json" || { rm -f "$tmp"; warn "could not write the plugin catalog"; return 1; }
}

# ------------------------------------------------- application visibility
#
# A profile shows a subset of the machine's applications by writing XDG hidden
# entries into ~/.local/share/applications. Omarchy's menu, launcher and search
# all filter through one script — hidden-entries.sh — so an entry marked
# NoDisplay=true there disappears from all three at once, live, with no shell
# restart. There is nothing to teach the launcher and no fork of it to maintain.
#
# This writes into the user's real application directory, which is the largest
# blast radius in the plugin, so every file we touch says what we did to it:
#
#   X-OmarchyProfiles-Hidden=1    we created this file from a system entry
#                                 -> unhiding it is `rm`
#   X-OmarchyProfiles-Modified=1  the user already had this file and we edited
#                                 it in place -> unhiding restores the backup,
#                                 unless it was edited while hidden
#
# Nothing untagged is ever deleted, and nothing untagged is edited before a
# backup of it has been made and compared byte for byte.

# Every desktop entry on the machine, as TSV, one line per desktop id:
#
#   id  level  source_path  hidden_at_source  wmclass  exec  name  tag  tag_path
#
# The first six columns are the design's; `name` saves every consumer a second
# read of the same files, and `tag`/`tag_path` say which file in APPS_DIR is
# ours and where it is. That is what keeps this the ONLY place in the engine
# that enumerates desktop files — everything else reads these lines.
#
# It mirrors hidden-entries.sh exactly — same scan order, same id rule, same
# hiding rules — with one deliberate difference: it looks THROUGH our own tags.
# A file we created is skipped without claiming its id, so the system entry
# behind it answers; a file we edited is judged by its backup. Our own edits
# therefore cannot change its answer, which is what gives reconcile a fixed
# point: without it, hiding an app removes it from the candidate set, and the
# next reconcile decides it is no longer an app anyone asked to hide.
#
# The rules are re-implemented in awk rather than shelling out to
# hidden-entries.sh because that script scans fixed directories: pointing it at
# a backup would mean copying every desktop file on the machine on every switch.
# The copy is kept honest by a test: with no tagged file anywhere, the ids this
# reports as hidden_at_source must equal hidden-entries.sh's output exactly.
app_sources() {
  [[ -n ${APP_SOURCES_CACHE+set} ]] || APP_SOURCES_CACHE=$(app_sources_scan)
  [[ -n $APP_SOURCES_CACHE ]] && printf '%s\n' "$APP_SOURCES_CACHE"
  return 0
}

# The desktop names AppLibrary.qml passes hidden-entries.sh: the three desktop
# environment variables, empty ones dropped, joined with a colon.
app_desktop_names() {
  local parts=() p
  for p in "${XDG_CURRENT_DESKTOP:-}" "${XDG_SESSION_DESKTOP:-}" "${DESKTOP_SESSION:-}"; do
    [[ -n $p ]] && parts+=("$p")
  done
  (IFS=:; printf '%s' "${parts[*]}")
}

app_sources_scan() {
  local dirs=("$APPS_DIR") data_dirs=() d
  IFS=':' read -ra data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for d in "${data_dirs[@]}"; do [[ -n $d ]] && dirs+=("$d/applications"); done
  dirs+=("$HOME/.nix-profile/share/applications")

  # NUL throughout, and every id and path handed to awk rather than to the
  # shell: "Disk Usage.desktop" and friends are already here, and a file name
  # is the one thing on this path we do not control.
  {
    for d in "${dirs[@]}"; do
      [[ -d $d ]] || continue
      printf 'D%s\0' "$d"
      find "$d" -type f -name '*.desktop' -print0 2>/dev/null | sort -z |
        awk 'BEGIN { RS = "\0"; ORS = "\0" } { print "F" $0 }'
    done
  } | awk -v RS='\0' \
          -v names="$(app_desktop_names)" \
          -v appsdir="$APPS_DIR" -v backups="$APP_BACKUP_DIR" \
          -v tag_hidden="$APP_TAG_HIDDEN" -v tag_modified="$APP_TAG_MODIFIED" '
    # hidden-entries.sh desktop_matches(): any name against any list entry.
    function matches(list, n, m, i, j, nn, ll) {
      n = split(names, nn, ":"); m = split(list, ll, ";")
      for (i = 1; i <= n; i++) {
        if (nn[i] == "") continue
        for (j = 1; j <= m; j++) if (ll[j] != "" && ll[j] == nn[i]) return 1
      }
      return 0
    }
    function openable(path, line, r) { r = (getline line < path); close(path); return r >= 0 }
    # hidden-entries.sh is_hidden_desktop_file(), plus the fields the callers
    # want, in one pass. `bare` drops Hidden/NoDisplay from the verdict, for the
    # one case where the file in front of us is ours and its backup is gone.
    function scan(path, bare, line, in_de, hid, only, notin, key, val, p, outer) {
      E_hidden = 0; E_class = ""; E_exec = ""; E_name = ""; E_tag = ""
      in_de = 0; hid = 0; only = ""; notin = ""
      # RS is NUL for the file list we are being fed; a desktop file is lines.
      outer = RS; RS = "\n"
      while ((getline line < path) > 0) {
        sub(/\r$/, "", line)
        if (line ~ /^\[.*\]$/) { in_de = (line == "[Desktop Entry]") ? 1 : 0; continue }
        if (!in_de) continue
        p = index(line, "="); if (p == 0) continue
        key = substr(line, 1, p - 1); val = substr(line, p + 1)
        if (key == "Hidden" || key == "NoDisplay") { if (val == "true" && !bare) hid = 1 }
        else if (key == "OnlyShowIn") only = val
        else if (key == "NotShowIn") notin = val
        else if (key == "StartupWMClass") { if (E_class == "") E_class = val }
        else if (key == "Exec") { if (E_exec == "") E_exec = val }
        else if (key == "Name") { if (E_name == "") E_name = val }
        else if (key == tag_hidden) { if (val == "1") E_tag = "hidden" }
        else if (key == tag_modified) { if (val == "1") E_tag = "modified" }
      }
      close(path); RS = outer
      if (hid) { E_hidden = 1; return }
      if (only != "" && !matches(only)) { E_hidden = 1; return }
      if (notin != "" && matches(notin)) { E_hidden = 1; return }
    }
    function clean(s) { gsub(/[\t\n]/, " ", s); return s }
    function emit(id, level, src, hid, cls, ex, nm, tg, tp) {
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", clean(id), level, clean(src),
             (hid ? "true" : "false"), clean(cls), clean(ex), clean(nm), tg, clean(tp)
    }
    {
      kind = substr($0, 1, 1); value = substr($0, 2)
      if (kind == "D") { dir = value; next }
      file = value
      id = substr(file, length(dir) + 2)            # desktop_id_for_file
      sub(/\.desktop$/, "", id)
      gsub(/\//, "-", id)
      if (id in seen) next                          # first-seen id wins
      level = (dir == appsdir) ? "user" : "system"
      src = file
      scan(file, 0)
      if (level == "user" && E_tag != "") {
        owned[id] = E_tag; ownpath[id] = file
        # Ours. Let the entry we made it from answer for the id instead.
        if (E_tag == "hidden") next
        backup = backups "/" id ".desktop"
        if (openable(backup)) { src = backup; scan(backup, 0) }
        else scan(file, 1)                          # backup lost: judge it by everything but our own flags
      }
      seen[id] = 1
      emit(id, level, src, E_hidden, E_class, E_exec, E_name, owned[id], ownpath[id])
    }
    # A file of ours whose source has since been uninstalled. Nothing else would
    # ever mention it again, and it would stay in the menu directory forever.
    END {
      for (id in owned)
        if (!(id in seen)) emit(id, "user", ownpath[id], 1, "", "", "", owned[id], ownpath[id])
    }'
}

# What apply_app_visibility would do for <profile>, as TSV:
#
#   H  id  level  source_path     hide this id (it is not ours yet)
#   S  id  tag    path            show it again (it is ours and no longer hidden)
#
# The hide side is the work outstanding, not the whole set a profile hides: once
# converged there is nothing to do and a preview is empty, which is the property
# the fixed-point test asserts.
app_visibility_plan() {
  local name=$1 master=false allowed=""
  is_master "$name" && master=true
  [[ $master == true ]] || allowed=$(jq -r '(.apps.allowed // [])[]' "$(file_for "$name")" 2>/dev/null)

  app_sources | awk -F'\t' -v master="$master" -v allowed="$allowed" '
    BEGIN { n = split(allowed, a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") ok[a[i]] = 1 }
    {
      id = $1; level = $2; src = $3; hidden = $4; tag = $8; tagpath = $9
      if (tag != "") { owned[id] = tag; opath[id] = tagpath }
      if (master == "true") next          # the master sees everything
      if (hidden == "true") next          # not a candidate: Omarchy hides it anyway
      if (id in ok) next
      hide[id] = 1; hlevel[id] = level; hsrc[id] = src
    }
    END {
      for (id in hide)  if (!(id in owned)) printf "H\t%s\t%s\t%s\n", id, hlevel[id], hsrc[id]
      for (id in owned) if (!(id in hide))  printf "S\t%s\t%s\t%s\n", id, owned[id], opath[id]
    }' | sort
}

# Make what is on disk match <profile>, whatever it was before. An absolute
# setter rather than a diff applier: it is re-run by refresh and after a crash,
# and has to be able to clean up work it did not itself start.
apply_app_visibility() {
  local name=${1:-}
  [[ -n $name ]] && exists "$name" || return 1
  mkdir -p "$APPS_DIR" "$APP_BACKUP_DIR" || return 1

  local changed=0 kind id arg path
  while IFS=$'\t' read -r kind id arg path; do
    case $kind in
    H) app_hide "$id" "$arg" "$path" && changed=1 ;;
    S) app_show "$id" "$arg" "$path" && changed=1 ;;
    esac
  done < <(app_visibility_plan "$name")

  ((changed)) || return 0
  unset APP_SOURCES_CACHE
  # Otherwise mimeinfo.cache still answers with the entries we removed.
  command -v update-desktop-database >/dev/null &&
    update-desktop-database -q "$APPS_DIR" 2>/dev/null
  return 0
}

# The copy of <src> that is hidden: NoDisplay and our tag go in immediately
# after the [Desktop Entry] header, and any NoDisplay/Hidden already in that
# group comes out.
#
# Stripping is not tidiness. hidden-entries.sh treats a `true` as sticky, but
# other XDG parsers take the LAST value in the group, so a pre-existing
# NoDisplay=false further down would leave the app hidden here and visible
# everywhere else. Later groups — [Desktop Action …], which chromium, code and
# nautilus all have — are left exactly as they are.
app_hidden_copy() {
  awk -v tag="$2" '
    /^\[/ { if (g == 1) g = 2
            if ($0 == "[Desktop Entry]" && g == 0) { print; print "NoDisplay=true"; print tag "=1"; g = 1; next } }
    g == 1 && /^(NoDisplay|Hidden)=/ { next }
    { print }' "$1"
}

# A temp file beside the entries, so the move onto them is atomic. The name
# deliberately does not end in .desktop: a scan racing us must not see it.
app_tempfile() { mktemp "$APPS_DIR/.omarchy-profiles.XXXXXX"; }

app_hide() {
  local id=$1 level=$2 src=$3 tmp
  if [[ $level == user ]]; then
    # The user's own file. It is read-only to us until there is a backup we
    # have compared against it — a half-written backup here is the difference
    # between hiding an app and losing it.
    local backup="$APP_BACKUP_DIR/$id.desktop"
    cp -p -- "$src" "$backup" 2>/dev/null || { warn "could not back up $id — leaving it visible"; return 1; }
    cmp -s -- "$src" "$backup" || {
      rm -f -- "$backup"
      warn "the backup of $id did not match the original — leaving it visible"; return 1
    }
    tmp=$(app_tempfile) || return 1
    app_hidden_copy "$src" "$APP_TAG_MODIFIED" >"$tmp" || { rm -f -- "$tmp"; return 1; }
    chmod --reference="$src" -- "$tmp" 2>/dev/null || chmod 0644 -- "$tmp"
    mv -f -- "$tmp" "$src" || { rm -f -- "$tmp"; return 1; }
    # The hash of the file AS WE LEFT IT. Unhiding compares against it to find
    # out whether anyone has touched the file since.
    sha256sum <"$src" | awk '{ print $1 }' >"$APP_BACKUP_DIR/$id.sha256"
  else
    # A system entry. Our copy shadows it by id, and unhiding is deleting it,
    # so there is nothing to back up.
    tmp=$(app_tempfile) || return 1
    app_hidden_copy "$src" "$APP_TAG_HIDDEN" >"$tmp" || { rm -f -- "$tmp"; return 1; }
    chmod 0644 -- "$tmp"
    mv -f -- "$tmp" "$APPS_DIR/$id.desktop" || { rm -f -- "$tmp"; return 1; }
  fi
  return 0
}

app_show() {
  local id=$1 tag=$2 path=$3
  [[ -f $path ]] || return 1

  if [[ $tag == hidden ]]; then
    rm -f -- "$path"
    return 0
  fi

  local backup="$APP_BACKUP_DIR/$id.desktop" hashfile="$APP_BACKUP_DIR/$id.sha256"
  local want="" live
  [[ -f $hashfile ]] && want=$(<"$hashfile")
  live=$(sha256sum <"$path" | awk '{ print $1 }')
  if [[ -f $backup && -n $want && $live == "$want" ]]; then
    mv -f -- "$backup" "$path" || return 1
    rm -f -- "$hashfile"
    return 0
  fi

  # Edited since we hid it — by the user, or by the app's own updater. The edit
  # wins: take out only the two lines we put in, and put back whatever
  # NoDisplay/Hidden the original had, which we stripped when we hid it.
  local restore=""
  [[ -f $backup ]] && restore=$(awk '
    /^\[/ { if (g == 1) g = 2; if ($0 == "[Desktop Entry]" && g == 0) { g = 1; next } }
    g == 1 && /^(NoDisplay|Hidden)=/ { print }' "$backup")

  local tmp; tmp=$(app_tempfile) || return 1
  awk -v tag="$APP_TAG_MODIFIED" -v restore="$restore" '
    BEGIN { nr = split(restore, rl, "\n") }
    {
      if (substr($0, 1, 1) == "[") {
        if (g == 1) g = 2
        if ($0 == "[Desktop Entry]" && g == 0) {
          print; g = 1; expect = 1
          for (i = 1; i <= nr; i++) if (rl[i] != "") print rl[i]
          next
        }
      }
      if (g == 1 && expect == 1 && $0 == "NoDisplay=true") { expect = 0; next }
      expect = 0
      if (g == 1 && $0 == tag "=1") next
      print
    }' "$path" >"$tmp" || { rm -f -- "$tmp"; return 1; }
  chmod --reference="$path" -- "$tmp" 2>/dev/null || chmod 0644 -- "$tmp"
  mv -f -- "$tmp" "$path" || { rm -f -- "$tmp"; return 1; }
  local had_backup=""; [[ -f $backup ]] && had_backup=1
  rm -f -- "$backup" "$hashfile"
  if [[ -n $had_backup ]]; then
    warn "kept your edits to $id"
  else
    # Nothing to put back. Removing our own two lines is all we can do, and all
    # we are entitled to do — the rest of the file is not ours.
    warn "no backup for $id — removed the lines this plugin added and left the rest"
  fi
  return 0
}

# Undo every hidden entry we own, whatever profile asked for it. The safety net
# for a crash mid-switch and the first step of uninstalling.
apps_sweep() {
  mkdir -p "$APP_BACKUP_DIR"
  local n=0 id tag path
  while IFS=$'\t' read -r id tag path; do
    [[ -n $id ]] || continue
    app_show "$id" "$tag" "$path" && n=$((n + 1))
  done < <(app_sources | awk -F'\t' '$8 != "" { print $1 "\t" $8 "\t" $9 }' | sort -u)
  if ((n)); then
    unset APP_SOURCES_CACHE
    command -v update-desktop-database >/dev/null &&
      update-desktop-database -q "$APPS_DIR" 2>/dev/null
  fi
  echo "restored $n hidden $([[ $n == 1 ]] && echo entry || echo entries)"
}

write_state() {
  local name=$1 offset
  offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$name")")
  mkdir -p "$STATE_DIR"
  local tmp
  tmp=$(mktemp "${STATE_FILE}.XXXXXX") || return 1
  jq -n --arg profile "$name" --argjson ws_offset "${offset:-0}" \
     --argjson span "$(cfg .workspace_span)" --arg updated "$(date -Iseconds)" \
     '{profile: $profile, ws_offset: $ws_offset, ws_span: $span, updated: $updated}' \
     >"$tmp" && mv "$tmp" "$STATE_FILE" || { rm -f "$tmp"; return 1; }

  # Stamped on the profile itself, so the overview can say "not opened in three
  # weeks" — which is the signal that it is holding windows you have forgotten.
  #
  # In the profile's own directory, like every other write here: a bare mktemp
  # lands on /tmp, which is a different filesystem, so the mv that follows is a
  # copy rather than an atomic rename — and a half-written profile is exactly
  # what the switch journal's recovery argument assumes cannot happen.
  local ptmp
  ptmp=$(mktemp "$(file_for "$name").XXXXXX") || return 0
  # UTC with a Z: jq's fromdateiso8601 rejects a +02:00 offset outright, and
  # the reader should not have to carry a timezone parser.
  jq --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.last_used = $t' "$(file_for "$name")" >"$ptmp" &&
    mv "$ptmp" "$(file_for "$name")" || rm -f "$ptmp"
}

# -------------------------------------------- the lock and the switch journal
#
# A switch restarts the shell, which kills whatever asked for it. That is not a
# bug to be fixed — the shell has to be restarted for a profile to apply — but
# it means the work cannot be done by the process the panel is waiting on, and
# that nothing can report back afterwards. So a switch is two stages:
#
#   stage 1  attached. Answers the one question the caller can still hear:
#            were you allowed to do this. Takes the lock, forks stage 2, exits.
#   stage 2  detached, and the only thing that touches profile data. Every step
#            it is about to take is written to the journal first, so a stage 2
#            that dies can be finished by the next thing that looks.
#
# The journal is what stops the worst bug in the design: a switch that dies
# after the restart leaves B's files live, and the next capture would file them
# under A. Nothing may capture while a journal exists.

# One flock on the state directory around every verb that changes what a
# profile owns; a second caller gets exit 3 rather than interleaving with the
# first. Deliberately fd 8 and deliberately written down: a child that inherits
# it holds the lock for as long as it lives, so every fork that can outlive the
# switch has a descriptor number to close.
#
# Whether THIS process already holds it is written down too. A verb that is
# also called in-process from inside a switch — `session restore` is the only
# one — must not take it a second time: `exec 8>` on a descriptor that already
# holds the lock closes the old open file description, which releases it for an
# instant, and an instant is all a second caller needs.
STATE_LOCK_HELD=""

take_state_lock() {
  mkdir -p "$STATE_DIR" || return 1
  exec 8>"$LOCK_FILE" || return 1
  flock -n 8 || return 1
  STATE_LOCK_HELD=1
}

lock_or_busy() {
  take_state_lock && return 0
  refuse 3 busy "another switch or profile change is running — try again in a moment"
}

# Is anyone holding it? Asked on a second descriptor and given straight back:
# a status query must never be the thing a switch waits on.
state_lock_free() {
  mkdir -p "$STATE_DIR" || return 1
  exec 9>"$LOCK_FILE" || return 1
  if flock -n 9; then exec 9>&-; return 0; fi
  exec 9>&-
  return 1
}

journal_field() { [[ -s $JOURNAL ]] && jq -r --arg k "$1" '.[$k] // ""' "$JOURNAL" 2>/dev/null; }

# Written before the step it names, never after, and fsynced: the case this
# exists for is the machine stopping between the two.
journal_set() {
  local from=$1 to=$2 stage=$3 tmp
  mkdir -p "$STATE_DIR"
  [[ -n ${SWITCH_STARTED:-} ]] || SWITCH_STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  tmp=$(mktemp "$JOURNAL.XXXXXX") || return 1
  jq -n --arg from "$from" --arg to "$to" --arg stage "$stage" --arg started "$SWITCH_STARTED" \
     '{from: $from, to: $to, stage: $stage, started: $started}' >"$tmp" &&
    mv "$tmp" "$JOURNAL" || { rm -f "$tmp"; warn "could not write the switch journal"; return 1; }
  sync -f "$JOURNAL" 2>/dev/null
  # A test hook, and the only one in this file. Recovery has to be provable from
  # every stage, and timing a kill into the millisecond a step takes is not a
  # proof. Set OMARCHY_PROFILE_STALL_AT=<stage> to hold a switch just after that
  # stage is recorded and just before it runs. It changes nothing else.
  [[ ${OMARCHY_PROFILE_STALL_AT:-} == "$stage" ]] && sleep "${OMARCHY_PROFILE_STALL_SECS:-5}"
  return 0
}

journal_clear() {
  rm -f "$JOURNAL"
  sync -f "$STATE_DIR" 2>/dev/null
  return 0
}

# Nothing that could capture may run while a stale intent exists: capturing
# then is exactly how one profile's live state gets filed under another's name.
#
# A journal beside a HELD lock is not a stale intent — it is a switch happening
# right now, and the answer to that is `busy` (rule 7), which the caller reaches
# a line or two later when its own flock fails. Only a journal whose stage 2 is
# gone is an interrupted switch. The two look identical on disk and mean
# opposite things, and the lock is what tells them apart.
require_no_journal() {
  [[ -e $JOURNAL ]] || return 0
  state_lock_free || return 0
  local from to stage
  from=$(journal_field from); to=$(journal_field to); stage=$(journal_field stage)
  refuse 1 interrupted_switch \
    "a switch from ${from:-nothing} to ${to:-?} stopped at ${stage:-?} — repair it in Setup, or run: omarchy-profile setup fix switch" \
    "$(jq -nc --arg f "$from" --arg t "$to" --arg s "$stage" '{from: $f, to: $t, stage: $s}')"
}

# A held path shows the outgoing profile's data under the incoming one, which
# is unavoidable once a move has failed — but it is never *filed* as the wrong
# profile's, because no further switch runs until it has been put away.
require_no_held_paths() {
  [[ -s $PENDING_OWNER ]] || return 0
  local paths
  paths=$(cut -f1 "$PENDING_OWNER" | jq -Rsc 'split("\n") | map(select(length > 0))')
  refuse 1 held_paths \
    "a file could not be filed into its profile's store and is still in place — repair it in Setup, or run: omarchy-profile setup fix switch" \
    "$(jq -nc --argjson p "${paths:-[]}" '{paths: $p}')"
}

# Every tier-3 path must have something to seed an incoming profile from, or
# the switch would leave a `require`d Hyprland file absent and hyprland.lua
# would abort at it — taking autostart, the toggles and the workspace keys with
# it. Checked in stage 1, before anything is captured, swapped or written: a
# refusal here costs nothing, and there is no good answer half way through.
preflight_tier3() {
  local to=${1:-} path reload store
  [[ -n $to ]] || return 0
  while IFS=$'\t' read -r path reload; do
    [[ $reload == hypr ]] || continue
    is_blocklisted "$path" && continue
    store=$(store_for "$to" "$path")
    [[ -e $store || -L $store ]] && continue          # the profile has its own
    packaged_for_path "$path" >/dev/null && continue  # Omarchy ships one
    [[ -e $path || -L $path ]] && continue            # what is live can be copied
    refuse 1 missing_packaged_config \
      "$to has no copy of ${path/#$HOME/\~}, Omarchy ships none, and there is nothing at the path to copy — switching would leave a file Hyprland requires absent" \
      "$(jq -nc --arg p "${path/#$HOME/\~}" --arg n "$to" '{path: $p, profile: $n}')"
  done < <(isolated_rows)
  return 0
}

# Stage 2. The only thing that touches profile data, and the only holder of the
# lock from the moment stage 1 exits.
switch_stage2() {
  local from=$1 to=$2
  # Stage 1's cancellation must not outlive the verdict: from here on, stopping
  # half way is the thing that leaves a machine in two profiles at once.
  trap - TERM
  # And nothing is attached any more. A HUP from the terminal that started this,
  # or a PIPE from a reader that died with the old shell, is not an instruction.
  trap '' HUP PIPE

  journal_set "$from" "$to" capture || return 1
  # The outgoing profile keeps whatever was changed while inside it — including
  # what it had open, so that entering it again on an empty block can offer to
  # put those windows back. Leaving a profile also ends any offer it had
  # pending: an answer that arrives after the desk has been left is not an
  # answer to anything.
  if [[ -n $from ]] && exists "$from"; then
    capture_into "$from"
    session_record "$from"
    rm -f "$(offer_file "$from")"
  fi
  switch_forward "$from" "$to"
}

# Steps 3 to 7, without the capture. Recovery re-runs exactly this: from the
# swap on, every step is an absolute setter and safe to repeat, while a capture
# would file whatever is live now under whoever the journal happens to name —
# the same bug the journal exists to prevent, reintroduced by the repair.
switch_forward() {
  local from=$1 to=$2

  journal_set "$from" "$to" swap
  # Plugin state that lives outside shell.json follows the profile too, so a
  # Spotify session or a dock layout belongs to one profile rather than all.
  prune_isolated
  swap_isolated "$from" "$to"

  journal_set "$from" "$to" write
  # 8>&- at the call site as well as on each command inside it. The commands
  # are the ones known to start something today; the closed descriptor here is
  # what makes a theme hook or a helper daemon added tomorrow harmless too.
  apply_profile_files "$to" 8>&-
  apply_app_visibility "$to"
  # BEFORE the restart, not after it. This used to run last, so a switch that
  # died after `omarchy restart shell` left B's files live while current.json
  # still said A — and the next switch captured B's desktop into A. Written
  # here, current.json names the profile whose files are live from the moment
  # they are written, and the restarted shell reads the right name on start.
  write_state "$to"

  journal_set "$from" "$to" restart
  restart_shell

  journal_set "$from" "$to" finish
  apply_profile_ipc "$to" 8>&-
  write_index
  write_catalog

  # Only now, after wait_for_shell: the notification server IS the shell that
  # was just restarted, so an offer raised any earlier would be drawn by a
  # process about to die. Under `always` this replays in-process and can hold
  # the lock for up to its own 30 s budget; under `ask` it forks a subshell
  # that has closed fd 8, so the pending notification holds nothing.
  maybe_restore "$to"

  # Last, not after write_state: a switch that died after the restart still has
  # its do-not-disturb, idle, wallpaper and launcher set finished by recovery.
  journal_clear
}

# Runs under the state lock, so a journal found here means stage 2 is dead — a
# live stage 2 holds the lock.
#
# Forward, never back. From the swap on, running the swap in reverse would file
# a real file that had not been moved yet under the wrong owner, which is the
# same class of bug as capturing into the wrong profile. And the user
# authenticated for `to` and asked for it, so finishing it is also what they
# wanted.
recover_switch() {
  # It finishes a switch, which means it restarts the shell, which means it is
  # detached like a switch is — so it needs the same signal hygiene.
  trap '' HUP PIPE
  [[ -e $JOURNAL ]] || { echo "no interrupted switch to repair"; return 0; }
  local from to stage
  from=$(journal_field from); to=$(journal_field to); stage=$(journal_field stage)
  SWITCH_STARTED=$(journal_field started)

  if [[ -z $to ]] || ! exists "$to"; then
    warn "the interrupted switch names a profile that is gone ('${to:-}') — discarding it"
    journal_clear
    return 0
  fi

  case $stage in
  capture)
    # Nothing of `to` has been touched: the live files and current.json are
    # still `from`, and a capture is atomic per file, so a half-done one is
    # either the old JSON or the new one. The switch simply did not happen.
    journal_clear
    echo "discarded an interrupted switch to $to that had not started" ;;
  *)
    [[ $stage == swap || $stage == write || $stage == restart || $stage == finish ]] ||
      warn "the journal names an unknown stage '$stage' — finishing it forward"
    echo "finishing the switch to $to (it stopped at ${stage:-?})"
    switch_forward "$from" "$to" ;;
  esac
}

# Hand the rest of the work to a forked copy of this already-authenticated
# shell, and get out of the way.
detach() {
  # The verdict has been printed and this process no longer has any business
  # holding the caller's pipes: it is about to restart the shell that is reading
  # them, and SIGPIPE from a dead reader would end the switch. Everything the
  # switch has to say from here goes to the log.
  local size=0
  [[ -e $SWITCH_LOG ]] && size=$(stat -c %s "$SWITCH_LOG" 2>/dev/null || echo 0)
  ((size > 1048576)) && : >"$SWITCH_LOG"
  exec 0</dev/null 1>>"$SWITCH_LOG" 2>&1

  # Job control, so the job gets its own process group. NOT setsid: that execs
  # a new program, which would need a callable "already authenticated" entry
  # point — the bypass this design deliberately does not have. The job is a
  # forked subshell of this process, with the function already in its memory.
  set -m
  "$@" &
  disown
}

# ------------------------------------------------------------------ apply

# Block until the shell answers, so the IPC calls after a restart are not fired
# into a process still starting up. Polls rather than sleeping a fixed amount:
# a cold start on a loaded machine is slower than on an idle one, and a fixed
# wait is either too short to be safe or too long to be pleasant.
wait_for_shell() {
  local i
  for i in $(seq 1 40); do
    omarchy-shell shell reloadConfig >/dev/null 2>&1 && return 0
    sleep 0.25
  done
  warn "the shell did not come back within 10s — do-not-disturb and idle may not have applied"
  return 1
}


# Applying a profile is three steps with a shell restart between the first and
# the last, and the switch journal has to be able to name each of them — so
# they are three functions rather than one. The order is what makes it safe:
# files first, restart second, IPC third. Restarting before the writes would
# have the new shell read the old files, and setting do-not-disturb over IPC
# before a restart wastes the call on a process about to exit.
#
# Every external call here closes fd 8. Anything started from inside the switch
# inherits the state lock otherwise, and a process that outlives stage 2 would
# hold it after the switch is over — which made every later verb `busy` until
# that process died.
apply_profile_files() {
  local name=$1 file
  file=$(file_for "$name")

  local theme screensaver lock bar
  theme=$(jq -r '.theme // ""' "$file")
  screensaver=$(jq -r '.idle.screensaver // empty' "$file")
  lock=$(jq -r '.idle.lock // empty' "$file")

  # Theme, FIRST and synchronously.
  #
  # This used to be backgrounded for a snappier picker, and the theme loaded
  # inconsistently as a result: `omarchy theme set` rewrites shell config and
  # asks the shell to reload, while the steps below also write shell.json and
  # request their own reload. Two writers racing over the same file meant
  # whichever finished last won, so the theme sometimes half-applied or not at
  # all. Waiting costs a couple of seconds per switch and is always correct.
  #
  # Still skipped when already current: retinting every terminal, the browser
  # policy and the shell is the expensive part, and there is no reason to pay
  # it to arrive where we already are.
  local live_theme=""
  [[ -s $THEME_NAME_FILE ]] && live_theme=$(<"$THEME_NAME_FILE")
  if [[ -n $theme && $theme != "$live_theme" ]]; then
    omarchy theme set "$theme" >/dev/null 2>&1 8>&- || warn "could not set theme '$theme'"
  fi

  # Bar layout and plugin enablement, written together in one atomic commit so
  # the shell never sees a layout referencing a plugin it has just disabled.
  bar=$(jq -c '.bar // empty' "$file")
  local disabled
  disabled=$(jq -c '.plugins.disabled // empty' "$file")

  # Shared widgets go back into the layout if this profile's snapshot predates
  # them being shared, and are taken out of disabledPlugins whatever the
  # profile says. "The same in every profile" has to survive a stale capture,
  # or the guarantee is only true until the next time you save a profile.
  local pinned_widgets pinned_all
  pinned_widgets=$(pinned_bar_widgets | jq -R . | jq -sc .)
  pinned_all=$(cfg -c '.pinned_plugins // []')

  if [[ -n $bar || -n $disabled ]]; then
    (
      # shellcheck disable=SC1091
      source /usr/share/omarchy/bin/omarchy-shell-config
      commit "$NORMALIZE
              | (if \$bar == null then . else .bar = \$bar end)
              | (if \$disabled == null then . else .disabledPlugins = \$disabled end)
              | .disabledPlugins = (.disabledPlugins - \$pinned_all)
              | ([.bar.layout.left, .bar.layout.center, .bar.layout.right]
                 | map(map(.id)) | add) as \$present
              | .bar.layout.right = (
                  (\$pinned_widgets
                   | map(. as \$id | select((\$present | index(\$id)) == null) | {id: \$id}))
                  + .bar.layout.right)" \
        --argjson bar "${bar:-null}" --argjson disabled "${disabled:-null}" \
        --argjson pinned_widgets "${pinned_widgets:-[]}" \
        --argjson pinned_all "${pinned_all:-[]}"
    ) >/dev/null 2>&1 8>&- || warn "could not write bar/plugins to shell.json"
  fi

  if [[ -n $screensaver && -n $lock ]]; then
    (
      # shellcheck disable=SC1091
      source /usr/share/omarchy/bin/omarchy-shell-config
      commit "$NORMALIZE | .idle.screensaver = \$sec | .idle.lock = \$lock" \
        --argjson sec "$screensaver" --argjson lock "$lock"
    ) >/dev/null 2>&1 8>&- || warn "could not write idle timers"
  fi
}

# Restart the shell, now that every file it reads has been written.
#
# A reload is not enough. Plugins hold their own config and state open, so a
# swapped Spotify session or dock file is not noticed; enabling a plugin that
# was off needs it instantiated; and Qt keeps compiled QML cached. Each of those
# produced a switch that looked half-applied, and "it usually works, restart if
# it looks wrong" is not a thing to ship.
#
# Its own step in the journal, because it is the step that kills whoever asked
# for the switch: everything before it must already be on disk, and everything
# after it has to be done by a process the restart cannot reach.
restart_shell() {
  command -v omarchy >/dev/null || return 0
  omarchy restart shell >/dev/null 2>&1 8>&- || warn "could not restart the shell"
  wait_for_shell
}

# The tail of a switch: settings that are told to the shell rather than written
# for it. Absolute setters only — a toggle would land on the wrong state
# whenever the machine already happened to be in the target state. These run
# against the shell that will still be running when the switch is done.
apply_profile_ipc() {
  local name=$1 file
  file=$(file_for "$name")

  local dnd inhibit browser
  dnd=$(jq -r 'if .dnd then "true" else "false" end' "$file")
  inhibit=$(jq -r 'if (.idle.inhibit // false) then "true" else "false" end' "$file")
  browser=$(jq -r '.browser_profile // "default"' "$file")

  omarchy-shell notifications setDnd "$dnd" >/dev/null 2>&1 8>&- ||
    warn "could not set do-not-disturb (shell busy?) — re-run to retry"

  # NOT `omarchy-shell idle enable`: that IPC target does not exist while
  # omarchy.idle sits in disabledPlugins, which is the normal state on a machine
  # using a third-party idle/lock plugin. Note the sense — stay-awake INHIBITS
  # idling, so inhibit=false means allow-idle.
  if [[ $inhibit == true ]]; then
    omarchy toggle idle stay-awake >/dev/null 2>&1 8>&- || warn "could not set stay-awake"
  else
    omarchy toggle idle allow-idle >/dev/null 2>&1 8>&- || warn "could not allow idling"
  fi

  [[ $browser != default ]] && mkdir -p "$DATA_HOME/omarchy-profiles/browser/$browser"

  local wallpaper
  wallpaper=$(jq -r '.wallpaper // ""' "$file")
  if [[ -n $wallpaper && -f $wallpaper ]]; then
    omarchy theme bg set "$wallpaper" >/dev/null 2>&1 8>&- || warn "could not set wallpaper"
  fi
  return 0
}

# Hyprland on Omarchy is configured in Lua, and hyprctl dispatch takes a Lua
# expression rather than a dispatcher name: `hyprctl dispatch workspace 3`
# fails with "')' expected near '3'". Every dispatch goes through these, so the
# dialect is written down once instead of four times.
#
# This was wrong in all four call sites until it was tested against a running
# compositor — including the window migration on remove, which therefore never
# moved anything. Nothing reported an error because the exit code was dropped.
hl_focus_workspace() {
  hyprctl dispatch "hl.dsp.focus({ workspace = \"$1\" })" >/dev/null
}

hl_move_window() {
  local ws=$1 addr=${2:-} follow=${3:-true} expr
  expr="hl.dsp.window.move({ workspace = \"$ws\""
  [[ -n $addr ]] && expr+=", window = \"address:$addr\""
  [[ $follow == false ]] && expr+=", follow = false"
  expr+=" })"
  hyprctl dispatch "$expr" >/dev/null
}

hl_close_window() {
  hyprctl dispatch "hl.dsp.window.close({ window = \"address:$1\" })" >/dev/null
}

# migrate_block_windows <from-offset> <span> <to-offset>
#
# Empty one block of workspaces into another, workspace for workspace: the third
# workspace of the block becomes the third workspace of the target. Prints how
# many windows it moved, and nothing else — every word for a person goes to
# stderr, because both callers capture this.
#
# `remove` had this inline until `purge` needed exactly the same walk for every
# profile at once. Two copies of "which windows belong to a profile" is how one
# of them ends up wrong, and the wrong one strands windows on a block no key can
# reach any more.
migrate_block_windows() {
  local from=$1 span=$2 to=$3 live addr ws
  command -v hyprctl >/dev/null || { echo 0; return 0; }
  live=$(hyprctl -j clients 2>/dev/null |
    jq --argjson o "$from" --argjson s "$span" \
       '[.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s))] | length')
  [[ $live =~ ^[0-9]+$ ]] || live=0
  ((live > 0)) || { echo 0; return 0; }
  # follow = false, so the screen does not jump through every workspace being
  # emptied on the way past.
  while read -r addr ws; do
    [[ -n $addr ]] || continue
    hl_move_window "$((to + ws - from))" "$addr" false ||
      warn "could not move window $addr off workspace $ws"
  done < <(hyprctl -j clients 2>/dev/null |
    jq -r --argjson o "$from" --argjson s "$span" \
       '.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s))
            | "\(.address) \(.workspace.id)"')
  echo "$live"
}

# ------------------------------------------------------------------ global
#
# A workspace that belongs to the machine rather than to a profile.
#
# Some windows are not part of any desk: music, a download, a long build. Under
# per-profile workspace blocks those would be stranded in whichever profile
# happened to be active when they opened, reachable only by switching back.
#
# Hyprland already has the right layer for this — a special workspace is an
# overlay, toggled on top of whatever is below, and its id is negative so it
# falls outside every profile's block automatically. No new mechanism, and the
# overview lists it under (unassigned) for free.
#
# Off by default. It costs a keybinding and a concept, and someone who keeps
# their music in the master profile does not need either.

global_ws_name() { cfg '.global_workspace // ""'; }

# Are the global-workspace bindings in the managed keys file, and is that file
# actually loaded? Both, because a binding in a file nothing requires is not a
# binding.
global_keys_bound() {
  local name; name=$(global_ws_name)
  [[ -n $name ]] || return 1
  [[ -s $KEYS_FILE ]] || return 1
  [[ -n $(keys_line_no) ]] || return 1
  grep -qF "toggle_special(\"$name\")" "$KEYS_FILE"
}

cmd_global() {
  local verb=${1:-status} arg=${2:-} a
  for a in "$@"; do [[ $a == --json ]] && JSON=1; done
  [[ $arg == --json ]] && arg=""

  case $verb in
  status)
    local name; name=$(global_ws_name)
    if [[ -n $JSON ]]; then
      local windows='[]'
      [[ -n $name ]] && command -v hyprctl >/dev/null &&
        windows=$(hyprctl -j clients 2>/dev/null |
          jq -c --arg w "special:$name" '[.[] | select(.workspace.name == $w)
                                            | {class: .class, title: .title}]' 2>/dev/null)
      jq -nc --arg n "$name" --argjson w "${windows:-[]}" \
             --argjson k "$(global_keys_bound && echo true || echo false)" \
        '{enabled: ($n != ""), name: $n, windows: $w, keysBound: $k}'
      return 0
    fi
    if [[ -z $name ]]; then
      echo "no global workspace (turn one on with: omarchy-profile global enable music)"
    else
      echo "global workspace: special:$name"
      command -v hyprctl >/dev/null &&
        hyprctl -j clients 2>/dev/null |
          jq -r --arg w "special:$name" '.[] | select(.workspace.name == $w) | "  \(.class)  \(.title[0:50])"'
    fi ;;
  enable)
    [[ -n $arg ]] || arg=music
    [[ $arg =~ ^[a-z0-9-]+$ ]] || die "a workspace name may use lowercase letters, digits and - only"
    cfg_set --arg w "$arg" '.global_workspace = $w' || die "could not enable it"
    cat <<EOF
global workspace enabled: special:$arg

Add a keybinding for it in ~/.config/hypr/bindings.lua:

  o.bind("SUPER + M", "Music", hl.dsp.workspace.toggle_special("$arg"))
  o.bind("SUPER + SHIFT + M", "Send to music",
    hl.dsp.window.move({ workspace = "special:$arg", follow = false }))

Windows there stay put through every profile switch, and the overview lists
them under (unassigned) because a special workspace has a negative id and so
falls outside every profile's block.
EOF
    ;;
  disable)
    cfg_set '.global_workspace = ""' || die "could not disable it"
    echo "global workspace off — remove its keybinding by hand if you added one" ;;
  send)
    local name; name=$(global_ws_name)
    [[ -n $name ]] || die "no global workspace; try: omarchy-profile global enable music"
    hl_move_window "special:$name" "" false
    echo "sent the focused window to special:$name" ;;
  toggle)
    local name; name=$(global_ws_name)
    [[ -n $name ]] || die "no global workspace; try: omarchy-profile global enable music"
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$name\")" >/dev/null ;;
  keys)
    # The bindings go into the managed file, never into the user's own
    # bindings.lua — which they may isolate per profile, and which Setup does
    # not write to. Without the managed file in place there is nothing to write
    # into, and the `keys` Setup row is the thing that puts it there.
    local name; name=$(global_ws_name)
    [[ -n $name ]] || die "no global workspace; try: omarchy-profile global enable music"
    [[ -s $KEYS_FILE && -n $(keys_line_no) ]] ||
      die "the managed workspace keys file is not in place yet — fix the 'Workspace keys' row in Setup first"
    keys_fix || exit 1
    echo "SUPER+M toggles special:$name, SUPER+CTRL+M sends the focused window there" ;;
  *) die "unknown global verb '$verb' (status, enable, disable, send, toggle, keys)" ;;
  esac
}

# ---------------------------------------------------------------- overview
#
# What every profile is holding open right now.
#
# Profiles persist by design: switching away kills nothing, which is what makes
# "I am working, now I want to game" safe. The cost is that seven profiles can
# quietly be holding seven browsers, and the only defence is being able to see
# it. This is that view.
#
# Two decisions make the numbers trustworthy rather than roughly right:
#
# Attribution is by WORKSPACE, not by anything we launched. A window belongs to
# a profile if its workspace falls in that profile's block, so a terminal
# started by hand counts exactly like one opened by a profile switch. Launching
# apps into per-profile systemd slices was the obvious alternative and is worse:
# it would only see what went through our own launcher, so the total would look
# authoritative while silently missing things.
#
# Memory comes from each window's cgroup, which uwsm already gives every app,
# so it is real accounting rather than a guess — and it is summed over UNIQUE
# cgroups, not windows. Chromium keeps every window in one scope; summing per
# window would report its memory once per tab-window and overstate a browser
# profile several times over.

# Deduped cgroup memory for a set of pids read from stdin.
#
# Deduped because Chromium keeps every window in one scope: summing per window
# would count a browser's memory once per window and overstate a profile
# several times over. An unreadable cgroup contributes nothing rather than
# failing the whole row.
cgroup_memory_for_pids() {
  local pid cg seen=() total=0 mem
  declare -A counted
  while read -r pid; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    cg=$(sed -n 's|^0::||p' "/proc/$pid/cgroup" 2>/dev/null)
    [[ -n $cg ]] || continue
    [[ -n ${counted[$cg]:-} ]] && continue
    counted[$cg]=1
    mem=$(cat "/sys/fs/cgroup${cg}/memory.current" 2>/dev/null) || continue
    [[ $mem =~ ^[0-9]+$ ]] && total=$((total + mem))
  done
  printf '%s\n' "$total"
}

overview_json() {
  command -v hyprctl >/dev/null || { echo '[]'; return 0; }

  local clients active ranges='[]' rows='[]' name offset span
  clients=$(hyprctl -j clients 2>/dev/null) || clients='[]'
  active=$(current_profile)

  while read -r name; do
    [[ -n $name ]] || continue
    offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$name")")
    span=$(jq -r '.workspaces.span // 10' "$(file_for "$name")")
    ranges=$(jq -c --argjson o "$offset" --argjson s "$span" '. + [{o: $o, s: $s}]' <<<"$ranges")

    local mem
    mem=$(jq -r --argjson o "$offset" --argjson s "$span" \
      '.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s)) | .pid' <<<"$clients" |
      cgroup_memory_for_pids)

    rows=$(jq -c \
      --arg name "$name" --arg active "$active" \
      --argjson o "$offset" --argjson s "$span" \
      --argjson clients "$clients" --argjson mem "${mem:-0}" \
      --slurpfile prof "$(file_for "$name")" '
        ($clients | [.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s))]) as $mine
        | . + [{
            profile: $name,
            active: ($name == $active),
            offset: $o, span: $s,
            windows: ($mine | length),
            workspaces: ($mine | map(.workspace.id) | unique | length),
            memory: $mem,
            apps: ($mine | group_by(.class) | map({class: (.[0].class // "?"), count: length})
                         | sort_by(-.count)),
            hidden: ($prof[0].hidden // false),
            locked: ($prof[0].locked // false),
            last_used: ($prof[0].last_used // "")
          }]' <<<"$rows")
  done < <(profile_names)

  # Anything outside every block, so nothing is invisible: the scratchpad, and
  # any workspace beyond the last profile's range.
  local loose_mem
  loose_mem=$(jq -r --argjson ranges "$ranges" \
    '.[] | . as $c
     | select([$ranges[] | select($c.workspace.id > .o and $c.workspace.id <= (.o + .s))] | length == 0)
     | .pid' <<<"$clients" | cgroup_memory_for_pids)

  jq -c --argjson clients "$clients" --argjson ranges "$ranges" --argjson mem "${loose_mem:-0}" '
    ($clients | [.[] | . as $c
       | select([$ranges[] | select($c.workspace.id > .o and $c.workspace.id <= (.o + .s))] | length == 0)]) as $loose
    | if ($loose | length) > 0 then
        . + [{
          profile: "(unassigned)",
          active: false, offset: null, span: null,
          windows: ($loose | length),
          workspaces: ($loose | map(.workspace.id) | unique | length),
          memory: $mem,
          apps: ($loose | group_by(.class) | map({class: (.[0].class // "?"), count: length}) | sort_by(-.count)),
          hidden: false, locked: false, last_used: ""
        }]
      else . end
  ' <<<"$rows"
}

cmd_overview() {
  local json
  json=$(overview_json)
  mkdir -p "$STATE_DIR"
  printf '%s' "$json" >"$STATE_DIR/overview.json"

  [[ ${1:-} == --json ]] && { printf '%s\n' "$json"; return 0; }

  printf '%-14s %5s %4s %8s %10s  %s\n' PROFILE WINS WS MEMORY 'LAST USED' APPS
  # Megabytes below a gigabyte: 51 MB rendered as "0G" at one decimal place,
  # which reads as "nothing here" for a window that is plainly open.
  jq -r --argjson now "$(date +%s)" '
    # A timestamp written before these were normalised to UTC carries a +02:00
    # offset, which fromdateiso8601 rejects outright. Catching that shows "?"
    # for one row instead of failing the whole table.
    def ago($now):
      if (. // "") == "" then "never"
      else (try ($now - fromdateiso8601) catch null) as $d
        | if   $d == null  then "?"
          elif $d < 3600   then (($d / 60      | floor | tostring) + "m ago")
          elif $d < 86400  then (($d / 3600    | floor | tostring) + "h ago")
          else                  (($d / 86400   | floor | tostring) + "d ago")
          end
      end;
    .[] | [
      (if .active then "* " else "  " end) + .profile,
      (.windows|tostring),
      (.workspaces|tostring),
      (if .memory >= 1073741824 then ((.memory/1073741824*10|round)/10|tostring) + "G"
       elif .memory >= 1048576 then ((.memory/1048576)|round|tostring) + "M"
       else "-" end),
      (if .active then "now" else (.last_used | ago($now)) end),
      (.apps | map(.class + (if .count > 1 then " x" + (.count|tostring) else "" end)) | join(", "))
    ] | @tsv' <<<"$json" |
    while IFS=$'\t' read -r p w ws m used apps; do
      printf '%-14s %5s %4s %8s %10s  %s\n' "$p" "$w" "$ws" "$m" "$used" "${apps:0:52}"
    done
}

# Close everything a profile is holding, politely.
#
# closewindow rather than killing the cgroup: an editor with unsaved work gets
# its usual chance to ask. Anything that ignores the request survives, which is
# the right failure — a profile with 12 windows and 6 GB is a housekeeping
# problem, not an emergency worth losing work over.
cmd_close_profile() {
  local name=${1:-}
  [[ -n $name ]] || die "usage: omarchy-profile close <name>"
  exists "$name" || die "no such profile '$name'"
  command -v hyprctl >/dev/null || die "hyprctl is not available"

  local offset span n=0 addr
  offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$name")")
  span=$(jq -r '.workspaces.span // 10' "$(file_for "$name")")
  while read -r addr; do
    [[ -n $addr ]] || continue
    hl_close_window "$addr" 2>/dev/null && ((n++))
  done < <(hyprctl -j clients 2>/dev/null |
    jq -r --argjson o "$offset" --argjson s "$span" \
      '.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s)) | .address')
  echo "asked $n window(s) in $name to close"
}

# ----------------------------------------------------------------- sessions
#
# What was open in a profile, so that entering it on a fresh boot can put it
# back. The user asked for a plain text record replayed on entry and nothing
# more complex, and the format is exactly that:
#
#   ~/.local/state/omarchy-profiles/sessions/<profile>.txt
#   3<TAB>zen.desktop
#   1<TAB>foot.desktop
#
# The workspace is 1..span, relative to the profile's block, so the record
# still means the same thing if the profile is later given a different block.
# The id is a desktop entry id and never a command line — /proc/<pid>/cmdline
# is not read anywhere here — so this can only reopen things the machine
# already knows how to launch, and a window whose class maps to no entry is
# skipped rather than guessed at.
#
# Readable, hand-editable, deletable: the reader takes ids with or without
# .desktop, ignores blank lines and # comments, and accepts spaces where it
# writes a tab. Everything it reads back is validated again before it is used.
#
# Replay is only ever offered into an EMPTY block. Profiles keep their windows
# across switches, so replaying on every entry would duplicate every window the
# profile already has open — "empty block" is what makes "after a reboot, or
# after close all" into a condition the engine can actually test.

SESSION_DIR="$STATE_DIR/sessions"
# Its own lock, not the state lock. One widget per monitor fires the recorder,
# and the second one arriving while the first writes has nothing to add — so it
# does nothing, rather than queueing behind it or making an unrelated verb busy.
SESSION_LOCK="$SESSION_DIR/.lock"
# Runtime, not state: an offer is about this boot. tmpfs clears both markers on
# reboot, which is precisely when they should stop being true.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-profiles"
OFFER_DIR="$RUNTIME_DIR/offer"
LOGIN_MARKER="$RUNTIME_DIR/login"
# This copy of the engine. The notification subshell has to re-enter the engine
# as a NEW process — the whole point is that it does not inherit the state lock
# — and it must be the copy that is running, not whichever one is installed, or
# a working tree would silently hand its work to the installed engine.
ENGINE_SELF="$PLUGIN_DIR/bin/omarchy-profile"

# A desktop id is spliced into a Lua string handed to `hyprctl dispatch`, so
# what may be in one is decided here and checked at every boundary. Anything
# outside this is not launched, and is not recorded either: a line the replay
# would always drop is not a record of anything.
SESSION_ID_RE='^[A-Za-z0-9._-]+$'

session_file() { printf '%s/%s.txt\n' "$SESSION_DIR" "$1"; }
offer_file() { printf '%s/%s\n' "$OFFER_DIR" "$1"; }

# A profile's workspace block, as "<offset> <span>".
profile_block() {
  local offset span
  offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$1")" 2>/dev/null)
  span=$(jq -r '.workspaces.span // 10' "$(file_for "$1")" 2>/dev/null)
  [[ $offset =~ ^[0-9]+$ ]] || offset=0
  [[ $span =~ ^[0-9]+$ ]] || span=10
  printf '%s %s\n' "$offset" "$span"
}

# Clients in <profile>'s block, as "<ws-in-block><TAB><class><TAB><initialClass>".
block_clients() {
  local offset span
  read -r offset span < <(profile_block "$1")
  command -v hyprctl >/dev/null || return 1
  hyprctl -j clients 2>/dev/null |
    jq -r --argjson o "$offset" --argjson s "$span" \
      '.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s))
           | "\(.workspace.id - $o)\t\(.class // "")\t\(.initialClass // "")"'
}

# Is the profile's block empty? A machine with no compositor, or a hyprctl that
# will not answer, says NO: replay is something done to a running desktop, and
# a question nobody could answer must never read as permission.
block_empty() {
  local offset span n
  read -r offset span < <(profile_block "$1")
  command -v hyprctl >/dev/null || return 1
  n=$(hyprctl -j clients 2>/dev/null |
    jq --argjson o "$offset" --argjson s "$span" \
       '[.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s))] | length' 2>/dev/null)
  [[ ${n:-1} == 0 ]]
}

# Window class -> desktop id, as "<rank><TAB><key><TAB><id>".
#
# Built from app_sources, the one enumerator: there is no second scan of
# desktop files anywhere in this file. NOT cached — building it costs tens of
# milliseconds here, which is not worth a state file that can go stale behind a
# package install.
#
# Four rules, first match wins at lookup time:
#
#   1  StartupWMClass equals the class exactly
#   2  the id, or the id's last dot-separated part, equals it (case-insensitive)
#   3  the basename of Exec's first word equals it, lowercased
#   4  Exec=omarchy-launch-webapp <url>, and the class is the browser's app
#      window for that URL's host
#
# Rule 4 is Chromium's --app= convention, measured here rather than assumed:
# omarchy-launch-webapp falls back to chromium for any default browser it does
# not recognise (zen, on this machine), and --app=https://example.com/ opens
# with the class chrome-example.com__-Default. Only the host is matched — the
# rest of that string is a URL encoding nobody documents, and two webapps on
# one host are a tie, resolved like any other.
class_map() {
  app_sources | awk -F'\t' '
    function base(p,   n, a) { n = split(p, a, "/"); return a[n] }
    function put(rank, key, id, level,   cur) {
      if (key == "" || id == "") return
      cur = map[rank, key]
      if (cur == "") { map[rank, key] = id; lvl[rank, key] = level; return }
      if (cur == id) return
      # Two ids answering to one class at the same rule. The user-level entry
      # wins, then the lexically first id.
      if (lvl[rank, key] == "system" && level == "user") { map[rank, key] = id; lvl[rank, key] = level }
      else if (lvl[rank, key] == level && id < cur) map[rank, key] = id
      # Said once, and only for the two rules where a tie is a surprise. Rule 3
      # ties by construction — every web app on the machine has the same
      # launcher as the first word of its Exec — and rule 4 resolves hosts,
      # where a tie means two entries genuinely point at one site.
      if (rank <= 2 && !((rank, key) in said)) {
        said[rank, key] = 1
        printf "omarchy-profile: two applications answer to the window class %s — using %s\n",
               key, map[rank, key] > "/dev/stderr"
      }
    }
    {
      id = $1; level = $2; hidden = $4; cls = $5; ex = $6
      if (hidden == "true") next          # Omarchy does not show it, so it is not one to reopen
      if (id == "org.quickshell") next    # the shell itself is not an application
      put(1, cls, id, level)
      put(2, tolower(id), id, level)
      n = split(id, parts, ".")
      if (n > 1) put(2, tolower(parts[n]), id, level)
      split(ex, words, " ")
      first = base(words[1])
      put(3, tolower(first), id, level)
      if (first == "omarchy-launch-webapp" && words[2] != "") {
        host = words[2]
        sub(/^[a-zA-Z]+:\/\//, "", host)
        sub(/\/.*$/, "", host)
        sub(/^www\./, "", host)
        put(4, tolower(host), id, level)
      }
    }
    END {
      for (k in map) { split(k, f, SUBSEP); printf "%s\t%s\t%s\n", f[1], f[2], map[k] }
    }'
}

declare -A CLASS_R1=() CLASS_R2=() CLASS_R3=() CLASS_R4=()
CLASS_MAP_LOADED=""
CLASS_ID=""

# Loaded once per process, deliberately: a lookup happens per window and per
# poll, and re-enumerating the machine's desktop entries for each one would
# turn tens of milliseconds into seconds.
class_map_load() {
  [[ -n $CLASS_MAP_LOADED ]] && return 0
  local rank key id
  while IFS=$'\t' read -r rank key id; do
    case $rank in
    1) CLASS_R1["$key"]=$id ;;
    2) CLASS_R2["$key"]=$id ;;
    3) CLASS_R3["$key"]=$id ;;
    4) CLASS_R4["$key"]=$id ;;
    esac
  done < <(class_map)
  CLASS_MAP_LOADED=1
}

# The desktop id for a window class, in CLASS_ID. A return value and a global
# rather than an echo: this is called once per window per poll, and a command
# substitution per call is a fork per call.
class_to_id() {
  local cls=${1:-} low host
  CLASS_ID=""
  [[ -n $cls ]] || return 1
  class_map_load
  if [[ -n ${CLASS_R1[$cls]:-} ]]; then CLASS_ID=${CLASS_R1[$cls]}; return 0; fi
  low=${cls,,}
  if [[ -n ${CLASS_R2[$low]:-} ]]; then CLASS_ID=${CLASS_R2[$low]}; return 0; fi
  if [[ -n ${CLASS_R3[$low]:-} ]]; then CLASS_ID=${CLASS_R3[$low]}; return 0; fi
  # chrome-<host><encoded-path>-<profile>: the app window a web app entry opens.
  if [[ $low == chrome-* ]]; then
    host=${low#chrome-}; host=${host%-*}; host=${host%%_*}
    if [[ -n ${CLASS_R4[$host]:-} ]]; then CLASS_ID=${CLASS_R4[$host]}; return 0; fi
  fi
  return 1
}

# What the record for <profile> would say about the desktop as it is right now:
# "<ws><TAB><id>", sorted by workspace then id, one line per id, keeping the
# lowest workspace. A browser with three windows is one line and reopens its
# own windows.
session_lines() {
  local p=$1 ws cls icls
  class_map_load
  while IFS=$'\t' read -r ws cls icls; do
    class_to_id "$cls" || class_to_id "$icls" || continue
    # Not recorded if it could never be replayed. The replay validates the id
    # again before it is interpolated; this is the same rule applied early, so
    # the file never carries a line whose only future is being dropped.
    [[ $CLASS_ID =~ $SESSION_ID_RE ]] || continue
    printf '%s\t%s\n' "$ws" "$CLASS_ID"
  done < <(block_clients "$p") | sort -k1,1n -k2,2 | awk -F'\t' '!seen[$2]++'
}

# The record as it is on disk, normalised to "<ws><TAB><id>" with no .desktop
# suffix. Everything a hand edit can do short of deleting the file is absorbed
# here: blank lines, comments, spaces instead of a tab, a missing suffix, a
# workspace that is not a number, the same id twice.
session_read() {
  local file; file=$(session_file "$1")
  [[ -s $file ]] || return 0
  awk '
    /^[[:space:]]*(#|$)/ { next }
    {
      ws = $1; id = $2
      if (id == "") next
      sub(/\.desktop$/, "", id)
      if (ws !~ /^[0-9]+$/) ws = 1
      printf "%s\t%s\n", ws, id
    }' "$file" | sort -k1,1n -k2,2 | awk -F'\t' '!seen[$2]++'
}

# Write "<ws><TAB><id>" lines from stdin as the record for <profile>. In the
# record's own directory, like every other write here: a bare mktemp lands on
# /tmp, and the mv that follows would be a copy rather than an atomic rename.
session_write() {
  local p=$1 file tmp
  file=$(session_file "$p")
  mkdir -p "$SESSION_DIR" || return 1
  tmp=$(mktemp "$file.XXXXXX") || return 1
  awk -F'\t' '$2 != "" { printf "%s\t%s.desktop\n", $1, $2 }' >"$tmp" &&
    mv "$tmp" "$file" || { rm -f "$tmp"; warn "could not write the session record for '$p'"; return 1; }
}

# Write down what <profile> has open. Called by the widget about ten seconds
# after the window set changes, and by stage 2 for the profile being left.
session_record() {
  local p=${1:-}
  [[ -n $p ]] || p=$(current_profile)
  [[ -n $p ]] && exists "$p" || { warn "cannot record a session for '${p:-}'"; return 1; }

  # A journal means current.json may be about to name a different profile, so
  # a record written now could be filed under the wrong one — the same mistake
  # as capturing into the wrong profile, in a smaller file. The one caller that
  # is allowed through is stage 2 itself, which is not guessing: it names the
  # profile it is leaving, and the journal says the same name.
  if [[ -e $JOURNAL && $p != "$(journal_field from)" ]]; then return 0; fi

  mkdir -p "$SESSION_DIR" || return 1
  exec 7>"$SESSION_LOCK" || return 1
  # Two seconds, and a failure does nothing at all rather than waiting: the
  # other recorder is writing the same desktop this one would.
  flock -w 2 7 || { exec 7>&-; return 0; }

  local lines
  lines=$(session_lines "$p")

  if [[ -z $lines ]]; then
    # AN EMPTY BLOCK NEVER OVERWRITES. Closing the last window by hand, or
    # `close all`, leaves the record intact — replay after exactly that is what
    # the whole feature is for. `session clear` is the only way to empty it.
    :
  elif [[ -e $(offer_file "$p") ]]; then
    # MERGE WHILE AN OFFER IS PENDING. After a reboot the block is empty and
    # the notification may be unanswered; the first app opened by hand fires
    # this, and a replace would shrink the record to that one app before the
    # user had chosen. Existing lines keep their workspaces.
    { session_read "$p"; printf '%s\n' "$lines"; } |
      awk -F'\t' '!seen[$2]++' | sort -k1,1n -k2,2 | session_write "$p"
  else
    printf '%s\n' "$lines" | session_write "$p"
  fi

  # Released here rather than at exit: stage 2 calls this, and stage 2 lives
  # for the rest of the switch.
  exec 7>&-
  return 0
}

# Wait for the window a launch was supposed to produce: the first client that
# was not there before and whose class maps to <id>. Its address, or nothing.
session_wait_for() {
  local id=$1 before=$2 deadline=$3 stop=$((SECONDS + 10)) addr cls
  ((stop > deadline)) && stop=$deadline
  while ((SECONDS < stop)); do
    sleep 0.2
    while IFS=$'\t' read -r addr cls; do
      [[ -n $addr ]] || continue
      grep -qxF -- "$addr" <<<"$before" && continue
      class_to_id "$cls" || continue
      [[ $CLASS_ID == "$id" ]] && { printf '%s\n' "$addr"; return 0; }
    done < <(hyprctl -j clients 2>/dev/null | jq -r '.[] | "\(.address)\t\(.class // "")"')
  done
  return 1
}

# Replay the record into the profile's empty block, now.
#
# Sequential, with a poll after each launch, so every move attaches to its own
# launch — and so the move catches a single-instance application that forwarded
# the launch to a process already running in another profile, which is the one
# case where the [workspace N silent] rule cannot work on its own.
session_restore() {
  local p=${1:-}
  [[ -n $p ]] && exists "$p" || refuse 1 no_such_profile "no such profile '${p:-}'"

  # In-process from stage 2 or from login_body the lock is already this
  # process's; anywhere else it is taken here, and a second caller is busy
  # rather than interleaved with the first.
  [[ $STATE_LOCK_HELD == 1 ]] || lock_or_busy

  [[ $p == "$(current_profile)" ]] ||
    refuse 1 not_active "windows can only be reopened in the profile you are in"
  block_empty "$p" ||
    refuse 1 not_empty "$p already has windows open — reopening would put a second copy of each beside them"
  command -v hyprctl >/dev/null ||
    refuse 1 no_compositor "there is no compositor to open windows on"

  local offset span
  read -r offset span < <(profile_block "$p")
  class_map_load

  # Every id the machine has an entry for, and every id this profile shows.
  # Two different answers: an id that no longer exists is dropped from the
  # record, an id this profile hides is kept and skipped — hiding an app is a
  # decision about the menu, not an instruction to forget it was ever open.
  local known visible
  known=$(app_sources | cut -f1)
  visible=$(apps_list_json "$p" | jq -r '.visible[].id' 2>/dev/null)

  local before
  before=$(hyprctl -j clients 2>/dev/null | jq -r '.[].address')

  # One budget for the whole replay, because it bounds how long the state lock
  # is held: a switch asked for meanwhile gets exit 3 until this is done.
  local deadline=$((SECONDS + 30))
  local total=0 launched=0 moved=0 ws id target addr at
  local kept=() missing=()

  while IFS=$'\t' read -r ws id; do
    ((total++))
    # VALIDATED BEFORE IT IS INTERPOLATED. The record is a file the user is
    # invited to edit, and the id below goes inside a Lua string inside a
    # dispatcher argument: an unchecked line is arbitrary code, not a typo.
    if [[ ! $id =~ $SESSION_ID_RE ]]; then
      warn "dropping a session line for '$p': '$id' is not a desktop id"
      continue
    fi
    if ! grep -qxF -- "$id" <<<"$known"; then
      warn "dropping '$id' from the session record for '$p': there is no such application any more"
      continue
    fi
    kept+=("$ws"$'\t'"$id")

    ((SECONDS >= deadline)) && continue            # budget spent; the line stays
    grep -qxF -- "$id" <<<"$visible" || continue   # hidden in this profile; the line stays

    ((ws < 1)) && ws=1
    ((ws > span)) && ws=span
    target=$((offset + ws))

    hyprctl dispatch "hl.dsp.exec_cmd(\"[workspace $target silent] uwsm app -- $id.desktop\")" >/dev/null ||
      { warn "could not launch $id"; missing+=("$id"); continue; }
    ((launched++))

    addr=$(session_wait_for "$id" "$before" "$deadline")
    if [[ -z $addr ]]; then missing+=("$id"); continue; fi
    before+=$'\n'$addr
    at=$(hyprctl -j clients 2>/dev/null | jq -r --arg a "$addr" '.[] | select(.address == $a) | .workspace.id')
    if [[ -n $at && $at != "$target" ]]; then
      hl_move_window "$target" "$addr" false && ((moved++))
    fi
  done < <(session_read "$p")

  # Only if something was actually dropped: a rewrite that changes nothing
  # still replaces the file the user may be looking at.
  if ((${#kept[@]} != total)); then
    printf '%s\n' ${kept[@]+"${kept[@]}"} | session_write "$p"
  fi
  rm -f "$(offer_file "$p")"

  answer "$(jq -nc --argjson l "$launched" --argjson m "$moved" \
              --argjson miss "$(printf '%s\n' ${missing[@]+"${missing[@]}"} |
                                jq -R -s 'split("\n") | map(select(length > 0))')" \
              '{ok: true, launched: $l, moved: $m, missing: $miss}')" \
         "reopened $launched application(s) in $p"
  return 0
}

# Ask, or do it, or do nothing — on entry, with the profile's block empty.
#
# Called from the end of stage 2 and from login_body, both of which hold the
# state lock; nothing else calls it.
maybe_restore() {
  local p=$1 mode
  mode=$(jq -r '.restore_apps // "ask"' "$(file_for "$p")" 2>/dev/null)
  [[ $mode == off || $mode == ask || $mode == always ]] || mode=ask
  [[ $mode == off ]] && return 0

  [[ -n $(session_read "$p") ]] || return 0
  block_empty "$p" || return 0

  mkdir -p "$OFFER_DIR" 2>/dev/null
  : >"$(offer_file "$p")" 2>/dev/null

  if [[ $mode == always ]]; then
    # In a subshell, for one reason: session_restore answers a refusal by
    # exiting, and a race that made the block non-empty between the check above
    # and the check inside it would otherwise take stage 2 down with it — before
    # journal_clear, leaving a finished switch looking interrupted.
    ( session_restore "$p" ) || true
    return 0
  fi

  # THE FORK CLOSES THE STATE LOCK. notify-send -A blocks until the
  # notification is answered or dies, which can be minutes after the switch is
  # over, and a child inherits fd 8 unless it is told not to — that is how the
  # first version of this made its own Restore, the panel's Restore button,
  # `apps allow` and every `set` return busy for as long as the notification
  # was on screen. `exec 8>&- 7>&-` as the subshell's FIRST statement closes
  # them in that process for good; a per-command redirection would be saved and
  # restored around the command and would not.
  ( exec 8>&- 7>&-; notify_offer "$p" ) </dev/null >/dev/null 2>&1 &
  disown
  return 0
}

# The Ask path. Runs detached, with no lock, in a process that may outlive the
# switch by as long as the user takes to answer.
notify_offer() {
  local p=$1 n names label action
  n=$(session_read "$p" | wc -l)
  ((n > 0)) || return 0
  label=$(jq -r '.label // ""' "$(file_for "$p")" 2>/dev/null)
  [[ -n $label && $label != null ]] || label=$p
  # The first three, by name rather than by id: "3 apps were open" says nothing
  # about whether they are the three you want back.
  names=$(session_read "$p" | head -3 | cut -f2 | while read -r id; do
    app_sources | awk -F'\t' -v i="$id" '$1 == i { print ($7 == "" ? $1 : $7); exit }'
  done | paste -sd, - | sed 's/,/, /g')
  [[ -n $names ]] || names=$(session_read "$p" | head -3 | cut -f2 | paste -sd, - | sed 's/,/, /g')
  ((n > 3)) && names="$names…"

  # -t 30000: the longest this notification server will hold a question.
  #
  # Measured here rather than assumed. Omarchy's server does not take the
  # client's expiry as given — it clamps it (notifications/Service.qml:102-110):
  # a normal-urgency popup lives between 8 s and 30 s whatever is asked for,
  # including 0, which elsewhere means "never expire". Only urgency=critical
  # waits indefinitely, and this is a question about windows, not an emergency;
  # claiming otherwise would also put it through do-not-disturb.
  #
  # So an Ask offer is a timed offer on this machine. That is consistent with
  # what the design already says — no answer is not a restore, and a switch or
  # a shell restart kills it just as dead — and the panel's Restore windows
  # button is what the promise actually rests on.
  action=$(notify-send -a Profiles -t 30000 -A restore=Restore -A skip="Not now" \
             "Restore windows?" "$n apps were open in $label: $names" 2>/dev/null)
  # Anything else — Not now, a dismissal, or the server dying with a shell
  # restart — does nothing. No answer is never a restore, and the panel's
  # Restore windows button is what remains.
  [[ $action == restore ]] && "$ENGINE_SELF" session restore "$p"
  return 0
}

# Everything the panel and the keybindings can ask about a session record.
cmd_session() {
  local args=() a
  for a in "$@"; do
    if [[ $a == --json ]]; then JSON=1; else args+=("$a"); fi
  done
  local verb=${args[0]:-} name=${args[1]:-} value=${args[2]:-}
  [[ -n $name ]] || name=$(current_profile)

  case $verb in
  record)
    session_record "${args[1]:-}" ;;
  restore)
    session_restore "$name" ;;
  show)
    [[ -n $name ]] && exists "$name" ||
      refuse 1 no_such_profile "no such profile '${name:-}'"
    session_show_json "$name" ;;
  clear)
    [[ -n $name ]] && exists "$name" ||
      refuse 1 no_such_profile "no such profile '${name:-}'"
    rm -f "$(session_file "$name")" "$(offer_file "$name")"
    answer '{"ok":true}' "forgot what was open in $name" ;;
  mode)
    [[ -n $name ]] && exists "$name" ||
      refuse 1 no_such_profile "no such profile '${name:-}'"
    session_mode "$name" "$value" ;;
  *)
    die "usage: omarchy-profile session <record|restore|show|clear|mode> [name] [value]" ;;
  esac
}

session_show_json() {
  local p=$1 mode names empty
  mode=$(jq -r '.restore_apps // "ask"' "$(file_for "$p")" 2>/dev/null)
  [[ $mode == off || $mode == ask || $mode == always ]] || mode=ask
  # The entry's own Name=, from the enumerator, so the panel does not have to
  # read a single desktop file to render the list.
  names=$(app_sources | awk -F'\t' '{ printf "%s\t%s\n", $1, ($7 == "" ? $1 : $7) }')
  empty=$(block_empty "$p" && echo true || echo false)

  session_read "$p" | jq -R -s --arg mode "$mode" --argjson empty "$empty" --arg names "$names" '
    ($names | split("\n") | map(select(length > 0) | split("\t"))
            | map({key: .[0], value: .[1]}) | from_entries) as $n
    | { restore_apps: $mode,
        apps: [ split("\n")[] | select(length > 0) | split("\t")
                | {workspace: (.[0] | tonumber), id: .[1], name: ($n[.[1]] // .[1])} ],
        blockEmpty: $empty }'
}

session_mode() {
  local p=$1 value=${2:-} file tmp
  [[ $value == off || $value == ask || $value == always ]] &&
    exists "$p" || refuse 1 bad_mode "reopening apps is off, ask or always"
  file=$(file_for "$p")
  tmp=$(mktemp "$file.XXXXXX") || return 1
  jq --arg v "$value" '.restore_apps = $v' "$file" >"$tmp" && mv "$tmp" "$file" ||
    { rm -f "$tmp"; refuse 1 write_failed "could not update '$p'"; }
  answer "$(jq -nc --arg v "$value" '{ok: true, restore_apps: $v}')" "reopen apps in $p: $value"
}

# ------------------------------------------------------------------- login
#
# The first thing to happen after a boot, and nothing else in the design knows
# when that is. There is no autostart line and no systemd unit: the widget
# calls `login` on every Component.onCompleted and the marker below decides
# whether this one is the boot.
#
# It has to be a marker rather than the widget's own judgement, because the
# shell restarts on every switch — including the switch login itself may make —
# so Component.onCompleted runs many times per boot and only the engine can
# tell which of them was the first.

cmd_login() {
  mkdir -p "$RUNTIME_DIR" 2>/dev/null
  # mkdir is the whole guard: it either creates the directory or fails, in one
  # atomic step, so two shells starting at once cannot both be the first. Taken
  # BEFORE any work, so the shell restart inside login's own switch re-runs the
  # widget, finds the marker and stops. A login that crashes is not retried
  # until the next boot, which is better than one that retries into a loop.
  mkdir "$LOGIN_MARKER" 2>/dev/null || exit 0

  # Detached exactly like `set`, and for the same reason: this may restart the
  # shell that called it.
  detach login_body
  exit 0
}

login_body() {
  trap '' HUP PIPE
  exec 8>"$LOCK_FILE" || return 0
  # Ten seconds, not none: at boot the widget may call this while something
  # else is still finishing, and giving up instantly would lose the only
  # chance this boot has.
  flock -w 10 8 || return 0
  STATE_LOCK_HELD=1

  # A switch that was cut off by the shutdown. Rolling it forward here is the
  # same repair Setup offers, done before anything reads current.json.
  [[ -e $JOURNAL ]] && recover_switch

  local cur; cur=$(current_profile)
  [[ -n $cur ]] && exists "$cur" || return 0

  if ! asks_auth "$cur"; then
    maybe_restore "$cur"
    return 0
  fi

  # The current profile is protected. Its theme, bar, launcher set, isolated
  # stores and workspace keys are already live — they are files, and they were
  # written when it was entered — so the only thing being withheld is its
  # windows, which is what the password is actually for.
  local u="" master n
  master=$(cfg .master)
  if exists "$master" && ! asks_auth "$master"; then
    u=$master
  else
    while read -r n; do
      [[ -n $n ]] || continue
      asks_auth "$n" && continue
      u=$n; break
    done < <(profile_names)
  fi

  if [[ -n $u && $u != "$cur" ]]; then
    # Capturing cur into itself is correct: its files ARE the live ones.
    switch_stage2 "$cur" "$u"
  fi
  # Either way the machine ends up asking for the password of the desk it was
  # left in. Its windows come back only through the ordinary `set`.
  prompt_unlock "$cur"
  return 0
}

# The panel has a field; a detached shell script does not. Retried for as long
# as wait_for_shell would wait, because a cold start registers the widget's IPC
# handler some time after the shell answers at all.
prompt_unlock() {
  local name=$1 i
  command -v omarchy-shell >/dev/null || return 0
  for i in $(seq 1 10); do
    omarchy-shell kalinewb.profiles promptUnlock "$name" >/dev/null 2>&1 && return 0
    sleep 1
  done
  warn "'$name' asks for a password and no panel answered the prompt"
  return 1
}

# ------------------------------------------------------------------ commands

# What a profile IS, for the config page's first group: the things that are
# always its own, whether or not anything is isolated. Display only — every one
# of them is changed somewhere else, and stating them here is what makes the
# machine-wide groups below it read as the exception they are.
cmd_config() {
  local name=${1:-}
  [[ -n $name ]] || name=$(current_profile)
  [[ -n $name ]] && exists "$name" ||
    refuse 1 no_such_profile "no such profile '${name:-}' (try: omarchy-profile list)"

  local file; file=$(file_for "$name")
  local catalog="$STATE_DIR/plugins.json" total_plugins=0
  [[ -s $catalog ]] && total_plugins=$(jq 'length' "$catalog" 2>/dev/null || echo 0)

  local apps_all=0 apps_allowed=0
  if is_master "$name"; then
    apps_all=$(apps_list_json "$name" | jq '.all | length' 2>/dev/null || echo 0)
    apps_allowed=$apps_all
  else
    apps_all=$(apps_list_json "$name" | jq '.all | length' 2>/dev/null || echo 0)
    apps_allowed=$(jq '(.apps.allowed // []) | length' "$file" 2>/dev/null || echo 0)
  fi

  jq -c --arg name "$name" --argjson plugins "${total_plugins:-0}" \
        --argjson appsAll "${apps_all:-0}" --argjson appsAllowed "${apps_allowed:-0}" \
        --argjson master "$(is_master "$name" && echo true || echo false)" \
        --argjson span "$(cfg .workspace_span)" '
    (.workspaces.offset // 0) as $off
    | {profile: $name, master: $master,
       theme: (.theme // ""),
       wallpaper: (.wallpaper // ""),
       # A captured layout, or Omarchy'"'"'s own: the count is what a person can
       # check against their own bar.
       bar: {captured: ((.bar // null) != null),
             widgets: ((.bar // {}) | [.. | objects | select(has("id")) | .id] | length)},
       plugins: {total: $plugins, disabled: ((.plugins.disabled // []) | length),
                 enabled: ([$plugins - ((.plugins.disabled // []) | length), 0] | max)},
       apps: {total: $appsAll, allowed: (if $master then $appsAll else $appsAllowed end)},
       workspaces: {offset: $off, span: (.workspaces.span // $span),
                    first: ($off + 1), last: ($off + (.workspaces.span // $span))},
       dnd: (.dnd // false),
       idle: (.idle // {}),
       restore_apps: (.restore_apps // "ask")}' "$file"
}

cmd_list() {
  local cur master
  cur=$(current_profile); master=$(cfg .master)
  local any=0
  while read -r n; do
    [[ -n $n ]] || continue
    any=1
    local marker=" " tag="" desc hidden
    [[ $n == "$cur" ]] && marker="*"
    [[ $n == "$master" ]] && tag=" (master)"
    desc=$(jq -r '._description // ""' "$(file_for "$n")")
    hidden=$(jq -r 'if .hidden then " [hidden]" else "" end' "$(file_for "$n")")
    printf '%s %-12s %s%s%s\n' "$marker" "$n" "$desc" "$tag" "$hidden"
  done < <(profile_names)
  ((any)) || echo "no profiles yet — try: omarchy-profile init"
}

cmd_current() { local c; c=$(current_profile); [[ -n $c ]] && echo "$c" || echo "unknown"; }

# Stage 1: the only part of a switch the caller is still alive to hear.
#
# It answers one question — were you allowed to do this — and then forks the
# work and exits, because the work restarts the shell and would otherwise be
# killed half way through by the thing it is doing.
cmd_set() {
  # A switch cancelled before its commit point must leave nothing behind, so the
  # trap goes up before the first thing that could leave something. 143 is the
  # code the panel drops in silence, having cancelled deliberately — and the
  # face attempt, if one is running, dies with it rather than a second later.
  trap '[[ -n ${face:-} ]] && kill "$face" 2>/dev/null; exit 143' TERM

  local name="" a
  for a in "$@"; do
    case $a in
    --json) JSON=1 ;;
    -*) die "unknown option '$a'" ;;
    *) [[ -n $name ]] || name=$a ;;
    esac
  done
  [[ -n $name ]] || die "usage: omarchy-profile set <name> [--json]"

  # Preflight, before anything is captured, swapped or written: a stale intent,
  # a path held by a failed swap, or a tier-3 path with nothing to seed from all
  # stop the switch here, where stopping costs nothing.
  require_no_journal
  require_no_held_paths
  preflight_tier3 "$name"

  exists "$name" ||
    refuse 1 no_such_profile "no such profile '$name' (try: omarchy-profile list)"
  if is_master "$name" && [[ $(cfg .master_switchable) != true ]]; then
    refuse 1 master_not_switchable "master is configured as a template only (master_switchable=false)"
  fi

  # A switch is running and it is going somewhere other than here. The
  # short-circuit below would answer "already" from a current.json that is about
  # to be rewritten, and this caller's click would be silently lost on the way.
  if [[ -e $JOURNAL ]] && ! state_lock_free && [[ $(journal_field to) != "$name" ]]; then
    refuse 3 busy "a switch to $(journal_field to) is already running — try again in a moment"
  fi

  local cur
  cur=$(current_profile)
  [[ $cur == "$name" ]] && { answer '{"ok":true,"already":true}' "already in $name"; return 0; }

  # Authenticate BEFORE anything is captured, swapped or written, and before the
  # lock is taken — a prompt on screen must not make every other verb busy. A
  # failed unlock has to leave the machine exactly where it was, not half-way
  # into a profile it never opened.
  #
  # The panel does not wait for a face before showing the field: it shows the
  # field at once and runs an empty-stdin `set` beside it, then TERMs that one
  # the moment something is typed. Both are this same code path; which secret
  # arrived on stdin is the only difference.
  if asks_auth "$name"; then
    collect_secret "$name"
    auth_entry "$name"
    clear_secrets
  fi

  if ! take_state_lock; then
    # Someone else is switching. If they are switching to where we were going,
    # that is this caller's own earlier attempt having got there first, and the
    # honest answer is that their switch is under way — not that it is busy.
    if [[ -e $JOURNAL && $(journal_field to) == "$name" ]]; then
      answer "$(jq -nc --arg n "$name" '{ok: true, switching: $n}')" "switching to $name"
      return 0
    fi
    refuse 3 busy "another switch or profile change is running — try again in a moment"
  fi

  # Both of these could have changed while a prompt was on screen.
  require_no_journal
  cur=$(current_profile)
  [[ $cur == "$name" ]] && { answer '{"ok":true,"already":true}' "already in $name"; return 0; }

  # The commit point. Up to here a TERM exits 143 with nothing written, no
  # journal (only stage 2 writes one) and the lock released by this process
  # exiting. After it the verdict is on stdout and the switch will finish.
  trap '' TERM
  answer "$(jq -nc --arg n "$name" '{ok: true, switching: $n}')" "switching to $name"
  detach switch_stage2 "$cur" "$name"
  exit 0
}

cmd_capture() {
  require_no_journal
  lock_or_busy
  local cur
  cur=$(current_profile)
  [[ -n $cur ]] || die "no active profile to capture into"
  capture_into "$cur" && echo "captured live state into $cur"
}

cmd_create() {
  local name=${1:-} mode=${2:---from-master}
  [[ -n $name ]] || die "usage: omarchy-profile create <name> [--from-master|--clean]"
  [[ $name =~ ^[a-zA-Z0-9_-]{1,64}$ ]] || die "profile names may use letters, digits, - and _ only"
  exists "$name" && die "profile '$name' already exists"

  # A hash or a binding left over from a profile of this name that no longer
  # exists. Creating on top of it would hand the new profile a password nobody
  # present knows, so it is refused and the `stale-hashes` Setup row clears it.
  if has_password "$name" || [[ -e $ROOT_STORE/identity/$name ]]; then
    refuse 1 stale_password \
      "a password is still stored for a deleted profile called '$name' — clear it in Setup" \
      "$(jq -nc --arg p "$name" '{profile: $p}')"
  fi

  local offset master
  offset=$(next_offset); master=$(cfg .master)

  case $mode in
  --from-master)
    exists "$master" || die "master profile '$master' does not exist yet"
    # A snapshot, not a link: later installs into master must not silently
    # appear here, which is the whole point of per-profile app visibility.
    jq --arg d "Copied from $master" --argjson o "$offset" \
       '._description = $d | .master = false | .hidden = false
        | .workspaces = {offset: $o, span: (.workspaces.span // 10)}
        | .browser_profile = "default"' \
       "$(file_for "$master")" >"$(file_for "$name")"
    ;;
  --clean)
    # Clean means "a stock Omarchy desktop with none of my add-ons", not "an
    # empty screen". First-party plugins stay on — a profile with no clock, no
    # tray and no network indicator is broken rather than clean — and so do the
    # pinned ones. Everything remains individually switchable afterwards;
    # this only decides where a new profile starts.
    local all_off
    all_off=$(omarchy plugin list --json 2>/dev/null |
      jq -c --argjson pinned "$(cfg -c '.pinned_plugins // []')" '
        [ .[] | . as $p | select(($pinned | index($p.id)) == null)
              | select(.firstParty // false | not)
              | select(.canDisable // true) | .id ]') || all_off="[]"
    jq -n --arg d "Clean profile" --argjson o "$offset" --argjson off "${all_off:-[]}" '{
      _description: $d, master: false, hidden: false, icon: "󰆼",
      theme: "tokyo-night", wallpaper: "",
      dnd: false, idle: {screensaver: 150, lock: 300, inhibit: false},
      workspaces: {offset: $o, span: 10},
      browser_profile: "default",
      bar: null, plugins: {disabled: $off}, apps: {allowed: []}
    }' >"$(file_for "$name")"
    ;;
  *) die "unknown mode '$mode' (use --from-master or --clean)" ;;
  esac
  write_index
  # Isolated plugin state follows the same choice as the rest of the profile.
  # From master: copy its stores, so the new profile starts already signed in
  # to Spotify and with the same dock. Clean: copy nothing, so each plugin
  # makes itself a fresh one on first use — signed out, default dock.
  if [[ $mode == --from-master ]]; then
    local src dst path
    while read -r path; do
      [[ -n $path ]] || continue
      src=$(store_for "$master" "$path")
      dst=$(store_for "$name" "$path")
      [[ -e $src ]] || continue
      mkdir -p "$(dirname "$dst")"
      cp -a "$src" "$dst" || warn "could not copy $path into $name"
    done < <(isolated_paths)
  else
    # Clean copies nothing — except the tier-3 files, which are required by
    # hyprland.lua and may never be absent. Those come from the packaged
    # version, which is exactly what "a stock Omarchy desktop" means.
    local path reload
    while IFS=$'\t' read -r path reload; do
      [[ $reload == hypr ]] || continue
      is_blocklisted "$path" && continue
      seed_tier3 "$name" "$path" "$path"
    done < <(isolated_rows)
  fi

  write_index
  echo "created $name (workspaces $((offset + 1))-$((offset + 10)))"
}

cmd_remove() {
  local name="" a
  for a in "$@"; do
    case $a in
    --json) JSON=1 ;;
    -*) die "unknown option '$a'" ;;
    *) [[ -n $name ]] || name=$a ;;
    esac
  done
  [[ -n $name ]] || die "usage: omarchy-profile remove <name> [--json]"
  # It deletes a profile's stores, so it may not run beside a switch that is
  # moving files into them, nor while an unfinished switch still names one.
  require_no_journal
  lock_or_busy
  exists "$name" || die "no such profile '$name'"
  is_master "$name" && die "refusing to remove the master profile"
  [[ $name == "$(current_profile)" ]] && die "refusing to remove the active profile — switch away first"

  # Authenticate FIRST, before a single window moves.
  #
  # The first version of this moved the windows and then asked, so a refused
  # password still emptied the profile's block — the deletion was refused and
  # the damage was done anyway. Nothing below runs unless the password (or the
  # owner) has answered.
  if has_password "$name" || [[ -e $ROOT_STORE/identity/$name ]]; then
    collect_secret "$name"
    if [[ -n $SECRET ]]; then
      HELPER_STDIN=$SECRET
      helper_or_refuse auth remove "$name"
    else
      HELPER_STDIN=""
      helper_or_refuse owner remove "$name"
    fi
    clear_secrets
    audit "root-side password and identity removed with $name"
  elif profile_locked "$name"; then
    # Locked with no hash: the owner is the only one who can answer, exactly as
    # entering it would.
    SECRET=""
    auth_entry "$name"
  fi

  # Its windows have to go somewhere.
  #
  # Abandoning them was the original behaviour and it was wrong twice over: no
  # profile maps to the freed block, so SUPER+1..0 can never reach those windows
  # again, and next_offset hands the same block to the next profile created —
  # which would then open onto a stranger's windows. Recovery meant knowing to
  # type `hyprctl dispatch workspace 14` at a shell.
  #
  # So they move to the master's block, workspace for workspace: the profile's
  # third workspace becomes the master's third. Master is the right destination
  # because it always exists and always sees everything.
  local offset span master_offset live=0
  offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$name")")
  span=$(jq -r '.workspaces.span // 10' "$(file_for "$name")")
  local master; master=$(cfg .master)
  master_offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$master")" 2>/dev/null)
  [[ $master_offset =~ ^[0-9]+$ ]] || master_offset=0

  live=$(migrate_block_windows "$offset" "$span" "$master_offset")
  [[ ${live:-0} -gt 0 ]] && echo "moved $live window(s) to $master"
  rm -f "$(file_for "$name")"
  # Its isolated plugin state goes too. Leaving it behind would accumulate
  # silently, and one of those files is a signed-in Spotify session.
  rm -rf "${ISOLATE_DIR:?}/${name:?}"

  # Removing the last visible profile would leave nothing to switch to, so the
  # master comes back into the picker rather than the user being stranded with
  # an empty list. Master is the fallback precisely because it always exists.
  if [[ $(visible_names | wc -l) -eq 0 ]]; then
    local master; master=$(cfg .master)
    if exists "$master"; then
      local tmp; tmp=$(mktemp "$(file_for "$master").XXXXXX")
      jq '.hidden = false' "$(file_for "$master")" >"$tmp" && mv "$tmp" "$(file_for "$master")"
      answer '{"ok":true}' "removed $name — $master is visible again, since nothing else was"
    else
      answer '{"ok":true}' "removed $name"
    fi
  else
    answer '{"ok":true}' "removed $name"
  fi
  # The session record goes with it, and so does anything it was owed.
  rm -f "$STATE_DIR/sessions/$name.txt" "$OFFER_DIR/$name" 2>/dev/null
  write_index
  return 0
}

# Rename a profile, root-owned files first.
#
# The order is the whole design. If the root files move first and the rest
# fails, <old> keeps "locked": true with no hash — it falls back to the owner,
# closed rather than open — and the `stale-hashes` row shows <new>. The reverse
# order would leave a profile with no hash under its own name, briefly and
# silently open. That is why it is not used.
cmd_rename() {
  local old="" new="" a
  for a in "$@"; do
    case $a in
    --json) JSON=1 ;;
    -*) die "unknown option '$a'" ;;
    *)
      if [[ -z $old ]]; then old=$a
      elif [[ -z $new ]]; then new=$a; fi ;;
    esac
  done
  [[ -n $old && -n $new ]] || die "usage: omarchy-profile rename <old> <new> [--json]"

  require_no_journal
  lock_or_busy

  exists "$old" || refuse 1 no_such_profile "no such profile '$old'"
  [[ $new =~ ^[a-zA-Z0-9_-]{1,64}$ ]] || refuse 1 bad_name "profile names may use letters, digits, - and _ only"
  [[ $old == "$new" ]] && { answer '{"ok":true}' "'$old' already has that name"; return 0; }
  exists "$new" && refuse 1 name_taken "a profile called '$new' already exists"
  if has_password "$new" || [[ -e $ROOT_STORE/identity/$new ]]; then
    refuse 1 stale_password \
      "a password is still stored for a deleted profile called '$new' — clear it in Setup" \
      "$(jq -nc --arg p "$new" '{profile: $p}')"
  fi

  # Step 2: the root files, before anything of ours moves.
  if has_password "$old" || [[ -e $ROOT_STORE/identity/$old ]]; then
    collect_secret "$old"
    if [[ -n $SECRET ]]; then
      HELPER_STDIN=$SECRET
      helper_or_refuse auth rename "$old" "$new"
    else
      HELPER_STDIN=""
      helper_or_refuse owner rename "$old" "$new"
    fi
    clear_secrets
  fi

  # Step 3: everything keyed by the name on this side. Every one of these is a
  # record that would point at a profile that no longer exists if it were
  # missed.
  mv -n "$(file_for "$old")" "$(file_for "$new")" ||
    refuse 1 rename_failed "could not rename the profile file — the password moved to '$new' and '$old' now asks the owner"

  [[ -d $ISOLATE_DIR/$old ]] && mv -n "$ISOLATE_DIR/$old" "$ISOLATE_DIR/$new"
  [[ -f $STATE_DIR/sessions/$old.txt ]] && mv -n "$STATE_DIR/sessions/$old.txt" "$STATE_DIR/sessions/$new.txt"
  # And the offer marker, so a rename in the middle of an unanswered "Restore
  # windows?" leaves the offer standing rather than stranding it under a name
  # nothing will ever look up again.
  [[ -e $OFFER_DIR/$old ]] && mv -n "$OFFER_DIR/$old" "$OFFER_DIR/$new"

  # The master is named in config.json, not in the profile file: a renamed
  # master that was not followed here would leave the machine with no master at
  # all, which is the one profile everything else falls back to.
  [[ $(cfg .master) == "$old" ]] && cfg_set --arg n "$new" '.master = $n'

  if [[ $(current_profile) == "$old" ]]; then
    local tmp
    tmp=$(mktemp "$STATE_FILE.XXXXXX") &&
      jq --arg n "$new" '.profile = $n' "$STATE_FILE" >"$tmp" &&
      mv "$tmp" "$STATE_FILE" || { rm -f "$tmp"; warn "could not update current.json"; }
  fi

  local errors="$STATE_DIR/hypr-errors.json"
  if [[ -s $errors ]] && jq -e --arg o "$old" 'has($o)' "$errors" >/dev/null 2>&1; then
    local etmp
    etmp=$(mktemp "$errors.XXXXXX") &&
      jq --arg o "$old" --arg n "$new" '.[$n] = .[$o] | del(.[$o])' "$errors" >"$etmp" &&
      mv "$etmp" "$errors" || { rm -f "$etmp"; warn "could not update hypr-errors.json"; }
  fi

  if [[ -s $PENDING_OWNER ]]; then
    local ptmp
    ptmp=$(mktemp "$PENDING_OWNER.XXXXXX") &&
      awk -F'\t' -v o="$old" -v n="$new" 'BEGIN{OFS="\t"} {if ($2 == o) $2 = n; print}' "$PENDING_OWNER" >"$ptmp" &&
      mv "$ptmp" "$PENDING_OWNER" || { rm -f "$ptmp"; warn "could not update the held-path record"; }
  fi

  note_password_name "$new"
  write_index
  write_catalog
  audit "renamed $old to $new"
  answer "$(jq -nc --arg n "$new" '{ok: true, name: $n}')" "renamed $old to $new"
}

# Profiles the picker will offer.
visible_names() {
  while read -r n; do
    [[ -n $n ]] || continue
    jq -e '.hidden // false' "$(file_for "$n")" >/dev/null 2>&1 || echo "$n"
  done < <(profile_names)
}

cmd_visibility() {
  local verb=$1 name=${2:-}
  [[ -n $name ]] || die "usage: omarchy-profile $verb <name>"
  exists "$name" || die "no such profile '$name'"

  # Hiding the last visible profile would leave the picker empty and no way to
  # switch at all. Master is allowed to be hidden like any other — it just
  # cannot be the one that empties the list.
  if [[ $verb == hide ]]; then
    local remaining
    remaining=$(visible_names | grep -vx "$name" | wc -l)
    ((remaining >= 1)) || die "'$name' is the only profile left in the picker — make another one visible first"
  fi

  local hidden=true; [[ $verb == show ]] && hidden=false
  local tmp; tmp=$(mktemp "$(file_for "$name").XXXXXX")
  jq --argjson h "$hidden" '.hidden = $h' "$(file_for "$name")" >"$tmp" && mv "$tmp" "$(file_for "$name")"
  write_index
  [[ $verb == show ]] && echo "$name now shows in the picker" || echo "$name is now hidden from the picker"
}

# What a profile is called on screen: its icon and the line under its name.
#
# The name itself is deliberately not here. Renaming moves a password hash and a
# face binding with it, so it authenticates and holds the state lock; this
# writes two cosmetic fields and nothing else. The one writer it can race is a
# capture, which rewrites the desk facts around these two — the same exposure
# `show`/`hide` has always had, and the cost of losing is a retyped line.
#
# Field names are the ones already in every profile JSON: `_description` (the
# underscore is the original schema's, and index_json reads it) and `icon`.
cmd_meta() {
  local name="" icon="" desc="" have_icon="" have_desc=""
  while (($#)); do
    case $1 in
    --json) JSON=1 ;;
    --icon) shift; have_icon=1; icon=${1:-} ;;
    --icon=*) have_icon=1; icon=${1#--icon=} ;;
    --description) shift; have_desc=1; desc=${1:-} ;;
    --description=*) have_desc=1; desc=${1#--description=} ;;
    -*) die "unknown option '$1'" ;;
    *) [[ -n $name ]] || name=$1 ;;
    esac
    shift
  done
  [[ -n $name ]] || die "usage: omarchy-profile meta <name> [--icon X] [--description Y]"
  exists "$name" || refuse 1 no_such_profile "no such profile '$name'"
  [[ -n $have_icon || -n $have_desc ]] ||
    die "nothing to change: pass --icon, --description, or both"

  # A codepoint typed instead of a glyph. Nerd Font tables are published as hex,
  # so "f0493", "U+F0493" and "0xf0493" are what a person copying one out of a
  # cheat sheet actually has in hand. Converted here rather than in the panel so
  # every caller writes the same thing into the file. Bare hex is only taken as
  # a codepoint at four digits or more: a two-letter icon could be meant.
  if [[ -n $have_icon && -n $icon ]]; then
    local hex=""
    case $icon in
    [Uu]+[0-9a-fA-F]*) hex=${icon:2} ;;
    0[xX][0-9a-fA-F]*) hex=${icon:2} ;;
    *) [[ $icon =~ ^[0-9a-fA-F]{4,6}$ ]] && hex=$icon ;;
    esac
    if [[ -n $hex && $hex =~ ^[0-9a-fA-F]{1,6}$ ]]; then
      # shellcheck disable=SC2059
      icon=$(printf "\\U$(printf '%08x' "0x$hex")")
    fi
  fi

  # Guards, not validation: an icon is whatever renders in one cell, and a
  # description is one line. Both are rendered in a fixed-width row, so a
  # paragraph pasted into either would simply be elided away — refusing says so
  # instead of silently keeping something nothing can show.
  if [[ -n $have_icon ]]; then
    ((${#icon} <= 8)) || refuse 1 bad_icon "an icon is one glyph, not ${#icon} characters"
  fi
  if [[ -n $have_desc ]]; then
    desc=${desc//$'\n'/ }
    ((${#desc} <= 160)) || refuse 1 bad_description "a description is one line — that one is ${#desc} characters"
  fi

  local file tmp
  file=$(file_for "$name")
  tmp=$(mktemp "$file.XXXXXX") || refuse 1 write_failed "could not write '$name'"
  jq --arg i "$icon" --arg d "$desc" \
     --argjson si "$([[ -n $have_icon ]] && echo true || echo false)" \
     --argjson sd "$([[ -n $have_desc ]] && echo true || echo false)" \
     'if $si then .icon = $i else . end | if $sd then ._description = $d else . end' \
     "$file" >"$tmp" && mv "$tmp" "$file" ||
    { rm -f "$tmp"; refuse 1 write_failed "could not write '$name'"; }

  write_index
  answer "$(jq -nc --arg n "$name" --arg i "$icon" --arg d "$desc" \
              --argjson si "$([[ -n $have_icon ]] && echo true || echo false)" \
              --argjson sd "$([[ -n $have_desc ]] && echo true || echo false)" \
              '{ok: true, name: $n}
               + (if $si then {icon: $i} else {} end)
               + (if $sd then {description: $d} else {} end)')" \
         "updated $name"
}

# What this profile may launch, as the panel reads it. `all` is every entry
# Omarchy would show if no profile hid anything — which is why it is taken from
# the enumerator rather than from what is visible right now: an app this profile
# has already hidden still has to appear in the list, or there is no way to
# switch it back on.
apps_list_json() {
  local name=$1 master=false allowed
  is_master "$name" && master=true
  allowed=$(jq -c '.apps.allowed // []' "$(file_for "$name")" 2>/dev/null) || allowed='[]'

  app_sources | awk -F'\t' '$4 == "false" { printf "%s\t%s\n", $1, ($7 == "" ? $1 : $7) }' |
    sort -u -t$'\t' -k2,2 -k1,1 |
    jq -R -s --argjson allowed "${allowed:-[]}" --argjson master "$master" '
      [ split("\n")[] | select(length > 0) | split("\t") | {id: .[0], name: .[1]} ] as $apps
      | { all: [$apps[].id],
          allowed: $allowed,
          visible: [ $apps[] | select($master or (.id as $i | $allowed | index($i) != null)) ] }'
}

apps_preview_json() {
  app_visibility_plan "$1" | jq -R -s '
    [ split("\n")[] | select(length > 0) | split("\t") ] as $rows
    | { to_hide: [ $rows[] | select(.[0] == "H") | .[1] ],
        to_show: [ $rows[] | select(.[0] == "S") | .[1] ] }'
}

# Applications. Master is a wildcard: it sees everything, so an install only has
# to be registered to the profile it happened in.
cmd_apps() {
  # Both argument orders are accepted: `apps <profile> <verb> [id]`, which the
  # keybindings and the panel have always used, and the contract's
  # `apps <verb> --json <profile>`. A profile named after a verb loses, which is
  # a price worth one line of documentation.
  local json="" args=() a
  for a in "$@"; do
    if [[ $a == --json ]]; then json=1; JSON=1; else args+=("$a"); fi
  done
  local name verb app
  case ${args[0]:-} in
  list | preview | allow | deny | allow-all | deny-all)
    verb=${args[0]}; name=${args[1]:-}; app=${args[2]:-} ;;
  *)
    name=${args[0]:-}; verb=${args[1]:-list}; app=${args[2]:-} ;;
  esac

  [[ -n $name ]] || die "usage: omarchy-profile apps <profile> [list|preview|allow|deny] [app-id]"
  exists "$name" || die "no such profile '$name'"
  # A change to the allow-list of the active profile rewrites entries in
  # ~/.local/share/applications immediately, which is work a switch is also
  # doing. Reads never take the lock, so the panel's lists open during a switch.
  case $verb in
  allow | deny | allow-all | deny-all) lock_or_busy ;;
  esac
  local file; file=$(file_for "$name")
  case $verb in
  list)
    if [[ -n $json ]]; then apps_list_json "$name"
    elif is_master "$name"; then echo "*  (master sees every application)"
    else jq -r '(.apps.allowed // [])[]' "$file"
    fi ;;
  preview)
    # What a switch into this profile would do to the menu, without doing it.
    apps_preview_json "$name" ;;
  allow-all | deny-all)
    is_master "$name" && { echo "master already sees every application"; return 0; }
    local tmp; tmp=$(mktemp "$file.XXXXXX")
    if [[ $verb == deny-all ]]; then
      jq '.apps = ((.apps // {}) | .allowed = [])' "$file" >"$tmp"
    else
      # Every entry Omarchy would show on its own. Taken from the enumerator, so
      # it is the same set whichever profile is active and whatever is hidden
      # right now — otherwise "allow all" in one profile would silently mean
      # "allow all except what the profile I am standing in has hidden".
      local ids
      ids=$(app_sources | awk -F'\t' '$4 == "false" { print $1 }' | sort -u | jq -R . | jq -sc .)
      jq --argjson all "${ids:-[]}" '.apps = ((.apps // {}) | .allowed = $all)' "$file" >"$tmp"
    fi
    mv "$tmp" "$file" || die "could not update '$name'"
    [[ $name == "$(current_profile)" ]] && apply_app_visibility "$name"
    echo "$verb in $name" ;;
  allow | deny)
    [[ -n $app ]] || die "usage: omarchy-profile apps $name $verb <app-id>"
    is_master "$name" && { echo "master already sees every application"; return 0; }
    local tmp; tmp=$(mktemp "$file.XXXXXX")
    if [[ $verb == allow ]]; then
      jq --arg a "$app" '.apps = ((.apps // {}) | .allowed = (((.allowed // []) + [$a]) | unique))' "$file" >"$tmp"
    else
      jq --arg a "$app" '.apps = ((.apps // {}) | .allowed = ((.allowed // []) | map(select(. != $a))))' "$file" >"$tmp"
    fi
    mv "$tmp" "$file" || die "could not update '$name'"
    [[ $name == "$(current_profile)" ]] && apply_app_visibility "$name"
    echo "$verb $app in $name" ;;
  *) die "unknown apps verb '$verb'" ;;
  esac
}

cmd_plugin() {
  local name verb id
  # The contract writes this the other way round — `plugin list --json <name>`,
  # `plugin enable <name> <id>` — so both orders are accepted, as `apps` does.
  # The per-profile `--json` shape itself is the config phase's.
  case ${1:-} in
  list | enable | disable)
    verb=$1
    [[ ${2:-} == --json ]] && not_implemented "plugin $1 --json"
    name=${2:-}; id=${3:-} ;;
  *)
    name=${1:-}; verb=${2:-list}; id=${3:-} ;;
  esac
  [[ -n $name ]] || die "usage: omarchy-profile plugin <profile> [list|enable|disable] [plugin-id]"
  exists "$name" || die "no such profile '$name'"
  local file; file=$(file_for "$name")
  case $verb in
  list) jq -r '(.plugins.disabled // [])[]' "$file" ;;
  # Bulk operations take an optional category so "disable all" from a filtered
  # view means what the user is looking at, not the whole machine.
  enable-all | disable-all)
    local category=${3:-}
    local ids
    ids=$(omarchy plugin list --json 2>/dev/null |
      jq -r --argjson pinned "$(cfg -c '.pinned_plugins // []')" --arg cat "$category" '
        .[] | . as $p
        | select(($pinned | index($p.id)) == null)
        | select(.canDisable // true)
        | select($cat == "" or (
            if ($p.kinds | index("bar-widget")) then "Bar widgets"
            elif ($p.kinds | index("panel")) then "Panels"
            elif ($p.kinds | index("service")) then "Services"
            elif ($p.kinds | index("overlay")) then "Overlays"
            elif ($p.kinds | index("menu")) then "Menus"
            elif ($p.kinds | index("bar")) then "Bars"
            else "Other" end) == $cat)
        | .id')
    [[ -n $ids ]] || { echo "nothing to change"; return 0; }
    local tmp; tmp=$(mktemp "$file.XXXXXX")
    if [[ $verb == disable-all ]]; then
      jq --argjson add "$(printf '%s\n' "$ids" | jq -R . | jq -sc .)" \
        '.plugins = ((.plugins // {}) | .disabled = (((.disabled // []) + $add) | unique))' "$file" >"$tmp"
    else
      jq --argjson drop "$(printf '%s\n' "$ids" | jq -R . | jq -sc .)" \
        '.plugins = ((.plugins // {}) | .disabled = ((.disabled // []) | map(select(. as $i | ($drop | index($i)) == null))))' "$file" >"$tmp"
    fi
    mv "$tmp" "$file" || { rm -f "$tmp"; die "could not update '$name'"; }
    if [[ $name == "$(current_profile)" ]]; then
      local v=enable; [[ $verb == disable-all ]] && v=disable
      while read -r id; do
        [[ -n $id ]] || continue
        omarchy plugin "$v" "$id" >/dev/null 2>&1 || true
      done <<<"$ids"
    fi
    write_catalog
    echo "$verb${category:+ ($category)} in $name" ;;
  enable | disable)
    [[ -n $id ]] || die "usage: omarchy-profile plugin $name $verb <plugin-id>"
    if [[ $verb == disable ]] && cfg '.pinned_plugins // []' | jq -e --arg i "$id" 'index($i)' >/dev/null 2>&1; then
      die "'$id' is pinned and cannot be disabled — disabling it would leave no way back into another profile"
    fi
    local tmp; tmp=$(mktemp "$file.XXXXXX")
    if [[ $verb == disable ]]; then
      jq --arg i "$id" '.plugins = ((.plugins // {}) | .disabled = (((.disabled // []) + [$i]) | unique))' "$file" >"$tmp"
    else
      jq --arg i "$id" '.plugins = ((.plugins // {}) | .disabled = ((.disabled // []) | map(select(. != $i))))' "$file" >"$tmp"
    fi
    mv "$tmp" "$file" || { rm -f "$tmp"; die "could not update '$name'"; }

    # Editing the profile you are currently in has to change the machine too,
    # not just the file. Otherwise the next switch captures live state over the
    # edit and it silently disappears — the record and the reality have to move
    # together for the active profile.
    if [[ $name == "$(current_profile)" ]]; then
      omarchy plugin "$verb" "$id" >/dev/null 2>&1 ||
        warn "recorded, but could not $verb '$id' on the running shell"
    fi
    write_catalog
    echo "$verb $id in $name" ;;
  *) die "unknown plugin verb '$verb'" ;;
  esac
}

# Workspace indirection. Hyprland has no app grouping, so workspaces are the
# only layer available; these two keep SUPER+N meaning "this profile's Nth".
# The active profile's block. Defaults to 0/10 so a missing or unreadable state
# file leaves the keys addressing workspaces 1-10 — the stock behaviour — rather
# than doing nothing. These run on every workspace keypress, so they stay to one
# jq call.
ws_offset() {
  local o
  o=$(jq -r '.ws_offset // 0' "$STATE_FILE" 2>/dev/null)
  [[ $o =~ ^[0-9]+$ ]] && printf '%s\n' "$o" || printf '0\n'
}

ws_span() {
  local s
  s=$(jq -r '.ws_span // 10' "$STATE_FILE" 2>/dev/null)
  [[ $s =~ ^[0-9]+$ ]] && printf '%s\n' "$s" || printf '10\n'
}

cmd_ws() {
  local n=${1:-} offset span cur
  offset=$(ws_offset); span=$(ws_span)

  # next/prev step to the next workspace in this block that EXISTS.
  #
  # Hyprland's own e+1 skips empty workspaces — that is what the "e" is for, and
  # it is the whole reason the binding is useful: two occupied workspaces are
  # one keypress apart however far their numbers are. Its only flaw is not
  # knowing where a profile's block ends, so after the tenth it carries you into
  # the next desk's windows.
  #
  # So: the same skipping, bounded. Walking all ten positions blindly was worse
  # than the stock behaviour, because reaching an occupied workspace three
  # numbers away meant three keypresses through empty ones.
  if [[ $n == next || $n == prev ]]; then
    cur=$(hyprctl -j activeworkspace 2>/dev/null | jq -r '.id // 1')
    [[ $cur =~ ^-?[0-9]+$ ]] || cur=$((offset + 1))

    # Existing workspaces inside the block, in order, with the current one
    # folded in: a workspace with only one window is real to the compositor but
    # `hyprctl workspaces` can lag a fresh switch.
    local ids
    ids=$(hyprctl -j workspaces 2>/dev/null |
      jq -r --argjson o "$offset" --argjson s "$span" --argjson cur "$cur" \
        '[.[] | .id | select(. > $o and . <= ($o + $s))] + [$cur | select(. > $o and . <= ($o + $s))]
         | unique | .[]')

    # Outside the block (a special workspace, say), or nothing here yet: land on
    # the block's first workspace rather than doing nothing.
    if [[ -z $ids ]]; then
      hl_focus_workspace "$((offset + 1))"
      return 0
    fi

    local target
    target=$(awk -v cur="$cur" -v dir="$n" '
      { a[NR] = $1; if ($1 == cur) at = NR }
      END {
        if (NR == 0) exit
        if (at == 0) { print a[1]; exit }          # current not in the list
        if (NR == 1) { print a[1]; exit }          # nowhere else to go
        if (dir == "next") print a[at % NR + 1]
        else               print a[(at - 2 + NR) % NR + 1]
      }' <<<"$ids")
    [[ -n $target ]] && hl_focus_workspace "$target"
    return 0
  fi

  [[ $n =~ ^([1-9]|10)$ ]] || die "usage: omarchy-profile ws <1-10|next|prev>"
  hl_focus_workspace "$((offset + n))"
}

cmd_move() {
  local n=${1:-} offset follow=true
  # "silent" is follow = false in the Lua API: the window moves and the view
  # stays put, rather than a separate dispatcher name.
  [[ ${2:-} == --silent ]] && follow=false
  [[ $n =~ ^([1-9]|10)$ ]] || die "usage: omarchy-profile move <1-10> [--silent]"
  offset=$(ws_offset)
  hl_move_window "$((offset + n))" "" "$follow"
}

cmd_next() {
  local cur next first
  cur=$(current_profile)
  # VISIBLE profiles only. A hidden profile is one the user took out of the
  # picker; landing on it from a keybinding is the same surprise by another
  # route.
  first=$(visible_names | head -1)
  [[ -n $first ]] || die "no profiles in the picker"
  next=$(visible_names | awk -v c="$cur" 'found { print; exit } $0 == c { found = 1 }')
  [[ -n $next ]] || next=$first
  [[ $next == "$cur" ]] && return 0

  # A keybinding has nowhere to type. If the next profile asks for anything,
  # hand it to the panel, which has a field, and stop here — switching would
  # otherwise sit on an invisible prompt with no way to answer it.
  if asks_auth "$next"; then
    if command -v omarchy-shell >/dev/null &&
       omarchy-shell kalinewb.profiles promptUnlock "$next" >/dev/null 2>&1; then
      return 0
    fi
    warn "'$next' asks for a password and there is no panel to ask in"
    return 1
  fi
  cmd_set "$next"
}

# Adopt the machine as it is right now as the master profile. Safe to run on a
# configured desktop: it reads state, never imposes any.
cmd_init() {
  ensure_config
  local master; master=$(cfg .master)
  exists "$master" && die "master profile '$master' already exists"
  jq -n --arg d "The whole machine — every app and plugin" '{
    _description: $d, master: true, hidden: false, icon: "󰒓",
    theme: "", wallpaper: "",
    dnd: false, idle: {screensaver: 150, lock: 300, inhibit: false},
    workspaces: {offset: 0, span: 10},
    browser_profile: "default",
    bar: null, plugins: {disabled: []}, apps: {allowed: []}
  }' >"$(file_for "$master")"
  capture_into "$master"
  write_index
  write_catalog
  write_state "$master"
  echo "initialised master profile '$master' from the current machine"
}

# ------------------------------------------------------------------- setup
#
# One row per thing that has to be true before profiles work, and a fix for
# each. `omarchy plugin add --enable` copies files and nothing else — it
# installs no binary, registers no polkit action and runs no install script —
# so this is where that gap is closed, from the panel, with no terminal.
#
# Three rules the rows keep:
#   - a status query never raises a dialog and never opens a camera;
#   - a fact that could not be determined is `unknown`, never `ok`;
#   - Setup never edits the user's own configuration. Where their file is the
#     problem it says so and stops.
#
# Rows land with the phase that makes them true. These five are this phase's.

SETUP_ROWS=()

# setup_row <id> <label> <state> <detail> <fixable>
setup_row() {
  SETUP_ROWS+=("$(jq -nc --arg id "$1" --arg label "$2" --arg state "$3" \
                        --arg detail "$4" --argjson fixable "$5" \
                  '{id: $id, label: $label, state: $state, detail: $detail, fixable: $fixable}')")
}

# Where the engine lives for anything that has to name it in a file that
# outlives this process. The installed copy wins: a keybinding written from a
# working tree would break the day that tree moved.
engine_path() {
  local installed="$CONFIG_HOME/omarchy/plugins/kalinewb.profiles/bin/omarchy-profile"
  if [[ $PLUGIN_DIR == "$CONFIG_HOME/omarchy/plugins/"* ]]; then
    printf '%s\n' "$PLUGIN_DIR/bin/omarchy-profile"
  elif [[ -x $installed ]]; then
    printf '%s\n' "$installed"
  else
    printf '%s\n' "$PLUGIN_DIR/bin/omarchy-profile"
  fi
}

# --------------------------------------------------------------- row: adopt

setup_row_adopt() {
  local master; master=$(cfg .master)
  if exists "$master"; then
    setup_row adopt "This machine is adopted" ok \
      "'$master' is the master profile: it sees every application, and new profiles are copied from it." false
  else
    setup_row adopt "Adopt this machine" needs_action \
      "Nothing is adopted yet, so there is no profile to switch to. This reads the desktop as it is right now and saves it as '$master'. It changes nothing." true
  fi
}

# ---------------------------------------------------------------- row: apps
#
# The hiding rules in app_sources are a copy of Omarchy's own
# hidden-entries.sh, and a copy that has drifted would hide the wrong
# applications on every switch. So they are checked against the original rather
# than trusted.
#
# Stated as two containments rather than as set equality, because equality can
# only be asked on a machine with none of our entries on disk: an entry we have
# hidden is hidden live and visible at its source, by design. Every id Omarchy
# hides is either hidden at its source or hidden by us; every id we read as
# hidden at source is hidden live. With no entries of ours those two reduce to
# equality, which is the test as the plan states it.
#
# Returns 0 match, 1 drifted, 2 could not be determined.
apps_rules_match() {
  local script="${OMARCHY_PATH:-/usr/share/omarchy}/shell/services/hidden-entries.sh"
  [[ -r $script ]] || return 2
  local tmp rc=0
  tmp=$(mktemp -d) || return 2
  # Its exit status is whatever its last scan_dir returned — 1 whenever
  # ~/.nix-profile/share/applications is absent, which is most machines — so it
  # says nothing about whether the scan worked. Only its output is a verdict.
  bash "$script" "$(app_desktop_names)" 2>/dev/null | sort -u >"$tmp/live"
  app_sources | awk -F'\t' '$4 == "true" { print $1 }' | sort -u >"$tmp/ours"
  app_sources | awk -F'\t' '$8 != "" { print $1 }' | sort -u >"$tmp/owned"

  # Hidden at source but not hidden live: we would be showing something Omarchy
  # hides.
  comm -23 "$tmp/ours" "$tmp/live" >"$tmp/extra"
  [[ -s $tmp/extra ]] && rc=1
  # Hidden live, not hidden at source, and not ours: something is hiding it for
  # a reason our copy of the rules does not know about.
  comm -13 "$tmp/ours" "$tmp/live" >"$tmp/live-only"
  comm -23 "$tmp/live-only" "$tmp/owned" >"$tmp/unexplained"
  [[ -s $tmp/unexplained ]] && rc=1
  rm -rf "$tmp"
  return $rc
}

setup_row_apps() {
  local label="Application visibility"
  local cur; cur=$(current_profile)
  if [[ -z $cur ]] || ! exists "$cur"; then
    setup_row apps "$label" unknown \
      "No profile is active yet, so there is nothing to compare the menu against." false
    return
  fi

  # A -Modified tag means we edited a file the user already had. Without its
  # backup there is nothing to put back, and that is the one state here that is
  # broken rather than merely out of date: the data to undo it is gone.
  local orphan="" id tag
  while IFS=$'\t' read -r id tag; do
    [[ $tag == modified ]] || continue
    [[ -s $APP_BACKUP_DIR/$id.desktop ]] && continue
    orphan+="${orphan:+, }$id"
  done < <(app_sources | awk -F'\t' '$8 != "" { print $1 "\t" $8 }')
  if [[ -n $orphan ]]; then
    setup_row apps "$label" broken \
      "These entries were edited with no backup left to restore: $orphan. Fixing puts every application back and applies '$cur' again from scratch." true
    return
  fi

  apps_rules_match
  case $? in
  1) setup_row apps "$label" broken \
       "This plugin's copy of Omarchy's hiding rules no longer agrees with Omarchy's own, so a switch could hide the wrong applications. Fixing restores every entry and applies '$cur' again." true
     return ;;
  2) setup_row apps "$label" unknown \
       "Omarchy's own hidden-entries.sh could not be read, so its rules could not be compared with this plugin's copy." false
     return ;;
  esac

  local pending
  pending=$(apps_preview_json "$cur" | jq -r '(.to_hide | length) + (.to_show | length)' 2>/dev/null)
  [[ $pending =~ ^[0-9]+$ ]] || pending=0
  if ((pending > 0)); then
    setup_row apps "$label" needs_action \
      "$pending application entr$([[ $pending == 1 ]] && echo y || echo ies) do not match what '$cur' allows. Fixing brings the menu, the launcher and search back in line." true
  else
    setup_row apps "$label" ok \
      "The menu, the launcher and search show exactly what '$cur' allows." false
  fi
}

# ---------------------------------------------------------------- row: keys
#
# SUPER+1..0 have to address the active profile's block of workspaces, which
# means a keybinding that calls this engine. bindings.lua stays the user's —
# they may isolate it per profile, and Setup never writes into it — so the keys
# live in a file of our own and hyprland.lua gets exactly one line pointing at
# it.

KEYS_FILE="$CONFIG_HOME/hypr/profiles-keys.lua"
HYPRLAND_LUA="$CONFIG_HOME/hypr/hyprland.lua"
KEYS_REQUIRE='pcall(require, "hypr.profiles-keys") -- kalinewb.profiles: managed, must stay after require("hypr.bindings")'

# The whole file is generated, every time. `hl` and `o` are globals in Omarchy's
# Lua state; the guard makes the file inert anywhere they are not, so a copy of
# it that ends up somewhere else can never break a config.
keys_file_content() {
  local engine; engine=$(engine_path)
  # A Lua string literal: a backslash or a quote in a path would otherwise end
  # the string, and nothing else in a path needs escaping.
  engine=${engine//\\/\\\\}
  engine=${engine//\"/\\\"}
  cat <<EOF
-- Managed by Profiles (kalinewb.profiles). Setup regenerates this file; edits are overwritten.
if not (hl and o) then return end
local engine = "$engine"
for w = 1, 10 do
  local key, n = "code:" .. tostring(w + 9), tostring(w)
  hl.unbind("SUPER + " .. key)
  o.bind("SUPER + " .. key, "Workspace " .. n, engine .. " ws " .. n)
  hl.unbind("SUPER + SHIFT + " .. key)
  o.bind("SUPER + SHIFT + " .. key, "Move window to workspace " .. n, engine .. " move " .. n)
  hl.unbind("SUPER + SHIFT + ALT + " .. key)
  o.bind("SUPER + SHIFT + ALT + " .. key, "Move window silently to workspace " .. n, engine .. " move " .. n .. " --silent")
end
hl.unbind("SUPER + TAB");         o.bind("SUPER + TAB", "Next workspace in this profile", engine .. " ws next")
hl.unbind("SUPER + SHIFT + TAB"); o.bind("SUPER + SHIFT + TAB", "Previous workspace in this profile", engine .. " ws prev")
EOF
  # The global workspace, when there is one. Plain SUPER+M and SUPER+CTRL+M:
  # SUPER+SHIFT+M and SUPER+SHIFT+ALT+M are already Music and Music TUI.
  local gws; gws=$(global_ws_name)
  [[ -n $gws ]] || return 0
  cat <<EOF
o.bind("SUPER + M", "Toggle the global workspace", hl.dsp.workspace.toggle_special("$gws"))
o.bind("SUPER + CTRL + M", "Send the window to the global workspace",
  hl.dsp.window.move({ workspace = "special:$gws", follow = false }))
EOF
}

# Someone's own workspace bindings, which would fight the managed ones.
#
# Matched on the binary path rather than on a command, because a block built
# from a variable — `gk_profile .. " ws " .. n` — contains no literal
# `omarchy-profile ws` anywhere. Every hypr Lua file except the managed one is
# searched, and so is every isolated copy of bindings.lua: another profile's
# copy can hold a block this profile's file does not.
keys_handwritten() {
  local f
  for f in "$CONFIG_HOME"/hypr/*.lua; do
    [[ -f $f ]] || continue
    [[ $f == "$KEYS_FILE" ]] && continue
    grep -nF 'kalinewb.profiles/bin/omarchy-profile' -- "$f" 2>/dev/null |
      cut -d: -f1 | sed "s|^|$f:|"
  done
  for f in "$ISOLATE_DIR"/*/.config%hypr%bindings.lua; do
    [[ -f $f ]] || continue
    grep -nF 'kalinewb.profiles/bin/omarchy-profile' -- "$f" 2>/dev/null |
      cut -d: -f1 | sed "s|^|$f:|"
  done
}

# Line numbers of the managed require line, and of the bindings require it must
# follow. `require("hypr.bindings")` wins over anything loaded before it, so
# these bindings have to come after it — not last: hyprmoncfg appends a block it
# wants last too, and the two do not conflict.
keys_line_no() { [[ -s $HYPRLAND_LUA ]] && grep -nF 'require, "hypr.profiles-keys"' -- "$HYPRLAND_LUA" | head -1 | cut -d: -f1; }
# Not the managed line itself, which says `require("hypr.bindings")` inside its
# own comment: matching that made the line look like it was in the right place
# whatever its position, because it was being compared against itself.
bindings_line_no() {
  [[ -s $HYPRLAND_LUA ]] || return 0
  grep -nF 'require("hypr.bindings")' -- "$HYPRLAND_LUA" |
    grep -vF 'hypr.profiles-keys' | head -1 | cut -d: -f1
}

setup_row_keys() {
  local label="Workspace keys"

  local hand; hand=$(keys_handwritten)
  if [[ -n $hand ]]; then
    # Not fixable from here, and deliberately so: the block is in the user's own
    # configuration, which Setup does not edit. The keys work — theirs call the
    # same engine — so this is a report, not a breakage.
    local files
    files=$(printf '%s\n' "$hand" | awk -F: '{ f[$1] = f[$1] (f[$1] ? ", " : "") $2 } END { for (k in f) printf "%s (lines %s) ", k, f[k] }' |
      sed "s|$HOME|~|g; s| $||")
    setup_row keys "$label" broken \
      "Workspace keys are also bound by hand in $files. Setup does not edit your own configuration — remove that block and this row goes green. Until then those bindings are the ones in force." false
    return
  fi

  local want have
  want=$(keys_file_content)
  have=$([[ -s $KEYS_FILE ]] && cat "$KEYS_FILE")
  local kline bline
  kline=$(keys_line_no); bline=$(bindings_line_no)

  if [[ ! -s $KEYS_FILE || -z $kline ]]; then
    setup_row keys "$label" needs_action \
      "SUPER+1..0 are not following the active profile yet, so they address workspaces 1-10 in every profile. Fixing writes ~/.config/hypr/profiles-keys.lua and adds one line to hyprland.lua." true
    return
  fi
  if [[ $have != "$want" ]]; then
    setup_row keys "$label" broken \
      "~/.config/hypr/profiles-keys.lua is not the file this plugin generates — it was edited, or written by an older version. Fixing rewrites it." true
    return
  fi
  if [[ -n $bline ]] && ((kline < bline)); then
    setup_row keys "$label" broken \
      "The managed line in hyprland.lua sits before require(\"hypr.bindings\"), so your own bindings overwrite the profile keys. Fixing moves it after." true
    return
  fi

  # Live confirmation, where there is a compositor to ask. Hyprland reports a
  # Lua binding's dispatcher as `__lua` with an opaque index, so what can be
  # confirmed is that a SUPER binding described "Workspace 1" exists, not which
  # command it runs — with no hand-written block in the tree above, this file is
  # the only thing that binds it.
  if ! command -v hyprctl >/dev/null || ! hyprctl binds -j >/dev/null 2>&1; then
    setup_row keys "$label" unknown \
      "The file and the line are in place, but there is no Hyprland session to confirm the keys are bound." false
    return
  fi
  if hyprctl binds -j 2>/dev/null |
     jq -e 'any(.[]; .description == "Workspace 1" and (.modmask % 128) >= 64)' >/dev/null 2>&1; then
    setup_row keys "$label" ok \
      "SUPER+1..0 follow the active profile, from a file this plugin owns." false
  else
    setup_row keys "$label" broken \
      "The managed file is in place but Hyprland has no SUPER+1 workspace binding, so the config did not load. Fixing rewrites the file and reloads." true
  fi
}

# Write the file, place the line, and prove the compositor still loads the
# config afterwards. If new errors appear the line comes straight back out: a
# workspace key is not worth a desktop that will not reload.
keys_fix() {
  mkdir -p "$CONFIG_HOME/hypr" || die "could not create ~/.config/hypr"
  local tmp
  tmp=$(mktemp "$KEYS_FILE.XXXXXX") || die "could not write beside profiles-keys.lua"
  keys_file_content >"$tmp" && mv "$tmp" "$KEYS_FILE" || { rm -f "$tmp"; die "could not write profiles-keys.lua"; }
  echo "wrote ${KEYS_FILE/#$HOME/\~}"

  local baseline=""
  command -v hyprctl >/dev/null &&
    baseline=$(hyprctl configerrors -j 2>/dev/null | jq -c 'map(select(. != ""))' 2>/dev/null)

  local kline bline added=0
  kline=$(keys_line_no); bline=$(bindings_line_no)
  if [[ -n $kline && -n $bline ]] && ((kline < bline)); then
    # Out of order: take the old one out before appending a new one, so the
    # file never ends up with two.
    local t2; t2=$(mktemp "$HYPRLAND_LUA.XXXXXX") || die "could not write beside hyprland.lua"
    grep -vF 'require, "hypr.profiles-keys"' -- "$HYPRLAND_LUA" >"$t2" &&
      mv "$t2" "$HYPRLAND_LUA" || { rm -f "$t2"; die "could not rewrite hyprland.lua"; }
    kline=""
  fi
  if [[ -z $kline ]]; then
    [[ -s $HYPRLAND_LUA ]] || die "no ~/.config/hypr/hyprland.lua to add the line to"
    printf '\n%s\n' "$KEYS_REQUIRE" >>"$HYPRLAND_LUA" || die "could not append to hyprland.lua"
    added=1
    echo "added one line to ${HYPRLAND_LUA/#$HOME/\~}"
  fi

  command -v hyprctl >/dev/null || return 0
  hyprctl reload >/dev/null 2>&1
  local now new
  now=$(hyprctl configerrors -j 2>/dev/null | jq -c 'map(select(. != ""))' 2>/dev/null)
  new=$(jq -nc --argjson a "${baseline:-[]}" --argjson b "${now:-[]}" '$b - $a' 2>/dev/null)
  if [[ -n $new && $new != "[]" ]]; then
    warn "Hyprland reported new config errors, so the line was taken out again:"
    jq -r '.[]' <<<"$new" | while read -r line; do warn "  $line"; done
    if ((added)); then
      local t3; t3=$(mktemp "$HYPRLAND_LUA.XXXXXX")
      grep -vF 'require, "hypr.profiles-keys"' -- "$HYPRLAND_LUA" >"$t3" && mv "$t3" "$HYPRLAND_LUA" || rm -f "$t3"
    fi
    hyprctl reload >/dev/null 2>&1
    return 1
  fi
  return 0
}

# ----------------------------------------------------------- row: indicator
#
# The bar's workspace numbers have to be relabelled per profile, and there is no
# hook for that — the widget has to be replaced. `omarchy plugin clone` makes a
# copy of the stock one under an id derived from the username, which is why the
# id is discovered and never written down: it is kalinewb.workspaces here and
# alice.workspaces on someone else's machine.
STOCK_WORKSPACES="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/bar/widgets/Workspaces.qml"

indicator_id() {
  local dir manifest
  for dir in "$CONFIG_HOME"/omarchy/plugins/*/; do
    manifest="$dir/manifest.json"
    [[ -s $manifest ]] || continue
    jq -e '.omarchy.clonedFrom == "omarchy.workspaces"' "$manifest" >/dev/null 2>&1 || continue
    jq -r '.id // empty' "$manifest"
    return 0
  done
  return 1
}

# This plugin's patched widget, with the clone's own id in it. The id is
# substituted rather than shipped, for the same reason it is discovered.
indicator_content() {
  sed "s|^\( *moduleName: \)\".*\"|\1\"$1\"|" "$PLUGIN_DIR/extras/Workspaces.qml"
}

indicator_enabled() {
  omarchy plugin list --json 2>/dev/null |
    jq -e --arg id "$1" 'any(.[]; .id == $id and (.enabled // false))' >/dev/null 2>&1
}

setup_row_indicator() {
  local label="Workspace indicator"
  local id; id=$(indicator_id)
  if [[ -z $id ]]; then
    setup_row indicator "$label" needs_action \
      "The bar still shows plain workspace numbers, so every profile looks like it is on workspace 1-10. Fixing clones Omarchy's workspace widget and teaches the copy about profiles." true
    return
  fi

  local file="$CONFIG_HOME/omarchy/plugins/$id/Workspaces.qml"
  if [[ ! -s $file ]] || ! grep -q 'ws_offset' "$file"; then
    setup_row indicator "$label" broken \
      "'$id' exists but is not the profile-aware widget. Fixing replaces its Workspaces.qml." true
    return
  fi
  if ! diff -q <(indicator_content "$id") "$file" >/dev/null 2>&1; then
    setup_row indicator "$label" needs_action \
      "'$id' is an older copy of this plugin's workspace widget. Fixing re-syncs it." true
    return
  fi
  if ! indicator_enabled "$id"; then
    setup_row indicator "$label" needs_action \
      "'$id' is installed but switched off, so the bar is showing real workspace numbers. Fixing enables it." true
    return
  fi
  # A clone is a snapshot. If Omarchy's own widget has moved on since this
  # plugin's copy was taken, the copy is behind — and no re-clone can fix that,
  # because re-applying would only put this same copy back.
  if [[ -f $STOCK_WORKSPACES && $STOCK_WORKSPACES -nt $PLUGIN_DIR/extras/Workspaces.qml ]]; then
    setup_row indicator "$label" broken \
      "Omarchy's own workspace widget has changed since this plugin's copy of it was made, so '$id' may be missing what that change added. Updating this plugin is what resolves it." false
    return
  fi
  setup_row indicator "$label" ok \
    "'$id' relabels the bar so every profile reads 1-0, whichever block of workspaces it actually uses." false
}

indicator_fix() {
  local id; id=$(indicator_id)
  if [[ -z $id ]]; then
    command -v omarchy >/dev/null || die "omarchy is not available to clone the widget with"
    omarchy plugin clone omarchy.workspaces >/dev/null 2>&1 || die "could not clone omarchy.workspaces"
    id=$(indicator_id)
    [[ -n $id ]] || die "cloned omarchy.workspaces but could not find the clone"
    echo "cloned the workspace widget as '$id'"
  fi
  local file="$CONFIG_HOME/omarchy/plugins/$id/Workspaces.qml"
  [[ -d ${file%/*} ]] || die "no plugin directory for '$id'"
  local tmp; tmp=$(mktemp "${file%/*}/.Workspaces.XXXXXX") || die "could not write beside $file"
  indicator_content "$id" >"$tmp" && mv "$tmp" "$file" || { rm -f "$tmp"; die "could not write $file"; }
  echo "installed the profile-aware widget into '$id'"
  if ! indicator_enabled "$id"; then
    omarchy plugin enable "$id" >/dev/null 2>&1 || warn "could not enable '$id' — enable it from the bar settings"
  fi
  # Two workspace widgets in one bar is a duplicate, not a fallback.
  if indicator_enabled omarchy.workspaces; then
    omarchy plugin disable omarchy.workspaces >/dev/null 2>&1 ||
      warn "could not disable the stock omarchy.workspaces widget"
  fi
  return 0
}

# -------------------------------------------------------------- row: switch

setup_row_switch() {
  local label="Switching"
  local held=""
  [[ -s $PENDING_OWNER ]] && held=$(cut -f1 "$PENDING_OWNER" | sed "s|^$HOME|~|" | paste -sd', ')

  if [[ -e $JOURNAL ]]; then
    if ! state_lock_free; then
      setup_row switch "$label" unknown "A switch is running right now." false
      return
    fi
    local from to stage
    from=$(journal_field from); to=$(journal_field to); stage=$(journal_field stage)
    setup_row switch "$label" broken \
      "A switch from ${from:-nothing} to ${to:-?} stopped at ${stage:-?} and did not finish. Until it is repaired nothing may be captured, because the desktop and the records disagree about who owns it. Fixing finishes that switch." true
    return
  fi
  if [[ -n $held ]]; then
    setup_row switch "$label" broken \
      "These files could not be moved into their profile's store and are still where they were: $held. Switching is blocked until they are filed. Fixing files them under the profile that owned them." true
    return
  fi
  if ! state_lock_free; then
    setup_row switch "$label" unknown "A switch is running right now." false
    return
  fi
  setup_row switch "$label" ok "No switch is stuck and nothing is waiting to be filed." false
}

# Put a held path away under the profile that owned it when the move failed.
# The line is only removed once the file is safely in the store, so a second
# failure leaves the block in place rather than losing the file.
file_held_paths() {
  [[ -s $PENDING_OWNER ]] || return 0
  local left path owner store
  left=$(mktemp "$PENDING_OWNER.XXXXXX") || return 1
  while IFS=$'\t' read -r path owner; do
    [[ -n $path && -n $owner ]] || continue
    if [[ ! -e $path && ! -L $path ]]; then
      echo "nothing left at ${path/#$HOME/\~} — dropping the block"
      continue
    fi
    if ! exists "$owner"; then
      warn "'${path/#$HOME/\~}' was held for the profile '$owner', which no longer exists — leaving it in place"
      printf '%s\t%s\n' "$path" "$owner" >>"$left"
      continue
    fi
    store=$(store_for "$owner" "$path")
    mkdir -p "$(dirname "$store")"
    rm -rf "$store.prev"
    [[ -e $store ]] && { mv -T "$store" "$store.prev" || { warn "could not move '$owner''s old store aside for ${path/#$HOME/\~}"; printf '%s\t%s\n' "$path" "$owner" >>"$left"; continue; }; }
    if mv -T "$path" "$store"; then
      echo "filed ${path/#$HOME/\~} into $owner"
    else
      [[ -e $store.prev ]] && mv -T "$store.prev" "$store"
      warn "still cannot move ${path/#$HOME/\~} into $owner's store — leaving it in place"
      printf '%s\t%s\n' "$path" "$owner" >>"$left"
    fi
  done <"$PENDING_OWNER"
  if [[ -s $left ]]; then mv "$left" "$PENDING_OWNER"; else rm -f "$left" "$PENDING_OWNER"; fi
  return 0
}

# ---------------------------------------------- row: the Hyprland reload probe

setup_row_hypr_probe() {
  local label="Live Hyprland settings" state
  state=$(hypr_reload_state)
  case $state in
  ok)
    setup_row hypr-reload-probe "$label" ok \
      "Hyprland re-reads a swapped file when it is told to reload, so a profile can have its own look'n'feel, bindings and input settings." false ;;
  broken)
    setup_row hypr-reload-probe "$label" broken \
      "Hyprland did not pick up a swapped file on this machine, so per-profile Hyprland settings are not offered. Everything else works. Fixing measures it again." true ;;
  *)
    if hypr_live; then
      setup_row hypr-reload-probe "$label" needs_action \
        "Whether Hyprland re-reads a swapped file has not been measured on this machine. Fixing tries it: one setting is changed and put straight back, which takes about a second." true
    else
      setup_row hypr-reload-probe "$label" unknown \
        "This can only be answered from inside a Hyprland session, and there is none here." false
    fi ;;
  esac
}

# ------------------------------------------------- rows: helpers and polkit
#
# `omarchy plugin add --enable` clones files and enables the plugin. It installs
# nothing under /usr/local/bin and registers no polkit action, so the two
# privileged pieces this phase depends on are missing on a fresh install. These
# two rows close that gap from the panel, with one dialog between them.

# The script the owner authorises, fixed and embedded here rather than a path
# passed to a shell: what runs as root is this text, whatever else is on disk.
#
# It runs under polkit's generic exec action (auth_admin), because the annotated
# actions it is installing do not exist yet at that point — a real chicken and
# egg, and the reason this one call is not covered by our own policy. What that
# authorisation trusts is the plugin directory: it installs whatever
# bin/omarchy-profile-auth contains at that moment, which is the trust model of
# every install from a user checkout. Hence: only offered when `helpers` is not
# already ok, and later drift is reported as broken rather than reinstalled.
SYSTEM_INSTALL='
set -euo pipefail
umask 022
plugin=${1:?no plugin directory}
for h in omarchy-profile-auth omarchy-profile-passwd; do
  [ -f "$plugin/bin/$h" ] || { echo "missing $plugin/bin/$h" >&2; exit 1; }
  install -o root -g root -m 0755 "$plugin/bin/$h" "/usr/local/bin/$h"
done
policy=$plugin/polkit/no.kalinewb.profiles.policy
[ -f "$policy" ] || { echo "missing $policy" >&2; exit 1; }
install -o root -g root -m 0644 "$policy" /usr/share/polkit-1/actions/no.kalinewb.profiles.policy
rm -f /usr/share/polkit-1/actions/no.kalinewb.profiles.unlock.policy
install -d -o root -g root -m 0711 /var/lib/omarchy-profiles
install -d -o root -g root -m 0711 /var/lib/omarchy-profiles/passwords
install -d -o root -g root -m 0755 /var/lib/omarchy-profiles/identity
install -d -o root -g root -m 0700 /var/lib/omarchy-profiles/attempts
[ -e /var/lib/omarchy-profiles/log ] || : >/var/lib/omarchy-profiles/log
chown root:root /var/lib/omarchy-profiles/log
chmod 0640 /var/lib/omarchy-profiles/log
echo installed
'

system_install() {
  command -v pkexec >/dev/null || die "pkexec is not available, so this cannot be installed"
  [[ -f $PLUGIN_DIR/bin/omarchy-profile-auth && -f $PLUGIN_DIR/bin/omarchy-profile-passwd ]] ||
    die "this copy of the plugin has no helpers in bin/ to install"
  local out rc
  out=$(pkexec /bin/bash -c "$SYSTEM_INSTALL" install-system "$PLUGIN_DIR" 2>&1)
  rc=$?
  if ((rc == 126 || rc == 127)); then
    refuse 2 owner_declined "the install was not authorised — nothing was changed"
  fi
  if ((rc != 0)); then
    [[ -n $out ]] && warn "$out"
    refuse 1 install_failed "the privileged install did not finish"
  fi
  # polkit reads the actions directory itself; nothing to reload. The helper
  # binaries are in place from the moment install(1) returns.
  echo "installed the password helpers and the polkit actions"
}

# 1 missing, 2 wrong owner or mode, 3 content drift.
helper_state() {
  local name=$1 f=/usr/local/bin/$1 src="$PLUGIN_DIR/bin/$1"
  [[ -f $f ]] || return 1
  [[ $(stat -c '%U %G %a' "$f" 2>/dev/null) == "root root 755" ]] || return 2
  [[ -f $src ]] || return 0
  cmp -s "$f" "$src" || return 3
  return 0
}

# The store's modes are what make hasPassword computable without privilege
# while a hash stays unreadable, so a wrong mode is not cosmetic.
root_store_state() {
  [[ -d $ROOT_STORE ]] || return 1
  local want
  for want in "$ROOT_STORE 711" "$ROOT_STORE/passwords 711" "$ROOT_STORE/identity 755" "$ROOT_STORE/attempts 700"; do
    local dir=${want% *} mode=${want#* }
    [[ -d $dir ]] || return 1
    [[ $(stat -c '%U %a' "$dir" 2>/dev/null) == "root $mode" ]] || return 2
  done
  return 0
}

setup_row_helpers() {
  local label="Password helpers" a p store
  helper_state omarchy-profile-auth; a=$?
  helper_state omarchy-profile-passwd; p=$?
  root_store_state; store=$?

  if ((a == 1 && p == 1 && store == 1)); then
    setup_row helpers "$label" needs_action \
      "Protecting a profile with a password needs two small programs installed outside your home directory, and a root-owned place to keep the password hashes. Nothing here can be read by a program running as you — that is the point of it. Fixing asks for your password once and installs both." true
    return
  fi
  if ((a == 0 && p == 0 && store == 0)); then
    setup_row helpers "$label" ok \
      "Both helpers are installed and match this copy of the plugin, and the password store has the permissions it should." false
    return
  fi
  local why=""
  ((a == 1 || p == 1)) && why="one of the two helpers is missing"
  ((a == 2 || p == 2)) && why="a helper is installed with the wrong owner or permissions"
  ((a == 3 || p == 3)) && why="an installed helper no longer matches this copy of the plugin"
  ((store == 1)) && why="${why:+$why, and }the password store is missing"
  ((store == 2)) && why="${why:+$why, and }the password store has the wrong permissions"
  setup_row helpers "$label" broken \
    "Passwords cannot be checked as things stand: $why. Fixing reinstalls both helpers and the store from this copy of the plugin." true
}

# Does a face answer the OWNER prompt on this machine? 0 yes, 1 no, 2 cannot tell.
face_answers_polkit() {
  [[ -r /etc/pam.d/polkit-1 ]] || return 2
  grep -q 'omarchy-face-verify' /etc/pam.d/polkit-1 2>/dev/null || return 1
  local fc=/etc/omarchy-face/config
  if [[ -e $fc ]]; then
    [[ -r $fc ]] || return 2
    # The gate honours this key; an absent file means its default, which is on.
    grep -Eq '^[[:space:]]*polkit[[:space:]]*=[[:space:]]*(false|no|0)' "$fc" && return 1
  fi
  return 0
}

policy_annotated() {
  command -v pkaction >/dev/null || return 2
  pkaction --action-id no.kalinewb.profiles.auth --verbose 2>/dev/null |
    grep -q 'exec.path.*omarchy-profile-auth' || return 1
  pkaction --action-id no.kalinewb.profiles.owner --verbose 2>/dev/null |
    grep -q 'exec.path.*omarchy-profile-passwd' || return 1
  return 0
}

legacy_action_present() {
  [[ -e $POLICY_LEGACY ]] && return 0
  command -v pkaction >/dev/null || return 1
  pkaction 2>/dev/null | grep -qx 'no.kalinewb.profiles.unlock'
}

# Only ever run after the annotation has been seen, so a status query can never
# be the thing that pops an admin dialog. Any of needs_password, no_password,
# rate_limited or busy proves the helper ran without prompting.
polkit_probe() {
  [[ -x $HELPER_AUTH ]] || return 1
  local out err
  out=$(printf '' | timeout 15 pkexec "$HELPER_AUTH" verify "$(cfg .master)" 2>/dev/null)
  err=$(jq -r '.error // ""' <<<"$out" 2>/dev/null) || err=""
  case $err in
  needs_password | no_password | rate_limited | busy) return 0 ;;
  esac
  return 1
}

setup_row_polkit() {
  local label="Password permissions"

  if [[ ! -e $POLICY_DEST ]]; then
    setup_row polkit "$label" needs_action \
      "The rules that say who may check a profile password are not registered yet. Fixing installs them together with the helpers — one password prompt for both." true
    return
  fi
  if ! cmp -s "$POLICY_SRC" "$POLICY_DEST"; then
    setup_row polkit "$label" broken \
      "The registered rules are not the ones this copy of the plugin ships. Fixing installs the current ones." true
    return
  fi
  if legacy_action_present; then
    setup_row polkit "$label" broken \
      "An old 'enter a locked profile' rule from before per-profile passwords is still registered. It gates nothing now and should not be left behind. Fixing removes it." true
    return
  fi
  policy_annotated
  local ann=$?
  if ((ann == 2)); then
    setup_row polkit "$label" unknown "pkaction is not available, so what polkit has registered cannot be read." false
    return
  fi
  if ((ann == 1)); then
    setup_row polkit "$label" broken \
      "The rules are registered without the annotation that ties them to the helpers, so checking a profile password would ask for the machine password instead. Fixing reinstalls them." true
    return
  fi
  if ! polkit_probe; then
    setup_row polkit "$label" broken \
      "The password checker did not answer when it was asked. Fixing reinstalls the helpers and the rules." true
    return
  fi

  face_answers_polkit
  local face=$?
  if ((face == 2)); then
    setup_row polkit "$label" unknown \
      "Face Unlock's configuration could not be read, so whether a face can answer the owner's prompt is not something this can say." false
    return
  fi
  if ((face == 0)); then
    # Reported, not fixed: Profiles does not rewire another plugin's PAM stack.
    setup_row polkit "$label" needs_action \
      "Face unlock answers the owner's prompt, so any program you run can reset a profile password or rebind a face while you are in front of the camera. Turn face off for polkit in Face Unlock. Everything else about passwords is set up correctly." false
    return
  fi
  setup_row polkit "$label" ok \
    "Checking a profile's password asks nobody else, and managing one asks you." false
}

# ------------------------------------------------------- rows: locks, hashes

setup_row_locks() {
  local label="Profile locks" migrating="" legacy="" n
  while read -r n; do
    [[ -n $n ]] || continue
    if ! has_password "$n" && profile_locked "$n"; then migrating="$migrating $n"; fi
    if jq -e 'has("identity")' "$(file_for "$n")" >/dev/null 2>&1; then legacy="$legacy $n"; fi
  done < <(profile_names)

  if [[ -z $migrating && -z $legacy ]]; then
    setup_row locks "$label" ok "Every profile that asks for something has a password to ask for." false
    return
  fi
  local detail=""
  [[ -n $migrating ]] &&
    detail="Locked without a password of their own:${migrating}. They were locked under the old model, so they ask for the machine owner every time — and a lock with no password is the one thing a settings edit can still switch off. Set a password on each from its Manage row."
  [[ -n $legacy ]] &&
    detail="${detail:+$detail } A face was bound to${legacy} in a file you can edit, which is exactly what the new binding exists to prevent, so it is ignored and removed. Bind the face again from the profile's Manage row and it will be kept where only the owner can change it."
  setup_row locks "$label" needs_action "$detail" false
}

# Every name the root store might hold something under.
#
# passwords/ is deliberately not listable without root — the modes are what make
# `hasPassword` answerable while a hash stays unreadable — so the names have to
# come from everywhere else that remembers one: identity/ (which is 0755 and
# does list), every profile, every store, every session record, and the hint
# file this engine writes when it gives a password out. A name is a candidate,
# never a fact: everything below checks it against the store itself.
root_name_hints() {
  {
    profile_names
    [[ -d $ROOT_STORE/identity ]] && find "$ROOT_STORE/identity" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null
    [[ -d $ISOLATE_DIR ]] && find "$ISOLATE_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null
    [[ -d $STATE_DIR/sessions ]] && find "$STATE_DIR/sessions" -maxdepth 1 -name '*.txt' -printf '%f\n' 2>/dev/null | sed 's/\.txt$//'
    [[ -s $PASSWORD_NAMES ]] && cat "$PASSWORD_NAMES"
    # And if the store ever IS listable, believe it over the hint.
    [[ -d $ROOT_STORE/passwords ]] && find "$ROOT_STORE/passwords" -maxdepth 1 -type f -printf '%f\n' 2>/dev/null
  } | sort -u | while read -r n; do
    [[ -n $n ]] || continue
    [[ $n =~ ^[a-zA-Z0-9_-]{1,64}$ ]] || continue
    printf '%s\n' "$n"
  done
}

# Root files whose profile is gone.
#
# A hash under a name nothing else remembers is invisible until somebody tries
# to create that profile again, which is refused with `stale_password` and
# points here.
stale_root_names() {
  root_name_hints | while read -r n; do
    exists "$n" && continue
    if has_password "$n" || [[ -e $ROOT_STORE/identity/$n ]]; then printf '%s\n' "$n"; fi
  done
}

setup_row_stale_hashes() {
  local label="Leftover passwords" names
  if [[ ! -d $ROOT_STORE ]]; then
    setup_row stale-hashes "$label" ok "There is no password store yet, so there is nothing left over in it." false
    return
  fi
  names=$(stale_root_names | paste -sd', ')
  if [[ -z $names ]]; then
    setup_row stale-hashes "$label" ok "Every stored password belongs to a profile that still exists." false
    return
  fi
  setup_row stale-hashes "$label" needs_action \
    "A password or a face binding is still stored for profiles that no longer exist: $names. Nothing can use them, and they stop a new profile being created under the same name. Fixing asks for your password and deletes them." true
}

# ------------------------------------------------------------ status and fix

setup_status() {
  SETUP_ROWS=()
  setup_row_adopt
  setup_row_apps
  setup_row_keys
  setup_row_indicator
  setup_row_switch
  setup_row_hypr_probe
  setup_row_helpers
  setup_row_polkit
  setup_row_locks
  setup_row_stale_hashes

  if [[ -n $JSON ]]; then
    printf '%s\n' "${SETUP_ROWS[@]}" | jq -sc .
    return 0
  fi
  local row
  for row in "${SETUP_ROWS[@]}"; do
    printf '%-10s %-12s %s\n' "$(jq -r .id <<<"$row")" "$(jq -r .state <<<"$row")" "$(jq -r .detail <<<"$row")"
  done
}

cmd_setup() {
  local verb=${1:-status} id=${2:-} a
  for a in "$@"; do [[ $a == --json ]] && JSON=1; done
  [[ $id == --json ]] && id=""

  case $verb in
  status) setup_status ;;
  fix)
    [[ -n $id ]] || die "usage: omarchy-profile setup fix <adopt|apps|keys|indicator|switch|hypr-reload-probe|helpers|polkit|stale-hashes>"
    # Every fix takes the state lock: each of them writes something a switch
    # also writes.
    lock_or_busy
    case $id in
    adopt) cmd_init ;;
    apps)
      local cur; cur=$(current_profile)
      [[ -n $cur ]] && exists "$cur" || die "no active profile to apply"
      # Broken means our tags no longer describe what is on disk, and the only
      # honest way back is to put every application in the menu again and
      # rebuild this profile's view of it from nothing.
      local broken=0 tag id2
      while IFS=$'\t' read -r id2 tag; do
        [[ $tag == modified ]] || continue
        [[ -s $APP_BACKUP_DIR/$id2.desktop ]] || broken=1
      done < <(app_sources | awk -F'\t' '$8 != "" { print $1 "\t" $8 }')
      # Only a genuine mismatch (1) sweeps; undeterminable (2) is not a reason
      # to take every application out of the menu and put it back.
      apps_rules_match
      [[ $? == 1 ]] && broken=1
      if ((broken)); then
        apps_sweep
        unset APP_SOURCES_CACHE
      fi
      apply_app_visibility "$cur"
      echo "applied '$cur''s applications" ;;
    keys) keys_fix || exit 1 ;;
    indicator)
      # Cloning or enabling the indicator widget ends in omarchy-shell's own
      # rescanPlugins (or an equivalent reload for enable/disable), which
      # reloads every panel in the shell — this one included, the same way
      # finishing an interrupted switch does (below). Detached, the actual
      # clone/patch/enable/disable survives that reload instead of dying
      # with the ask() call that started it; the row picks up the real
      # result on the next status poll rather than this call reporting it
      # directly, so a "did it work" from the GUI could still be wrong for
      # the few hundred ms the reload takes.
      echo "working on the workspace indicator"
      detach indicator_fix ;;
    switch)
      # Filing a held path leaves it absent at the path, so the active profile's
      # own copy can be linked in afterwards — seeding a tier-3 one if that
      # profile never had it. Same call a switch makes, with both sides the
      # current profile.
      local had_held=0
      [[ -s $PENDING_OWNER ]] && had_held=1
      file_held_paths
      if ((had_held)) && [[ ! -s $PENDING_OWNER ]]; then
        local held_cur; held_cur=$(current_profile)
        [[ -n $held_cur ]] && swap_isolated "$held_cur" "$held_cur"
      fi
      if [[ -e $JOURNAL ]]; then
        # Finishing a switch restarts the shell, which kills whoever asked for
        # the repair — the panel most of all. So the repair detaches exactly
        # like a switch does, and the row reads "a switch is running right now"
        # until it is done.
        local to; to=$(journal_field to)
        answer "$(jq -nc --arg n "$to" '{ok: true, switching: $n}')" "finishing the interrupted switch to $to"
        detach recover_switch
        exit 0
      fi
      echo "nothing to repair" ;;
    # One call, one dialog, both rows: the helpers and the actions that make
    # them reachable are installed together or not at all.
    helpers | polkit) system_install ;;
    hypr-reload-probe)
      local probed; probed=$(hypr_reload_probe) || exit 1
      case $probed in
      ok) echo "Hyprland re-read the swapped file — per-profile Hyprland settings work here" ;;
      broken) echo "Hyprland did not pick up the swapped file — per-profile Hyprland settings are not offered" ;;
      *) echo "could not measure it" ;;
      esac ;;
    stale-hashes)
      local stale n=0
      stale=$(stale_root_names)
      [[ -n $stale ]] || { echo "nothing left over"; return 0; }
      while read -r name; do
        [[ -n $name ]] || continue
        # Deleting root-owned files is the owner's to authorise, and only ever
        # for a name that has no profile of its own.
        exists "$name" && continue
        HELPER_STDIN=""
        helper_or_refuse owner remove "$name"
        echo "cleared the leftover password for '$name'"
        n=$((n + 1))
      done <<<"$stale"
      echo "cleared $n leftover record(s)" ;;
    locks) die "each profile's lock is set from its own Manage row — Setup cannot choose a password for you" ;;
    *) die "unknown setup row '$id'" ;;
    esac ;;
  *) die "usage: omarchy-profile setup [status|fix <id>]" ;;
  esac
}

# ------------------------------------------------------------------- purge
#
# Taking this plugin off the machine, and handing the desktop back.
#
# Three invocations, and only one of them removes anything:
#
#   purge --dry-run --json   the manifest the confirmation lists. Writes nothing,
#                            does not require master, and answers on a machine
#                            where half of this was never installed.
#   purge --export <dir>     copies every store, every kept copy, the held paths,
#                            the session records and the profile JSONs into <dir>
#                            and exits. Also not a purge.
#   purge --yes              the real thing, in the order §9.2 fixes.
#
# The order is not a preference. Windows move before the keys that reach them
# are deleted, the isolated paths are un-isolated before the directory their
# stores live in is removed, and the applications are put back before the
# backups they are put back from go. Each of those, done the other way round,
# leaves something the user cannot recover without knowing what this plugin did.

PURGE_PLUGIN_ID="kalinewb.profiles"

# This copy of the plugin's own id, from its manifest — the same lookup the
# indicator uses for the clone, and for the same reason: an id written down in
# two places is an id that will disagree with itself.
purge_plugin_id() {
  local id=""
  [[ -s $PLUGIN_DIR/manifest.json ]] && id=$(jq -r '.id // empty' "$PLUGIN_DIR/manifest.json" 2>/dev/null)
  printf '%s\n' "${id:-$PURGE_PLUGIN_ID}"
}

# ~/.config/hypr/looknfeel.lua from .config%hypr%looknfeel.lua. The inverse of
# store_key, and it carries the same assumption: a path with a literal % in it
# was never storable in the first place.
store_path_from_key() { printf '~/%s\n' "$(printf '%s' "$1" | tr '%' '/')"; }

# Which tier a store belongs to, from the isolate table rather than from the
# path: `hypr` means the compositor has to be told, which is the whole of what
# makes tier 3 different. A store for a path nothing isolates any more is tier 2
# — it is data, and it is still about to be deleted.
purge_tier_for() {
  local path=${1/#\~/$HOME} p r
  while IFS=$'\t' read -r p r; do
    [[ $p == "$path" ]] || continue
    [[ $r == hypr ]] && { echo 3; return 0; }
    echo 2; return 0
  done < <(isolated_rows)
  echo 2
}

# Every profile's block, as JSON. One call, so the window count and the
# migration agree about who owns what.
purge_blocks_json() {
  local master=$1 n off span m
  while read -r n; do
    [[ -n $n ]] || continue
    read -r off span < <(profile_block "$n")
    m=false; [[ $n == "$master" ]] && m=true
    jq -nc --arg n "$n" --argjson o "$off" --argjson s "$span" --argjson m "$m" \
      '{name: $n, offset: $o, span: $s, master: $m}'
  done < <(profile_names) | jq -sc .
}

# Windows a purge would move: everything in a non-master block, plus anything
# above workspace 10 that no profile's block covers at all. The second set is
# the one that matters — with the managed keys gone, SUPER+1..0 reach 1-10 and
# nothing else, so a window left above that is reachable by mouse scroll only.
purge_window_count() {
  local blocks=$1
  command -v hyprctl >/dev/null || { echo 0; return 0; }
  local n
  n=$(hyprctl -j clients 2>/dev/null | jq --argjson b "$blocks" '
    [ .[] | .workspace.id as $w
      | select( ($b | any(.master == false and $w > .offset and $w <= (.offset + .span)))
                or ($w > 10 and (($b | any($w > .offset and $w <= (.offset + .span))) | not)) ) ]
    | length' 2>/dev/null)
  [[ $n =~ ^[0-9]+$ ]] || n=0
  echo "$n"
}

# Every store this plugin holds, with what is beside it. `.prev` is the previous
# copy a swap rotated out and `.broken.<epoch>` is what a tier-3 rollback kept —
# both are the user's own configuration, and both are listed by name so that
# "export first" means something.
purge_stores_json() {
  local dir name f base key path tier bytes extra
  {
    for dir in "$ISOLATE_DIR"/*/; do
      [[ -d $dir ]] || continue
      name=$(basename "$dir")
      # find, not a glob: a store key is the path with its slashes turned into
      # percent signs, so ~/.config/... becomes `.config%...` and every single
      # one of them starts with a dot. A `*` glob lists none of them.
      while IFS= read -r f; do
        [[ -e $f || -L $f ]] || continue
        base=$(basename "$f")
        [[ $base == *.prev || $base == *.broken.* ]] && continue
        key=$base
        path=$(store_path_from_key "$key")
        tier=$(purge_tier_for "$path")
        bytes=$(du -sb -- "$f" 2>/dev/null | cut -f1)
        [[ $bytes =~ ^[0-9]+$ ]] || bytes=0
        extra=$({
          [[ -e $f.prev || -L $f.prev ]] && echo ".prev"
          local b
          for b in "$f".broken.*; do [[ -e $b ]] && echo "${b##*"/$key"}"; done
        } | jq -Rsc 'split("\n") | map(select(length > 0))')
        jq -nc --arg p "$name" --arg path "$path" --argjson t "$tier" \
               --argjson b "$bytes" --argjson x "${extra:-[]}" \
          '{profile: $p, path: $path, tier: $t, bytes: $b, extra: $x}'
      done < <(find "$dir" -mindepth 1 -maxdepth 1 2>/dev/null | sort)
    done
  } | jq -sc .
}

# Files a swap could not file under anybody and moved aside rather than unlink.
purge_orphaned_json() {
  [[ -d $ISOLATE_DIR/.orphaned ]] || { echo '[]'; return 0; }
  find "$ISOLATE_DIR/.orphaned" -mindepth 2 -maxdepth 2 2>/dev/null |
    sed "s|^$HOME|~|" | sort | jq -Rsc 'split("\n") | map(select(length > 0))'
}

# The applications this plugin is currently hiding, by which tag they carry —
# and how many of those the user (or the app's own updater) has edited since,
# which is the set `apps-sweep` cannot simply put the backup back over.
purge_apps_json() {
  local hidden=0 modified=0 edited=0 id tag path live want
  while IFS=$'\t' read -r id tag path; do
    [[ -n $id ]] || continue
    case $tag in
    hidden) hidden=$((hidden + 1)) ;;
    modified)
      modified=$((modified + 1))
      want=""
      [[ -f $APP_BACKUP_DIR/$id.sha256 ]] && want=$(<"$APP_BACKUP_DIR/$id.sha256")
      live=$(sha256sum <"$path" 2>/dev/null | awk '{ print $1 }')
      [[ -n $want && -n $live && $live == "$want" ]] || edited=$((edited + 1)) ;;
    esac
  done < <(app_sources | awk -F'\t' '$8 != "" { print $1 "\t" $8 "\t" $9 }' | sort -u)
  jq -nc --argjson h "$hidden" --argjson m "$modified" --argjson e "$edited" \
    '{hidden: $h, modified: $m, edited_while_hidden: $e}'
}

# The managed keys file, and any block of the user's own that calls this engine.
# The second is reported and never touched: it is in their configuration, and
# after a purge it points at a script that is gone.
purge_keys_json() {
  local managed=false
  [[ -s $KEYS_FILE ]] && managed=true
  local hand
  hand=$(keys_handwritten | awk -F: '
    { f = $1; l = $2; if (!(f in first)) { first[f] = l; order[++n] = f } last[f] = l }
    END { for (i = 1; i <= n; i++) {
            f = order[i]
            printf "%s:%s%s\n", f, first[f], (last[f] != first[f] ? "-" last[f] : "")
          } }' | sed "s|^$HOME|~|")
  jq -nc --argjson m "$managed" \
     --argjson h "$(printf '%s' "$hand" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    '{managed_file: $m, hand_written: $h}'
}

# What is in the root store, counted the only way an unprivileged process can.
#
# passwords/ is 0711: a name can be tested with -e, but the directory cannot be
# listed. So the names come from root_name_hints() — the same enumerator the
# `stale-hashes` row solved this with — and each is tested against the store.
# identity/ is 0755 and lists for itself, so it is counted directly and its
# names are folded into the hint list by that function.
purge_root_json() {
  local helpers=false policy=false passwords=0 identities=0 n
  [[ -e $HELPER_AUTH || -e $HELPER_PASSWD ]] && helpers=true
  [[ -e $POLICY_DEST || -e $POLICY_LEGACY ]] && policy=true
  while read -r n; do
    [[ -n $n ]] || continue
    has_password "$n" && passwords=$((passwords + 1))
  done < <(root_name_hints)
  [[ -d $ROOT_STORE/identity ]] &&
    identities=$(find "$ROOT_STORE/identity" -maxdepth 1 -type f 2>/dev/null | wc -l)
  jq -nc --argjson h "$helpers" --argjson p "$policy" \
         --argjson pw "$passwords" --argjson id "${identities:-0}" \
    '{helpers: $h, policy: $p, passwords: $pw, identities: $id}'
}

# Everything the confirmation lists, in one document (plan-engine.md §9.1).
# Reads and counts; writes nothing at all, so it is safe to ask on a machine
# nobody has decided anything about yet.
purge_manifest() {
  local master blocks sessions=0
  master=$(cfg .master)
  blocks=$(purge_blocks_json "$master")
  [[ -d $SESSION_DIR ]] &&
    sessions=$(find "$SESSION_DIR" -maxdepth 1 -name '*.txt' 2>/dev/null | wc -l)
  local held='[]'
  [[ -s $PENDING_OWNER ]] &&
    held=$(cut -f1 "$PENDING_OWNER" | sed "s|^$HOME|~|" | jq -Rsc 'split("\n") | map(select(length > 0))')

  jq -nc \
    --argjson w "$(purge_window_count "$blocks")" \
    --argjson s "$(purge_stores_json)" \
    --argjson o "$(purge_orphaned_json)" \
    --argjson h "$held" \
    --argjson a "$(purge_apps_json)" \
    --argjson k "$(purge_keys_json)" \
    --arg i "$(indicator_id)" \
    --argjson r "$(purge_root_json)" \
    --argjson n "${sessions:-0}" \
    --arg m "$master" \
    --arg c "$(current_profile)" \
    '{windows_to_move: $w, stores: $s, orphaned: $o, pending_owner: $h,
      apps: $a, keys: $k, indicator: $i, root: $r, sessions: $n,
      master: $m, current: $c}'
}

# Copy, never move, and exit before anything is removed.
#
# The export exists because a store is the only copy of a per-profile
# configuration that exists anywhere: nothing else on the machine has work's
# looknfeel.lua. It is a separate invocation rather than a step of `--yes`
# precisely so that it has to succeed, visibly, before Remove is offered.
purge_export() {
  local dir=${1:-}
  [[ -n $dir ]] || refuse 1 no_directory "usage: omarchy-profile purge --export <directory>"
  dir=${dir/#\~/$HOME}
  [[ -e $dir && ! -d $dir ]] && refuse 1 not_a_directory "'$dir' exists and is not a directory"
  mkdir -p "$dir" || refuse 1 export_failed "could not create $dir"

  local files=0 name src path dest
  purge_manifest >"$dir/manifest.json" || refuse 1 export_failed "could not write the manifest"

  # The profiles themselves, and the machine-wide settings they are read with.
  mkdir -p "$dir/profiles"
  while read -r name; do
    [[ -n $name ]] || continue
    cp -p -- "$(file_for "$name")" "$dir/profiles/$name.json" && files=$((files + 1))
  done < <(profile_names)
  [[ -s $CONFIG_FILE ]] && cp -p -- "$CONFIG_FILE" "$dir/profiles/config.json"

  # Every store, with its .prev and its .broken.<epoch> copies — the whole
  # directory, because everything in it is the user's.
  if [[ -d $ISOLATE_DIR ]]; then
    for src in "$ISOLATE_DIR"/*/; do
      [[ -d $src ]] || continue
      name=$(basename "$src")
      mkdir -p "$dir/stores/$name"
      cp -a -- "$src". "$dir/stores/$name/" 2>/dev/null &&
        files=$((files + $(find "$dir/stores/$name" -mindepth 1 2>/dev/null | wc -l)))
    done
    [[ -d $ISOLATE_DIR/.orphaned ]] && {
      mkdir -p "$dir/orphaned"
      cp -a -- "$ISOLATE_DIR/.orphaned/." "$dir/orphaned/" 2>/dev/null
    }
  fi

  # Held paths are still at the path, not in a store — and they are exactly the
  # files a failed rotation could not file, so they are the last thing to lose.
  if [[ -s $PENDING_OWNER ]]; then
    mkdir -p "$dir/held"
    while IFS=$'\t' read -r path _; do
      [[ -n $path && -e $path ]] || continue
      cp -a -- "$path" "$dir/held/$(store_key "$path")" && files=$((files + 1))
    done <"$PENDING_OWNER"
  fi

  if [[ -d $SESSION_DIR ]]; then
    mkdir -p "$dir/sessions"
    for src in "$SESSION_DIR"/*.txt; do
      [[ -f $src ]] || continue
      cp -p -- "$src" "$dir/sessions/" && files=$((files + 1))
    done
  fi
  [[ -s $HYPR_ERRORS ]] && cp -p -- "$HYPR_ERRORS" "$dir/"

  local bytes; bytes=$(du -sb -- "$dir" 2>/dev/null | cut -f1)
  [[ $bytes =~ ^[0-9]+$ ]] || bytes=0
  answer "$(jq -nc --arg d "$dir" --argjson f "$files" --argjson b "$bytes" \
             '{ok: true, dir: $d, files: $f, bytes: $b}')" \
         "exported $files file(s) to ${dir/#$HOME/\~}"
  return 0
}

# Step 1, the second half: windows above 10 that no profile's block covers.
# They belong to nobody, and after step 5 no key reaches them, so master's
# workspace 10 is where they go.
purge_move_strays() {
  local blocks=$1 to=$2 n=0 addr ws
  command -v hyprctl >/dev/null || { echo 0; return 0; }
  while read -r addr ws; do
    [[ -n $addr ]] || continue
    hl_move_window "$((to + 10))" "$addr" false || warn "could not move window $addr off workspace $ws"
    n=$((n + 1))
  done < <(hyprctl -j clients 2>/dev/null | jq -r --argjson b "$blocks" '
    .[] | .workspace.id as $w
        | select($w > 10 and (($b | any($w > .offset and $w <= (.offset + .span))) | not))
        | "\(.address) \(.workspace.id)"')
  echo "$n"
}

# Step 3. Put every isolated path back as a real file, from MASTER's store.
#
# Master, because the machine keeps master's desk: it is the profile that saw
# everything, and its `disabledPlugins` are the user's own choices rather than
# some other profile's. A path where a real file has appeared is left alone —
# this never overwrites one, exactly as a swap never does — and a tier-3 path
# master has no store for gets the packaged file, because hyprland.lua requires
# it without pcall and an absent one takes autostart and the keys with it.
purge_unisolate() {
  local master=$1 path reload store restored=0 touched=0 baseline='[]'
  if has_tier3 && hypr_live; then baseline=$(hypr_config_errors); fi

  while IFS=$'\t' read -r path reload; do
    [[ -n $path ]] || continue
    is_blocklisted "$path" && continue

    # Ours, and pointing into a directory that is about to stop existing.
    if [[ -L $path && $(readlink "$path") == "$ISOLATE_DIR"/* ]]; then
      rm -f "$path"
      touched=1
    fi

    if [[ $reload == hypr ]]; then
      # §5.3a rule 4, through the same function a switch seeds with.
      seed_tier3 "$master" "$path" || true
      refresh_if_packaged "$master" "$path" >/dev/null
    fi

    store=$(store_for "$master" "$path")
    if [[ -e $path || -L $path ]]; then
      warn "left ${path/#$HOME/\~} as it is — something is already there"
      continue
    fi
    [[ -e $store || -L $store ]] || continue
    mkdir -p "$(dirname "$path")"
    if mv -T "$store" "$path"; then
      restored=$((restored + 1))
      touched=1
    else
      warn "could not put ${path/#$HOME/\~} back from $master's copy"
    fi
  done < <(isolated_rows)

  # One reload for the lot, and the errors are reported rather than rolled back:
  # there is nothing left to roll back to, and the files now at those paths are
  # master's own — the ones that were live before any of this was installed.
  if ((touched)) && hypr_live; then
    hyprctl reload >/dev/null 2>&1
    local now new
    now=$(hypr_config_errors)
    new=$(jq -nc --argjson a "$now" --argjson b "$baseline" '$a - $b' 2>/dev/null) || new='[]'
    if [[ -n $new && $new != "[]" ]]; then
      warn "Hyprland reported config errors after putting your files back:"
      jq -r '.[]' <<<"$new" | while read -r line; do warn "  $line"; done
    fi
  fi
  echo "$restored"
}

# Step 5. The managed file and the one line that requires it.
#
# Same discipline as the row that writes them: a temp file beside the original
# and a rename, then a reload, so hyprland.lua is never half a file — it is the
# loader every other Hyprland file comes from.
purge_keys() {
  local removed=none
  if [[ -s $HYPRLAND_LUA ]] && [[ -n $(keys_line_no) ]]; then
    local tmp; tmp=$(mktemp "$HYPRLAND_LUA.XXXXXX") || { warn "could not write beside hyprland.lua"; echo partial; return 0; }
    if grep -vF 'require, "hypr.profiles-keys"' -- "$HYPRLAND_LUA" >"$tmp" && mv "$tmp" "$HYPRLAND_LUA"; then
      removed=removed
    else
      rm -f "$tmp"
      warn "could not take the managed line out of ${HYPRLAND_LUA/#$HOME/\~} — remove it by hand"
      echo partial
      return 0
    fi
  fi
  if [[ -e $KEYS_FILE ]]; then
    rm -f "$KEYS_FILE" && removed=removed
  fi
  [[ $removed == removed ]] && hypr_live && hyprctl reload >/dev/null 2>&1
  echo "$removed"
}

cmd_purge() {
  local mode="" dir="" keep_indicator="" want_dir="" a
  for a in "$@"; do
    case $a in
    --json) JSON=1 ;;
    --dry-run) mode=dry ;;
    --yes) mode=yes ;;
    --export) mode="export"; want_dir=1 ;;
    --keep-indicator) keep_indicator=1 ;;
    -*) die "unknown option '$a'" ;;
    *) [[ -n $want_dir && -z $dir ]] && dir=$a ;;
    esac
  done

  case $mode in
  dry)
    # Never the state lock, and never a refusal: this is a status query about
    # what would happen, asked from a panel that has to render an answer even
    # while something else is running.
    purge_manifest
    return 0 ;;
  export)
    # Under the lock, because a switch moves stores between directories and an
    # export taken across one is a copy of neither side.
    lock_or_busy
    purge_export "$dir"
    return $? ;;
  yes) ;;
  *) die "usage: omarchy-profile purge [--dry-run --json | --export <dir> | --yes]" ;;
  esac

  # ------------------------------------------------------------------ step 0
  lock_or_busy
  # A switch that died is finished forward first: half of one is a machine
  # whose live files and records name two different profiles, and every step
  # below reads one of those two answers.
  [[ -e $JOURNAL ]] && recover_switch

  local master cur
  master=$(cfg .master)
  cur=$(current_profile)
  if [[ $cur != "$master" ]]; then
    refuse 1 not_master \
      "purge puts the machine back as ${master:-the master profile} — switch to it first" \
      "$(jq -nc --arg m "$master" --arg c "$cur" '{master: $m, current: $c}')"
  fi

  local blocks; blocks=$(purge_blocks_json "$master")
  local master_offset
  read -r master_offset _ < <(profile_block "$master")

  # ------------------------------------------------------------------ step 1
  #
  # Before the keys go, never after: without profiles-keys.lua SUPER+1..0
  # address 1-10 and nothing else, so a window left on 27 is reachable by mouse
  # scroll alone.
  local moved=0 n name off span
  while read -r name; do
    [[ -n $name && $name != "$master" ]] || continue
    read -r off span < <(profile_block "$name")
    n=$(migrate_block_windows "$off" "$span" "$master_offset")
    moved=$((moved + n))
  done < <(profile_names)
  n=$(purge_move_strays "$blocks" "$master_offset")
  moved=$((moved + n))
  ((moved)) && echo "moved $moved window(s) into $master's workspaces" >&2

  # ------------------------------------------------------------------ step 3
  local restored; restored=$(purge_unisolate "$master")

  # ------------------------------------------------------------------ step 4
  #
  # Before the state directory goes: a -Modified entry's backup lives in it, and
  # deleting that first leaves the user's own launcher entries hidden with
  # nothing to put back.
  local apps_note; apps_note=$(apps_sweep)
  [[ -n $apps_note ]] && echo "$apps_note" >&2

  # ------------------------------------------------------------------ step 5
  local keys; keys=$(purge_keys)

  # ------------------------------------------------------------------ step 6
  local indicator=absent id
  id=$(indicator_id)
  if [[ -n $id ]]; then
    if [[ -n $keep_indicator ]]; then
      indicator=kept
    elif command -v omarchy >/dev/null; then
      if omarchy plugin remove "$id" --yes >/dev/null 2>&1; then
        indicator=removed
        omarchy plugin enable omarchy.workspaces >/dev/null 2>&1 ||
          warn "could not switch Omarchy's own workspace widget back on"
      else
        indicator=failed
        warn "could not remove the cloned workspace widget '$id' — remove it from the bar settings"
      fi
    else
      indicator=failed
    fi
  fi

  # ------------------------------------------------------------------ step 7
  #
  # After everything unprivileged, so a declined owner prompt cannot leave the
  # rest undone — and never fatal: the answer is the exact commands to finish it
  # with, and the purge carries on.
  local root=absent commands='[]'
  local root_cmds=(
    "rm -f $HELPER_AUTH $HELPER_PASSWD"
    "rm -f $POLICY_DEST $POLICY_LEGACY"
    "rm -rf $ROOT_STORE"
  )
  if [[ -e $HELPER_AUTH || -e $HELPER_PASSWD || -e $POLICY_DEST || -e $POLICY_LEGACY || -d $ROOT_STORE ]]; then
    root=incomplete
    if [[ -x $HELPER_PASSWD ]] && command -v pkexec >/dev/null; then
      HELPER_STDIN=""
      if helper_call owner purge; then root=removed; fi
      clear_secrets
    fi
    if [[ $root != removed ]]; then
      commands=$(printf '%s\n' "${root_cmds[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')
      warn "the root-owned half was not removed. As root:"
      local c; for c in "${root_cmds[@]}"; do warn "  $c"; done
    fi
  fi

  # ------------------------------------------------------------------ step 8
  rm -rf "${PROFILE_DIR:?}" "${STATE_DIR:?}" "${RUNTIME_DIR:?}" 2>/dev/null

  # ------------------------------------------------------------------ step 9
  #
  # The answer goes out before the plugin is removed, because removing it
  # reloads every panel in the shell — including the one waiting for this.
  local plugin=absent pid; pid=$(purge_plugin_id)
  [[ -d $PLUGIN_ROOT/$pid ]] && plugin=pending
  answer "$(jq -nc --argjson w "$moved" --argjson s "$restored" \
              --arg k "$keys" --arg i "$indicator" --arg r "$root" \
              --argjson c "$commands" --arg p "$plugin" \
              '{ok: true, windows_moved: $w, paths_restored: $s, keys: $k,
                indicator: $i, root: $r, commands: $c,
                plugin: (if $p == "pending" then "removed" else $p end)}')" \
           "removed. $moved window(s) moved, $restored file(s) put back."

  # ----------------------------------------------------------------- step 10
  [[ $plugin == pending ]] || return 0
  command -v omarchy >/dev/null || return 0
  # `omarchy plugin remove` starts by telling the running shell to disable
  # this exact plugin over IPC (setPluginEnabled false) before it moves a
  # single file — which tears down this plugin's own QML, including the
  # `ask()` Process that is this script's parent. A plain child dies with
  # its parent's process group when that happens, landing mid-removal: the
  # directory not yet moved to its backup name, still present under its own
  # name, needing a second `remove` run by hand to actually finish. detach
  # (§4.9) exists for exactly this shape of problem — forked into its own
  # process group and disowned, it outlives whatever happens to the process
  # that started it, the same guarantee switch_stage2 relies on to survive
  # the shell restart a switch itself causes.
  detach purge_remove_self "$pid"
  return 0
}

purge_remove_self() {
  local pid=$1
  omarchy plugin remove "$pid" --yes
}

# What this machine can and cannot do, as state strings. Every fact whose answer
# would have to be guessed is `unknown`, and an optional component that is not
# installed is `absent` — neither is ever reported as healthy.
cmd_capabilities() {
  # Read from the cache, never measured here: a status query does not perturb
  # the compositor's settings, and it does not wait a second to answer. Until
  # the probe has run — or on a Hyprland this machine has not been measured on
  # — it is `unknown`, which disables the Hyprland toggles with the reason.
  local reload face=absent polkit=absent helpers=absent
  reload=$(hypr_reload_state)

  face_installed && face=ok

  # Installed, owned by root, and the same bytes this copy of the plugin ships.
  # Anything else is broken rather than absent: something is there and it is not
  # what the gate is about to rely on.
  local a p store
  helper_state omarchy-profile-auth; a=$?
  helper_state omarchy-profile-passwd; p=$?
  root_store_state; store=$?
  if ((a == 0 && p == 0 && store == 0)); then helpers=ok
  elif ((a == 1 && p == 1)); then helpers=absent
  else helpers=broken; fi

  # Never the probe here: capabilities is a status query, and a status query
  # does not run anything through pkexec.
  if [[ -e $POLICY_DEST ]]; then
    policy_annotated
    case $? in
    0) polkit=ok ;;
    2) polkit=unknown ;;
    *) polkit=broken ;;
    esac
    legacy_action_present && polkit=broken
  fi

  jq -nc --arg r "$reload" --arg f "$face" --arg p "$polkit" --arg h "$helpers" \
    '{hyprland_reload: $r, face: $f, polkit: $p, helpers: $h}'
}

ensure_config

case "${1:-}" in
catalog) write_catalog ;;
global) shift; cmd_global "${1:-status}" "${2:-}" ;;
refresh)
  # Rewrite every file the panel and launcher read, without switching. Useful
  # after editing a profile by hand, and after installing over an older version
  # that wrote none of them.
  require_no_journal
  lock_or_busy
  cur=$(current_profile)
  write_index; write_catalog
  [[ -n $cur ]] && apply_app_visibility "$cur"
  migrate_profiles
  echo "refreshed" ;;
isolate) shift; cmd_isolate "$@" ;;
shared) shift; cmd_shared "${1:-list}" "${2:-}" ;;
overview) shift; cmd_overview "${1:-}" ;;
close) shift; cmd_close_profile "${1:-}" ;;
identity) shift; cmd_identity "$@" ;;
password) shift; cmd_password "$@" ;;
rename) shift; cmd_rename "$@" ;;
config)
  shift
  for a in "$@"; do [[ $a == --json ]] && JSON=1; done
  cmd_config "$(for a in "$@"; do [[ $a == --* ]] || { printf '%s' "$a"; break; }; done)" ;;
meta) shift; cmd_meta "$@" ;;
session) shift; cmd_session "$@" ;;
login) cmd_login ;;
purge) shift; cmd_purge "$@" ;;
setup) shift; cmd_setup "$@" ;;
capabilities) cmd_capabilities ;;
set) shift; cmd_set "$@" ;;
capture) cmd_capture ;;
create) shift; cmd_create "${1:-}" "${2:---from-master}" ;;
remove) shift; cmd_remove "$@" ;;
show) shift; cmd_visibility show "${1:-}" ;;
hide) shift; cmd_visibility hide "${1:-}" ;;
apps) shift; cmd_apps "$@" ;;
apps-sweep) apps_sweep ;;
plugin) shift; cmd_plugin "${1:-}" "${2:-list}" "${3:-}" "${4:-}" ;;
ws) shift; cmd_ws "${1:-}" ;;
move) shift; cmd_move "${1:-}" "${2:-}" ;;
next) cmd_next ;;
current) cmd_current ;;
init) cmd_init ;;
list | ls | "")
  # hasPassword and identity come from the root store, so the JSON shape is the
  # index's, built by one function both this and profiles.json go through.
  if [[ ${2:-} == --json ]]; then index_json | jq -c .; else cmd_list; fi ;;
-h | --help | help)
  # Not a command-line tool any more. It is the implementation behind the panel
  # and the keybindings, and its verbs move with the plugin rather than with
  # anybody's muscle memory — so enumerating them here would advertise a surface
  # nothing promises to keep. One line is documented, and it is the one that
  # matters when the shell will not start.
  cat <<'USAGE'
omarchy-profile — the engine behind the Profiles plugin

This is not a supported command-line interface. It is what the panel and the
keybindings call, and its verbs can change with any release. Everything it does
is in the panel: click the Profiles icon on the bar, then Manage.

If the shell will not start, this switches profiles from a TTY:

  ~/.config/omarchy/plugins/kalinewb.profiles/bin/omarchy-profile set <name>

A profile with a password asks for it on the terminal, with nothing echoed.

The verbs, their arguments and what each returns are specified in the plugin's
documentation.
USAGE
  ;;
*) die "unknown command '$1' (try: omarchy-profile --help)" ;;
esac
