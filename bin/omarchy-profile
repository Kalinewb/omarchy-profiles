#!/bin/bash

# omarchy-profile — switch the machine between profiles.
#
# A profile is a saved desktop: theme, wallpaper, bar layout, which plugins run,
# which applications are visible, do-not-disturb, idle timers, a browser data
# directory and a block of workspaces. Switching is not "apply a template" — the
# outgoing profile's live state is captured back into it first, so anything
# changed while inside a profile is still there next time. Profiles are saved
# desks, not presets.
#
# One profile is the master. It sees every application, new profiles are copied
# from it, and an application installed anywhere is registered to it.
#
#   ~/.config/omarchy/profiles/config.json    global settings
#   ~/.config/omarchy/profiles/<name>.json    one profile
#   ~/.local/state/omarchy-profiles/current.json   which profile is active
#
# This script is the engine. The Quickshell plugin is a face for it; everything
# here works from a terminal or a keybind with no shell running, which is what
# makes recovery possible when the shell is the thing that broke.

set -uo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

PROFILE_DIR="$CONFIG_HOME/omarchy/profiles"
CONFIG_FILE="$PROFILE_DIR/config.json"
SHELL_JSON="$CONFIG_HOME/omarchy/shell.json"
# Where this copy of the plugin lives, so messages can point at the file the
# user actually has rather than at a path we hope they installed to.
PLUGIN_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

STATE_DIR="$STATE_HOME/omarchy-profiles"
STATE_FILE="$STATE_DIR/current.json"
THEME_NAME_FILE="$STATE_HOME/omarchy/current/theme.name"

# A switch outlives the process that started it — it restarts the shell that
# asked for it — so what it is doing has to be written down somewhere that
# survives both. These three are that record, and they are read before any
# switch starts as well as after one dies.
LOCK_FILE="$STATE_DIR/.lock"
JOURNAL="$STATE_DIR/switch.json"
SWITCH_LOG="$STATE_DIR/switch.log"

# Application visibility writes XDG hidden entries here. Deliberately the
# literal path and not "$DATA_HOME/applications": Omarchy's hidden-entries.sh
# scans ~/.local/share/applications whatever XDG_DATA_HOME says, so writing
# anywhere else would hide nothing.
APPS_DIR="$HOME/.local/share/applications"
APP_BACKUP_DIR="$STATE_DIR/desktop-backups"
# Written into the [Desktop Entry] group of every file we touch. Which tag a
# file carries is what decides how it is put back (see the section below).
APP_TAG_HIDDEN="X-OmarchyProfiles-Hidden"
APP_TAG_MODIFIED="X-OmarchyProfiles-Modified"

die() { echo "omarchy-profile: $*" >&2; exit 1; }
warn() { echo "omarchy-profile: $*" >&2; }

# A --json verb prints ONE JSON document on stdout and nothing else, and every
# word meant for a person goes to stderr. Set by the verbs that take the flag,
# read by refuse() and answer(), so a refusal does not have to be written twice.
JSON=""

# refuse <exit-code> <error> <message> [<extra JSON object>]
#
# The error string is the contract's; the message is the same thing said to a
# person. Exit codes: 1 error, 2 refused by authentication, 3 busy.
refuse() {
  local code=$1 err=$2 msg=$3 extra=${4:-}
  if [[ -n $JSON ]]; then
    if [[ -n $extra ]]; then jq -nc --arg e "$err" --argjson x "$extra" '{error: $e} + $x'
    else jq -nc --arg e "$err" '{error: $e}'; fi
  fi
  [[ -n $msg ]] && echo "omarchy-profile: $msg" >&2
  exit "$code"
}

# answer <json> <prose> — one verdict, in whichever language was asked for.
answer() { if [[ -n $JSON ]]; then printf '%s\n' "$1"; else printf '%s\n' "$2"; fi; }

# Verbs the contract names but that a later phase builds. They are dispatchable
# from the day the contract freezes, so a panel that calls one gets a JSON
# answer it can render rather than "unknown command" on stderr and exit 1 with
# nothing on stdout.
not_implemented() {
  echo '{"error":"not_implemented"}'
  echo "omarchy-profile: '$*' is not built yet" >&2
  exit 1
}

command -v jq >/dev/null || die "jq is required"

# ------------------------------------------------------------------ config

ensure_config() {
  mkdir -p "$PROFILE_DIR" "$STATE_DIR"
  [[ -s $CONFIG_FILE ]] && return 0
  jq -n '{
    version: 1, master: "master", master_switchable: true,
    restore_last_on_login: true, last: "",
    pinned_plugins: ["graveklar.profiles"], workspace_span: 10,
    isolate: [],
    unlock: {method: "polkit"}
  }' >"$CONFIG_FILE"
}

# cfg <filter>            raw string value
# cfg -c <filter>         compact JSON (for arrays handed to --argjson)
cfg() {
  if [[ ${1:-} == -c ]]; then jq -c "$2" "$CONFIG_FILE" 2>/dev/null
  else jq -r "$1" "$CONFIG_FILE" 2>/dev/null; fi
}

cfg_set() {
  local tmp
  tmp=$(mktemp) || return 1
  jq "$@" "$CONFIG_FILE" >"$tmp" && mv "$tmp" "$CONFIG_FILE" || { rm -f "$tmp"; return 1; }
}

file_for() { printf '%s/%s.json\n' "$PROFILE_DIR" "$1"; }

profile_names() {
  find "$PROFILE_DIR" -maxdepth 1 -name '*.json' -not -name 'config.json' -printf '%f\n' 2>/dev/null |
    sed 's/\.json$//' | sort
}

exists() { [[ -f $(file_for "$1") ]]; }

current_profile() {
  [[ -s $STATE_FILE ]] || { echo ""; return; }
  jq -r '.profile // ""' "$STATE_FILE" 2>/dev/null
}

is_master() { [[ $1 == "$(cfg .master)" ]]; }

# Workspace blocks are allocated in order and never reused while a profile
# holds one, so window ids stay stable across a rename or a reordering.
next_offset() {
  local span used max=-1
  span=$(cfg .workspace_span); [[ $span =~ ^[0-9]+$ ]] || span=10
  while read -r n; do
    [[ -n $n ]] || continue
    used=$(jq -r '.workspaces.offset // 0' "$(file_for "$n")" 2>/dev/null)
    [[ $used =~ ^[0-9]+$ ]] && ((used > max)) && max=$used
  done < <(profile_names)
  ((max < 0)) && { echo 0; return; }
  echo $((max + span))
}

# ------------------------------------------------------------------- locks
#
# Password-protected profiles.
#
# Authentication goes through PAM rather than a passphrase of our own, because
# PAM is already where this user's identity is decided. On this machine the sudo
# stack is:
#
#   auth [success=1 default=ignore] pam_exec.so ... omarchy-face-gate
#   auth sufficient                 pam_exec.so ... omarchy-face-verify
#   auth include                    system-auth
#
# so `sudo -v` accepts a face, and falls through to the password — and to a
# fingerprint for anyone who has added pam_fprintd. None of that is implemented
# here, and adding a new method later needs no change to this plugin.
#
# `sudo -k` first, deliberately: without it a cached sudo timestamp would let
# someone walk up to an unattended machine and enter a locked profile with no
# prompt at all. The cost is that the next real sudo asks again.
#
# What this is and is not: it gates ENTERING a profile. Every profile runs as the
# same Unix user, so it is not a security boundary — a process running as you can
# read another profile's files whether or not this prompt exists. It stops a
# person at the keyboard, not a program.

profile_locked() { jq -e '.locked // false' "$(file_for "$1")" >/dev/null 2>&1; }

# Every attempt is logged, pass or fail.
#
# Not for its own sake: with a face in the PAM stack a successful unlock is
# silent and instant, which is indistinguishable from no check having run at
# all. "It did not ask me for anything" is the expected experience and also
# exactly what a broken gate looks like, so the only way to tell them apart is
# a record. `journalctl --user -t omarchy-profile` shows it.
audit() { logger -t omarchy-profile -p user.notice -- "$*" 2>/dev/null || true; }

# True only for methods that need somewhere to type. polkit draws its own
# dialog through the session agent, so a locked switch started from the panel
# no longer has to relaunch itself in a floating terminal just to have a place
# to prompt.
auth_needs_terminal() {
  [[ $(cfg '.unlock.method // "polkit"') == sudo ]]
}

authenticate() {
  local method for_what=${1:-a locked profile} profile=${2:-}
  method=$(cfg '.unlock.method // "polkit"')

  # A profile may name a face other than the owner's — a partner's, say. PAM
  # cannot express that: it authenticates the Unix user, and there is only one.
  # So the identity is asked first and separately.
  #
  # owner_override decides what happens when that face is not recognised:
  #
  #   true (default)  the owner check below still runs, so a camera that cannot
  #                   see is never the reason somebody is locked out of their
  #                   own machine.
  #   false           refuse. Only the bound face opens this profile, and the
  #                   machine owner's password does not.
  #
  # Read the honesty note under "What a lock is not" before trusting the second
  # one: this file is writable by the owner, so owner_override=false is a
  # courtesy between people sharing a laptop, not a boundary.
  local identity="" owner_override=true
  if [[ -n $profile ]]; then
    identity=$(jq -r '.identity // empty' "$(file_for "$profile")" 2>/dev/null)
    # `== false`, not `// true`: jq's alternative operator treats false as
    # absent, so `.owner_override // true` returned TRUE for a profile that had
    # explicitly set it to false — the setting was silently a no-op, and the
    # owner's password kept opening a profile meant to refuse it.
    owner_override=$(jq -r 'if (.owner_override == false) then "false" else "true" end' \
      "$(file_for "$profile")" 2>/dev/null)
  fi

  if [[ -n $identity ]]; then
    if [[ ! -x /usr/local/bin/omarchy-face-identity ]]; then
      # A bound identity with no way to check it. Normally that falls through to
      # the owner, because refusing would strand the profile on a machine where
      # the face plugin was removed.
      #
      # But with owner_override off, falling through is the one thing the
      # setting exists to prevent: the owner's password would open a profile
      # marked as opening only for somebody else. Removing the helper -- or
      # simply making it unreachable -- must not be a way to downgrade that.
      if [[ $owner_override == false ]]; then
        warn "'$profile' opens only for '$identity', and the face tooling is missing"
        warn "as it stands nothing opens it. To undo the binding, remove the"
        warn "\"identity\" and \"owner_override\" keys from:"
        warn "  $(file_for "$profile" | sed "s|^$HOME|~|")"
        audit "unlock of $for_what REFUSED: identity '$identity' unverifiable and owner_override is off"
        return 1
      fi
      warn "'$profile' is bound to the face '$identity', but omarchy-face-identity is not installed"
      audit "unlock of $for_what: identity '$identity' unverifiable, face tooling missing"
    elif ! /usr/local/bin/omarchy-face-identity list 2>/dev/null | grep -qx -- "$identity"; then
      # Not "unrecognised" -- gone. The model was cleared, or the engine behind
      # it was uninstalled, which is what omarchy-remove-security-face does:
      # the helper stays in /usr/local/bin while howdy and every model leave.
      # `verify` cannot tell that from a stranger at the camera, so without
      # this the profile would answer "the camera did not recognise you"
      # forever and the reason would never appear anywhere.
      #
      # Refused rather than waved through when owner_override is off, for the
      # same reason a missing helper is: clearing a model must not be a way to
      # downgrade --only. But it says what happened and how to undo it.
      if [[ $owner_override == false ]]; then
        warn "'$profile' opens only for '$identity', which is no longer enrolled"
        warn "as it stands nothing opens it. To undo the binding, remove the"
        warn "\"identity\" and \"owner_override\" keys from:"
        warn "  $(file_for "$profile" | sed "s|^$HOME|~|")"
        audit "unlock of $for_what REFUSED: identity '$identity' no longer enrolled and owner_override is off"
        return 1
      fi
      warn "'$profile' is bound to the face '$identity', which is no longer enrolled"
      audit "unlock of $for_what: identity '$identity' no longer enrolled, falling back to the owner check"
    elif /usr/local/bin/omarchy-face-identity verify "$identity"; then
      audit "unlock of $for_what succeeded: face matched identity '$identity'"
      return 0
    elif [[ $owner_override == false ]] && /usr/local/bin/omarchy-face-identity verify "$identity"; then
      # One retry, and only on the path that has nowhere else to go. With
      # owner_override off there is no password to fall back to, so a camera
      # that simply did not see anyone would lock the owner out of their own
      # profile -- and the check is silent, which means the first attempt is
      # often spent before anyone thinks to look up. A second attempt costs a
      # couple of seconds and proves nothing different about who is there:
      # howdy keeps its own attempt limits underneath this.
      audit "unlock of $for_what succeeded: face matched identity '$identity' on retry"
      return 0
    elif [[ $owner_override == false ]]; then
      warn "this profile opens only for '$identity' — the camera did not recognise you"
      audit "unlock of $for_what REFUSED: identity '$identity' not recognised and owner_override is off"
      return 1
    else
      audit "unlock of $for_what: identity '$identity' not recognised, falling back to the owner check"
    fi
  fi

  case $method in
  polkit)
    command -v pkcheck >/dev/null || {
      warn "pkcheck is not available; set unlock.method to sudo or none"
      audit "unlock of $for_what refused: pkcheck missing"
      return 1
    }
    # pkcheck asks the question without running anything as root: this is an
    # authorisation decision, not a privileged action, and it should not need
    # to become one. The agent runs the polkit-1 PAM stack, so a face is tried
    # first where omarchy-face has configured one, then the password.
    local pkout
    if pkout=$(pkcheck --action-id no.graveklar.profiles.unlock \
               --process "$$" --allow-user-interaction 2>&1); then
      audit "unlock of $for_what succeeded via polkit (polkit-1 stack: face, fingerprint or password)"
      return 0
    fi

    # "not registered" is not a wrong password, and must not be treated as one.
    #
    # The action is declared by a file under /usr/share/polkit-1/actions, which
    # install.sh puts there with sudo. A marketplace install copies the plugin
    # and never runs install.sh, so on that path the action is simply absent --
    # and polkit says so rather than asking anything. Counting that as a failed
    # authentication would leave every locked profile permanently unenterable,
    # while telling the user their password was wrong.
    if [[ $pkout == *"not registered"* ]]; then
      audit "unlock of $for_what: polkit action not registered"
      warn "the polkit action is not installed, so the password check cannot run"
      warn "install it with:"
      warn "  sudo install -m 0644 $PLUGIN_DIR/polkit/no.graveklar.profiles.policy \\"
      warn "    /usr/share/polkit-1/actions/"
      # sudo can stand in, but only where there is somewhere to type. From the
      # bar there is not, and a silent hang would be worse than a clear refusal.
      if [[ -t 0 ]] && command -v sudo >/dev/null; then
        warn "falling back to your password for this one switch"
        sudo -k >/dev/null 2>&1
        if sudo -v; then
          audit "unlock of $for_what succeeded via sudo (polkit action missing)"
          return 0
        fi
      fi
      return 1
    fi

    audit "unlock of $for_what failed via polkit"
    return 1 ;;
  none)
    audit "unlock of $for_what allowed without a check (unlock.method=none)"
    return 0 ;;
  sudo)
    command -v sudo >/dev/null || {
      warn "sudo is not available; set unlock.method to none"
      audit "unlock of $for_what refused: sudo missing"
      return 1
    }
    # -k so a cached timestamp cannot stand in for a real prompt.
    sudo -k >/dev/null 2>&1
    if sudo -v; then
      audit "unlock of $for_what succeeded via PAM (sudo stack: face, fingerprint or password)"
      return 0
    fi
    audit "unlock of $for_what FAILED via PAM"
    return 1 ;;
  *)
    warn "unknown unlock.method '$method'"
    audit "unlock of $for_what refused: unknown unlock.method '$method'"
    return 1 ;;
  esac
}

# Bind a named face to a profile, so that face opens it without the owner
# having to authorise. The face itself is enrolled by omarchy-face; this only
# records which one this profile answers to.
#
# Deliberately gated the same way unlocking is: choosing who else may enter a
# profile is at least as consequential as entering it, and an ungated version
# would let anyone at the keyboard point a locked profile at their own face.
cmd_identity() {
  local name=${1:-} identity=${2:-} only=""
  [[ ${3:-} == --only ]] && only=1
  [[ -n $name ]] || die "usage: omarchy-profile identity <profile> <identity|none> [--only]"
  exists "$name" || die "no such profile '$name'"

  if [[ -z $identity ]]; then
    jq -r '.identity // "none"' "$(file_for "$name")"
    return 0
  fi

  if [[ -t 0 ]] || ! auth_needs_terminal; then
    authenticate "the face bound to $name" "$name" ||
      die "authentication failed — '$name' is unchanged"
  else
    # --only must survive the hop. Dropping it would set the binding and leave
    # owner_override ON, which looks like success and is the opposite of what
    # was asked for -- the one failure mode this flag cannot have.
    relaunch_in_terminal identity "$name" "$identity" ${only:+--only}
    return 0
  fi

  local tmp file
  file=$(file_for "$name")
  tmp=$(mktemp)

  if [[ $identity == none ]]; then
    # owner_override goes back to its default too: leaving it off with no
    # identity bound would leave a profile nothing could open.
    jq 'del(.identity) | del(.owner_override)' "$file" >"$tmp" && mv "$tmp" "$file"
    audit "identity cleared on $name"
    echo "$name no longer answers to a face of its own"
    return 0
  fi

  [[ -x /usr/local/bin/omarchy-face-identity ]] ||
    die "omarchy-face is not installed, so named faces cannot be verified"

  # Refuse to point a profile at a face that was never enrolled: the profile
  # would look configured and silently never open for anyone but the owner.
  if ! /usr/local/bin/omarchy-face-identity list | grep -qx -- "$identity"; then
    rm -f "$tmp"
    die "no face enrolled as '$identity' — enrol it first with omarchy-face"
  fi

  # An identity is only ever consulted by the lock: `set` authenticates a
  # profile that asks to be authenticated, and walks straight into one that does
  # not. Binding a face to an unlocked profile therefore protects nothing, while
  # printing a message that says it does -- so the binding brings the lock with
  # it, and says so rather than leaving a profile that only looks guarded.
  local was_locked=0
  profile_locked "$name" && was_locked=1

  jq --arg i "$identity" --argjson override "$([[ -n $only ]] && echo false || echo true)" \
    '.identity = $i | .owner_override = $override | .locked = true' "$file" >"$tmp" && mv "$tmp" "$file"
  write_index

  if ((!was_locked)); then
    audit "locked $name (an identity is only consulted at the lock)"
    echo "Locked '$name' too — a bound face is only consulted when the profile asks"
    echo "for authentication, so on an unlocked profile the binding would do nothing."
    echo
  fi

  if [[ -n $only ]]; then
    audit "identity '$identity' bound to $name, owner override OFF"
    cat <<EOF
$name now opens only for the face enrolled as '$identity'.
Your own password will not open it.

Read this before relying on it. $(file_for "$name" | sed "s|^$HOME|~|") is writable
by whoever owns this machine, so anyone who can edit it can turn this back on,
or clear the binding, or read the profile's files directly without entering it
at all. As a courtesy between people sharing a laptop it holds. As a boundary
it does not, and nothing kept in ~/.config could.

For a part of the profile that a password genuinely cannot reach:

  omarchy-profile vault init $name

The vault's key comes from its passphrase, so it is not a rule anybody can edit
— without the passphrase the contents are ciphertext to every account on the
machine, root included.
EOF
  else
    audit "identity '$identity' bound to $name"
    echo "$name now also opens for the face enrolled as '$identity'"
    echo "(your own password still opens it too — use --only to change that)"
  fi
}

cmd_lock() {
  local verb=$1 name=${2:-}
  [[ -n $name ]] || die "usage: omarchy-profile $verb <name>"
  exists "$name" || die "no such profile '$name'"
  local want=true; [[ $verb == unlock ]] && want=false

  # Removing the lock proves you could get in, so it needs the same gate as
  # entering would. Otherwise the lock is a label anyone can peel off.
  if [[ $verb == unlock ]]; then
    if [[ -t 0 ]] || ! auth_needs_terminal; then
      authenticate "the lock on $name" "$name" || die "authentication failed — '$name' stays locked"
    else
      relaunch_in_terminal unlock "$name"
      return 0
    fi
  fi

  local tmp; tmp=$(mktemp)
  jq --argjson l "$want" '.locked = $l' "$(file_for "$name")" >"$tmp" && mv "$tmp" "$(file_for "$name")"
  write_index
  [[ $want == true ]] && echo "$name now asks for authentication" || echo "$name no longer asks"
}

# The panel runs this script through the bar with no terminal attached, so a
# password prompt has nowhere to appear. Hand the same command to a floating
# themed terminal, which has a tty, and let that copy do the work.
#
# Deliberately NOT omarchy-launch-floating-terminal-with-presentation: that
# wrapper ends with omarchy-show-done, which waits for a keypress. It is right
# for an installer whose output you want to read, and wrong here — a profile
# switch that succeeds should leave nothing behind to dismiss, especially when
# a face unlocks it in a second and there was never anything to read.
#
# So: close on success, and linger only on failure, where there is an error
# worth reading.
relaunch_in_terminal() {
  local self="${BASH_SOURCE[0]}" cmd
  printf -v cmd '%q ' "$self" "$@" 2>/dev/null || cmd="$self $*"
  local script="$cmd || { printf '\\n'; read -rsn1 -p 'Failed. Press any key to close...'; }"

  if command -v xdg-terminal-exec >/dev/null; then
    # The app-id is what Omarchy's window rules float and centre.
    setsid uwsm-app -- xdg-terminal-exec \
      --app-id=org.omarchy.terminal --title=Omarchy \
      -e bash -c "$script" >/dev/null 2>&1
  elif command -v omarchy-launch-floating-terminal-with-presentation >/dev/null; then
    omarchy-launch-floating-terminal-with-presentation "$cmd" >/dev/null 2>&1
  else
    warn "no terminal available to ask for authentication"
    return 1
  fi
}

# --------------------------------------------------------------- isolation
#
# Per-profile plugin state.
#
# A plugin's settings are per-profile already when it keeps them inline in
# shell.json, because a profile captures that whole object. Plugins with their
# own files outside it are global: the Spotify plugin's session lives at
# ~/.local/state/omarchy-spotify/session.json, so every profile is signed in as
# the same person, and the dock's settings live in one arc-dock.json, so every
# profile gets the same dock.
#
# The fix is the trick browsers use for their own profiles: keep one copy per
# profile and point the path the plugin knows at the active profile's copy. The
# plugin is unchanged and unaware.
#
# Swapping is lossless and self-healing:
#   leaving F, entering T, for each isolated path P
#     P is a symlink   -> remove it (the target is already F's store)
#     P is real        -> move it into F's store, since the live data is F's
#     T has a store    -> symlink P at it
#     T has none       -> leave P absent, and the plugin makes a fresh one;
#                         the next switch away adopts that into T's store
# Nothing is ever deleted and no symlink is ever left dangling.

ISOLATE_DIR="$STATE_DIR/isolated"
# A path a swap could not file under its owner is left exactly where it is and
# recorded here, `path<TAB>owner`. While a line exists no switch may start, so
# no later swap ever has to wonder whose data is at that path. Written by the
# isolate phase; read from here on, which is what makes the refusal real before
# the thing that writes it exists.
PENDING_OWNER="$ISOLATE_DIR/.pending-owner"

# ~/.local/state/omarchy-spotify -> local%state%omarchy-spotify
store_key() { printf '%s' "${1#"$HOME"/}" | tr '/' '%'; }
store_for() { printf '%s/%s/%s\n' "$ISOLATE_DIR" "$1" "$(store_key "$2")"; }

# An isolate entry is either a bare path or {path, plugin}. The tagged form
# exists so one control can answer "is this plugin the same in every profile",
# which is the question a person actually has — they do not think in terms of
# ~/.local/state/omarchy-spotify. Bare strings keep working.
isolated_paths() {
  cfg -c '.isolate // []' |
    jq -r '.[] | if type == "object" then .path else . end' 2>/dev/null |
    while read -r p; do
      [[ -n $p ]] || continue
      printf '%s\n' "${p/#\~/$HOME}"
    done
}

# Paths this plugin owns, whether isolated right now or parked in `shared`.
plugin_paths() {
  local id=$1
  cfg -c '.isolate // []' |
    jq -r --arg id "$id" '.[] | select(type == "object" and .plugin == $id) | .path' 2>/dev/null |
    while read -r p; do [[ -n $p ]] && printf '%s\n' "${p/#\~/$HOME}"; done
  cfg -c '.shared_paths // []' |
    jq -r --arg id "$id" '.[] | select(.plugin == $id) | .path' 2>/dev/null |
    while read -r p; do [[ -n $p ]] && printf '%s\n' "${p/#\~/$HOME}"; done
}

# Drop every isolate entry naming this path, in whichever form it was written.
#
# Entries exist as a bare string or as {path, plugin}, and as "~/..." or as a
# full path, because both forms have been written at different times. Comparing
# the literals missed the older ones, which then quietly re-isolated a plugin
# that had just been made shared. Normalise both sides against $HOME instead.
drop_isolate_path() {
  local target=${1/#\~/$HOME}
  cfg_set --arg t "$target" --arg home "$HOME" '
    def norm: if startswith("~/") then ($home + .[1:]) else . end;
    .isolate = ((.isolate // [])
      | map(select(((if type == "object" then .path else . end) | norm) != $t)))
  '
}

plugin_is_shared() {
  cfg -c '.pinned_plugins // []' | jq -e --arg id "$1" 'index($id) != null' >/dev/null 2>&1
}

# Pinned plugins that render in the bar.
#
# Pinning used to mean only "a profile may not add this to disabledPlugins",
# which is not enough: applying a profile writes .bar wholesale from what that
# profile captured, so a pinned widget missing from that snapshot still
# vanished. A plugin that is the same in every profile has to be put back.
pinned_bar_widgets() {
  local catalog="$STATE_DIR/plugins.json"
  [[ -s $catalog ]] || return 0
  # `. as $p` before the pipe: inside `$pinned | index(...)` the input is the
  # array, so a bare `.id` there indexes an array with a string and jq aborts.
  # Same mistake as write_catalog had; it fails loudly there and silently here,
  # which is why it survived — an empty list just looks like "nothing pinned".
  jq -r --argjson pinned "$(cfg -c '.pinned_plugins // []')" '
    .[] | . as $p
        | select(($pinned | index($p.id)) != null)
        | select($p.kinds | index("bar-widget"))
        | $p.id
  ' "$catalog" 2>/dev/null
}

# Drop stores belonging to profiles that no longer exist. Removal cleans up
# after itself, but a profile deleted by hand — or by a version of this script
# from before that existed — leaves one behind, and those files can include a
# live Spotify session.
prune_isolated() {
  [[ -d $ISOLATE_DIR ]] || return 0
  local dir name
  for dir in "$ISOLATE_DIR"/*; do
    [[ -d $dir ]] || continue
    name=$(basename "$dir")
    exists "$name" || { rm -rf "${dir:?}"; warn "dropped leftover plugin data for the removed profile '$name'"; }
  done
}

swap_isolated() {
  local from=${1:-} to=${2:-} path from_store to_store
  while read -r path; do
    [[ -n $path ]] || continue
    [[ $path == "$HOME"/* ]] || { warn "refusing to isolate '$path' (outside your home)"; continue; }

    if [[ -L $path ]]; then
      rm -f "$path"
    elif [[ -e $path ]]; then
      if [[ -n $from ]]; then
        from_store=$(store_for "$from" "$path")
        mkdir -p "$(dirname "$from_store")"
        rm -rf "$from_store"
        mv "$path" "$from_store" || warn "could not save '$path' into $from"
      fi
      # With no outgoing profile the live data has no owner to be filed under,
      # so it is left alone rather than moved somewhere arbitrary.
    fi

    if [[ -n $to ]]; then
      to_store=$(store_for "$to" "$path")
      if [[ -e $to_store ]]; then
        mkdir -p "$(dirname "$path")"
        ln -sfn "$to_store" "$path"
      fi
    fi
  done < <(isolated_paths)
}

cmd_isolate() {
  local verb=${1:-list} path=${2:-}
  # Adding or removing a path moves real files between stores, which is exactly
  # what a switch is doing; the two may not interleave. `list` never waits.
  case $verb in
  add | remove) require_no_journal; lock_or_busy ;;
  esac
  case $verb in
  list)
    local any=0
    while read -r p; do
      [[ -n $p ]] || continue
      any=1
      local mark="  "
      [[ -L $p ]] && mark="* "
      printf '%s%s\n' "$mark" "${p/#$HOME/~}"
    done < <(isolated_paths)
    ((any)) || echo "nothing isolated — try: omarchy-profile isolate add ~/.local/state/omarchy-spotify"
    echo
    echo "* = currently pointed at the active profile's copy" ;;
  add)
    # isolate add [--plugin <id>] <path>
    #
    # The tag is what lets one "same in every profile" control move a plugin's
    # paths together. It cannot be guessed: quickshell.spotify keeps its session
    # in omarchy-spotify, and nothing in either name implies the other.
    local plugin=""
    if [[ $path == --plugin ]]; then plugin=${3:-}; path=${4:-}; fi
    [[ -n $path ]] || die "usage: omarchy-profile isolate add [--plugin <id>] <path>"
    local rel; rel=$(printf '%s' "$path" | sed "s|^$HOME/|~/|")
    if [[ -n $plugin ]]; then
      drop_isolate_path "$path"
      cfg_set --arg p "$rel" --arg id "$plugin" \
        '.isolate = ((.isolate // []) + [{path: $p, plugin: $id}])' ||
        die "could not record '$path'"
    else
      cfg_set --arg p "$rel" '.isolate = (((.isolate // []) + [$p]) | unique)' ||
        die "could not record '$path'"
    fi
    # Adopt what is live into the profile the user is in, then point at it.
    # Passing the same profile as both sides does exactly that: the real file
    # is filed under it, and the symlink comes back to the copy just made.
    local cur; cur=$(current_profile)
    [[ -n $cur ]] && swap_isolated "$cur" "$cur"
    echo "isolating $rel" ;;
  remove)
    [[ -n $path ]] || die "usage: omarchy-profile isolate remove <path>"
    local expanded=${path/#\~/$HOME} cur store
    cur=$(current_profile)
    # Put the active profile's copy back as a real file, so dropping isolation
    # leaves a working setup rather than a dangling link.
    if [[ -L $expanded && -n $cur ]]; then
      store=$(store_for "$cur" "$expanded")
      rm -f "$expanded"
      [[ -e $store ]] && mv "$store" "$expanded"
    fi
    drop_isolate_path "$expanded" || die "could not update the isolate list"
    echo "no longer isolating ${path/#$HOME/~}" ;;
  *) die "unknown isolate verb '$verb' (list, add, remove)" ;;
  esac
}

# "Is this plugin the same in every profile?" — one question, one control.
#
# Two mechanisms sit underneath it and a person should not have to know either:
# pinning keeps the plugin out of disabledPlugins and forces its widget back
# into every profile's bar, and un-isolating its state files gives it one
# account rather than one per profile. Answering them separately is how you end
# up with music playing and no player: the daemon kept going while the widget
# came back signed in to a different profile's empty session.
cmd_shared() {
  local verb=${1:-list} id=${2:-}
  case $verb in
  list)
    local any=0 p
    while read -r p; do
      [[ -n $p ]] || continue
      any=1
      printf '  %s\n' "$p"
    done < <(cfg -c '.pinned_plugins // []' | jq -r '.[]')
    ((any)) || echo "nothing shared"
    echo
    echo "These are in every profile's bar, cannot be switched off by a profile,"
    echo "and use one set of files rather than one per profile." ;;
  add)
    [[ -n $id ]] || die "usage: omarchy-profile shared add <plugin-id>"
    cfg_set --arg id "$id" '.pinned_plugins = (((.pinned_plugins // []) + [$id]) | unique)' ||
      die "could not pin '$id'"

    # Stop isolating its paths, and keep the record so unsharing can restore it.
    # The active profile's copy becomes the real file, since that is the one the
    # user has been using and the only one that is certainly current.
    local path expanded cur store rel
    cur=$(current_profile)
    while read -r path; do
      [[ -n $path ]] || continue
      expanded=${path/#\~/$HOME}
      rel=$(printf '%s' "$expanded" | sed "s|^$HOME/|~/|")
      if [[ -L $expanded && -n $cur ]]; then
        store=$(store_for "$cur" "$expanded")
        rm -f "$expanded"
        [[ -e $store ]] && mv "$store" "$expanded"
      fi
      drop_isolate_path "$expanded"
      cfg_set --arg p "$rel" --arg id "$id" \
        '.shared_paths = (((.shared_paths // []) + [{path: $p, plugin: $id}]) | unique)' ||
        warn "could not stop isolating $rel"
    done < <(plugin_paths "$id")
    write_catalog
    echo "$id is now the same in every profile" ;;
  remove)
    [[ -n $id ]] || die "usage: omarchy-profile shared remove <plugin-id>"
    [[ $id == graveklar.profiles ]] &&
      die "the profile picker stays shared — a profile that could hide it would leave no way back"
    cfg_set --arg id "$id" '.pinned_plugins = ((.pinned_plugins // []) | map(select(. != $id)))' ||
      die "could not unpin '$id'"
    # Anything parked in shared_paths goes back to being isolated.
    local path rel
    while read -r path; do
      [[ -n $path ]] || continue
      rel=$(printf '%s' "${path/#\~/$HOME}" | sed "s|^$HOME/|~/|")
      cfg_set --arg p "$rel" --arg id "$id" \
        '.shared_paths = ((.shared_paths // []) | map(select(.path != $p)))
         | .isolate = (((.isolate // []) + [{path: $p, plugin: $id}]))' ||
        warn "could not isolate $rel again"
    done < <(cfg -c '.shared_paths // []' | jq -r --arg id "$id" '.[] | select(.plugin == $id) | .path')
    local cur; cur=$(current_profile)
    [[ -n $cur ]] && swap_isolated "$cur" "$cur"
    write_catalog
    echo "$id is now per profile" ;;
  *) die "unknown shared verb '$verb' (list, add, remove)" ;;
  esac
}

# ------------------------------------------------------------------ capture

# Read the machine's live state into a profile. This is what makes a profile a
# saved desk: it runs for the OUTGOING profile on every switch, so changes made
# while inside it are kept rather than discarded on the way out.
capture_into() {
  local name=$1 file
  file=$(file_for "$name")
  exists "$name" || { warn "cannot capture into unknown profile '$name'"; return 1; }

  local theme dnd screensaver lock bar
  # `cat`, not `$([[ -s f ]] && <f)`: a redirect with no command runs no command
  # and so produces no output, which silently captured an empty theme.
  theme=$(cat "$THEME_NAME_FILE" 2>/dev/null)
  dnd=$(omarchy-shell notifications isDnd 2>/dev/null)
  [[ $dnd == on ]] && dnd=true || dnd=false
  screensaver=$(jq -r '.idle.screensaver // 150' "$SHELL_JSON" 2>/dev/null)
  lock=$(jq -r '.idle.lock // 300' "$SHELL_JSON" 2>/dev/null)
  # The whole bar object, not a preset name. A profile owning its own layout is
  # what removes any chance of a stale shared preset silently dropping widgets.
  bar=$(jq -c '.bar // {}' "$SHELL_JSON" 2>/dev/null)
  local disabled
  disabled=$(jq -c '.disabledPlugins // []' "$SHELL_JSON" 2>/dev/null)

  local tmp
  tmp=$(mktemp) || return 1
  jq \
    --arg theme "$theme" \
    --argjson dnd "$dnd" \
    --argjson screensaver "${screensaver:-150}" \
    --argjson lock "${lock:-300}" \
    --argjson bar "${bar:-\{\}}" \
    --argjson disabled "${disabled:-[]}" '
      . as $p
      | .theme = (if $theme == "" then $p.theme else $theme end)
      | .dnd = $dnd
      | .idle = ((.idle // {}) | .screensaver = $screensaver | .lock = $lock)
      | .bar = $bar
      | .plugins = ((.plugins // {}) | .disabled = $disabled)
    ' "$file" >"$tmp" && mv "$tmp" "$file" || { rm -f "$tmp"; warn "capture into '$name' failed"; return 1; }
}

# An index of every profile, for the panel to read.
#
# The panel could shell out and parse `list`, but a QML process per repaint is
# both slow and racy. One JSON file it can FileView, rewritten by whichever
# command changed the set, keeps the UI declarative and means the panel has no
# opinion about where profiles live or what a profile is.
write_index() {
  mkdir -p "$STATE_DIR"
  local master tmp
  master=$(cfg .master)
  tmp=$(mktemp "$STATE_DIR/profiles.json.XXXXXX") || return 1
  {
    printf '['
    local first=1
    while read -r n; do
      [[ -n $n ]] || continue
      ((first)) || printf ','
      first=0
      jq -c --arg name "$n" --argjson is_master "$([[ $n == "$master" ]] && echo true || echo false)" '{
        name: $name,
        description: (._description // ""),
        master: $is_master,
        hidden: (.hidden // false),
        locked: (.locked // false),
        identity: (.identity // ""),
        theme: (.theme // ""),
        icon: (.icon // ""),
        offset: (.workspaces.offset // 0)
      }' "$(file_for "$n")"
    done < <(profile_names)
    printf ']'
  } >"$tmp" && mv "$tmp" "$STATE_DIR/profiles.json" || { rm -f "$tmp"; warn "could not write the profile index"; return 1; }
}

# The installable set, for the settings view's toggle lists.
#
# Plugins come from `omarchy plugin list --json` because QML has no plugin
# registry to read; applications are NOT listed here — the panel reads
# DesktopEntries directly, which is always current and needs no refresh.
#
# `pinned` is folded in here rather than left to the UI so every consumer agrees
# on what may not be switched off.
write_catalog() {
  mkdir -p "$STATE_DIR"
  command -v omarchy >/dev/null || return 0
  local tmp pinned state meta
  pinned=$(cfg -c '.pinned_plugins // []')

  # Two sources, because neither alone is enough:
  #   plugin list --json  what is enabled, what may be disabled
  #   plugin-catalog      the description and the author's own category
  # A list of bare ids tells the user nothing about what they are switching
  # off, so the description is the point of joining them.
  state=$(omarchy plugin list --json 2>/dev/null) || state='[]'
  meta=$(omarchy-plugin-catalog 2>/dev/null) || meta='[]'

  tmp=$(mktemp "$STATE_DIR/plugins.json.XXXXXX") || return 1
  jq -nc --argjson state "${state:-[]}" --argjson meta "${meta:-[]}" \
         --argjson pinned "${pinned:-[]}" '
    ($meta | map({key: .id, value: .}) | from_entries) as $by_id
    | [ $state[] | . as $p | ($by_id[$p.id] // {}) as $m | {
        id: $p.id,
        name: ($p.name // $p.id),
        kinds: ($p.kinds // []),
        enabled: ($p.enabled // false),
        canDisable: ($p.canDisable // true),
        firstParty: ($p.firstParty // false),
        # $p.id, not .id: after `$pinned |` the input is the array, so `.id`
        # would try to index it with a string.
        pinned: (($pinned | index($p.id)) != null),
        # The widget blurb first: it is written about the thing in the bar and
        # is shorter than the plugin-level description, which often reads like
        # a README paragraph.
        description: (($m.barWidget.description // $m.description // "") | gsub("\\s+"; " ")),
        # The author'"'"'s own category where they set one — Audio, Compositor,
        # Wellbeing — since it says more than the kind does. Falls back to the
        # kind for the plugins that declare none.
        category: (
          $m.barWidget.category //
          (if ($p.kinds | index("bar-widget")) then "Bar widgets"
           elif ($p.kinds | index("panel")) then "Panels"
           elif ($p.kinds | index("service")) then "Services"
           elif ($p.kinds | index("overlay")) then "Overlays"
           elif ($p.kinds | index("menu")) then "Menus"
           elif ($p.kinds | index("bar")) then "Bars"
           else "Other" end))
      } ]
    | sort_by(.category, (.name | ascii_downcase))
  ' >"$tmp" && mv "$tmp" "$STATE_DIR/plugins.json" || { rm -f "$tmp"; warn "could not write the plugin catalog"; return 1; }
}

# ------------------------------------------------- application visibility
#
# A profile shows a subset of the machine's applications by writing XDG hidden
# entries into ~/.local/share/applications. Omarchy's menu, launcher and search
# all filter through one script — hidden-entries.sh — so an entry marked
# NoDisplay=true there disappears from all three at once, live, with no shell
# restart. There is nothing to teach the launcher and no fork of it to maintain.
#
# This writes into the user's real application directory, which is the largest
# blast radius in the plugin, so every file we touch says what we did to it:
#
#   X-OmarchyProfiles-Hidden=1    we created this file from a system entry
#                                 -> unhiding it is `rm`
#   X-OmarchyProfiles-Modified=1  the user already had this file and we edited
#                                 it in place -> unhiding restores the backup,
#                                 unless it was edited while hidden
#
# Nothing untagged is ever deleted, and nothing untagged is edited before a
# backup of it has been made and compared byte for byte.

# Every desktop entry on the machine, as TSV, one line per desktop id:
#
#   id  level  source_path  hidden_at_source  wmclass  exec  name  tag  tag_path
#
# The first six columns are the design's; `name` saves every consumer a second
# read of the same files, and `tag`/`tag_path` say which file in APPS_DIR is
# ours and where it is. That is what keeps this the ONLY place in the engine
# that enumerates desktop files — everything else reads these lines.
#
# It mirrors hidden-entries.sh exactly — same scan order, same id rule, same
# hiding rules — with one deliberate difference: it looks THROUGH our own tags.
# A file we created is skipped without claiming its id, so the system entry
# behind it answers; a file we edited is judged by its backup. Our own edits
# therefore cannot change its answer, which is what gives reconcile a fixed
# point: without it, hiding an app removes it from the candidate set, and the
# next reconcile decides it is no longer an app anyone asked to hide.
#
# The rules are re-implemented in awk rather than shelling out to
# hidden-entries.sh because that script scans fixed directories: pointing it at
# a backup would mean copying every desktop file on the machine on every switch.
# The copy is kept honest by a test: with no tagged file anywhere, the ids this
# reports as hidden_at_source must equal hidden-entries.sh's output exactly.
app_sources() {
  [[ -n ${APP_SOURCES_CACHE+set} ]] || APP_SOURCES_CACHE=$(app_sources_scan)
  [[ -n $APP_SOURCES_CACHE ]] && printf '%s\n' "$APP_SOURCES_CACHE"
  return 0
}

# The desktop names AppLibrary.qml passes hidden-entries.sh: the three desktop
# environment variables, empty ones dropped, joined with a colon.
app_desktop_names() {
  local parts=() p
  for p in "${XDG_CURRENT_DESKTOP:-}" "${XDG_SESSION_DESKTOP:-}" "${DESKTOP_SESSION:-}"; do
    [[ -n $p ]] && parts+=("$p")
  done
  (IFS=:; printf '%s' "${parts[*]}")
}

app_sources_scan() {
  local dirs=("$APPS_DIR") data_dirs=() d
  IFS=':' read -ra data_dirs <<<"${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for d in "${data_dirs[@]}"; do [[ -n $d ]] && dirs+=("$d/applications"); done
  dirs+=("$HOME/.nix-profile/share/applications")

  # NUL throughout, and every id and path handed to awk rather than to the
  # shell: "Disk Usage.desktop" and friends are already here, and a file name
  # is the one thing on this path we do not control.
  {
    for d in "${dirs[@]}"; do
      [[ -d $d ]] || continue
      printf 'D%s\0' "$d"
      find "$d" -type f -name '*.desktop' -print0 2>/dev/null | sort -z |
        awk 'BEGIN { RS = "\0"; ORS = "\0" } { print "F" $0 }'
    done
  } | awk -v RS='\0' \
          -v names="$(app_desktop_names)" \
          -v appsdir="$APPS_DIR" -v backups="$APP_BACKUP_DIR" \
          -v tag_hidden="$APP_TAG_HIDDEN" -v tag_modified="$APP_TAG_MODIFIED" '
    # hidden-entries.sh desktop_matches(): any name against any list entry.
    function matches(list, n, m, i, j, nn, ll) {
      n = split(names, nn, ":"); m = split(list, ll, ";")
      for (i = 1; i <= n; i++) {
        if (nn[i] == "") continue
        for (j = 1; j <= m; j++) if (ll[j] != "" && ll[j] == nn[i]) return 1
      }
      return 0
    }
    function openable(path, line, r) { r = (getline line < path); close(path); return r >= 0 }
    # hidden-entries.sh is_hidden_desktop_file(), plus the fields the callers
    # want, in one pass. `bare` drops Hidden/NoDisplay from the verdict, for the
    # one case where the file in front of us is ours and its backup is gone.
    function scan(path, bare, line, in_de, hid, only, notin, key, val, p, outer) {
      E_hidden = 0; E_class = ""; E_exec = ""; E_name = ""; E_tag = ""
      in_de = 0; hid = 0; only = ""; notin = ""
      # RS is NUL for the file list we are being fed; a desktop file is lines.
      outer = RS; RS = "\n"
      while ((getline line < path) > 0) {
        sub(/\r$/, "", line)
        if (line ~ /^\[.*\]$/) { in_de = (line == "[Desktop Entry]") ? 1 : 0; continue }
        if (!in_de) continue
        p = index(line, "="); if (p == 0) continue
        key = substr(line, 1, p - 1); val = substr(line, p + 1)
        if (key == "Hidden" || key == "NoDisplay") { if (val == "true" && !bare) hid = 1 }
        else if (key == "OnlyShowIn") only = val
        else if (key == "NotShowIn") notin = val
        else if (key == "StartupWMClass") { if (E_class == "") E_class = val }
        else if (key == "Exec") { if (E_exec == "") E_exec = val }
        else if (key == "Name") { if (E_name == "") E_name = val }
        else if (key == tag_hidden) { if (val == "1") E_tag = "hidden" }
        else if (key == tag_modified) { if (val == "1") E_tag = "modified" }
      }
      close(path); RS = outer
      if (hid) { E_hidden = 1; return }
      if (only != "" && !matches(only)) { E_hidden = 1; return }
      if (notin != "" && matches(notin)) { E_hidden = 1; return }
    }
    function clean(s) { gsub(/[\t\n]/, " ", s); return s }
    function emit(id, level, src, hid, cls, ex, nm, tg, tp) {
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", clean(id), level, clean(src),
             (hid ? "true" : "false"), clean(cls), clean(ex), clean(nm), tg, clean(tp)
    }
    {
      kind = substr($0, 1, 1); value = substr($0, 2)
      if (kind == "D") { dir = value; next }
      file = value
      id = substr(file, length(dir) + 2)            # desktop_id_for_file
      sub(/\.desktop$/, "", id)
      gsub(/\//, "-", id)
      if (id in seen) next                          # first-seen id wins
      level = (dir == appsdir) ? "user" : "system"
      src = file
      scan(file, 0)
      if (level == "user" && E_tag != "") {
        owned[id] = E_tag; ownpath[id] = file
        # Ours. Let the entry we made it from answer for the id instead.
        if (E_tag == "hidden") next
        backup = backups "/" id ".desktop"
        if (openable(backup)) { src = backup; scan(backup, 0) }
        else scan(file, 1)                          # backup lost: judge it by everything but our own flags
      }
      seen[id] = 1
      emit(id, level, src, E_hidden, E_class, E_exec, E_name, owned[id], ownpath[id])
    }
    # A file of ours whose source has since been uninstalled. Nothing else would
    # ever mention it again, and it would stay in the menu directory forever.
    END {
      for (id in owned)
        if (!(id in seen)) emit(id, "user", ownpath[id], 1, "", "", "", owned[id], ownpath[id])
    }'
}

# What apply_app_visibility would do for <profile>, as TSV:
#
#   H  id  level  source_path     hide this id (it is not ours yet)
#   S  id  tag    path            show it again (it is ours and no longer hidden)
#
# The hide side is the work outstanding, not the whole set a profile hides: once
# converged there is nothing to do and a preview is empty, which is the property
# the fixed-point test asserts.
app_visibility_plan() {
  local name=$1 master=false allowed=""
  is_master "$name" && master=true
  [[ $master == true ]] || allowed=$(jq -r '(.apps.allowed // [])[]' "$(file_for "$name")" 2>/dev/null)

  app_sources | awk -F'\t' -v master="$master" -v allowed="$allowed" '
    BEGIN { n = split(allowed, a, "\n"); for (i = 1; i <= n; i++) if (a[i] != "") ok[a[i]] = 1 }
    {
      id = $1; level = $2; src = $3; hidden = $4; tag = $8; tagpath = $9
      if (tag != "") { owned[id] = tag; opath[id] = tagpath }
      if (master == "true") next          # the master sees everything
      if (hidden == "true") next          # not a candidate: Omarchy hides it anyway
      if (id in ok) next
      hide[id] = 1; hlevel[id] = level; hsrc[id] = src
    }
    END {
      for (id in hide)  if (!(id in owned)) printf "H\t%s\t%s\t%s\n", id, hlevel[id], hsrc[id]
      for (id in owned) if (!(id in hide))  printf "S\t%s\t%s\t%s\n", id, owned[id], opath[id]
    }' | sort
}

# Make what is on disk match <profile>, whatever it was before. An absolute
# setter rather than a diff applier: it is re-run by refresh and after a crash,
# and has to be able to clean up work it did not itself start.
apply_app_visibility() {
  local name=${1:-}
  [[ -n $name ]] && exists "$name" || return 1
  mkdir -p "$APPS_DIR" "$APP_BACKUP_DIR" || return 1

  local changed=0 kind id arg path
  while IFS=$'\t' read -r kind id arg path; do
    case $kind in
    H) app_hide "$id" "$arg" "$path" && changed=1 ;;
    S) app_show "$id" "$arg" "$path" && changed=1 ;;
    esac
  done < <(app_visibility_plan "$name")

  ((changed)) || return 0
  unset APP_SOURCES_CACHE
  # Otherwise mimeinfo.cache still answers with the entries we removed.
  command -v update-desktop-database >/dev/null &&
    update-desktop-database -q "$APPS_DIR" 2>/dev/null
  return 0
}

# The copy of <src> that is hidden: NoDisplay and our tag go in immediately
# after the [Desktop Entry] header, and any NoDisplay/Hidden already in that
# group comes out.
#
# Stripping is not tidiness. hidden-entries.sh treats a `true` as sticky, but
# other XDG parsers take the LAST value in the group, so a pre-existing
# NoDisplay=false further down would leave the app hidden here and visible
# everywhere else. Later groups — [Desktop Action …], which chromium, code and
# nautilus all have — are left exactly as they are.
app_hidden_copy() {
  awk -v tag="$2" '
    /^\[/ { if (g == 1) g = 2
            if ($0 == "[Desktop Entry]" && g == 0) { print; print "NoDisplay=true"; print tag "=1"; g = 1; next } }
    g == 1 && /^(NoDisplay|Hidden)=/ { next }
    { print }' "$1"
}

# A temp file beside the entries, so the move onto them is atomic. The name
# deliberately does not end in .desktop: a scan racing us must not see it.
app_tempfile() { mktemp "$APPS_DIR/.omarchy-profiles.XXXXXX"; }

app_hide() {
  local id=$1 level=$2 src=$3 tmp
  if [[ $level == user ]]; then
    # The user's own file. It is read-only to us until there is a backup we
    # have compared against it — a half-written backup here is the difference
    # between hiding an app and losing it.
    local backup="$APP_BACKUP_DIR/$id.desktop"
    cp -p -- "$src" "$backup" 2>/dev/null || { warn "could not back up $id — leaving it visible"; return 1; }
    cmp -s -- "$src" "$backup" || {
      rm -f -- "$backup"
      warn "the backup of $id did not match the original — leaving it visible"; return 1
    }
    tmp=$(app_tempfile) || return 1
    app_hidden_copy "$src" "$APP_TAG_MODIFIED" >"$tmp" || { rm -f -- "$tmp"; return 1; }
    chmod --reference="$src" -- "$tmp" 2>/dev/null || chmod 0644 -- "$tmp"
    mv -f -- "$tmp" "$src" || { rm -f -- "$tmp"; return 1; }
    # The hash of the file AS WE LEFT IT. Unhiding compares against it to find
    # out whether anyone has touched the file since.
    sha256sum <"$src" | awk '{ print $1 }' >"$APP_BACKUP_DIR/$id.sha256"
  else
    # A system entry. Our copy shadows it by id, and unhiding is deleting it,
    # so there is nothing to back up.
    tmp=$(app_tempfile) || return 1
    app_hidden_copy "$src" "$APP_TAG_HIDDEN" >"$tmp" || { rm -f -- "$tmp"; return 1; }
    chmod 0644 -- "$tmp"
    mv -f -- "$tmp" "$APPS_DIR/$id.desktop" || { rm -f -- "$tmp"; return 1; }
  fi
  return 0
}

app_show() {
  local id=$1 tag=$2 path=$3
  [[ -f $path ]] || return 1

  if [[ $tag == hidden ]]; then
    rm -f -- "$path"
    return 0
  fi

  local backup="$APP_BACKUP_DIR/$id.desktop" hashfile="$APP_BACKUP_DIR/$id.sha256"
  local want="" live
  [[ -f $hashfile ]] && want=$(<"$hashfile")
  live=$(sha256sum <"$path" | awk '{ print $1 }')
  if [[ -f $backup && -n $want && $live == "$want" ]]; then
    mv -f -- "$backup" "$path" || return 1
    rm -f -- "$hashfile"
    return 0
  fi

  # Edited since we hid it — by the user, or by the app's own updater. The edit
  # wins: take out only the two lines we put in, and put back whatever
  # NoDisplay/Hidden the original had, which we stripped when we hid it.
  local restore=""
  [[ -f $backup ]] && restore=$(awk '
    /^\[/ { if (g == 1) g = 2; if ($0 == "[Desktop Entry]" && g == 0) { g = 1; next } }
    g == 1 && /^(NoDisplay|Hidden)=/ { print }' "$backup")

  local tmp; tmp=$(app_tempfile) || return 1
  awk -v tag="$APP_TAG_MODIFIED" -v restore="$restore" '
    BEGIN { nr = split(restore, rl, "\n") }
    {
      if (substr($0, 1, 1) == "[") {
        if (g == 1) g = 2
        if ($0 == "[Desktop Entry]" && g == 0) {
          print; g = 1; expect = 1
          for (i = 1; i <= nr; i++) if (rl[i] != "") print rl[i]
          next
        }
      }
      if (g == 1 && expect == 1 && $0 == "NoDisplay=true") { expect = 0; next }
      expect = 0
      if (g == 1 && $0 == tag "=1") next
      print
    }' "$path" >"$tmp" || { rm -f -- "$tmp"; return 1; }
  chmod --reference="$path" -- "$tmp" 2>/dev/null || chmod 0644 -- "$tmp"
  mv -f -- "$tmp" "$path" || { rm -f -- "$tmp"; return 1; }
  local had_backup=""; [[ -f $backup ]] && had_backup=1
  rm -f -- "$backup" "$hashfile"
  if [[ -n $had_backup ]]; then
    warn "kept your edits to $id"
  else
    # Nothing to put back. Removing our own two lines is all we can do, and all
    # we are entitled to do — the rest of the file is not ours.
    warn "no backup for $id — removed the lines this plugin added and left the rest"
  fi
  return 0
}

# Undo every hidden entry we own, whatever profile asked for it. The safety net
# for a crash mid-switch and the first step of uninstalling.
apps_sweep() {
  mkdir -p "$APP_BACKUP_DIR"
  local n=0 id tag path
  while IFS=$'\t' read -r id tag path; do
    [[ -n $id ]] || continue
    app_show "$id" "$tag" "$path" && n=$((n + 1))
  done < <(app_sources | awk -F'\t' '$8 != "" { print $1 "\t" $8 "\t" $9 }' | sort -u)
  if ((n)); then
    unset APP_SOURCES_CACHE
    command -v update-desktop-database >/dev/null &&
      update-desktop-database -q "$APPS_DIR" 2>/dev/null
  fi
  echo "restored $n hidden $([[ $n == 1 ]] && echo entry || echo entries)"
}

write_state() {
  local name=$1 offset
  offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$name")")
  mkdir -p "$STATE_DIR"
  local tmp
  tmp=$(mktemp "${STATE_FILE}.XXXXXX") || return 1
  jq -n --arg profile "$name" --argjson ws_offset "${offset:-0}" \
     --argjson span "$(cfg .workspace_span)" --arg updated "$(date -Iseconds)" \
     '{profile: $profile, ws_offset: $ws_offset, ws_span: $span, updated: $updated}' \
     >"$tmp" && mv "$tmp" "$STATE_FILE" || { rm -f "$tmp"; return 1; }
  cfg_set --arg last "$name" '.last = $last' || warn "could not record last profile"

  # Stamped on the profile itself, so the overview can say "not opened in three
  # weeks" — which is the signal that it is holding windows you have forgotten.
  local ptmp
  ptmp=$(mktemp) || return 0
  # UTC with a Z: jq's fromdateiso8601 rejects a +02:00 offset outright, and
  # the reader should not have to carry a timezone parser.
  jq --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '.last_used = $t' "$(file_for "$name")" >"$ptmp" &&
    mv "$ptmp" "$(file_for "$name")" || rm -f "$ptmp"
}

# -------------------------------------------- the lock and the switch journal
#
# A switch restarts the shell, which kills whatever asked for it. That is not a
# bug to be fixed — the shell has to be restarted for a profile to apply — but
# it means the work cannot be done by the process the panel is waiting on, and
# that nothing can report back afterwards. So a switch is two stages:
#
#   stage 1  attached. Answers the one question the caller can still hear:
#            were you allowed to do this. Takes the lock, forks stage 2, exits.
#   stage 2  detached, and the only thing that touches profile data. Every step
#            it is about to take is written to the journal first, so a stage 2
#            that dies can be finished by the next thing that looks.
#
# The journal is what stops the worst bug in the design: a switch that dies
# after the restart leaves B's files live, and the next capture would file them
# under A. Nothing may capture while a journal exists.

# One flock on the state directory around every verb that changes what a
# profile owns; a second caller gets exit 3 rather than interleaving with the
# first. Deliberately fd 8 and deliberately written down: a child that inherits
# it holds the lock for as long as it lives, so every fork that can outlive the
# switch has a descriptor number to close.
take_state_lock() {
  mkdir -p "$STATE_DIR" || return 1
  exec 8>"$LOCK_FILE" || return 1
  flock -n 8
}

lock_or_busy() {
  take_state_lock && return 0
  refuse 3 busy "another switch or profile change is running — try again in a moment"
}

# Is anyone holding it? Asked on a second descriptor and given straight back:
# a status query must never be the thing a switch waits on.
state_lock_free() {
  mkdir -p "$STATE_DIR" || return 1
  exec 9>"$LOCK_FILE" || return 1
  if flock -n 9; then exec 9>&-; return 0; fi
  exec 9>&-
  return 1
}

journal_field() { [[ -s $JOURNAL ]] && jq -r --arg k "$1" '.[$k] // ""' "$JOURNAL" 2>/dev/null; }

# Written before the step it names, never after, and fsynced: the case this
# exists for is the machine stopping between the two.
journal_set() {
  local from=$1 to=$2 stage=$3 tmp
  mkdir -p "$STATE_DIR"
  [[ -n ${SWITCH_STARTED:-} ]] || SWITCH_STARTED=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  tmp=$(mktemp "$JOURNAL.XXXXXX") || return 1
  jq -n --arg from "$from" --arg to "$to" --arg stage "$stage" --arg started "$SWITCH_STARTED" \
     '{from: $from, to: $to, stage: $stage, started: $started}' >"$tmp" &&
    mv "$tmp" "$JOURNAL" || { rm -f "$tmp"; warn "could not write the switch journal"; return 1; }
  sync -f "$JOURNAL" 2>/dev/null
  # A test hook, and the only one in this file. Recovery has to be provable from
  # every stage, and timing a kill into the millisecond a step takes is not a
  # proof. Set OMARCHY_PROFILE_STALL_AT=<stage> to hold a switch just after that
  # stage is recorded and just before it runs. It changes nothing else.
  [[ ${OMARCHY_PROFILE_STALL_AT:-} == "$stage" ]] && sleep "${OMARCHY_PROFILE_STALL_SECS:-5}"
  return 0
}

journal_clear() {
  rm -f "$JOURNAL"
  sync -f "$STATE_DIR" 2>/dev/null
  return 0
}

# Nothing that could capture may run while a stale intent exists: capturing
# then is exactly how one profile's live state gets filed under another's name.
#
# A journal beside a HELD lock is not a stale intent — it is a switch happening
# right now, and the answer to that is `busy` (rule 7), which the caller reaches
# a line or two later when its own flock fails. Only a journal whose stage 2 is
# gone is an interrupted switch. The two look identical on disk and mean
# opposite things, and the lock is what tells them apart.
require_no_journal() {
  [[ -e $JOURNAL ]] || return 0
  state_lock_free || return 0
  local from to stage
  from=$(journal_field from); to=$(journal_field to); stage=$(journal_field stage)
  refuse 1 interrupted_switch \
    "a switch from ${from:-nothing} to ${to:-?} stopped at ${stage:-?} — repair it in Setup, or run: omarchy-profile setup fix switch" \
    "$(jq -nc --arg f "$from" --arg t "$to" --arg s "$stage" '{from: $f, to: $t, stage: $s}')"
}

# A held path shows the outgoing profile's data under the incoming one, which
# is unavoidable once a move has failed — but it is never *filed* as the wrong
# profile's, because no further switch runs until it has been put away.
require_no_held_paths() {
  [[ -s $PENDING_OWNER ]] || return 0
  local paths
  paths=$(cut -f1 "$PENDING_OWNER" | jq -Rsc 'split("\n") | map(select(length > 0))')
  refuse 1 held_paths \
    "a file could not be filed into its profile's store and is still in place — repair it in Setup, or run: omarchy-profile setup fix switch" \
    "$(jq -nc --argjson p "${paths:-[]}" '{paths: $p}')"
}

# Every tier-3 path must have something to seed an incoming profile from, or
# the switch would leave a `require`d Hyprland file absent. Tier 3 arrives with
# the isolate phase; until there are tier-3 entries this cannot fire, and it is
# wired here so stage 1 has the shape the plan gives it.
preflight_tier3() { return 0; }

# Stage 2. The only thing that touches profile data, and the only holder of the
# lock from the moment stage 1 exits.
switch_stage2() {
  local from=$1 to=$2
  # Stage 1's cancellation must not outlive the verdict: from here on, stopping
  # half way is the thing that leaves a machine in two profiles at once.
  trap - TERM
  # And nothing is attached any more. A HUP from the terminal that started this,
  # or a PIPE from a reader that died with the old shell, is not an instruction.
  trap '' HUP PIPE

  journal_set "$from" "$to" capture || return 1
  # The outgoing profile keeps whatever was changed while inside it.
  [[ -n $from ]] && exists "$from" && capture_into "$from"
  switch_forward "$from" "$to"
}

# Steps 3 to 7, without the capture. Recovery re-runs exactly this: from the
# swap on, every step is an absolute setter and safe to repeat, while a capture
# would file whatever is live now under whoever the journal happens to name —
# the same bug the journal exists to prevent, reintroduced by the repair.
switch_forward() {
  local from=$1 to=$2

  journal_set "$from" "$to" swap
  # Plugin state that lives outside shell.json follows the profile too, so a
  # Spotify session or a dock layout belongs to one profile rather than all.
  prune_isolated
  swap_isolated "$from" "$to"

  journal_set "$from" "$to" write
  apply_profile_files "$to"
  apply_app_visibility "$to"
  # BEFORE the restart, not after it. This used to run last, so a switch that
  # died after `omarchy restart shell` left B's files live while current.json
  # still said A — and the next switch captured B's desktop into A. Written
  # here, current.json names the profile whose files are live from the moment
  # they are written, and the restarted shell reads the right name on start.
  write_state "$to"

  journal_set "$from" "$to" restart
  restart_shell

  journal_set "$from" "$to" finish
  apply_profile_ipc "$to"
  write_index
  write_catalog

  # Last, not after write_state: a switch that died after the restart still has
  # its do-not-disturb, idle, wallpaper and launcher set finished by recovery.
  journal_clear
}

# Runs under the state lock, so a journal found here means stage 2 is dead — a
# live stage 2 holds the lock.
#
# Forward, never back. From the swap on, running the swap in reverse would file
# a real file that had not been moved yet under the wrong owner, which is the
# same class of bug as capturing into the wrong profile. And the user
# authenticated for `to` and asked for it, so finishing it is also what they
# wanted.
recover_switch() {
  # It finishes a switch, which means it restarts the shell, which means it is
  # detached like a switch is — so it needs the same signal hygiene.
  trap '' HUP PIPE
  [[ -e $JOURNAL ]] || { echo "no interrupted switch to repair"; return 0; }
  local from to stage
  from=$(journal_field from); to=$(journal_field to); stage=$(journal_field stage)
  SWITCH_STARTED=$(journal_field started)

  if [[ -z $to ]] || ! exists "$to"; then
    warn "the interrupted switch names a profile that is gone ('${to:-}') — discarding it"
    journal_clear
    return 0
  fi

  case $stage in
  capture)
    # Nothing of `to` has been touched: the live files and current.json are
    # still `from`, and a capture is atomic per file, so a half-done one is
    # either the old JSON or the new one. The switch simply did not happen.
    journal_clear
    echo "discarded an interrupted switch to $to that had not started" ;;
  *)
    [[ $stage == swap || $stage == write || $stage == restart || $stage == finish ]] ||
      warn "the journal names an unknown stage '$stage' — finishing it forward"
    echo "finishing the switch to $to (it stopped at ${stage:-?})"
    switch_forward "$from" "$to" ;;
  esac
}

# Hand the rest of the work to a forked copy of this already-authenticated
# shell, and get out of the way.
detach() {
  # The verdict has been printed and this process no longer has any business
  # holding the caller's pipes: it is about to restart the shell that is reading
  # them, and SIGPIPE from a dead reader would end the switch. Everything the
  # switch has to say from here goes to the log.
  local size=0
  [[ -e $SWITCH_LOG ]] && size=$(stat -c %s "$SWITCH_LOG" 2>/dev/null || echo 0)
  ((size > 1048576)) && : >"$SWITCH_LOG"
  exec 0</dev/null 1>>"$SWITCH_LOG" 2>&1

  # Job control, so the job gets its own process group. NOT setsid: that execs
  # a new program, which would need a callable "already authenticated" entry
  # point — the bypass this design deliberately does not have. The job is a
  # forked subshell of this process, with the function already in its memory.
  set -m
  "$@" &
  disown
}

# ------------------------------------------------------------------ apply

# Block until the shell answers, so the IPC calls after a restart are not fired
# into a process still starting up. Polls rather than sleeping a fixed amount:
# a cold start on a loaded machine is slower than on an idle one, and a fixed
# wait is either too short to be safe or too long to be pleasant.
wait_for_shell() {
  local i
  for i in $(seq 1 40); do
    omarchy-shell shell reloadConfig >/dev/null 2>&1 && return 0
    sleep 0.25
  done
  warn "the shell did not come back within 10s — do-not-disturb and idle may not have applied"
  return 1
}


# Applying a profile is three steps with a shell restart between the first and
# the last, and the switch journal has to be able to name each of them — so
# they are three functions rather than one. The order is what makes it safe:
# files first, restart second, IPC third. Restarting before the writes would
# have the new shell read the old files, and setting do-not-disturb over IPC
# before a restart wastes the call on a process about to exit.
#
# Every external call here closes fd 8. Anything started from inside the switch
# inherits the state lock otherwise, and a process that outlives stage 2 would
# hold it after the switch is over — which made every later verb `busy` until
# that process died.
apply_profile_files() {
  local name=$1 file
  file=$(file_for "$name")

  local theme screensaver lock bar
  theme=$(jq -r '.theme // ""' "$file")
  screensaver=$(jq -r '.idle.screensaver // empty' "$file")
  lock=$(jq -r '.idle.lock // empty' "$file")

  # Theme, FIRST and synchronously.
  #
  # This used to be backgrounded for a snappier picker, and the theme loaded
  # inconsistently as a result: `omarchy theme set` rewrites shell config and
  # asks the shell to reload, while the steps below also write shell.json and
  # request their own reload. Two writers racing over the same file meant
  # whichever finished last won, so the theme sometimes half-applied or not at
  # all. Waiting costs a couple of seconds per switch and is always correct.
  #
  # Still skipped when already current: retinting every terminal, the browser
  # policy and the shell is the expensive part, and there is no reason to pay
  # it to arrive where we already are.
  local live_theme=""
  [[ -s $THEME_NAME_FILE ]] && live_theme=$(<"$THEME_NAME_FILE")
  if [[ -n $theme && $theme != "$live_theme" ]]; then
    omarchy theme set "$theme" >/dev/null 2>&1 8>&- || warn "could not set theme '$theme'"
  fi

  # Bar layout and plugin enablement, written together in one atomic commit so
  # the shell never sees a layout referencing a plugin it has just disabled.
  bar=$(jq -c '.bar // empty' "$file")
  local disabled
  disabled=$(jq -c '.plugins.disabled // empty' "$file")

  # Shared widgets go back into the layout if this profile's snapshot predates
  # them being shared, and are taken out of disabledPlugins whatever the
  # profile says. "The same in every profile" has to survive a stale capture,
  # or the guarantee is only true until the next time you save a profile.
  local pinned_widgets pinned_all
  pinned_widgets=$(pinned_bar_widgets | jq -R . | jq -sc .)
  pinned_all=$(cfg -c '.pinned_plugins // []')

  if [[ -n $bar || -n $disabled ]]; then
    (
      # shellcheck disable=SC1091
      source /usr/share/omarchy/bin/omarchy-shell-config
      commit "$NORMALIZE
              | (if \$bar == null then . else .bar = \$bar end)
              | (if \$disabled == null then . else .disabledPlugins = \$disabled end)
              | .disabledPlugins = (.disabledPlugins - \$pinned_all)
              | ([.bar.layout.left, .bar.layout.center, .bar.layout.right]
                 | map(map(.id)) | add) as \$present
              | .bar.layout.right = (
                  (\$pinned_widgets
                   | map(. as \$id | select((\$present | index(\$id)) == null) | {id: \$id}))
                  + .bar.layout.right)" \
        --argjson bar "${bar:-null}" --argjson disabled "${disabled:-null}" \
        --argjson pinned_widgets "${pinned_widgets:-[]}" \
        --argjson pinned_all "${pinned_all:-[]}"
    ) >/dev/null 2>&1 8>&- || warn "could not write bar/plugins to shell.json"
  fi

  if [[ -n $screensaver && -n $lock ]]; then
    (
      # shellcheck disable=SC1091
      source /usr/share/omarchy/bin/omarchy-shell-config
      commit "$NORMALIZE | .idle.screensaver = \$sec | .idle.lock = \$lock" \
        --argjson sec "$screensaver" --argjson lock "$lock"
    ) >/dev/null 2>&1 8>&- || warn "could not write idle timers"
  fi
}

# Restart the shell, now that every file it reads has been written.
#
# A reload is not enough. Plugins hold their own config and state open, so a
# swapped Spotify session or dock file is not noticed; enabling a plugin that
# was off needs it instantiated; and Qt keeps compiled QML cached. Each of those
# produced a switch that looked half-applied, and "it usually works, restart if
# it looks wrong" is not a thing to ship.
#
# Its own step in the journal, because it is the step that kills whoever asked
# for the switch: everything before it must already be on disk, and everything
# after it has to be done by a process the restart cannot reach.
restart_shell() {
  command -v omarchy >/dev/null || return 0
  omarchy restart shell >/dev/null 2>&1 8>&- || warn "could not restart the shell"
  wait_for_shell
}

# The tail of a switch: settings that are told to the shell rather than written
# for it. Absolute setters only — a toggle would land on the wrong state
# whenever the machine already happened to be in the target state. These run
# against the shell that will still be running when the switch is done.
apply_profile_ipc() {
  local name=$1 file
  file=$(file_for "$name")

  local dnd inhibit browser
  dnd=$(jq -r 'if .dnd then "true" else "false" end' "$file")
  inhibit=$(jq -r 'if (.idle.inhibit // false) then "true" else "false" end' "$file")
  browser=$(jq -r '.browser_profile // "default"' "$file")

  omarchy-shell notifications setDnd "$dnd" >/dev/null 2>&1 8>&- ||
    warn "could not set do-not-disturb (shell busy?) — re-run to retry"

  # NOT `omarchy-shell idle enable`: that IPC target does not exist while
  # omarchy.idle sits in disabledPlugins, which is the normal state on a machine
  # using a third-party idle/lock plugin. Note the sense — stay-awake INHIBITS
  # idling, so inhibit=false means allow-idle.
  if [[ $inhibit == true ]]; then
    omarchy toggle idle stay-awake >/dev/null 2>&1 8>&- || warn "could not set stay-awake"
  else
    omarchy toggle idle allow-idle >/dev/null 2>&1 8>&- || warn "could not allow idling"
  fi

  [[ $browser != default ]] && mkdir -p "$DATA_HOME/omarchy-profiles/browser/$browser"

  local wallpaper
  wallpaper=$(jq -r '.wallpaper // ""' "$file")
  if [[ -n $wallpaper && -f $wallpaper ]]; then
    omarchy theme bg set "$wallpaper" >/dev/null 2>&1 8>&- || warn "could not set wallpaper"
  fi
  return 0
}

# Hyprland on Omarchy is configured in Lua, and hyprctl dispatch takes a Lua
# expression rather than a dispatcher name: `hyprctl dispatch workspace 3`
# fails with "')' expected near '3'". Every dispatch goes through these, so the
# dialect is written down once instead of four times.
#
# This was wrong in all four call sites until it was tested against a running
# compositor — including the window migration on remove, which therefore never
# moved anything. Nothing reported an error because the exit code was dropped.
hl_focus_workspace() {
  hyprctl dispatch "hl.dsp.focus({ workspace = \"$1\" })" >/dev/null
}

hl_move_window() {
  local ws=$1 addr=${2:-} follow=${3:-true} expr
  expr="hl.dsp.window.move({ workspace = \"$ws\""
  [[ -n $addr ]] && expr+=", window = \"address:$addr\""
  [[ $follow == false ]] && expr+=", follow = false"
  expr+=" })"
  hyprctl dispatch "$expr" >/dev/null
}

hl_close_window() {
  hyprctl dispatch "hl.dsp.window.close({ window = \"address:$1\" })" >/dev/null
}

# ------------------------------------------------------------------ global
#
# A workspace that belongs to the machine rather than to a profile.
#
# Some windows are not part of any desk: music, a download, a long build. Under
# per-profile workspace blocks those would be stranded in whichever profile
# happened to be active when they opened, reachable only by switching back.
#
# Hyprland already has the right layer for this — a special workspace is an
# overlay, toggled on top of whatever is below, and its id is negative so it
# falls outside every profile's block automatically. No new mechanism, and the
# overview lists it under (unassigned) for free.
#
# Off by default. It costs a keybinding and a concept, and someone who keeps
# their music in the master profile does not need either.

global_ws_name() { cfg '.global_workspace // ""'; }

cmd_global() {
  local verb=${1:-status} arg=${2:-}
  case $verb in
  status)
    local name; name=$(global_ws_name)
    if [[ -z $name ]]; then
      echo "no global workspace (turn one on with: omarchy-profile global enable music)"
    else
      echo "global workspace: special:$name"
      command -v hyprctl >/dev/null &&
        hyprctl -j clients 2>/dev/null |
          jq -r --arg w "special:$name" '.[] | select(.workspace.name == $w) | "  \(.class)  \(.title[0:50])"'
    fi ;;
  enable)
    [[ -n $arg ]] || arg=music
    [[ $arg =~ ^[a-z0-9-]+$ ]] || die "a workspace name may use lowercase letters, digits and - only"
    cfg_set --arg w "$arg" '.global_workspace = $w' || die "could not enable it"
    cat <<EOF
global workspace enabled: special:$arg

Add a keybinding for it in ~/.config/hypr/bindings.lua:

  o.bind("SUPER + M", "Music", hl.dsp.workspace.toggle_special("$arg"))
  o.bind("SUPER + SHIFT + M", "Send to music",
    hl.dsp.window.move({ workspace = "special:$arg", follow = false }))

Windows there stay put through every profile switch, and the overview lists
them under (unassigned) because a special workspace has a negative id and so
falls outside every profile's block.
EOF
    ;;
  disable)
    cfg_set '.global_workspace = ""' || die "could not disable it"
    echo "global workspace off — remove its keybinding by hand if you added one" ;;
  send)
    local name; name=$(global_ws_name)
    [[ -n $name ]] || die "no global workspace; try: omarchy-profile global enable music"
    hl_move_window "special:$name" "" false
    echo "sent the focused window to special:$name" ;;
  toggle)
    local name; name=$(global_ws_name)
    [[ -n $name ]] || die "no global workspace; try: omarchy-profile global enable music"
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$name\")" >/dev/null ;;
  # Writing the global-workspace bindings into the managed keys file is the
  # keybinding phase's; named here so the contract's verb is dispatchable.
  keys) not_implemented "global keys" ;;
  *) die "unknown global verb '$verb' (status, enable, disable, send, toggle, keys)" ;;
  esac
}

# ---------------------------------------------------------------- overview
#
# What every profile is holding open right now.
#
# Profiles persist by design: switching away kills nothing, which is what makes
# "I am working, now I want to game" safe. The cost is that seven profiles can
# quietly be holding seven browsers, and the only defence is being able to see
# it. This is that view.
#
# Two decisions make the numbers trustworthy rather than roughly right:
#
# Attribution is by WORKSPACE, not by anything we launched. A window belongs to
# a profile if its workspace falls in that profile's block, so a terminal
# started by hand counts exactly like one opened by a profile switch. Launching
# apps into per-profile systemd slices was the obvious alternative and is worse:
# it would only see what went through our own launcher, so the total would look
# authoritative while silently missing things.
#
# Memory comes from each window's cgroup, which uwsm already gives every app,
# so it is real accounting rather than a guess — and it is summed over UNIQUE
# cgroups, not windows. Chromium keeps every window in one scope; summing per
# window would report its memory once per tab-window and overstate a browser
# profile several times over.

# Deduped cgroup memory for a set of pids read from stdin.
#
# Deduped because Chromium keeps every window in one scope: summing per window
# would count a browser's memory once per window and overstate a profile
# several times over. An unreadable cgroup contributes nothing rather than
# failing the whole row.
cgroup_memory_for_pids() {
  local pid cg seen=() total=0 mem
  declare -A counted
  while read -r pid; do
    [[ $pid =~ ^[0-9]+$ ]] || continue
    cg=$(sed -n 's|^0::||p' "/proc/$pid/cgroup" 2>/dev/null)
    [[ -n $cg ]] || continue
    [[ -n ${counted[$cg]:-} ]] && continue
    counted[$cg]=1
    mem=$(cat "/sys/fs/cgroup${cg}/memory.current" 2>/dev/null) || continue
    [[ $mem =~ ^[0-9]+$ ]] && total=$((total + mem))
  done
  printf '%s\n' "$total"
}

overview_json() {
  command -v hyprctl >/dev/null || { echo '[]'; return 0; }

  local clients active ranges='[]' rows='[]' name offset span
  clients=$(hyprctl -j clients 2>/dev/null) || clients='[]'
  active=$(current_profile)

  while read -r name; do
    [[ -n $name ]] || continue
    offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$name")")
    span=$(jq -r '.workspaces.span // 10' "$(file_for "$name")")
    ranges=$(jq -c --argjson o "$offset" --argjson s "$span" '. + [{o: $o, s: $s}]' <<<"$ranges")

    local mem
    mem=$(jq -r --argjson o "$offset" --argjson s "$span" \
      '.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s)) | .pid' <<<"$clients" |
      cgroup_memory_for_pids)

    rows=$(jq -c \
      --arg name "$name" --arg active "$active" \
      --argjson o "$offset" --argjson s "$span" \
      --argjson clients "$clients" --argjson mem "${mem:-0}" \
      --slurpfile prof "$(file_for "$name")" '
        ($clients | [.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s))]) as $mine
        | . + [{
            profile: $name,
            active: ($name == $active),
            offset: $o, span: $s,
            windows: ($mine | length),
            workspaces: ($mine | map(.workspace.id) | unique | length),
            memory: $mem,
            apps: ($mine | group_by(.class) | map({class: (.[0].class // "?"), count: length})
                         | sort_by(-.count)),
            hidden: ($prof[0].hidden // false),
            locked: ($prof[0].locked // false),
            last_used: ($prof[0].last_used // "")
          }]' <<<"$rows")
  done < <(profile_names)

  # Anything outside every block, so nothing is invisible: the scratchpad, and
  # any workspace beyond the last profile's range.
  local loose_mem
  loose_mem=$(jq -r --argjson ranges "$ranges" \
    '.[] | . as $c
     | select([$ranges[] | select($c.workspace.id > .o and $c.workspace.id <= (.o + .s))] | length == 0)
     | .pid' <<<"$clients" | cgroup_memory_for_pids)

  jq -c --argjson clients "$clients" --argjson ranges "$ranges" --argjson mem "${loose_mem:-0}" '
    ($clients | [.[] | . as $c
       | select([$ranges[] | select($c.workspace.id > .o and $c.workspace.id <= (.o + .s))] | length == 0)]) as $loose
    | if ($loose | length) > 0 then
        . + [{
          profile: "(unassigned)",
          active: false, offset: null, span: null,
          windows: ($loose | length),
          workspaces: ($loose | map(.workspace.id) | unique | length),
          memory: $mem,
          apps: ($loose | group_by(.class) | map({class: (.[0].class // "?"), count: length}) | sort_by(-.count)),
          hidden: false, locked: false, last_used: ""
        }]
      else . end
  ' <<<"$rows"
}

cmd_overview() {
  local json
  json=$(overview_json)
  mkdir -p "$STATE_DIR"
  printf '%s' "$json" >"$STATE_DIR/overview.json"

  [[ ${1:-} == --json ]] && { printf '%s\n' "$json"; return 0; }

  printf '%-14s %5s %4s %8s %10s  %s\n' PROFILE WINS WS MEMORY 'LAST USED' APPS
  # Megabytes below a gigabyte: 51 MB rendered as "0G" at one decimal place,
  # which reads as "nothing here" for a window that is plainly open.
  jq -r --argjson now "$(date +%s)" '
    # A timestamp written before these were normalised to UTC carries a +02:00
    # offset, which fromdateiso8601 rejects outright. Catching that shows "?"
    # for one row instead of failing the whole table.
    def ago($now):
      if (. // "") == "" then "never"
      else (try ($now - fromdateiso8601) catch null) as $d
        | if   $d == null  then "?"
          elif $d < 3600   then (($d / 60      | floor | tostring) + "m ago")
          elif $d < 86400  then (($d / 3600    | floor | tostring) + "h ago")
          else                  (($d / 86400   | floor | tostring) + "d ago")
          end
      end;
    .[] | [
      (if .active then "* " else "  " end) + .profile,
      (.windows|tostring),
      (.workspaces|tostring),
      (if .memory >= 1073741824 then ((.memory/1073741824*10|round)/10|tostring) + "G"
       elif .memory >= 1048576 then ((.memory/1048576)|round|tostring) + "M"
       else "-" end),
      (if .active then "now" else (.last_used | ago($now)) end),
      (.apps | map(.class + (if .count > 1 then " x" + (.count|tostring) else "" end)) | join(", "))
    ] | @tsv' <<<"$json" |
    while IFS=$'\t' read -r p w ws m used apps; do
      printf '%-14s %5s %4s %8s %10s  %s\n' "$p" "$w" "$ws" "$m" "$used" "${apps:0:52}"
    done
}

# Close everything a profile is holding, politely.
#
# closewindow rather than killing the cgroup: an editor with unsaved work gets
# its usual chance to ask. Anything that ignores the request survives, which is
# the right failure — a profile with 12 windows and 6 GB is a housekeeping
# problem, not an emergency worth losing work over.
cmd_close_profile() {
  local name=${1:-}
  [[ -n $name ]] || die "usage: omarchy-profile close <name>"
  exists "$name" || die "no such profile '$name'"
  command -v hyprctl >/dev/null || die "hyprctl is not available"

  local offset span n=0 addr
  offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$name")")
  span=$(jq -r '.workspaces.span // 10' "$(file_for "$name")")
  while read -r addr; do
    [[ -n $addr ]] || continue
    hl_close_window "$addr" 2>/dev/null && ((n++))
  done < <(hyprctl -j clients 2>/dev/null |
    jq -r --argjson o "$offset" --argjson s "$span" \
      '.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s)) | .address')
  echo "asked $n window(s) in $name to close"
}

# ------------------------------------------------------------------ commands

cmd_list() {
  local cur master
  cur=$(current_profile); master=$(cfg .master)
  local any=0
  while read -r n; do
    [[ -n $n ]] || continue
    any=1
    local marker=" " tag="" desc hidden
    [[ $n == "$cur" ]] && marker="*"
    [[ $n == "$master" ]] && tag=" (master)"
    desc=$(jq -r '._description // ""' "$(file_for "$n")")
    hidden=$(jq -r 'if .hidden then " [hidden]" else "" end' "$(file_for "$n")")
    printf '%s %-12s %s%s%s\n' "$marker" "$n" "$desc" "$tag" "$hidden"
  done < <(profile_names)
  ((any)) || echo "no profiles yet — try: omarchy-profile init"
}

cmd_current() { local c; c=$(current_profile); [[ -n $c ]] && echo "$c" || echo "unknown"; }

# Stage 1: the only part of a switch the caller is still alive to hear.
#
# It answers one question — were you allowed to do this — and then forks the
# work and exits, because the work restarts the shell and would otherwise be
# killed half way through by the thing it is doing.
cmd_set() {
  # A switch cancelled before its commit point must leave nothing behind, so the
  # trap goes up before the first thing that could leave something. 143 is the
  # code the panel drops in silence, having cancelled deliberately.
  trap 'exit 143' TERM

  local name="" as_owner="" a
  for a in "$@"; do
    case $a in
    --json) JSON=1 ;;
    --as-owner) as_owner=1 ;;
    -*) die "unknown option '$a'" ;;
    *) [[ -n $name ]] || name=$a ;;
    esac
  done
  [[ -n $name ]] || die "usage: omarchy-profile set <name> [--json] [--as-owner]"

  # Preflight, before anything is captured, swapped or written: a stale intent,
  # a path held by a failed swap, or a tier-3 path with nothing to seed from all
  # stop the switch here, where stopping costs nothing.
  require_no_journal
  require_no_held_paths
  preflight_tier3 "$name"

  exists "$name" ||
    refuse 1 no_such_profile "no such profile '$name' (try: omarchy-profile list)"
  if is_master "$name" && [[ $(cfg .master_switchable) != true ]]; then
    refuse 1 master_not_switchable "master is configured as a template only (master_switchable=false)"
  fi

  # A switch is running and it is going somewhere other than here. The
  # short-circuit below would answer "already" from a current.json that is about
  # to be rewritten, and this caller's click would be silently lost on the way.
  if [[ -e $JOURNAL ]] && ! state_lock_free && [[ $(journal_field to) != "$name" ]]; then
    refuse 3 busy "a switch to $(journal_field to) is already running — try again in a moment"
  fi

  local cur
  cur=$(current_profile)
  [[ $cur == "$name" ]] && { answer '{"ok":true,"already":true}' "already in $name"; return 0; }

  # Authenticate BEFORE anything is captured, swapped or written, and before the
  # lock is taken — a prompt on screen must not make every other verb busy. A
  # failed unlock has to leave the machine exactly where it was, not half-way
  # into a profile it never opened.
  if profile_locked "$name"; then
    if [[ -t 0 ]] || ! auth_needs_terminal; then
      # --as-owner skips the bound-identity attempt.
      #
      # The identity check runs the camera engine, which waits out its own
      # timeout before failing — around nine seconds with the IR emitter
      # warm-up. Without this the owner of the machine pays that wait, every
      # time, before their own prompt even appears, on any profile that has
      # somebody else's face bound to it.
      #
      # Racing the two would be better than choosing between them: start the
      # identity check in the background, raise the prompt immediately, first
      # success wins. That needs a per-call timeout and clean cancellation from
      # omarchy-face, so this flag is the interim.
      # Passing no profile is what suppresses the identity attempt, since
      # authenticate() only looks for a bound identity when it is given one.
      local auth_profile="$name"
      [[ -n $as_owner ]] && auth_profile=""
      # The error code is today's mechanism told truthfully: what answers here
      # is the machine owner's prompt, and a refusal is the owner declining it.
      # The per-profile password codes arrive with the password phase.
      authenticate "$name" "$auth_profile" ||
        refuse 2 owner_declined "authentication failed — staying in ${cur:-the current profile}"
    else
      relaunch_in_terminal set "$name"
      return 0
    fi
  fi

  if ! take_state_lock; then
    # Someone else is switching. If they are switching to where we were going,
    # that is this caller's own earlier attempt having got there first, and the
    # honest answer is that their switch is under way — not that it is busy.
    if [[ -e $JOURNAL && $(journal_field to) == "$name" ]]; then
      answer "$(jq -nc --arg n "$name" '{ok: true, switching: $n}')" "switching to $name"
      return 0
    fi
    refuse 3 busy "another switch or profile change is running — try again in a moment"
  fi

  # Both of these could have changed while a prompt was on screen.
  require_no_journal
  cur=$(current_profile)
  [[ $cur == "$name" ]] && { answer '{"ok":true,"already":true}' "already in $name"; return 0; }

  # The commit point. Up to here a TERM exits 143 with nothing written, no
  # journal (only stage 2 writes one) and the lock released by this process
  # exiting. After it the verdict is on stdout and the switch will finish.
  trap '' TERM
  answer "$(jq -nc --arg n "$name" '{ok: true, switching: $n}')" "switching to $name"
  detach switch_stage2 "$cur" "$name"
  exit 0
}

cmd_capture() {
  require_no_journal
  lock_or_busy
  local cur
  cur=$(current_profile)
  [[ -n $cur ]] || die "no active profile to capture into"
  capture_into "$cur" && echo "captured live state into $cur"
}

cmd_create() {
  local name=${1:-} mode=${2:---from-master}
  [[ -n $name ]] || die "usage: omarchy-profile create <name> [--from-master|--clean]"
  [[ $name =~ ^[a-zA-Z0-9_-]+$ ]] || die "profile names may use letters, digits, - and _ only"
  exists "$name" && die "profile '$name' already exists"

  local offset master
  offset=$(next_offset); master=$(cfg .master)

  case $mode in
  --from-master)
    exists "$master" || die "master profile '$master' does not exist yet"
    # A snapshot, not a link: later installs into master must not silently
    # appear here, which is the whole point of per-profile app visibility.
    jq --arg d "Copied from $master" --argjson o "$offset" \
       '._description = $d | .master = false | .hidden = false
        | .workspaces = {offset: $o, span: (.workspaces.span // 10)}
        | .browser_profile = "default"' \
       "$(file_for "$master")" >"$(file_for "$name")"
    ;;
  --clean)
    # Clean means "a stock Omarchy desktop with none of my add-ons", not "an
    # empty screen". First-party plugins stay on — a profile with no clock, no
    # tray and no network indicator is broken rather than clean — and so do the
    # pinned ones. Everything remains individually switchable afterwards;
    # this only decides where a new profile starts.
    local all_off
    all_off=$(omarchy plugin list --json 2>/dev/null |
      jq -c --argjson pinned "$(cfg -c '.pinned_plugins // []')" '
        [ .[] | . as $p | select(($pinned | index($p.id)) == null)
              | select(.firstParty // false | not)
              | select(.canDisable // true) | .id ]') || all_off="[]"
    jq -n --arg d "Clean profile" --argjson o "$offset" --argjson off "${all_off:-[]}" '{
      _description: $d, master: false, hidden: false, icon: "󰆼",
      theme: "tokyo-night", wallpaper: "",
      dnd: false, idle: {screensaver: 150, lock: 300, inhibit: false},
      workspaces: {offset: $o, span: 10},
      browser_profile: "default",
      bar: null, plugins: {disabled: $off}, apps: {allowed: []}
    }' >"$(file_for "$name")"
    ;;
  *) die "unknown mode '$mode' (use --from-master or --clean)" ;;
  esac
  write_index
  # Isolated plugin state follows the same choice as the rest of the profile.
  # From master: copy its stores, so the new profile starts already signed in
  # to Spotify and with the same dock. Clean: copy nothing, so each plugin
  # makes itself a fresh one on first use — signed out, default dock.
  if [[ $mode == --from-master ]]; then
    local src dst path
    while read -r path; do
      [[ -n $path ]] || continue
      src=$(store_for "$master" "$path")
      dst=$(store_for "$name" "$path")
      [[ -e $src ]] || continue
      mkdir -p "$(dirname "$dst")"
      cp -a "$src" "$dst" || warn "could not copy $path into $name"
    done < <(isolated_paths)
  fi

  write_index
  echo "created $name (workspaces $((offset + 1))-$((offset + 10)))"
}

cmd_remove() {
  local name=${1:-}
  [[ -n $name ]] || die "usage: omarchy-profile remove <name>"
  # It deletes a profile's stores, so it may not run beside a switch that is
  # moving files into them, nor while an unfinished switch still names one.
  require_no_journal
  lock_or_busy
  exists "$name" || die "no such profile '$name'"
  is_master "$name" && die "refusing to remove the master profile"
  [[ $name == "$(current_profile)" ]] && die "refusing to remove the active profile — switch away first"

  # Its windows have to go somewhere.
  #
  # Abandoning them was the original behaviour and it was wrong twice over: no
  # profile maps to the freed block, so SUPER+1..0 can never reach those windows
  # again, and next_offset hands the same block to the next profile created —
  # which would then open onto a stranger's windows. Recovery meant knowing to
  # type `hyprctl dispatch workspace 14` at a shell.
  #
  # So they move to the master's block, workspace for workspace: the profile's
  # third workspace becomes the master's third. Master is the right destination
  # because it always exists and always sees everything.
  local offset span master_offset live=0
  offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$name")")
  span=$(jq -r '.workspaces.span // 10' "$(file_for "$name")")
  local master; master=$(cfg .master)
  master_offset=$(jq -r '.workspaces.offset // 0' "$(file_for "$master")" 2>/dev/null)
  [[ $master_offset =~ ^[0-9]+$ ]] || master_offset=0

  if command -v hyprctl >/dev/null; then
    live=$(hyprctl -j clients 2>/dev/null |
      jq --argjson o "$offset" --argjson s "$span" \
         '[.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s))] | length')
    if [[ ${live:-0} -gt 0 ]]; then
      # movetoworkspacesilent so the screen does not jump through every
      # workspace being emptied.
      while read -r addr ws; do
        [[ -n $addr ]] || continue
        hl_move_window "$((master_offset + ws - offset))" "$addr" false ||
          warn "could not move window $addr off workspace $ws"
      done < <(hyprctl -j clients 2>/dev/null |
        jq -r --argjson o "$offset" --argjson s "$span" \
           '.[] | select(.workspace.id > $o and .workspace.id <= ($o + $s))
                | "\(.address) \(.workspace.id)"')
      echo "moved $live window(s) to $master"
    fi
  fi
  rm -f "$(file_for "$name")"
  # Its isolated plugin state goes too. Leaving it behind would accumulate
  # silently, and one of those files is a signed-in Spotify session.
  rm -rf "${ISOLATE_DIR:?}/${name:?}"

  # Removing the last visible profile would leave nothing to switch to, so the
  # master comes back into the picker rather than the user being stranded with
  # an empty list. Master is the fallback precisely because it always exists.
  if [[ $(visible_names | wc -l) -eq 0 ]]; then
    local master; master=$(cfg .master)
    if exists "$master"; then
      local tmp; tmp=$(mktemp)
      jq '.hidden = false' "$(file_for "$master")" >"$tmp" && mv "$tmp" "$(file_for "$master")"
      echo "removed $name — $master is visible again, since nothing else was"
    fi
  else
    echo "removed $name"
  fi
  write_index
}

# Profiles the picker will offer.
visible_names() {
  while read -r n; do
    [[ -n $n ]] || continue
    jq -e '.hidden // false' "$(file_for "$n")" >/dev/null 2>&1 || echo "$n"
  done < <(profile_names)
}

cmd_visibility() {
  local verb=$1 name=${2:-}
  [[ -n $name ]] || die "usage: omarchy-profile $verb <name>"
  exists "$name" || die "no such profile '$name'"

  # Hiding the last visible profile would leave the picker empty and no way to
  # switch at all. Master is allowed to be hidden like any other — it just
  # cannot be the one that empties the list.
  if [[ $verb == hide ]]; then
    local remaining
    remaining=$(visible_names | grep -vx "$name" | wc -l)
    ((remaining >= 1)) || die "'$name' is the only profile left in the picker — make another one visible first"
  fi

  local hidden=true; [[ $verb == show ]] && hidden=false
  local tmp; tmp=$(mktemp)
  jq --argjson h "$hidden" '.hidden = $h' "$(file_for "$name")" >"$tmp" && mv "$tmp" "$(file_for "$name")"
  write_index
  [[ $verb == show ]] && echo "$name now shows in the picker" || echo "$name is now hidden from the picker"
}

# What this profile may launch, as the panel reads it. `all` is every entry
# Omarchy would show if no profile hid anything — which is why it is taken from
# the enumerator rather than from what is visible right now: an app this profile
# has already hidden still has to appear in the list, or there is no way to
# switch it back on.
apps_list_json() {
  local name=$1 master=false allowed
  is_master "$name" && master=true
  allowed=$(jq -c '.apps.allowed // []' "$(file_for "$name")" 2>/dev/null) || allowed='[]'

  app_sources | awk -F'\t' '$4 == "false" { printf "%s\t%s\n", $1, ($7 == "" ? $1 : $7) }' |
    sort -u -t$'\t' -k2,2 -k1,1 |
    jq -R -s --argjson allowed "${allowed:-[]}" --argjson master "$master" '
      [ split("\n")[] | select(length > 0) | split("\t") | {id: .[0], name: .[1]} ] as $apps
      | { all: [$apps[].id],
          allowed: $allowed,
          visible: [ $apps[] | select($master or (.id as $i | $allowed | index($i) != null)) ] }'
}

apps_preview_json() {
  app_visibility_plan "$1" | jq -R -s '
    [ split("\n")[] | select(length > 0) | split("\t") ] as $rows
    | { to_hide: [ $rows[] | select(.[0] == "H") | .[1] ],
        to_show: [ $rows[] | select(.[0] == "S") | .[1] ] }'
}

# Applications. Master is a wildcard: it sees everything, so an install only has
# to be registered to the profile it happened in.
cmd_apps() {
  # Both argument orders are accepted: `apps <profile> <verb> [id]`, which the
  # keybindings and the panel have always used, and the contract's
  # `apps <verb> --json <profile>`. A profile named after a verb loses, which is
  # a price worth one line of documentation.
  local json="" args=() a
  for a in "$@"; do
    if [[ $a == --json ]]; then json=1; JSON=1; else args+=("$a"); fi
  done
  local name verb app
  case ${args[0]:-} in
  list | preview | allow | deny | allow-all | deny-all)
    verb=${args[0]}; name=${args[1]:-}; app=${args[2]:-} ;;
  *)
    name=${args[0]:-}; verb=${args[1]:-list}; app=${args[2]:-} ;;
  esac

  [[ -n $name ]] || die "usage: omarchy-profile apps <profile> [list|preview|allow|deny] [app-id]"
  exists "$name" || die "no such profile '$name'"
  # A change to the allow-list of the active profile rewrites entries in
  # ~/.local/share/applications immediately, which is work a switch is also
  # doing. Reads never take the lock, so the panel's lists open during a switch.
  case $verb in
  allow | deny | allow-all | deny-all) lock_or_busy ;;
  esac
  local file; file=$(file_for "$name")
  case $verb in
  list)
    if [[ -n $json ]]; then apps_list_json "$name"
    elif is_master "$name"; then echo "*  (master sees every application)"
    else jq -r '(.apps.allowed // [])[]' "$file"
    fi ;;
  preview)
    # What a switch into this profile would do to the menu, without doing it.
    apps_preview_json "$name" ;;
  allow-all | deny-all)
    is_master "$name" && { echo "master already sees every application"; return 0; }
    local tmp; tmp=$(mktemp)
    if [[ $verb == deny-all ]]; then
      jq '.apps = ((.apps // {}) | .allowed = [])' "$file" >"$tmp"
    else
      # Every entry Omarchy would show on its own. Taken from the enumerator, so
      # it is the same set whichever profile is active and whatever is hidden
      # right now — otherwise "allow all" in one profile would silently mean
      # "allow all except what the profile I am standing in has hidden".
      local ids
      ids=$(app_sources | awk -F'\t' '$4 == "false" { print $1 }' | sort -u | jq -R . | jq -sc .)
      jq --argjson all "${ids:-[]}" '.apps = ((.apps // {}) | .allowed = $all)' "$file" >"$tmp"
    fi
    mv "$tmp" "$file" || die "could not update '$name'"
    [[ $name == "$(current_profile)" ]] && apply_app_visibility "$name"
    echo "$verb in $name" ;;
  allow | deny)
    [[ -n $app ]] || die "usage: omarchy-profile apps $name $verb <app-id>"
    is_master "$name" && { echo "master already sees every application"; return 0; }
    local tmp; tmp=$(mktemp)
    if [[ $verb == allow ]]; then
      jq --arg a "$app" '.apps = ((.apps // {}) | .allowed = (((.allowed // []) + [$a]) | unique))' "$file" >"$tmp"
    else
      jq --arg a "$app" '.apps = ((.apps // {}) | .allowed = ((.allowed // []) | map(select(. != $a))))' "$file" >"$tmp"
    fi
    mv "$tmp" "$file" || die "could not update '$name'"
    [[ $name == "$(current_profile)" ]] && apply_app_visibility "$name"
    echo "$verb $app in $name" ;;
  *) die "unknown apps verb '$verb'" ;;
  esac
}

cmd_plugin() {
  local name verb id
  # The contract writes this the other way round — `plugin list --json <name>`,
  # `plugin enable <name> <id>` — so both orders are accepted, as `apps` does.
  # The per-profile `--json` shape itself is the config phase's.
  case ${1:-} in
  list | enable | disable)
    verb=$1
    [[ ${2:-} == --json ]] && not_implemented "plugin $1 --json"
    name=${2:-}; id=${3:-} ;;
  *)
    name=${1:-}; verb=${2:-list}; id=${3:-} ;;
  esac
  [[ -n $name ]] || die "usage: omarchy-profile plugin <profile> [list|enable|disable] [plugin-id]"
  exists "$name" || die "no such profile '$name'"
  local file; file=$(file_for "$name")
  case $verb in
  list) jq -r '(.plugins.disabled // [])[]' "$file" ;;
  # Bulk operations take an optional category so "disable all" from a filtered
  # view means what the user is looking at, not the whole machine.
  enable-all | disable-all)
    local category=${3:-}
    local ids
    ids=$(omarchy plugin list --json 2>/dev/null |
      jq -r --argjson pinned "$(cfg -c '.pinned_plugins // []')" --arg cat "$category" '
        .[] | . as $p
        | select(($pinned | index($p.id)) == null)
        | select(.canDisable // true)
        | select($cat == "" or (
            if ($p.kinds | index("bar-widget")) then "Bar widgets"
            elif ($p.kinds | index("panel")) then "Panels"
            elif ($p.kinds | index("service")) then "Services"
            elif ($p.kinds | index("overlay")) then "Overlays"
            elif ($p.kinds | index("menu")) then "Menus"
            elif ($p.kinds | index("bar")) then "Bars"
            else "Other" end) == $cat)
        | .id')
    [[ -n $ids ]] || { echo "nothing to change"; return 0; }
    local tmp; tmp=$(mktemp)
    if [[ $verb == disable-all ]]; then
      jq --argjson add "$(printf '%s\n' "$ids" | jq -R . | jq -sc .)" \
        '.plugins = ((.plugins // {}) | .disabled = (((.disabled // []) + $add) | unique))' "$file" >"$tmp"
    else
      jq --argjson drop "$(printf '%s\n' "$ids" | jq -R . | jq -sc .)" \
        '.plugins = ((.plugins // {}) | .disabled = ((.disabled // []) | map(select(. as $i | ($drop | index($i)) == null))))' "$file" >"$tmp"
    fi
    mv "$tmp" "$file" || { rm -f "$tmp"; die "could not update '$name'"; }
    if [[ $name == "$(current_profile)" ]]; then
      local v=enable; [[ $verb == disable-all ]] && v=disable
      while read -r id; do
        [[ -n $id ]] || continue
        omarchy plugin "$v" "$id" >/dev/null 2>&1 || true
      done <<<"$ids"
    fi
    write_catalog
    echo "$verb${category:+ ($category)} in $name" ;;
  enable | disable)
    [[ -n $id ]] || die "usage: omarchy-profile plugin $name $verb <plugin-id>"
    if [[ $verb == disable ]] && cfg '.pinned_plugins // []' | jq -e --arg i "$id" 'index($i)' >/dev/null 2>&1; then
      die "'$id' is pinned and cannot be disabled — disabling it would leave no way back into another profile"
    fi
    local tmp; tmp=$(mktemp)
    if [[ $verb == disable ]]; then
      jq --arg i "$id" '.plugins = ((.plugins // {}) | .disabled = (((.disabled // []) + [$i]) | unique))' "$file" >"$tmp"
    else
      jq --arg i "$id" '.plugins = ((.plugins // {}) | .disabled = ((.disabled // []) | map(select(. != $i))))' "$file" >"$tmp"
    fi
    mv "$tmp" "$file" || { rm -f "$tmp"; die "could not update '$name'"; }

    # Editing the profile you are currently in has to change the machine too,
    # not just the file. Otherwise the next switch captures live state over the
    # edit and it silently disappears — the record and the reality have to move
    # together for the active profile.
    if [[ $name == "$(current_profile)" ]]; then
      omarchy plugin "$verb" "$id" >/dev/null 2>&1 ||
        warn "recorded, but could not $verb '$id' on the running shell"
    fi
    write_catalog
    echo "$verb $id in $name" ;;
  *) die "unknown plugin verb '$verb'" ;;
  esac
}

# Workspace indirection. Hyprland has no app grouping, so workspaces are the
# only layer available; these two keep SUPER+N meaning "this profile's Nth".
# The active profile's block. Defaults to 0/10 so a missing or unreadable state
# file leaves the keys addressing workspaces 1-10 — the stock behaviour — rather
# than doing nothing. These run on every workspace keypress, so they stay to one
# jq call.
ws_offset() {
  local o
  o=$(jq -r '.ws_offset // 0' "$STATE_FILE" 2>/dev/null)
  [[ $o =~ ^[0-9]+$ ]] && printf '%s\n' "$o" || printf '0\n'
}

ws_span() {
  local s
  s=$(jq -r '.ws_span // 10' "$STATE_FILE" 2>/dev/null)
  [[ $s =~ ^[0-9]+$ ]] && printf '%s\n' "$s" || printf '10\n'
}

cmd_ws() {
  local n=${1:-} offset span cur
  offset=$(ws_offset); span=$(ws_span)

  # next/prev step to the next workspace in this block that EXISTS.
  #
  # Hyprland's own e+1 skips empty workspaces — that is what the "e" is for, and
  # it is the whole reason the binding is useful: two occupied workspaces are
  # one keypress apart however far their numbers are. Its only flaw is not
  # knowing where a profile's block ends, so after the tenth it carries you into
  # the next desk's windows.
  #
  # So: the same skipping, bounded. Walking all ten positions blindly was worse
  # than the stock behaviour, because reaching an occupied workspace three
  # numbers away meant three keypresses through empty ones.
  if [[ $n == next || $n == prev ]]; then
    cur=$(hyprctl -j activeworkspace 2>/dev/null | jq -r '.id // 1')
    [[ $cur =~ ^-?[0-9]+$ ]] || cur=$((offset + 1))

    # Existing workspaces inside the block, in order, with the current one
    # folded in: a workspace with only one window is real to the compositor but
    # `hyprctl workspaces` can lag a fresh switch.
    local ids
    ids=$(hyprctl -j workspaces 2>/dev/null |
      jq -r --argjson o "$offset" --argjson s "$span" --argjson cur "$cur" \
        '[.[] | .id | select(. > $o and . <= ($o + $s))] + [$cur | select(. > $o and . <= ($o + $s))]
         | unique | .[]')

    # Outside the block (a special workspace, say), or nothing here yet: land on
    # the block's first workspace rather than doing nothing.
    if [[ -z $ids ]]; then
      hl_focus_workspace "$((offset + 1))"
      return 0
    fi

    local target
    target=$(awk -v cur="$cur" -v dir="$n" '
      { a[NR] = $1; if ($1 == cur) at = NR }
      END {
        if (NR == 0) exit
        if (at == 0) { print a[1]; exit }          # current not in the list
        if (NR == 1) { print a[1]; exit }          # nowhere else to go
        if (dir == "next") print a[at % NR + 1]
        else               print a[(at - 2 + NR) % NR + 1]
      }' <<<"$ids")
    [[ -n $target ]] && hl_focus_workspace "$target"
    return 0
  fi

  [[ $n =~ ^([1-9]|10)$ ]] || die "usage: omarchy-profile ws <1-10|next|prev>"
  hl_focus_workspace "$((offset + n))"
}

cmd_move() {
  local n=${1:-} offset follow=true
  # "silent" is follow = false in the Lua API: the window moves and the view
  # stays put, rather than a separate dispatcher name.
  [[ ${2:-} == --silent ]] && follow=false
  [[ $n =~ ^([1-9]|10)$ ]] || die "usage: omarchy-profile move <1-10> [--silent]"
  offset=$(ws_offset)
  hl_move_window "$((offset + n))" "" "$follow"
}

cmd_next() {
  local cur next first
  cur=$(current_profile)
  first=$(profile_names | head -1)
  [[ -n $first ]] || die "no profiles yet"
  next=$(profile_names | awk -v c="$cur" 'found { print; exit } $0 == c { found = 1 }')
  [[ -n $next ]] || next=$first
  cmd_set "$next"
}

# Adopt the machine as it is right now as the master profile. Safe to run on a
# configured desktop: it reads state, never imposes any.
cmd_init() {
  ensure_config
  local master; master=$(cfg .master)
  exists "$master" && die "master profile '$master' already exists"
  jq -n --arg d "The whole machine — every app and plugin" '{
    _description: $d, master: true, hidden: false, icon: "󰒓",
    theme: "", wallpaper: "",
    dnd: false, idle: {screensaver: 150, lock: 300, inhibit: false},
    workspaces: {offset: 0, span: 10},
    browser_profile: "default",
    bar: null, plugins: {disabled: []}, apps: {allowed: []}
  }' >"$(file_for "$master")"
  capture_into "$master"
  write_index
  write_catalog
  write_state "$master"
  echo "initialised master profile '$master' from the current machine"
  check_polkit_action
}

# Locking a profile depends on a polkit action declared system-wide, and
# `omarchy plugin add` cannot put a file in /usr/share -- so on a fresh install
# from the marketplace the action is missing. Nothing notices until somebody
# locks a profile and then cannot get back into it, which is far too late and
# looks like the lock is broken rather than unconfigured. Say it once, here,
# while the fix is still cheap.
check_polkit_action() {
  command -v pkcheck >/dev/null || return 0
  local out
  out=$(pkcheck --action-id no.graveklar.profiles.unlock --process "$$" 2>&1)
  [[ $out == *"not registered"* ]] || return 0
  echo
  warn "profile locks will not work yet: the polkit action is not installed."
  warn "one command, once:"
  warn "  sudo install -m 0644 $PLUGIN_DIR/polkit/no.graveklar.profiles.policy \\"
  warn "    /usr/share/polkit-1/actions/"
  warn "Everything else works without it."
}

# ------------------------------------------------------------------- setup
#
# One row per thing that has to be true before profiles work, and a fix for
# each. `omarchy plugin add --enable` copies files and nothing else — it
# installs no binary, registers no polkit action and runs no install script —
# so this is where that gap is closed, from the panel, with no terminal.
#
# Three rules the rows keep:
#   - a status query never raises a dialog and never opens a camera;
#   - a fact that could not be determined is `unknown`, never `ok`;
#   - Setup never edits the user's own configuration. Where their file is the
#     problem it says so and stops.
#
# Rows land with the phase that makes them true. These five are this phase's.

SETUP_ROWS=()

# setup_row <id> <label> <state> <detail> <fixable>
setup_row() {
  SETUP_ROWS+=("$(jq -nc --arg id "$1" --arg label "$2" --arg state "$3" \
                        --arg detail "$4" --argjson fixable "$5" \
                  '{id: $id, label: $label, state: $state, detail: $detail, fixable: $fixable}')")
}

# Where the engine lives for anything that has to name it in a file that
# outlives this process. The installed copy wins: a keybinding written from a
# working tree would break the day that tree moved.
engine_path() {
  local installed="$CONFIG_HOME/omarchy/plugins/graveklar.profiles/bin/omarchy-profile"
  if [[ $PLUGIN_DIR == "$CONFIG_HOME/omarchy/plugins/"* ]]; then
    printf '%s\n' "$PLUGIN_DIR/bin/omarchy-profile"
  elif [[ -x $installed ]]; then
    printf '%s\n' "$installed"
  else
    printf '%s\n' "$PLUGIN_DIR/bin/omarchy-profile"
  fi
}

# --------------------------------------------------------------- row: adopt

setup_row_adopt() {
  local master; master=$(cfg .master)
  if exists "$master"; then
    setup_row adopt "This machine is adopted" ok \
      "'$master' is the master profile: it sees every application, and new profiles are copied from it." false
  else
    setup_row adopt "Adopt this machine" needs_action \
      "Nothing is adopted yet, so there is no profile to switch to. This reads the desktop as it is right now and saves it as '$master'. It changes nothing." true
  fi
}

# ---------------------------------------------------------------- row: apps
#
# The hiding rules in app_sources are a copy of Omarchy's own
# hidden-entries.sh, and a copy that has drifted would hide the wrong
# applications on every switch. So they are checked against the original rather
# than trusted.
#
# Stated as two containments rather than as set equality, because equality can
# only be asked on a machine with none of our entries on disk: an entry we have
# hidden is hidden live and visible at its source, by design. Every id Omarchy
# hides is either hidden at its source or hidden by us; every id we read as
# hidden at source is hidden live. With no entries of ours those two reduce to
# equality, which is the test as the plan states it.
#
# Returns 0 match, 1 drifted, 2 could not be determined.
apps_rules_match() {
  local script="${OMARCHY_PATH:-/usr/share/omarchy}/shell/services/hidden-entries.sh"
  [[ -r $script ]] || return 2
  local tmp rc=0
  tmp=$(mktemp -d) || return 2
  # Its exit status is whatever its last scan_dir returned — 1 whenever
  # ~/.nix-profile/share/applications is absent, which is most machines — so it
  # says nothing about whether the scan worked. Only its output is a verdict.
  bash "$script" "$(app_desktop_names)" 2>/dev/null | sort -u >"$tmp/live"
  app_sources | awk -F'\t' '$4 == "true" { print $1 }' | sort -u >"$tmp/ours"
  app_sources | awk -F'\t' '$8 != "" { print $1 }' | sort -u >"$tmp/owned"

  # Hidden at source but not hidden live: we would be showing something Omarchy
  # hides.
  comm -23 "$tmp/ours" "$tmp/live" >"$tmp/extra"
  [[ -s $tmp/extra ]] && rc=1
  # Hidden live, not hidden at source, and not ours: something is hiding it for
  # a reason our copy of the rules does not know about.
  comm -13 "$tmp/ours" "$tmp/live" >"$tmp/live-only"
  comm -23 "$tmp/live-only" "$tmp/owned" >"$tmp/unexplained"
  [[ -s $tmp/unexplained ]] && rc=1
  rm -rf "$tmp"
  return $rc
}

setup_row_apps() {
  local label="Application visibility"
  local cur; cur=$(current_profile)
  if [[ -z $cur ]] || ! exists "$cur"; then
    setup_row apps "$label" unknown \
      "No profile is active yet, so there is nothing to compare the menu against." false
    return
  fi

  # A -Modified tag means we edited a file the user already had. Without its
  # backup there is nothing to put back, and that is the one state here that is
  # broken rather than merely out of date: the data to undo it is gone.
  local orphan="" id tag
  while IFS=$'\t' read -r id tag; do
    [[ $tag == modified ]] || continue
    [[ -s $APP_BACKUP_DIR/$id.desktop ]] && continue
    orphan+="${orphan:+, }$id"
  done < <(app_sources | awk -F'\t' '$8 != "" { print $1 "\t" $8 }')
  if [[ -n $orphan ]]; then
    setup_row apps "$label" broken \
      "These entries were edited with no backup left to restore: $orphan. Fixing puts every application back and applies '$cur' again from scratch." true
    return
  fi

  apps_rules_match
  case $? in
  1) setup_row apps "$label" broken \
       "This plugin's copy of Omarchy's hiding rules no longer agrees with Omarchy's own, so a switch could hide the wrong applications. Fixing restores every entry and applies '$cur' again." true
     return ;;
  2) setup_row apps "$label" unknown \
       "Omarchy's own hidden-entries.sh could not be read, so its rules could not be compared with this plugin's copy." false
     return ;;
  esac

  local pending
  pending=$(apps_preview_json "$cur" | jq -r '(.to_hide | length) + (.to_show | length)' 2>/dev/null)
  [[ $pending =~ ^[0-9]+$ ]] || pending=0
  if ((pending > 0)); then
    setup_row apps "$label" needs_action \
      "$pending application entr$([[ $pending == 1 ]] && echo y || echo ies) do not match what '$cur' allows. Fixing brings the menu, the launcher and search back in line." true
  else
    setup_row apps "$label" ok \
      "The menu, the launcher and search show exactly what '$cur' allows." false
  fi
}

# ---------------------------------------------------------------- row: keys
#
# SUPER+1..0 have to address the active profile's block of workspaces, which
# means a keybinding that calls this engine. bindings.lua stays the user's —
# they may isolate it per profile, and Setup never writes into it — so the keys
# live in a file of our own and hyprland.lua gets exactly one line pointing at
# it.

KEYS_FILE="$CONFIG_HOME/hypr/profiles-keys.lua"
HYPRLAND_LUA="$CONFIG_HOME/hypr/hyprland.lua"
KEYS_REQUIRE='pcall(require, "hypr.profiles-keys") -- graveklar.profiles: managed, must stay after require("hypr.bindings")'

# The whole file is generated, every time. `hl` and `o` are globals in Omarchy's
# Lua state; the guard makes the file inert anywhere they are not, so a copy of
# it that ends up somewhere else can never break a config.
keys_file_content() {
  local engine; engine=$(engine_path)
  # A Lua string literal: a backslash or a quote in a path would otherwise end
  # the string, and nothing else in a path needs escaping.
  engine=${engine//\\/\\\\}
  engine=${engine//\"/\\\"}
  cat <<EOF
-- Managed by Profiles (graveklar.profiles). Setup regenerates this file; edits are overwritten.
if not (hl and o) then return end
local engine = "$engine"
for w = 1, 10 do
  local key, n = "code:" .. tostring(w + 9), tostring(w)
  hl.unbind("SUPER + " .. key)
  o.bind("SUPER + " .. key, "Workspace " .. n, engine .. " ws " .. n)
  hl.unbind("SUPER + SHIFT + " .. key)
  o.bind("SUPER + SHIFT + " .. key, "Move window to workspace " .. n, engine .. " move " .. n)
  hl.unbind("SUPER + SHIFT + ALT + " .. key)
  o.bind("SUPER + SHIFT + ALT + " .. key, "Move window silently to workspace " .. n, engine .. " move " .. n .. " --silent")
end
hl.unbind("SUPER + TAB");         o.bind("SUPER + TAB", "Next workspace in this profile", engine .. " ws next")
hl.unbind("SUPER + SHIFT + TAB"); o.bind("SUPER + SHIFT + TAB", "Previous workspace in this profile", engine .. " ws prev")
-- global workspace bindings are written here by \`global keys\` when the global workspace is enabled
EOF
}

# Someone's own workspace bindings, which would fight the managed ones.
#
# Matched on the binary path rather than on a command, because a block built
# from a variable — `gk_profile .. " ws " .. n` — contains no literal
# `omarchy-profile ws` anywhere. Every hypr Lua file except the managed one is
# searched, and so is every isolated copy of bindings.lua: another profile's
# copy can hold a block this profile's file does not.
keys_handwritten() {
  local f
  for f in "$CONFIG_HOME"/hypr/*.lua; do
    [[ -f $f ]] || continue
    [[ $f == "$KEYS_FILE" ]] && continue
    grep -nF 'graveklar.profiles/bin/omarchy-profile' -- "$f" 2>/dev/null |
      cut -d: -f1 | sed "s|^|$f:|"
  done
  for f in "$ISOLATE_DIR"/*/.config%hypr%bindings.lua; do
    [[ -f $f ]] || continue
    grep -nF 'graveklar.profiles/bin/omarchy-profile' -- "$f" 2>/dev/null |
      cut -d: -f1 | sed "s|^|$f:|"
  done
}

# Line numbers of the managed require line, and of the bindings require it must
# follow. `require("hypr.bindings")` wins over anything loaded before it, so
# these bindings have to come after it — not last: hyprmoncfg appends a block it
# wants last too, and the two do not conflict.
keys_line_no() { [[ -s $HYPRLAND_LUA ]] && grep -nF 'require, "hypr.profiles-keys"' -- "$HYPRLAND_LUA" | head -1 | cut -d: -f1; }
# Not the managed line itself, which says `require("hypr.bindings")` inside its
# own comment: matching that made the line look like it was in the right place
# whatever its position, because it was being compared against itself.
bindings_line_no() {
  [[ -s $HYPRLAND_LUA ]] || return 0
  grep -nF 'require("hypr.bindings")' -- "$HYPRLAND_LUA" |
    grep -vF 'hypr.profiles-keys' | head -1 | cut -d: -f1
}

setup_row_keys() {
  local label="Workspace keys"

  local hand; hand=$(keys_handwritten)
  if [[ -n $hand ]]; then
    # Not fixable from here, and deliberately so: the block is in the user's own
    # configuration, which Setup does not edit. The keys work — theirs call the
    # same engine — so this is a report, not a breakage.
    local files
    files=$(printf '%s\n' "$hand" | awk -F: '{ f[$1] = f[$1] (f[$1] ? ", " : "") $2 } END { for (k in f) printf "%s (lines %s) ", k, f[k] }' |
      sed "s|$HOME|~|g; s| $||")
    setup_row keys "$label" broken \
      "Workspace keys are also bound by hand in $files. Setup does not edit your own configuration — remove that block and this row goes green. Until then those bindings are the ones in force." false
    return
  fi

  local want have
  want=$(keys_file_content)
  have=$([[ -s $KEYS_FILE ]] && cat "$KEYS_FILE")
  local kline bline
  kline=$(keys_line_no); bline=$(bindings_line_no)

  if [[ ! -s $KEYS_FILE || -z $kline ]]; then
    setup_row keys "$label" needs_action \
      "SUPER+1..0 are not following the active profile yet, so they address workspaces 1-10 in every profile. Fixing writes ~/.config/hypr/profiles-keys.lua and adds one line to hyprland.lua." true
    return
  fi
  if [[ $have != "$want" ]]; then
    setup_row keys "$label" broken \
      "~/.config/hypr/profiles-keys.lua is not the file this plugin generates — it was edited, or written by an older version. Fixing rewrites it." true
    return
  fi
  if [[ -n $bline ]] && ((kline < bline)); then
    setup_row keys "$label" broken \
      "The managed line in hyprland.lua sits before require(\"hypr.bindings\"), so your own bindings overwrite the profile keys. Fixing moves it after." true
    return
  fi

  # Live confirmation, where there is a compositor to ask. Hyprland reports a
  # Lua binding's dispatcher as `__lua` with an opaque index, so what can be
  # confirmed is that a SUPER binding described "Workspace 1" exists, not which
  # command it runs — with no hand-written block in the tree above, this file is
  # the only thing that binds it.
  if ! command -v hyprctl >/dev/null || ! hyprctl binds -j >/dev/null 2>&1; then
    setup_row keys "$label" unknown \
      "The file and the line are in place, but there is no Hyprland session to confirm the keys are bound." false
    return
  fi
  if hyprctl binds -j 2>/dev/null |
     jq -e 'any(.[]; .description == "Workspace 1" and (.modmask % 128) >= 64)' >/dev/null 2>&1; then
    setup_row keys "$label" ok \
      "SUPER+1..0 follow the active profile, from a file this plugin owns." false
  else
    setup_row keys "$label" broken \
      "The managed file is in place but Hyprland has no SUPER+1 workspace binding, so the config did not load. Fixing rewrites the file and reloads." true
  fi
}

# Write the file, place the line, and prove the compositor still loads the
# config afterwards. If new errors appear the line comes straight back out: a
# workspace key is not worth a desktop that will not reload.
keys_fix() {
  mkdir -p "$CONFIG_HOME/hypr" || die "could not create ~/.config/hypr"
  local tmp
  tmp=$(mktemp "$KEYS_FILE.XXXXXX") || die "could not write beside profiles-keys.lua"
  keys_file_content >"$tmp" && mv "$tmp" "$KEYS_FILE" || { rm -f "$tmp"; die "could not write profiles-keys.lua"; }
  echo "wrote ${KEYS_FILE/#$HOME/\~}"

  local baseline=""
  command -v hyprctl >/dev/null &&
    baseline=$(hyprctl configerrors -j 2>/dev/null | jq -c 'map(select(. != ""))' 2>/dev/null)

  local kline bline added=0
  kline=$(keys_line_no); bline=$(bindings_line_no)
  if [[ -n $kline && -n $bline ]] && ((kline < bline)); then
    # Out of order: take the old one out before appending a new one, so the
    # file never ends up with two.
    local t2; t2=$(mktemp "$HYPRLAND_LUA.XXXXXX") || die "could not write beside hyprland.lua"
    grep -vF 'require, "hypr.profiles-keys"' -- "$HYPRLAND_LUA" >"$t2" &&
      mv "$t2" "$HYPRLAND_LUA" || { rm -f "$t2"; die "could not rewrite hyprland.lua"; }
    kline=""
  fi
  if [[ -z $kline ]]; then
    [[ -s $HYPRLAND_LUA ]] || die "no ~/.config/hypr/hyprland.lua to add the line to"
    printf '\n%s\n' "$KEYS_REQUIRE" >>"$HYPRLAND_LUA" || die "could not append to hyprland.lua"
    added=1
    echo "added one line to ${HYPRLAND_LUA/#$HOME/\~}"
  fi

  command -v hyprctl >/dev/null || return 0
  hyprctl reload >/dev/null 2>&1
  local now new
  now=$(hyprctl configerrors -j 2>/dev/null | jq -c 'map(select(. != ""))' 2>/dev/null)
  new=$(jq -nc --argjson a "${baseline:-[]}" --argjson b "${now:-[]}" '$b - $a' 2>/dev/null)
  if [[ -n $new && $new != "[]" ]]; then
    warn "Hyprland reported new config errors, so the line was taken out again:"
    jq -r '.[]' <<<"$new" | while read -r line; do warn "  $line"; done
    if ((added)); then
      local t3; t3=$(mktemp "$HYPRLAND_LUA.XXXXXX")
      grep -vF 'require, "hypr.profiles-keys"' -- "$HYPRLAND_LUA" >"$t3" && mv "$t3" "$HYPRLAND_LUA" || rm -f "$t3"
    fi
    hyprctl reload >/dev/null 2>&1
    return 1
  fi
  return 0
}

# ----------------------------------------------------------- row: indicator
#
# The bar's workspace numbers have to be relabelled per profile, and there is no
# hook for that — the widget has to be replaced. `omarchy plugin clone` makes a
# copy of the stock one under an id derived from the username, which is why the
# id is discovered and never written down: it is graveklar.workspaces here and
# alice.workspaces on someone else's machine.
STOCK_WORKSPACES="${OMARCHY_PATH:-/usr/share/omarchy}/shell/plugins/bar/widgets/Workspaces.qml"

indicator_id() {
  local dir manifest
  for dir in "$CONFIG_HOME"/omarchy/plugins/*/; do
    manifest="$dir/manifest.json"
    [[ -s $manifest ]] || continue
    jq -e '.omarchy.clonedFrom == "omarchy.workspaces"' "$manifest" >/dev/null 2>&1 || continue
    jq -r '.id // empty' "$manifest"
    return 0
  done
  return 1
}

# This plugin's patched widget, with the clone's own id in it. The id is
# substituted rather than shipped, for the same reason it is discovered.
indicator_content() {
  sed "s|^\( *moduleName: \)\".*\"|\1\"$1\"|" "$PLUGIN_DIR/extras/Workspaces.qml"
}

indicator_enabled() {
  omarchy plugin list --json 2>/dev/null |
    jq -e --arg id "$1" 'any(.[]; .id == $id and (.enabled // false))' >/dev/null 2>&1
}

setup_row_indicator() {
  local label="Workspace indicator"
  local id; id=$(indicator_id)
  if [[ -z $id ]]; then
    setup_row indicator "$label" needs_action \
      "The bar still shows plain workspace numbers, so every profile looks like it is on workspace 1-10. Fixing clones Omarchy's workspace widget and teaches the copy about profiles." true
    return
  fi

  local file="$CONFIG_HOME/omarchy/plugins/$id/Workspaces.qml"
  if [[ ! -s $file ]] || ! grep -q 'ws_offset' "$file"; then
    setup_row indicator "$label" broken \
      "'$id' exists but is not the profile-aware widget. Fixing replaces its Workspaces.qml." true
    return
  fi
  if ! diff -q <(indicator_content "$id") "$file" >/dev/null 2>&1; then
    setup_row indicator "$label" needs_action \
      "'$id' is an older copy of this plugin's workspace widget. Fixing re-syncs it." true
    return
  fi
  if ! indicator_enabled "$id"; then
    setup_row indicator "$label" needs_action \
      "'$id' is installed but switched off, so the bar is showing real workspace numbers. Fixing enables it." true
    return
  fi
  # A clone is a snapshot. If Omarchy's own widget has moved on since this
  # plugin's copy was taken, the copy is behind — and no re-clone can fix that,
  # because re-applying would only put this same copy back.
  if [[ -f $STOCK_WORKSPACES && $STOCK_WORKSPACES -nt $PLUGIN_DIR/extras/Workspaces.qml ]]; then
    setup_row indicator "$label" broken \
      "Omarchy's own workspace widget has changed since this plugin's copy of it was made, so '$id' may be missing what that change added. Updating this plugin is what resolves it." false
    return
  fi
  setup_row indicator "$label" ok \
    "'$id' relabels the bar so every profile reads 1-0, whichever block of workspaces it actually uses." false
}

indicator_fix() {
  local id; id=$(indicator_id)
  if [[ -z $id ]]; then
    command -v omarchy >/dev/null || die "omarchy is not available to clone the widget with"
    omarchy plugin clone omarchy.workspaces >/dev/null 2>&1 || die "could not clone omarchy.workspaces"
    id=$(indicator_id)
    [[ -n $id ]] || die "cloned omarchy.workspaces but could not find the clone"
    echo "cloned the workspace widget as '$id'"
  fi
  local file="$CONFIG_HOME/omarchy/plugins/$id/Workspaces.qml"
  [[ -d ${file%/*} ]] || die "no plugin directory for '$id'"
  local tmp; tmp=$(mktemp "${file%/*}/.Workspaces.XXXXXX") || die "could not write beside $file"
  indicator_content "$id" >"$tmp" && mv "$tmp" "$file" || { rm -f "$tmp"; die "could not write $file"; }
  echo "installed the profile-aware widget into '$id'"
  if ! indicator_enabled "$id"; then
    omarchy plugin enable "$id" >/dev/null 2>&1 || warn "could not enable '$id' — enable it from the bar settings"
  fi
  # Two workspace widgets in one bar is a duplicate, not a fallback.
  if indicator_enabled omarchy.workspaces; then
    omarchy plugin disable omarchy.workspaces >/dev/null 2>&1 ||
      warn "could not disable the stock omarchy.workspaces widget"
  fi
  return 0
}

# -------------------------------------------------------------- row: switch

setup_row_switch() {
  local label="Switching"
  local held=""
  [[ -s $PENDING_OWNER ]] && held=$(cut -f1 "$PENDING_OWNER" | sed "s|^$HOME|~|" | paste -sd', ')

  if [[ -e $JOURNAL ]]; then
    if ! state_lock_free; then
      setup_row switch "$label" unknown "A switch is running right now." false
      return
    fi
    local from to stage
    from=$(journal_field from); to=$(journal_field to); stage=$(journal_field stage)
    setup_row switch "$label" broken \
      "A switch from ${from:-nothing} to ${to:-?} stopped at ${stage:-?} and did not finish. Until it is repaired nothing may be captured, because the desktop and the records disagree about who owns it. Fixing finishes that switch." true
    return
  fi
  if [[ -n $held ]]; then
    setup_row switch "$label" broken \
      "These files could not be moved into their profile's store and are still where they were: $held. Switching is blocked until they are filed. Fixing files them under the profile that owned them." true
    return
  fi
  if ! state_lock_free; then
    setup_row switch "$label" unknown "A switch is running right now." false
    return
  fi
  setup_row switch "$label" ok "No switch is stuck and nothing is waiting to be filed." false
}

# Put a held path away under the profile that owned it when the move failed.
# The line is only removed once the file is safely in the store, so a second
# failure leaves the block in place rather than losing the file.
file_held_paths() {
  [[ -s $PENDING_OWNER ]] || return 0
  local left path owner store
  left=$(mktemp "$PENDING_OWNER.XXXXXX") || return 1
  while IFS=$'\t' read -r path owner; do
    [[ -n $path && -n $owner ]] || continue
    if [[ ! -e $path && ! -L $path ]]; then
      echo "nothing left at ${path/#$HOME/\~} — dropping the block"
      continue
    fi
    if ! exists "$owner"; then
      warn "'${path/#$HOME/\~}' was held for the profile '$owner', which no longer exists — leaving it in place"
      printf '%s\t%s\n' "$path" "$owner" >>"$left"
      continue
    fi
    store=$(store_for "$owner" "$path")
    mkdir -p "$(dirname "$store")"
    rm -rf "$store.prev"
    [[ -e $store ]] && { mv -T "$store" "$store.prev" || { warn "could not move '$owner''s old store aside for ${path/#$HOME/\~}"; printf '%s\t%s\n' "$path" "$owner" >>"$left"; continue; }; }
    if mv -T "$path" "$store"; then
      echo "filed ${path/#$HOME/\~} into $owner"
    else
      [[ -e $store.prev ]] && mv -T "$store.prev" "$store"
      warn "still cannot move ${path/#$HOME/\~} into $owner's store — leaving it in place"
      printf '%s\t%s\n' "$path" "$owner" >>"$left"
    fi
  done <"$PENDING_OWNER"
  if [[ -s $left ]]; then mv "$left" "$PENDING_OWNER"; else rm -f "$left" "$PENDING_OWNER"; fi
  return 0
}

# ------------------------------------------------------------ status and fix

setup_status() {
  SETUP_ROWS=()
  setup_row_adopt
  setup_row_apps
  setup_row_keys
  setup_row_indicator
  setup_row_switch

  if [[ -n $JSON ]]; then
    printf '%s\n' "${SETUP_ROWS[@]}" | jq -sc .
    return 0
  fi
  local row
  for row in "${SETUP_ROWS[@]}"; do
    printf '%-10s %-12s %s\n' "$(jq -r .id <<<"$row")" "$(jq -r .state <<<"$row")" "$(jq -r .detail <<<"$row")"
  done
}

cmd_setup() {
  local verb=${1:-status} id=${2:-} a
  for a in "$@"; do [[ $a == --json ]] && JSON=1; done
  [[ $id == --json ]] && id=""

  case $verb in
  status) setup_status ;;
  fix)
    [[ -n $id ]] || die "usage: omarchy-profile setup fix <adopt|apps|keys|indicator|switch>"
    # Every fix takes the state lock: each of them writes something a switch
    # also writes.
    lock_or_busy
    case $id in
    adopt) cmd_init ;;
    apps)
      local cur; cur=$(current_profile)
      [[ -n $cur ]] && exists "$cur" || die "no active profile to apply"
      # Broken means our tags no longer describe what is on disk, and the only
      # honest way back is to put every application in the menu again and
      # rebuild this profile's view of it from nothing.
      local broken=0 tag id2
      while IFS=$'\t' read -r id2 tag; do
        [[ $tag == modified ]] || continue
        [[ -s $APP_BACKUP_DIR/$id2.desktop ]] || broken=1
      done < <(app_sources | awk -F'\t' '$8 != "" { print $1 "\t" $8 }')
      # Only a genuine mismatch (1) sweeps; undeterminable (2) is not a reason
      # to take every application out of the menu and put it back.
      apps_rules_match
      [[ $? == 1 ]] && broken=1
      if ((broken)); then
        apps_sweep
        unset APP_SOURCES_CACHE
      fi
      apply_app_visibility "$cur"
      echo "applied '$cur''s applications" ;;
    keys) keys_fix || exit 1 ;;
    indicator) indicator_fix ;;
    switch)
      file_held_paths
      if [[ -e $JOURNAL ]]; then
        # Finishing a switch restarts the shell, which kills whoever asked for
        # the repair — the panel most of all. So the repair detaches exactly
        # like a switch does, and the row reads "a switch is running right now"
        # until it is done.
        local to; to=$(journal_field to)
        answer "$(jq -nc --arg n "$to" '{ok: true, switching: $n}')" "finishing the interrupted switch to $to"
        detach recover_switch
        exit 0
      fi
      echo "nothing to repair" ;;
    *) die "unknown setup row '$id'" ;;
    esac ;;
  *) die "usage: omarchy-profile setup [status|fix <id>]" ;;
  esac
}

# What this machine can and cannot do, as state strings. Every fact whose answer
# would have to be guessed is `unknown`, and an optional component that is not
# installed is `absent` — neither is ever reported as healthy.
cmd_capabilities() {
  # The reload probe belongs to the isolate phase; until it exists, whether
  # `hyprctl reload` re-reads a swapped file on THIS machine is not something
  # this engine has measured.
  local reload=unknown face=absent polkit=absent helpers=absent

  local identity=""
  command -v omarchy-face-identity >/dev/null && identity=$(command -v omarchy-face-identity)
  [[ -z $identity && -x /usr/local/bin/omarchy-face-identity ]] && identity=/usr/local/bin/omarchy-face-identity
  [[ -n $identity ]] && face=ok

  # Both belong to the password phase. They are reported as absent rather than
  # as needing action because there is nothing installed to act on yet.
  [[ -x /usr/local/bin/omarchy-profile-auth && -x /usr/local/bin/omarchy-profile-passwd ]] && helpers=unknown
  [[ -r /usr/share/polkit-1/actions/no.graveklar.profiles.auth.policy ]] && polkit=unknown

  jq -nc --arg r "$reload" --arg f "$face" --arg p "$polkit" --arg h "$helpers" \
    '{hyprland_reload: $r, face: $f, polkit: $p, helpers: $h}'
}

ensure_config

case "${1:-}" in
catalog) write_catalog ;;
global) shift; cmd_global "${1:-status}" "${2:-}" ;;
refresh)
  # Rewrite every file the panel and launcher read, without switching. Useful
  # after editing a profile by hand, and after installing over an older version
  # that wrote none of them.
  require_no_journal
  lock_or_busy
  cur=$(current_profile)
  write_index; write_catalog
  [[ -n $cur ]] && apply_app_visibility "$cur"
  echo "refreshed"
  # Also the upgrade path: someone who installed before this check existed, or
  # who installed from the marketplace, finds out here rather than at a lock.
  check_polkit_action ;;
isolate)
  shift
  # Two sub-verbs the isolate phase builds; named here so the panel gets a JSON
  # answer rather than "unknown command" on stderr.
  case "${1:-list}" in
  candidates | resolve) not_implemented "isolate $1" ;;
  esac
  cmd_isolate "${1:-list}" "${2:-}" "${3:-}" "${4:-}" ;;
shared) shift; cmd_shared "${1:-list}" "${2:-}" ;;
overview) shift; cmd_overview "${1:-}" ;;
close) shift; cmd_close_profile "${1:-}" ;;
lock) shift; cmd_lock lock "${1:-}" ;;
unlock) shift; cmd_lock unlock "${1:-}" ;;
identity)
  shift
  # The contract's `identity list --json` is the password phase's shape, and is
  # a different thing from today's `identity <profile> [<face>]`.
  [[ ${1:-} == list ]] && not_implemented "identity list"
  cmd_identity "${1:-}" "${2:-}" "${3:-}" ;;
# Everything below is named in the contract and built by a later phase. Each
# answers in JSON and exits 1, so the panel can call any verb the contract has
# from the day it freezes and render a real answer.
password | meta | rename | config | session | login | purge)
  not_implemented "$1 ${2:-}" ;;
setup) shift; cmd_setup "$@" ;;
capabilities) cmd_capabilities ;;
set) shift; cmd_set "$@" ;;
capture) cmd_capture ;;
create) shift; cmd_create "${1:-}" "${2:---from-master}" ;;
remove) shift; cmd_remove "${1:-}" ;;
show) shift; cmd_visibility show "${1:-}" ;;
hide) shift; cmd_visibility hide "${1:-}" ;;
apps) shift; cmd_apps "$@" ;;
apps-sweep) apps_sweep ;;
plugin) shift; cmd_plugin "${1:-}" "${2:-list}" "${3:-}" "${4:-}" ;;
ws) shift; cmd_ws "${1:-}" ;;
move) shift; cmd_move "${1:-}" "${2:-}" ;;
next) cmd_next ;;
current) cmd_current ;;
init) cmd_init ;;
list | ls | "")
  # The contract's `list --json` carries two fields — hasPassword and identity —
  # that only the password phase's root store can answer. Rather than print a
  # shape with invented values in it, the flag says so until that store exists.
  [[ ${2:-} == --json ]] && not_implemented "list --json"
  cmd_list ;;
-h | --help | help)
  cat <<'USAGE'
omarchy-profile — profiles for the Omarchy desktop

  init                             adopt the current machine as the master profile
  list                             profiles; * is active, (master) is the master
  current                          print the active profile
  set <name>                       switch (captures the outgoing profile first)
  next                             cycle to the next profile
  capture                          save live state into the active profile now

  create <name> [--from-master|--clean]
  remove <name>                    moves its windows to the master first
  show <name> | hide <name>        whether it appears in the picker
  lock <name> | unlock <name>      whether entering it needs authentication

  isolate [list|add|remove] [path]  give each profile its own copy of a
                                    plugin's own config or state file

  overview [--json]                what every profile is holding open
  refresh                          rewrite the files the panel and launcher read

  setup status [--json]            what still has to be true for this to work
  setup fix <id>                   fix one of those things
  capabilities --json              what this machine can and cannot do

  global [status|enable|disable|send|toggle] [name]
                                   a workspace that survives every switch

  close <name>                     ask every window in a profile to close

  apps <profile> [list|allow|deny|allow-all|deny-all] [app-id]
                                   which applications the profile may launch;
                                   the others are hidden from the menu, the
                                   launcher and search while it is active
  apps preview --json <profile>    what switching into it would hide or show
  apps-sweep                       put every application back, whatever profile
                                   hid it — the way out if something went wrong

  plugin <profile> [list|enable|disable] [plugin-id]

  ws <1-10|next|prev>            focus a workspace inside this profile
  move <1-10> [--silent]           move the window inside this profile

A profile is a saved desk, not a template: switching away captures whatever you
changed, so nothing resets when you come back.
USAGE
  ;;
*) die "unknown command '$1' (try: omarchy-profile --help)" ;;
esac
