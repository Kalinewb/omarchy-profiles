<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>omarchy-profiles</vendor>

  <!--
    Two actions, because the two privileged halves answer to different people.

    A profile's own password is checked with no dialog at all: the password IS
    the authentication, and asking the machine owner for theirs on top would
    mean nobody could open their own desk without the owner standing there. The
    helper behind this action cannot do anything that is not gated by that
    password — it cannot create a hash, reset one, bind a face or print one.

    The exec.path annotations are not optional. Without them pkexec maps the
    call to its generic org.freedesktop.policykit.exec action, which is
    auth_admin, and the no-prompt verifier would prompt — breaking every
    password entry. Modelled on omarchy-face's own policy.
  -->
  <action id="no.graveklar.profiles.auth">
    <description>Check a profile's password</description>
    <message>Checking a profile password</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/omarchy-profile-auth</annotate>
  </action>

  <!--
    auth_self, deliberately without _keep: a cached authorisation is exactly the
    hole this gate exists to close. The threat is a person at an unattended
    machine, and "you authorised something five minutes ago" is no evidence at
    all that you are the one standing here now.
  -->
  <action id="no.graveklar.profiles.owner">
    <description>Manage profile passwords</description>
    <message>Authentication is required to manage profile passwords</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/omarchy-profile-passwd</annotate>
  </action>

</policyconfig>
